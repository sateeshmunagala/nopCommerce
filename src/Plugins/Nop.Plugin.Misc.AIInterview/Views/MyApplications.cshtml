@model ApplicationListModel
@using Nop.Plugin.Misc.AIInterview.Domain
@using Nop.Web.Models.Customer

@{
    Layout = "_ColumnsTwo";
    NopHtml.AddTitleParts(T("Plugins.Misc.AIInterview.MyApplications.Title").Text);
    NopHtml.AppendCssFileParts("~/Plugins/Misc.AIInterview/Content/css/aiinterview-public.css");
    NopHtml.AppendPageCssClassParts("html-account-page");
    NopHtml.AppendPageCssClassParts("html-aiinterview-view-page");
    NopHtml.AppendPageCssClassParts("html-aiinterview-my-applications-page");

    var copyShareLinkText = T("Plugins.Misc.AIInterview.Report.CopyShareLink").Text;
    var shareText = T("Plugins.Misc.AIInterview.Report.Share").Text;
    var openSharePageText = T("Plugins.Misc.AIInterview.Report.OpenSharePage").Text;
    var jobReportTitleFormat = T("Plugins.Misc.AIInterview.Report.JobReportTitle").Text;
    var jobRecordingTitleFormat = T("Plugins.Misc.AIInterview.Report.JobRecordingTitle").Text;
    var viewReportText = T("Plugins.Misc.AIInterview.Report.ViewReport").Text;
}

@section left
{
    @await Component.InvokeAsync("CustomerNavigation", new { selectedTabId = AIInterviewDefaults.MyApplicationsNavigationTab })
}

<div class="page ai-applications-page">
    <div class="page-title">
        <h1>@T("Plugins.Misc.AIInterview.MyApplications.Title")</h1>
    </div>
    <div class="page-body">
        <div class="applications-card">
            <div class="applications-toolbar">
                <div>
                    <strong>@Model.TotalCount</strong> @T("Plugins.Misc.AIInterview.MyApplications.ApplicationsCountLabel")
                </div>
                <div class="applications-sort">
                    <label for="sortOrder">@T("Plugins.Misc.AIInterview.MyApplications.SortBy")</label>
                    <select id="sortOrder" onchange="location.href='@Url.Action("MyApplications")?sortOrder=' + this.value;">
                        <option value="LatestApplied" selected="@(Model.SortOrder == "LatestApplied")">@T("Plugins.Misc.AIInterview.History.Sort.LatestApplied")</option>
                        <option value="OldestApplied" selected="@(Model.SortOrder == "OldestApplied")">@T("Plugins.Misc.AIInterview.History.Sort.OldestApplied")</option>
                        <option value="HighestScore" selected="@(Model.SortOrder == "HighestScore")">@T("Plugins.Misc.AIInterview.History.Sort.HighestScore")</option>
                        <option value="LowestScore" selected="@(Model.SortOrder == "LowestScore")">@T("Plugins.Misc.AIInterview.History.Sort.LowestScore")</option>
                        <option value="LatestInterviewDate" selected="@(Model.SortOrder == "LatestInterviewDate")">@T("Plugins.Misc.AIInterview.History.Sort.LatestInterviewDate")</option>
                    </select>
                </div>
            </div>

            @if (Model.Applications.Any())
            {
                <div class="applications-table-wrap applications-table-scroller">
                <table class="applications-table">
                    <thead>
                        <tr>
                            <th>@T("Plugins.Misc.AIInterview.MyApplications.JobTitle")</th>
                            <th>@T("Plugins.Misc.AIInterview.MyApplications.Score")</th>
                            <th>@T("Plugins.Misc.AIInterview.History.Status")</th>
                            <th>@T("Plugins.Misc.AIInterview.Common.CompletedUtc")</th>
                            <th>@T("Plugins.Misc.AIInterview.Report.Title")</th>
                            <th>@T("Plugins.Misc.AIInterview.Report.Recording")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model.Applications)
                        {
                            var reportTitle = string.Format(jobReportTitleFormat, app.JobTitle);
                            var recordingTitle = string.Format(jobRecordingTitleFormat, app.JobTitle);
                            <tr>
                                <td>
                                    <div><strong>@app.JobTitle</strong></div>
                                    <div class="applications-footnote">@T("Plugins.Misc.AIInterview.MyApplications.Applied") @app.CreatedOn.ToString("yyyy-MM-dd HH:mm:ss")Z</div>
                                </td>
                                <td>
                                    @if (app.InterviewScore.HasValue)
                                    {
                                        <span class="score-chip">@Math.Round(app.InterviewScore.Value)</span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td><span class="status-pill">@app.Status</span></td>
                                <td>@(app.CompletedOn.HasValue ? app.CompletedOn.Value.ToString("yyyy-MM-dd HH:mm:ss") + "Z" : "-")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(app.InterviewReportUrl))
                                    {
                                        <a href="@app.InterviewReportUrl"
                                           class="js-open-report-drawer ai-view-report-link"
                                           data-report-panel-url="@app.InterviewReportPanelUrl"
                                           data-report-title="@reportTitle"><i class="fa-solid fa-eye" aria-hidden="true"></i><span>@viewReportText</span></a>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(app.RecordingUrl))
                                    {
                                        <div class="candidate-recording-actions">
                                            <a href="@app.RecordingUrl" target="_blank" rel="noopener">@T("Plugins.Misc.AIInterview.Report.OpenRecording")</a>
                                            @if (!string.IsNullOrEmpty(app.RecordingShareUrl))
                                            {
                                                <button type="button" class="button-2 ai-copy-share-link" data-share-url="@app.RecordingShareUrl">@copyShareLinkText</button>
                                                <button type="button" class="button-2 ai-native-share-link aiinterview-hidden" data-share-url="@app.RecordingShareUrl" data-share-title="@recordingTitle">@shareText</button>
                                                <noscript>
                                                    <a href="@app.RecordingShareUrl" target="_blank" rel="noopener">@openSharePageText</a>
                                                </noscript>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>

                <div class="applications-footnote">
                    @T("Plugins.Misc.AIInterview.MyApplications.HistoryFootnote")
                </div>
            }
            else
            {
                <p>@T("Plugins.Misc.AIInterview.History.NoSessions")</p>
            }
        </div>
    </div>
</div>

@await Html.PartialAsync("~/Plugins/Misc.AIInterview/Views/Shared/_CandidateReportDrawer.cshtml")
