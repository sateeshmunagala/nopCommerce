@model ApplicationListModel

@{
    Layout = "_ColumnsOne";
    NopHtml.AddTitleParts(T("Plugins.Misc.AIInterview.MyApplications.Title").Text);
}

<div class="page ai-interview-history-page">
    <div class="page-title">
        <h1>@T("Plugins.Misc.AIInterview.MyApplications.Title")</h1>
    </div>
    <div class="page-body">
        <div class="sort-options" style="margin-bottom: 20px;">
            <span>Sort by: </span>
            <select id="sortOrder" onchange="location.href='@Url.Action("MyApplications")?sortOrder=' + this.value;">
                <option value="LatestApplied" selected="@(Model.SortOrder == "LatestApplied")">@T("Plugins.Misc.AIInterview.History.Sort.LatestApplied")</option>
                <option value="OldestApplied" selected="@(Model.SortOrder == "OldestApplied")">@T("Plugins.Misc.AIInterview.History.Sort.OldestApplied")</option>
                <option value="HighestScore" selected="@(Model.SortOrder == "HighestScore")">@T("Plugins.Misc.AIInterview.History.Sort.HighestScore")</option>
                <option value="LowestScore" selected="@(Model.SortOrder == "LowestScore")">@T("Plugins.Misc.AIInterview.History.Sort.LowestScore")</option>
                <option value="LatestInterviewDate" selected="@(Model.SortOrder == "LatestInterviewDate")">@T("Plugins.Misc.AIInterview.History.Sort.LatestInterviewDate")</option>
            </select>
        </div>

        @if (Model.Applications.Any())
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>@T("Plugins.Misc.AIInterview.MyApplications.JobTitle")</th>
                        <th>@T("Plugins.Misc.AIInterview.MyApplications.AppliedDate")</th>
                        <th>@T("Plugins.Misc.AIInterview.MyApplications.AttemptCount")</th>
                        <th>@T("Plugins.Misc.AIInterview.MyApplications.LatestScoreDate")</th>
                        <th>@T("Plugins.Misc.AIInterview.MyApplications.Score")</th>
                        <th>@T("Plugins.Misc.AIInterview.History.Status")</th>
                        <th>@T("Plugins.Misc.AIInterview.History.Actions")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var app in Model.Applications)
                    {
                        <tr>
                            <td>@app.JobTitle</td>
                            <td>@app.CreatedOn.ToString("g")</td>
                            <td>@app.AttemptCount</td>
                            <td>@(app.LatestScoreDate.HasValue ? app.LatestScoreDate.Value.ToString("g") : "-")</td>
                            <td>@(app.InterviewScore.HasValue ? app.InterviewScore.Value.ToString("N2") : "-")</td>
                            <td>@app.Status</td>
                            <td>
                                @if (!string.IsNullOrEmpty(app.InterviewReportUrl))
                                {
                                    <a href="@app.InterviewReportUrl">@T("Plugins.Misc.AIInterview.History.ViewReport")</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>@T("Plugins.Misc.AIInterview.History.NoSessions")</p>
        }
    </div>
</div>
