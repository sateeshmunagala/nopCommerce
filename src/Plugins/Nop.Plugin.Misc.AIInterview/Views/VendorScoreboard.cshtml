@using Nop.Web.Models.Customer
@model VendorScoreboardModel
@{
    Layout = "_ColumnsTwo";
    NopHtml.AddTitleParts(T("Plugins.Misc.AIInterview.VendorScoreboard.Title").Text);
    NopHtml.AppendCssFileParts("~/Plugins/Misc.AIInterview/Content/css/aiinterview-public.css");
    NopHtml.AppendPageCssClassParts("html-account-page");
    NopHtml.AppendPageCssClassParts("html-aiinterview-view-page");
    NopHtml.AppendPageCssClassParts("html-aiinterview-vendor-scoreboard-page");
}

@section left
{
    @await Component.InvokeAsync("CustomerNavigation", new { selectedTabId = AIInterviewDefaults.VendorScoreboardNavigationTab })
}

<div class="page vendor-scoreboard-page">
    <div class="page-title">
        <h1>@T("Plugins.Misc.AIInterview.VendorScoreboard.Title")</h1>
    </div>
    <div class="page-body">
        <div class="section">
            <div class="title">
                <strong>@T("Plugins.Misc.AIInterview.VendorScoreboard.Title")</strong>
            </div>
            <div class="fieldset">
                <div class="form-fields vendor-scoreboard-summary">
                    <div class="inputs"><label>@T("Plugins.Misc.AIInterview.VendorScoreboard.TotalJobs")</label><span>@Model.TotalJobs</span></div>
                    <div class="inputs"><label>@T("Plugins.Misc.AIInterview.VendorScoreboard.TotalApplications")</label><span>@Model.TotalApplications</span></div>
                    <div class="inputs"><label>@T("Plugins.Misc.AIInterview.VendorScoreboard.CompletedInterviews")</label><span>@Model.CompletedInterviews</span></div>
                    <div class="inputs"><label>@T("Plugins.Misc.AIInterview.VendorScoreboard.Shortlisted")</label><span>@Model.ShortlistedApplications</span></div>
                    <div class="inputs"><label>@T("Plugins.Misc.AIInterview.VendorScoreboard.AverageScore")</label><span>@(Model.AverageScore?.ToString("N2") ?? "-")</span></div>
                    <div class="inputs"><label>@T("Plugins.Misc.AIInterview.VendorScoreboard.HighestScore")</label><span>@(Model.HighestScore?.ToString("N2") ?? "-")</span></div>
                </div>
            </div>
        </div>

        <div class="buttons">
            <a class="button-1" href="@Url.RouteUrl(AIInterviewDefaults.VendorJobCreationRouteName)">@T("Plugins.Misc.AIInterview.VendorScoreboard.CreateJob")</a>
            <a class="button-2" href="@Url.RouteUrl(AIInterviewDefaults.EmployerApplicationsRouteName)">@T("Plugins.Misc.AIInterview.VendorScoreboard.ViewApplications")</a>
            <a class="button-2" href="@Url.RouteUrl(AIInterviewDefaults.MockEmployerManageRouteName)">@T("Plugins.Misc.AIInterview.Employer.Invite.Title")</a>
        </div>

        <div class="section">
            <div class="title">
                <strong>@T("Plugins.Misc.AIInterview.VendorScoreboard.RecentApplications")</strong>
            </div>
            @if (Model.RecentApplications.Any())
            {
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>@T("Plugins.Misc.AIInterview.MyApplications.JobTitle")</th>
                                <th>@T("Plugins.Misc.AIInterview.History.Status")</th>
                                <th>@T("Plugins.Misc.AIInterview.MyApplications.AppliedDate")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var application in Model.RecentApplications)
                            {
                                <tr>
                                    <td>@application.JobTitle</td>
                                    <td>@T($"Plugins.Misc.AIInterview.Status.{application.RawStatus}")</td>
                                    <td>@application.CreatedOn.ToString("g")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p>@T("Plugins.Misc.AIInterview.VendorScoreboard.NoApplications")</p>
            }
        </div>
    </div>
</div>
