@using System.Collections.Generic
@using Nop.Plugin.Misc.AIInterview.Domain
@using Nop.Services.Helpers
@model VendorScoreboardModel
@inject IDateTimeHelper dateTimeHelper

@{
    async Task<string> FormatUtcDateTimeAsync(DateTime utcDateTime)
    {
        var userDateTime = await dateTimeHelper.ConvertToUserTimeAsync(utcDateTime, DateTimeKind.Utc);
        return userDateTime.ToString("g");
    }

    string FormatInterviewScore(decimal? score) => score.HasValue ? $"{Math.Round(score.Value):N0}/100" : "-";

    var introText = T("Plugins.Misc.AIInterview.VendorScoreboard.Intro").Text;
    var eyebrowText = T("Plugins.Misc.AIInterview.VendorScoreboard.Eyebrow").Text;
    var totalSubmissionsText = string.Format(T("Plugins.Misc.AIInterview.VendorScoreboard.TotalSubmissions").Text, Model.TotalApplications);
    var highestScoreText = string.Format(T("Plugins.Misc.AIInterview.VendorScoreboard.HighestRecordedScore").Text, FormatInterviewScore(Model.HighestScore));
    var shortlistedText = string.Format(T("Plugins.Misc.AIInterview.VendorScoreboard.ShortlistedDetail").Text, Model.ShortlistedApplications);
    var reviewQueueText = T("Plugins.Misc.AIInterview.Employer.Dashboard.Action.ReviewQueue").Text;
    var viewAnalysisText = T("Plugins.Misc.AIInterview.Employer.Dashboard.Action.ViewAnalysis").Text;
    var pagerModel = new MyActivityPagerModel
    {
        Page = Model.Page,
        PageSize = Model.PageSize,
        TotalCount = Model.TotalCount,
        TotalPages = Model.TotalPages,
        RouteValues = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["tab"] = AIInterviewDefaults.EmployerDashboardOverviewTabKey
        }
    };

    static string GetVerificationLabel(string rawStatus)
    {
        return JobApplicationStatuses.Normalize(rawStatus) switch
        {
            JobApplicationStatuses.Completed or JobApplicationStatuses.Reviewed or JobApplicationStatuses.Shortlisted => "Plugins.Misc.AIInterview.VendorScoreboard.Verification.Verified",
            JobApplicationStatuses.Rejected or JobApplicationStatuses.Withdrawn => "Plugins.Misc.AIInterview.VendorScoreboard.Verification.Flagged",
            _ => "Plugins.Misc.AIInterview.VendorScoreboard.Verification.Evaluating"
        };
    }

    static string GetVerificationClass(string rawStatus)
    {
        return JobApplicationStatuses.Normalize(rawStatus) switch
        {
            JobApplicationStatuses.Completed or JobApplicationStatuses.Reviewed or JobApplicationStatuses.Shortlisted => "is-verified",
            JobApplicationStatuses.Rejected or JobApplicationStatuses.Withdrawn => "is-flagged",
            _ => "is-evaluating"
        };
    }
}

