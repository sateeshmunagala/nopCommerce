<div class="section scoreboard-deck-table-section">
    <div class="title scoreboard-deck-section-head">
        <strong>@T("Plugins.Misc.AIInterview.VendorScoreboard.CandidateAssessmentMatrix")</strong>
    </div>
    @if (Model.RecentApplications.Any())
    {
        <div class="table-wrapper employer-dashboard-table-wrapper scoreboard-deck-table-wrapper">
            <table class="data-table scoreboard-deck-table">
                <thead>
                    <tr>
                        <th>@T("Plugins.Misc.AIInterview.VendorScoreboard.CandidateName")</th>
                        <th>@T("Plugins.Misc.AIInterview.VendorScoreboard.AssessmentModule")</th>
                        <th>@T("Plugins.Misc.AIInterview.VendorScoreboard.CompletionDate")</th>
                        <th>@T("Plugins.Misc.AIInterview.VendorScoreboard.CoreAiRating")</th>
                        <th>@T("Plugins.Misc.AIInterview.VendorScoreboard.VerificationStatus")</th>
                        <th>@T("Plugins.Misc.AIInterview.VendorScoreboard.Actions")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var application in Model.RecentApplications)
                    {
                        var verificationLabel = T(GetVerificationLabel(application.RawStatus)).Text;
                        var verificationClass = GetVerificationClass(application.RawStatus);
                        var statusText = string.IsNullOrWhiteSpace(application.Status) ? verificationLabel : application.Status;
                        var completionDate = application.CompletedOn ?? application.CreatedOn;
                        <tr>
                            <td>
                                <div class="scoreboard-deck-cell-primary">@(string.IsNullOrWhiteSpace(application.CandidateName) ? application.CandidateEmail : application.CandidateName)</div>
                                @if (!string.IsNullOrWhiteSpace(application.CandidateEmail))
                                {
                                    <div class="scoreboard-deck-cell-secondary">@application.CandidateEmail</div>
                                }
                            </td>
                            <td>
                                <div class="scoreboard-deck-cell-primary">@application.JobTitle</div>
                                <div class="scoreboard-deck-cell-secondary">@T("Plugins.Misc.AIInterview.VendorScoreboard.AssessmentWorkflow")</div>
                            </td>
                            <td>
                                <div class="scoreboard-deck-cell-primary">@(await FormatUtcDateTimeAsync(completionDate))</div>
                                <div class="scoreboard-deck-cell-secondary">@(application.CompletedOn.HasValue ? T("Plugins.Misc.AIInterview.VendorScoreboard.InterviewCompleted").Text : T("Plugins.Misc.AIInterview.VendorScoreboard.ApplicationReceived").Text)</div>
                            </td>
                            <td>
                                @if (application.InterviewScore.HasValue)
                                {
                                    <span class="scoreboard-deck-score">@FormatInterviewScore(application.InterviewScore)</span>
                                }
                                else
                                {
                                    <span class="scoreboard-deck-score scoreboard-deck-score-muted">@T("Plugins.Misc.AIInterview.Status.Pending")</span>
                                }
                            </td>
                            <td>
                                <span class="scoreboard-deck-status @verificationClass">@verificationLabel</span>
                                <div class="scoreboard-deck-cell-secondary">@statusText</div>
                            </td>
                            <td>
                                <div class="buttons scoreboard-deck-row-actions">
                                    @if (!string.IsNullOrWhiteSpace(application.InterviewReportUrl))
                                    {
                                        <a class="button-2 ai-icon-action employer-dashboard-action-icon"
                                           href="@application.InterviewReportUrl"
                                           title="@viewAnalysisText"
                                           aria-label="@viewAnalysisText">
                                            <i class="fa-solid fa-chart-column" aria-hidden="true"></i>
                                            <span class="sr-only">@viewAnalysisText</span>
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="button-2 ai-icon-action employer-dashboard-action-icon"
                                           href="@Url.RouteUrl(AIInterviewDefaults.EmployerDashboardRouteName, new { tab = AIInterviewDefaults.EmployerDashboardApplicationsTabKey })"
                                           title="@reviewQueueText"
                                           aria-label="@reviewQueueText">
                                            <i class="fa-solid fa-list-check" aria-hidden="true"></i>
                                            <span class="sr-only">@reviewQueueText</span>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("~/Plugins/Misc.AIInterview/Views/Shared/_MyActivityPager.cshtml", pagerModel)
    }
    else
    {
        <div class="fieldset scoreboard-deck-empty-state">
            <p>@T("Plugins.Misc.AIInterview.VendorScoreboard.NoAssessments")</p>
        </div>
    }
</div>
