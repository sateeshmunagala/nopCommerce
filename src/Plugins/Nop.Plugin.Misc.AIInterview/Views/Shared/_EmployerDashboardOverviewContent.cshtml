@using Nop.Plugin.Misc.AIInterview.Domain
@using Nop.Services.Helpers
@model VendorScoreboardModel
@inject IDateTimeHelper dateTimeHelper

@{
    async Task<string> FormatUtcDateTimeAsync(DateTime utcDateTime)
    {
        var userDateTime = await dateTimeHelper.ConvertToUserTimeAsync(utcDateTime, DateTimeKind.Utc);
        return userDateTime.ToString("g");
    }

    var introText = T("Plugins.Misc.AIInterview.VendorScoreboard.Intro").Text;
    var eyebrowText = T("Plugins.Misc.AIInterview.VendorScoreboard.Eyebrow").Text;
    var totalSubmissionsText = string.Format(T("Plugins.Misc.AIInterview.VendorScoreboard.TotalSubmissions").Text, Model.TotalApplications);
    var highestScoreText = string.Format(T("Plugins.Misc.AIInterview.VendorScoreboard.HighestRecordedScore").Text, Model.HighestScore?.ToString("N2") ?? "-");
    var shortlistedText = string.Format(T("Plugins.Misc.AIInterview.VendorScoreboard.ShortlistedDetail").Text, Model.ShortlistedApplications);

    static string GetVerificationLabel(string rawStatus)
    {
        return JobApplicationStatuses.Normalize(rawStatus) switch
        {
            JobApplicationStatuses.Completed or JobApplicationStatuses.Reviewed or JobApplicationStatuses.Shortlisted => "Plugins.Misc.AIInterview.VendorScoreboard.Verification.Verified",
            JobApplicationStatuses.Rejected or JobApplicationStatuses.Withdrawn => "Plugins.Misc.AIInterview.VendorScoreboard.Verification.Flagged",
            _ => "Plugins.Misc.AIInterview.VendorScoreboard.Verification.Evaluating"
        };
    }

    static string GetVerificationClass(string rawStatus)
    {
        return JobApplicationStatuses.Normalize(rawStatus) switch
        {
            JobApplicationStatuses.Completed or JobApplicationStatuses.Reviewed or JobApplicationStatuses.Shortlisted => "is-verified",
            JobApplicationStatuses.Rejected or JobApplicationStatuses.Withdrawn => "is-flagged",
            _ => "is-evaluating"
        };
    }
}

<div class="section scoreboard-deck-shell">
    <div class="scoreboard-deck-header">
        <div>
            <strong class="scoreboard-deck-eyebrow">@eyebrowText</strong>
            <p class="scoreboard-deck-title">@T("Plugins.Misc.AIInterview.VendorScoreboard.AssessmentWorkflow")</p>
            <p class="scoreboard-deck-copy">@introText</p>
        </div>
        <div class="buttons scoreboard-deck-actions">
            <a class="button-1 scoreboard-deck-action-primary" href="@Url.RouteUrl(AIInterviewDefaults.VendorJobCreationRouteName)" title="@T("Plugins.Misc.AIInterview.VendorScoreboard.CreateJobAction")">@T("Plugins.Misc.AIInterview.VendorScoreboard.CreateJobAction")</a>
            <a class="button-2 scoreboard-deck-action-secondary" href="@Url.RouteUrl(AIInterviewDefaults.EmployerDashboardRouteName, new { tab = AIInterviewDefaults.EmployerDashboardApplicationsTabKey })" title="@T("Plugins.Misc.AIInterview.VendorScoreboard.ReviewApplicationsAction")">@T("Plugins.Misc.AIInterview.VendorScoreboard.ReviewApplicationsAction")</a>
            <a class="button-2 scoreboard-deck-action-secondary" href="@Url.RouteUrl(AIInterviewDefaults.EmployerDashboardRouteName, new { tab = AIInterviewDefaults.EmployerDashboardInvitesTabKey })" title="@T("Plugins.Misc.AIInterview.VendorScoreboard.ManageInvitesAction")">@T("Plugins.Misc.AIInterview.VendorScoreboard.ManageInvitesAction")</a>
        </div>
    </div>

    <div class="fieldset scoreboard-deck-summary">
        <div class="scoreboard-deck-metrics">
            <div class="scoreboard-deck-metric">
                <span class="scoreboard-deck-metric-label">@T("Plugins.Misc.AIInterview.VendorScoreboard.TotalCompletedAssessments")</span>
                <strong class="scoreboard-deck-metric-value">@Model.CompletedInterviews</strong>
                <span class="scoreboard-deck-metric-detail">@totalSubmissionsText</span>
            </div>
            <div class="scoreboard-deck-metric">
                <span class="scoreboard-deck-metric-label">@T("Plugins.Misc.AIInterview.VendorScoreboard.AverageAnalyticalScore")</span>
                <strong class="scoreboard-deck-metric-value">@(Model.AverageScore?.ToString("N2") ?? "-")</strong>
                <span class="scoreboard-deck-metric-detail">@highestScoreText</span>
            </div>
            <div class="scoreboard-deck-metric">
                <span class="scoreboard-deck-metric-label">@T("Plugins.Misc.AIInterview.VendorScoreboard.ActiveFlaggedViolations")</span>
                <strong class="scoreboard-deck-metric-value">@Model.ActiveFlaggedViolations</strong>
                <span class="scoreboard-deck-metric-detail">@shortlistedText</span>
            </div>
        </div>
    </div>

    <div class="fieldset scoreboard-deck-overview">
        <div class="scoreboard-deck-overview-card">
            <span class="scoreboard-deck-overview-label">@T("Plugins.Misc.AIInterview.VendorScoreboard.OpenJobModules")</span>
            <strong class="scoreboard-deck-overview-value">@Model.TotalJobs</strong>
        </div>
        <div class="scoreboard-deck-overview-card">
            <span class="scoreboard-deck-overview-label">@T("Plugins.Misc.AIInterview.VendorScoreboard.CandidateVolume")</span>
            <strong class="scoreboard-deck-overview-value">@Model.TotalApplications</strong>
        </div>
        <div class="scoreboard-deck-overview-card">
            <span class="scoreboard-deck-overview-label">@T("Plugins.Misc.AIInterview.VendorScoreboard.ShortlistQueue")</span>
            <strong class="scoreboard-deck-overview-value">@Model.ShortlistedApplications</strong>
        </div>
    </div>
</div>

<div class="section scoreboard-deck-table-section">
    <div class="title scoreboard-deck-section-head">
        <strong>@T("Plugins.Misc.AIInterview.VendorScoreboard.CandidateAssessmentMatrix")</strong>
    </div>
    @if (Model.RecentApplications.Any())
    {
        <div class="table-wrapper scoreboard-deck-table-wrapper">
            <table class="data-table scoreboard-deck-table">
                <thead>
                    <tr>
                        <th>@T("Plugins.Misc.AIInterview.VendorScoreboard.CandidateName")</th>
                        <th>@T("Plugins.Misc.AIInterview.VendorScoreboard.AssessmentModule")</th>
                        <th>@T("Plugins.Misc.AIInterview.VendorScoreboard.CompletionDate")</th>
                        <th>@T("Plugins.Misc.AIInterview.VendorScoreboard.CoreAiRating")</th>
                        <th>@T("Plugins.Misc.AIInterview.VendorScoreboard.VerificationStatus")</th>
                        <th>@T("Plugins.Misc.AIInterview.VendorScoreboard.Actions")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var application in Model.RecentApplications)
                    {
                        var verificationLabel = T(GetVerificationLabel(application.RawStatus)).Text;
                        var verificationClass = GetVerificationClass(application.RawStatus);
                        var statusText = string.IsNullOrWhiteSpace(application.Status) ? verificationLabel : application.Status;
                        var completionDate = application.CompletedOn ?? application.CreatedOn;
                        <tr>
                            <td>
                                <div class="scoreboard-deck-cell-primary">@(string.IsNullOrWhiteSpace(application.CandidateName) ? application.CandidateEmail : application.CandidateName)</div>
                                @if (!string.IsNullOrWhiteSpace(application.CandidateEmail))
                                {
                                    <div class="scoreboard-deck-cell-secondary">@application.CandidateEmail</div>
                                }
                            </td>
                            <td>
                                <div class="scoreboard-deck-cell-primary">@application.JobTitle</div>
                                <div class="scoreboard-deck-cell-secondary">@T("Plugins.Misc.AIInterview.VendorScoreboard.AssessmentWorkflow")</div>
                            </td>
                            <td>
                                <div class="scoreboard-deck-cell-primary">@(await FormatUtcDateTimeAsync(completionDate))</div>
                                <div class="scoreboard-deck-cell-secondary">@(application.CompletedOn.HasValue ? T("Plugins.Misc.AIInterview.VendorScoreboard.InterviewCompleted").Text : T("Plugins.Misc.AIInterview.VendorScoreboard.ApplicationReceived").Text)</div>
                            </td>
                            <td>
                                @if (application.InterviewScore.HasValue)
                                {
                                    <span class="scoreboard-deck-score">@application.InterviewScore.Value.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="scoreboard-deck-score scoreboard-deck-score-muted">@T("Plugins.Misc.AIInterview.Status.Pending")</span>
                                }
                            </td>
                            <td>
                                <span class="scoreboard-deck-status @verificationClass">@verificationLabel</span>
                                <div class="scoreboard-deck-cell-secondary">@statusText</div>
                            </td>
                            <td>
                                <div class="buttons scoreboard-deck-row-actions">
                                    @if (!string.IsNullOrWhiteSpace(application.InterviewReportUrl))
                                    {
                                        <a class="button-2 scoreboard-deck-row-link" href="@application.InterviewReportUrl" title="@T("Plugins.Misc.AIInterview.VendorScoreboard.ViewAnalysis")">@T("Plugins.Misc.AIInterview.VendorScoreboard.ViewAnalysis")</a>
                                    }
                                    else
                                    {
                                        <a class="button-2 scoreboard-deck-row-link" href="@Url.RouteUrl(AIInterviewDefaults.EmployerDashboardRouteName, new { tab = AIInterviewDefaults.EmployerDashboardApplicationsTabKey })" title="@T("Plugins.Misc.AIInterview.VendorScoreboard.ReviewQueue")">@T("Plugins.Misc.AIInterview.VendorScoreboard.ReviewQueue")</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="fieldset scoreboard-deck-empty-state">
            <p>@T("Plugins.Misc.AIInterview.VendorScoreboard.NoAssessments")</p>
        </div>
    }
</div>
