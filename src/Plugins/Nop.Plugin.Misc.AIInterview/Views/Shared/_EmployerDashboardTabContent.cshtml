@model EmployerDashboardPageModel

<div class="my-activity-panel" data-employer-dashboard-tab-panel="true" data-active-tab="@Model.ActiveTab">
    @switch (Model.ActiveTab)
    {
        case var value when string.Equals(value, AIInterviewDefaults.EmployerDashboardJobsTabKey, StringComparison.Ordinal):
            @await Html.PartialAsync("~/Plugins/Misc.AIInterview/Views/Shared/_EmployerDashboardJobsContent.cshtml", Model.Jobs)
            break;
        case var value when string.Equals(value, AIInterviewDefaults.EmployerDashboardApplicationsTabKey, StringComparison.Ordinal):
            @await Html.PartialAsync("~/Plugins/Misc.AIInterview/Views/Shared/_EmployerDashboardApplicationsContent.cshtml", Model.Applications)
            @await Html.PartialAsync("~/Plugins/Misc.AIInterview/Views/Shared/_CandidateReportDrawer.cshtml")
            break;
        case var value when string.Equals(value, AIInterviewDefaults.EmployerDashboardInvitesTabKey, StringComparison.Ordinal):
            @await Html.PartialAsync("~/Plugins/Misc.AIInterview/Views/Shared/_EmployerDashboardInvitesContent.cshtml", Model.Invites)
            break;
        default:
            @await Html.PartialAsync("~/Plugins/Misc.AIInterview/Views/Shared/_EmployerDashboardOverviewContent.cshtml", Model.Overview)
            break;
    }
</div>
