@model ApplicationListModel
@using System.Globalization
@using Microsoft.AspNetCore.WebUtilities
@using Nop.Services.Helpers
@inject IDateTimeHelper dateTimeHelper

@{
    async Task<string> FormatUtcDateTimeAsync(DateTime? utcDateTime)
    {
        if (!utcDateTime.HasValue)
            return "-";

        var userDateTime = await dateTimeHelper.ConvertToUserTimeAsync(utcDateTime.Value, DateTimeKind.Utc);
        return userDateTime.ToString("g");
    }

    string FormatInterviewScore(decimal? score) => score.HasValue ? $"{Math.Round(score.Value):N0}/100" : "-";

    var isMyActivity = ViewData["IsMyActivity"] is bool isMyActivityValue && isMyActivityValue;
    var copyShareLinkText = T("Plugins.Misc.AIInterview.Report.CopyShareLink").Text;
    var shareText = T("Plugins.Misc.AIInterview.Report.Share").Text;
    var openSharePageText = T("Plugins.Misc.AIInterview.Report.OpenSharePage").Text;
    var jobReportTitleFormat = T("Plugins.Misc.AIInterview.Report.JobReportTitle").Text;
    var jobRecordingTitleFormat = T("Plugins.Misc.AIInterview.Report.JobRecordingTitle").Text;
    var viewReportText = T("Plugins.Misc.AIInterview.Report.ViewReport").Text;
    var completedLabelText = T("Plugins.Misc.AIInterview.Common.CompletedUtc").Text.Replace(" (UTC)", string.Empty);
    var mockHistoryUrl = isMyActivity
        ? Url.RouteUrl(AIInterviewDefaults.MyActivityRouteName, new { tab = AIInterviewDefaults.MyActivityMockInterviewsTabKey })
        : Url.RouteUrl(AIInterviewDefaults.MockHistoryRouteName);
    var sortBaseUrl = isMyActivity
        ? Url.RouteUrl(AIInterviewDefaults.MyActivityRouteName, new { tab = AIInterviewDefaults.MyActivityAppliedJobsTabKey })
        : Url.RouteUrl(AIInterviewDefaults.MyApplicationsRouteName);
    var sortQuery = new Dictionary<string, string>();
    if (!string.IsNullOrWhiteSpace(Model.Status))
        sortQuery["status"] = Model.Status;
    if (Model.MinScore.HasValue)
        sortQuery["minScore"] = Model.MinScore.Value.ToString(CultureInfo.InvariantCulture);
    if (Model.MaxScore.HasValue)
        sortQuery["maxScore"] = Model.MaxScore.Value.ToString(CultureInfo.InvariantCulture);
    if (Model.PageSize > 0)
        sortQuery["pageSize"] = Model.PageSize.ToString(CultureInfo.InvariantCulture);

    string BuildSortUrl(string value)
    {
        var values = new Dictionary<string, string>(sortQuery)
        {
            ["sortOrder"] = value
        };

        return QueryHelpers.AddQueryString(sortBaseUrl ?? string.Empty, values);
    }
}

<div class="applications-card">
    <div class="applications-toolbar">
        <div>
            <strong>@Model.TotalCount</strong> @T("Plugins.Misc.AIInterview.MyApplications.ApplicationsCountLabel")
        </div>
        @if (!isMyActivity)
        {
            <div class="applications-toolbar-links">
                <a class="button-2" href="@mockHistoryUrl">@T("Plugins.Misc.AIInterview.History.MockTitle")</a>
            </div>
        }
        <div class="applications-sort">
            <label for="sortOrder">@T("Plugins.Misc.AIInterview.MyApplications.SortBy")</label>
            @if (isMyActivity)
            {
                <div class="aiinterview-hidden" data-my-activity-sort-context="true">
                    <input type="hidden" name="page" value="1" />
                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                    @if (!string.IsNullOrWhiteSpace(Model.Status))
                    {
                        <input type="hidden" name="status" value="@Model.Status" />
                    }
                    @if (Model.MinScore.HasValue)
                    {
                        <input type="hidden" name="minScore" value="@Model.MinScore.Value.ToString(CultureInfo.InvariantCulture)" />
                    }
                    @if (Model.MaxScore.HasValue)
                    {
                        <input type="hidden" name="maxScore" value="@Model.MaxScore.Value.ToString(CultureInfo.InvariantCulture)" />
                    }
                </div>
                <select id="sortOrder"
                        name="sortOrder"
                        hx-get="@sortBaseUrl"
                        hx-target="#my-activity-content"
                        hx-swap="innerHTML"
                        hx-push-url="true"
                        hx-indicator="#my-activity-loading"
                        hx-include="[data-my-activity-sort-context='true']"
                        onchange="if (!window.htmx) { location.href = this.options[this.selectedIndex].getAttribute('data-navigate-url'); }">
                    <option value="LatestApplied" data-navigate-url="@BuildSortUrl("LatestApplied")" selected="@(Model.SortOrder == "LatestApplied")">@T("Plugins.Misc.AIInterview.History.Sort.LatestApplied")</option>
                    <option value="OldestApplied" data-navigate-url="@BuildSortUrl("OldestApplied")" selected="@(Model.SortOrder == "OldestApplied")">@T("Plugins.Misc.AIInterview.History.Sort.OldestApplied")</option>
                    <option value="HighestScore" data-navigate-url="@BuildSortUrl("HighestScore")" selected="@(Model.SortOrder == "HighestScore")">@T("Plugins.Misc.AIInterview.History.Sort.HighestScore")</option>
                    <option value="LowestScore" data-navigate-url="@BuildSortUrl("LowestScore")" selected="@(Model.SortOrder == "LowestScore")">@T("Plugins.Misc.AIInterview.History.Sort.LowestScore")</option>
                    <option value="LatestInterviewDate" data-navigate-url="@BuildSortUrl("LatestInterviewDate")" selected="@(Model.SortOrder == "LatestInterviewDate")">@T("Plugins.Misc.AIInterview.History.Sort.LatestInterviewDate")</option>
                </select>
            }
            else
            {
                <select id="sortOrder" onchange="location.href=this.value;">
                    <option value="@BuildSortUrl("LatestApplied")" selected="@(Model.SortOrder == "LatestApplied")">@T("Plugins.Misc.AIInterview.History.Sort.LatestApplied")</option>
                    <option value="@BuildSortUrl("OldestApplied")" selected="@(Model.SortOrder == "OldestApplied")">@T("Plugins.Misc.AIInterview.History.Sort.OldestApplied")</option>
                    <option value="@BuildSortUrl("HighestScore")" selected="@(Model.SortOrder == "HighestScore")">@T("Plugins.Misc.AIInterview.History.Sort.HighestScore")</option>
                    <option value="@BuildSortUrl("LowestScore")" selected="@(Model.SortOrder == "LowestScore")">@T("Plugins.Misc.AIInterview.History.Sort.LowestScore")</option>
                    <option value="@BuildSortUrl("LatestInterviewDate")" selected="@(Model.SortOrder == "LatestInterviewDate")">@T("Plugins.Misc.AIInterview.History.Sort.LatestInterviewDate")</option>
                </select>
            }
        </div>
    </div>

    @if (Model.Applications.Any())
    {
        <div class="applications-table-wrap applications-table-scroller">
            <table class="applications-table">
                <thead>
                    <tr>
                        <th class="col-job">@T("Plugins.Misc.AIInterview.MyApplications.JobTitle")</th>
                        <th class="col-score">@T("Plugins.Misc.AIInterview.MyApplications.Score")</th>
                        <th class="col-status">@T("Plugins.Misc.AIInterview.History.Status")</th>
                        <th class="col-completed">@completedLabelText</th>
                        <th class="col-report">@T("Plugins.Misc.AIInterview.Report.Title")</th>
                        <th class="col-recording">@T("Plugins.Misc.AIInterview.Report.Recording")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var app in Model.Applications)
                    {
                        var reportTitle = string.Format(jobReportTitleFormat, app.JobTitle);
                        var recordingTitle = string.Format(jobRecordingTitleFormat, app.JobTitle);
                        var reportActionLabel = $"{viewReportText} - {app.JobTitle}";
                        var openRecordingLabel = $"{T("Plugins.Misc.AIInterview.Report.OpenRecording").Text} - {app.JobTitle}";
                        var copyShareLabel = $"{copyShareLinkText} - {app.JobTitle}";
                        var shareActionLabel = $"{shareText} - {app.JobTitle}";
                        <tr>
                            <td class="col-job">
                                <div><strong>@app.JobTitle</strong></div>
                                <div class="applications-footnote">@T("Plugins.Misc.AIInterview.MyApplications.Applied") @(await FormatUtcDateTimeAsync(app.CreatedOn))</div>
                            </td>
                            <td class="col-score">
                                @if (app.InterviewScore.HasValue)
                                {
                                    <span class="score-chip">@FormatInterviewScore(app.InterviewScore)</span>
                                }
                                else
                                {
                                    <span>--</span>
                                }
                            </td>
                            <td class="col-status"><span class="status-pill">@app.Status</span></td>
                            <td class="col-completed">@(await FormatUtcDateTimeAsync(app.CompletedOn))</td>
                            <td class="col-report">
                                @if (!string.IsNullOrEmpty(app.InterviewReportUrl))
                                {
                                    <a href="@app.InterviewReportUrl"
                                       class="ai-view-report-link ai-icon-action"
                                       aria-label="@reportActionLabel"
                                       title="@reportActionLabel"><i class="fa-solid fa-eye" aria-hidden="true"></i><span class="sr-only">@viewReportText</span></a>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td class="col-recording">
                                @if (!string.IsNullOrEmpty(app.RecordingUrl))
                                {
                                    <div class="candidate-recording-actions">
                                        <a href="@(!string.IsNullOrWhiteSpace(app.InterviewReportUrl) ? app.InterviewReportUrl : app.RecordingUrl)"
                                           class="button-1 ai-report-action ai-report-action-primary ai-icon-action"
                                           aria-label="@openRecordingLabel"
                                           title="@openRecordingLabel"><i class="fa-solid fa-circle-play" aria-hidden="true"></i><span class="sr-only">@T("Plugins.Misc.AIInterview.Report.OpenRecording")</span></a>
                                        @if (!string.IsNullOrEmpty(app.RecordingShareUrl))
                                        {
                                            <button type="button"
                                                    class="button-2 ai-copy-share-link ai-icon-action"
                                                    data-share-url="@app.RecordingShareUrl"
                                                    aria-label="@copyShareLabel"
                                                    title="@copyShareLabel"><i class="fa-solid fa-copy ai-copy-default-icon" aria-hidden="true"></i><i class="fa-solid fa-check ai-copy-success-icon" aria-hidden="true"></i><i class="fa-solid fa-xmark ai-copy-error-icon" aria-hidden="true"></i><span class="sr-only">@copyShareLinkText</span></button>
                                            <button type="button"
                                                    class="button-2 ai-native-share-link aiinterview-hidden ai-icon-action"
                                                    data-share-url="@app.RecordingShareUrl"
                                                    data-share-title="@recordingTitle"
                                                    aria-label="@shareActionLabel"
                                                    title="@shareActionLabel"><i class="fa-solid fa-share-nodes" aria-hidden="true"></i><span class="sr-only">@shareText</span></button>
                                            <noscript>
                                                <a href="@app.RecordingShareUrl" target="_blank" rel="noopener">@openSharePageText</a>
                                            </noscript>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="responsive-data-list applications-mobile-list" aria-label="@T("Plugins.Misc.AIInterview.MyApplications.Title")">
            @foreach (var app in Model.Applications)
            {
                var reportTitle = string.Format(jobReportTitleFormat, app.JobTitle);
                var recordingTitle = string.Format(jobRecordingTitleFormat, app.JobTitle);
                var reportActionLabel = $"{viewReportText} - {app.JobTitle}";
                var openRecordingLabel = $"{T("Plugins.Misc.AIInterview.Report.OpenRecording").Text} - {app.JobTitle}";
                var copyShareLabel = $"{copyShareLinkText} - {app.JobTitle}";
                var shareActionLabel = $"{shareText} - {app.JobTitle}";
                <article class="responsive-data-card">
                    <div class="responsive-data-card-head">
                        <div class="responsive-data-card-head-copy">
                            <strong class="responsive-data-card-title">@app.JobTitle</strong>
                            <div class="applications-footnote">@T("Plugins.Misc.AIInterview.MyApplications.Applied") @(await FormatUtcDateTimeAsync(app.CreatedOn))</div>
                        </div>
                        <div class="responsive-data-card-chip-group">
                            @if (app.InterviewScore.HasValue)
                            {
                                <span class="score-chip">@FormatInterviewScore(app.InterviewScore)</span>
                            }
                            else
                            {
                                <span class="score-chip score-chip-muted">-</span>
                            }
                            <span class="status-pill">@app.Status</span>
                        </div>
                    </div>
                    <div class="responsive-data-card-grid">
                        <div class="responsive-data-card-item">
                            <span class="responsive-data-card-label">@T("Plugins.Misc.AIInterview.MyApplications.Score")</span>
                            <span class="responsive-data-card-value">@FormatInterviewScore(app.InterviewScore)</span>
                        </div>
                        <div class="responsive-data-card-item">
                            <span class="responsive-data-card-label">@completedLabelText</span>
                            <span class="responsive-data-card-value">@(await FormatUtcDateTimeAsync(app.CompletedOn))</span>
                        </div>
                    </div>
                    <div class="responsive-data-card-actions">
                        @if (!string.IsNullOrEmpty(app.InterviewReportUrl))
                        {
                            <a href="@app.InterviewReportUrl"
                               class="ai-view-report-link ai-icon-action"
                               aria-label="@reportActionLabel"
                               title="@reportActionLabel">
                                <i class="fa-solid fa-eye" aria-hidden="true"></i>
                                <span>@viewReportText</span>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(app.RecordingUrl))
                        {
                            <div class="candidate-recording-actions">
                                <a href="@(!string.IsNullOrWhiteSpace(app.InterviewReportUrl) ? app.InterviewReportUrl : app.RecordingUrl)"
                                   class="button-1 ai-report-action ai-report-action-primary ai-icon-action"
                                   aria-label="@openRecordingLabel"
                                   title="@openRecordingLabel"><i class="fa-solid fa-circle-play" aria-hidden="true"></i><span class="sr-only">@T("Plugins.Misc.AIInterview.Report.OpenRecording")</span></a>
                                @if (!string.IsNullOrEmpty(app.RecordingShareUrl))
                                {
                                    <button type="button"
                                            class="button-2 ai-copy-share-link ai-icon-action"
                                            data-share-url="@app.RecordingShareUrl"
                                            aria-label="@copyShareLabel"
                                            title="@copyShareLabel"><i class="fa-solid fa-copy ai-copy-default-icon" aria-hidden="true"></i><i class="fa-solid fa-check ai-copy-success-icon" aria-hidden="true"></i><i class="fa-solid fa-xmark ai-copy-error-icon" aria-hidden="true"></i><span class="sr-only">@copyShareLinkText</span></button>
                                    <button type="button"
                                            class="button-2 ai-native-share-link aiinterview-hidden ai-icon-action"
                                            data-share-url="@app.RecordingShareUrl"
                                            data-share-title="@recordingTitle"
                                            aria-label="@shareActionLabel"
                                            title="@shareActionLabel"><i class="fa-solid fa-share-nodes" aria-hidden="true"></i><span class="sr-only">@shareText</span></button>
                                    <noscript>
                                        <a href="@app.RecordingShareUrl" target="_blank" rel="noopener">@openSharePageText</a>
                                    </noscript>
                                }
                            </div>
                        }
                    </div>
                </article>
            }
        </div>

        @if (isMyActivity && Model.TotalPages > 1)
        {
            @await Html.PartialAsync("~/Plugins/Misc.AIInterview/Views/Shared/_MyActivityPager.cshtml", new MyActivityPagerModel
            {
                Page = Model.Page,
                PageSize = Model.PageSize,
                TotalCount = Model.TotalCount,
                TotalPages = Model.TotalPages
            })
        }
    }
    else
    {
        <p>@T("Plugins.Misc.AIInterview.History.NoSessions")</p>
    }
</div>

@await Html.PartialAsync("~/Plugins/Misc.AIInterview/Views/Shared/_CandidateReportDrawer.cshtml")
