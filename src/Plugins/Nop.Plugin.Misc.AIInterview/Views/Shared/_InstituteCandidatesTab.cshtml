@model InstituteDashboardPageModel

<div class="institute-dashboard-tab-panel ai-institute-candidates-page">
    @if (!string.IsNullOrWhiteSpace(Model.TransferMessage))
    {
        <div class="institute-transfer-alert @(Model.TransferSucceeded ? "is-success" : "is-error")"
             role="@(Model.TransferSucceeded ? "status" : "alert")"
             aria-live="@(Model.TransferSucceeded ? "polite" : "assertive")"
             aria-atomic="true">
            @Model.TransferMessage
        </div>
    }

    @if (!Model.Candidates.Any())
    {
        <p class="institute-candidates-empty">
            No applicants yet. Share your registration link from Dashboard to onboard applicants.
        </p>
    }
    else
    {
        <div class="institute-candidates-table-wrapper">
            <table class="institute-candidates-table">
                <thead>
                    <tr>
                        <th>Email / Name</th>
                        <th>Status</th>
                        <th>Credits</th>
                        <th>Joined On</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Candidates)
                    {
                        <tr class="institute-candidate-row">
                            <td data-label="Email / Name">
                                <span class="candidate-email">@c.Email</span>
                                @if (!string.IsNullOrWhiteSpace(c.CustomerName))
                                {
                                    <span class="candidate-name">@c.CustomerName</span>
                                }
                            </td>
                            <td data-label="Status">
                                <span class="candidate-status-badge badge-accepted">Active</span>
                            </td>
                            <td data-label="Credits">@c.CreditBalance.ToString("0.##")</td>
                            <td data-label="Joined On">@c.CreatedOnUtc.ToString("dd MMM yyyy")</td>
                            <td data-label="Actions">
                                <div class="institute-candidate-actions">
                                    <button type="button"
                                            class="button-2 institute-candidate-edit"
                                            aria-label="Edit credits for @c.CustomerName"
                                            data-applicant-customer-id="@c.CustomerId"
                                            onclick="document.getElementById('selectedCandidateCustomerId').value='@c.CustomerId';document.getElementById('institute-credit-modal-student').value='@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(c.CustomerName ?? string.Empty)';document.getElementById('institute-credit-modal-balance').value='@c.CreditBalance.ToString("0.##")';window.openInstituteCreditModal && window.openInstituteCreditModal(this);">
                                        Edit
                                    </button>
                                    <button type="button"
                                            class="button-2 institute-applicant-history"
                                            aria-label="View credit history for @c.CustomerName"
                                            data-applicant-customer-id="@c.CustomerId"
                                            hx-get="@Url.RouteUrl(AIInterviewDefaults.InstituteApplicantLedgerRouteName, new { applicantCustomerId = c.CustomerId })"
                                            hx-target="#institute-ledger-modal-host"
                                            hx-swap="innerHTML">
                                        History
                                    </button>
                                    <a class="button-2"
                                       href="@Url.RouteUrl(AIInterviewDefaults.InstituteApplicantInterviewsRouteName, new { applicantCustomerId = c.CustomerId })"
                                       aria-label="View AI interviews for @(c.CustomerName ?? c.Email)">
                                        Interviews
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("~/Plugins/Misc.AIInterview/Views/Shared/_InstituteCandidateCreditModal.cshtml", Model)
    }

    <div id="institute-ledger-modal-host" class="institute-ledger-modal-host" aria-live="polite"></div>
</div>
