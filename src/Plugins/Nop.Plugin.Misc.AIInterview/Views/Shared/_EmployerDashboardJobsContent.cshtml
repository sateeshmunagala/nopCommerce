@using System.Collections.Generic
@using Nop.Services.Helpers
@model EmployerDashboardJobsTabModel
@inject IDateTimeHelper dateTimeHelper

@{
    async Task<string> FormatUtcDateAsync(DateTime utcDateTime)
    {
        var userDateTime = await dateTimeHelper.ConvertToUserTimeAsync(utcDateTime, DateTimeKind.Utc);
        return userDateTime.ToString("d");
    }

    var pagerModel = new MyActivityPagerModel
    {
        Page = Model.Page,
        PageSize = Model.PageSize,
        TotalCount = Model.TotalCount,
        TotalPages = Model.TotalPages,
        RouteValues = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["tab"] = AIInterviewDefaults.EmployerDashboardJobsTabKey
        }
    };
}

<div class="section">
    <div class="scoreboard-deck-header">
        <div>
            <strong class="scoreboard-deck-eyebrow">@T("Plugins.Misc.AIInterview.Employer.Dashboard.Tab.Jobs")</strong>
            @* <p class="scoreboard-deck-title">@T("Plugins.Misc.AIInterview.Employer.Jobs.Title")</p> *@
        </div>
        <div class="buttons scoreboard-deck-actions">
            <a class="button-1 scoreboard-deck-action-primary" href="@Url.RouteUrl(AIInterviewDefaults.VendorJobCreationRouteName)" title="@T("Plugins.Misc.AIInterview.Employer.Jobs.Create")">@T("Plugins.Misc.AIInterview.Employer.Jobs.Create")</a>
        </div>
    </div>

    @if (Model.Jobs.Any())
    {
        <div class="table-wrapper employer-dashboard-table-wrapper">
            <table class="data-table employer-table employer-dashboard-jobs-table"
                   style="min-width:1080px;table-layout:fixed;">
                <thead>
                    <tr>
                        <th class="col-job-title" style="width:36%;padding:7px 12px;line-height:1.1;vertical-align:middle;">@T("Plugins.Misc.AIInterview.Employer.Jobs.JobTitle")</th>
                        <th class="col-job-status" style="width:15%;padding:7px 12px;line-height:1.1;vertical-align:middle;">@T("Plugins.Misc.AIInterview.Employer.Jobs.Status")</th>
                        <th class="col-job-salary" style="width:21%;padding:7px 12px;line-height:1.1;vertical-align:middle;">@T("Plugins.Misc.AIInterview.Employer.Jobs.Salary")</th>
                        <th class="col-job-posted" style="width:11%;padding:7px 12px;line-height:1.1;vertical-align:middle;white-space:nowrap;">@T("Plugins.Misc.AIInterview.Employer.Jobs.CreatedOn")</th>
                        <th class="col-job-count" style="width:8%;padding:7px 12px;line-height:1.1;vertical-align:middle;white-space:nowrap;">@T("Plugins.Misc.AIInterview.Employer.Jobs.ApplicationCount")</th>
                        <th class="col-job-actions" style="width:10%;padding:7px 12px;line-height:1.1;vertical-align:middle;white-space:nowrap;">@T("Plugins.Misc.AIInterview.Employer.Jobs.Actions")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in Model.Jobs)
                    {
                        <tr>
                            <td class="col-job-title" title="@job.JobTitle" style="padding:7px 12px;line-height:1.1;vertical-align:middle;">
                                <span class="job-table-text-truncate" style="display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;line-height:1.1;">@job.JobTitle</span>
                            </td>
                            <td class="col-job-status" style="padding:7px 12px;line-height:1.1;vertical-align:middle;">@(job.Published ? T("Plugins.Misc.AIInterview.Employer.Jobs.Published") : T("Plugins.Misc.AIInterview.Employer.Jobs.Unpublished"))</td>
                            <td class="col-job-salary" title="@(string.IsNullOrWhiteSpace(job.SalaryRange) ? "-" : job.SalaryRange)" style="padding:7px 12px;line-height:1.1;vertical-align:middle;">
                                <span class="job-table-text-truncate" style="display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;line-height:1.1;">@(string.IsNullOrWhiteSpace(job.SalaryRange) ? "-" : job.SalaryRange)</span>
                            </td>
                            <td class="col-job-posted" style="padding:7px 12px;line-height:1.1;vertical-align:middle;white-space:nowrap;">@(await FormatUtcDateAsync(job.CreatedOnUtc))</td>
                            <td class="col-job-count" style="padding:7px 12px;line-height:1.1;vertical-align:middle;white-space:nowrap;">@job.ApplicationCount</td>
                            <td class="col-job-actions" style="padding:7px 12px;line-height:1.1;vertical-align:middle;white-space:nowrap;text-align:center;">
                                @{
                                    var editText = T("Plugins.Misc.AIInterview.Employer.Jobs.Edit").Text;
                                    var publishText = job.Published
                                        ? T("Plugins.Misc.AIInterview.Employer.Jobs.Unpublish").Text
                                        : T("Plugins.Misc.AIInterview.Employer.Jobs.Publish").Text;
                                }
                                <div class="buttons scoreboard-deck-row-actions" style="display:inline-flex;align-items:center;gap:6px;margin:0;">
                                    <a class="button-2 ai-icon-action employer-dashboard-action-icon"
                                       href="@Url.RouteUrl(AIInterviewDefaults.VendorJobEditRouteName, new { productId = job.ProductId })"
                                       title="@editText"
                                       aria-label="@editText"
                                       style="width:32px;min-width:32px;max-width:32px;height:32px;min-height:32px;max-height:32px;padding:0;">
                                        <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                                        <span class="sr-only">@editText</span>
                                    </a>
                                    <form asp-route="@AIInterviewDefaults.VendorJobPublishToggleRouteName" asp-route-productId="@job.ProductId" method="post" class="inline">
                                        <button type="submit"
                                                class="button-2 ai-icon-action employer-dashboard-action-icon"
                                                title="@publishText"
                                                aria-label="@publishText"
                                                style="width:32px;min-width:32px;max-width:32px;height:32px;min-height:32px;max-height:32px;padding:0;">
                                            <i class="fa-solid @(job.Published ? "fa-eye-slash" : "fa-eye")" aria-hidden="true"></i>
                                            <span class="sr-only">@publishText</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("~/Plugins/Misc.AIInterview/Views/Shared/_MyActivityPager.cshtml", pagerModel)
    }
    else
    {
        <div class="fieldset scoreboard-deck-empty-state">
            <p>@T("Plugins.Misc.AIInterview.Employer.Jobs.Empty")</p>
        </div>
    }
</div>
