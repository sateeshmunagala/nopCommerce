@using System.Collections.Generic
@using Nop.Services.Helpers
@model EmployerDashboardJobsTabModel
@inject IDateTimeHelper dateTimeHelper

@{
    async Task<string> FormatUtcDateAsync(DateTime utcDateTime)
    {
        var userDateTime = await dateTimeHelper.ConvertToUserTimeAsync(utcDateTime, DateTimeKind.Utc);
        return userDateTime.ToString("d");
    }

    var pagerModel = new MyActivityPagerModel
    {
        Page = Model.Page,
        PageSize = Model.PageSize,
        TotalCount = Model.TotalCount,
        TotalPages = Model.TotalPages,
        RouteValues = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["tab"] = AIInterviewDefaults.EmployerDashboardJobsTabKey
        }
    };
}

<div class="section">
    <div class="scoreboard-deck-header">
        <div>
            <strong class="scoreboard-deck-eyebrow">@T("Plugins.Misc.AIInterview.Employer.Dashboard.Tab.Jobs")</strong>
            @* <p class="scoreboard-deck-title">@T("Plugins.Misc.AIInterview.Employer.Jobs.Title")</p> *@
        </div>
        <div class="buttons scoreboard-deck-actions">
            <a class="button-1 scoreboard-deck-action-primary" href="@Url.RouteUrl(AIInterviewDefaults.VendorJobCreationRouteName)" title="@T("Plugins.Misc.AIInterview.Employer.Jobs.Create")">@T("Plugins.Misc.AIInterview.Employer.Jobs.Create")</a>
        </div>
    </div>

    @if (Model.Jobs.Any())
    {
        <div class="table-wrapper employer-dashboard-table-wrapper">
            <table class="data-table employer-table employer-dashboard-jobs-table">
                <thead>
                    <tr>
                        <th>@T("Plugins.Misc.AIInterview.Employer.Jobs.JobTitle")</th>
                        <th>@T("Plugins.Misc.AIInterview.Employer.Jobs.Status")</th>
                        <th>@T("Plugins.Misc.AIInterview.Employer.Jobs.Salary")</th>
                        <th>@T("Plugins.Misc.AIInterview.Employer.Jobs.CreatedOn")</th>
                        <th>@T("Plugins.Misc.AIInterview.Employer.Jobs.ApplicationCount")</th>
                        <th>@T("Plugins.Misc.AIInterview.Employer.Jobs.Actions")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in Model.Jobs)
                    {
                        <tr>
                            <td>@job.JobTitle</td>
                            <td>@(job.Published ? T("Plugins.Misc.AIInterview.Employer.Jobs.Published") : T("Plugins.Misc.AIInterview.Employer.Jobs.Unpublished"))</td>
                            <td>@(string.IsNullOrWhiteSpace(job.SalaryRange) ? "-" : job.SalaryRange)</td>
                            <td>@(await FormatUtcDateAsync(job.CreatedOnUtc))</td>
                            <td>@job.ApplicationCount</td>
                            <td>
                                @{
                                    var editText = T("Plugins.Misc.AIInterview.Employer.Jobs.Edit").Text;
                                    var publishText = job.Published
                                        ? T("Plugins.Misc.AIInterview.Employer.Jobs.Unpublish").Text
                                        : T("Plugins.Misc.AIInterview.Employer.Jobs.Publish").Text;
                                }
                                <div class="buttons scoreboard-deck-row-actions">
                                    <a class="button-2 ai-icon-action employer-dashboard-action-icon"
                                       href="@Url.RouteUrl(AIInterviewDefaults.VendorJobEditRouteName, new { productId = job.ProductId })"
                                       title="@editText"
                                       aria-label="@editText">
                                        <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                                        <span class="sr-only">@editText</span>
                                    </a>
                                    <form asp-route="@AIInterviewDefaults.VendorJobPublishToggleRouteName" asp-route-productId="@job.ProductId" method="post" class="inline">
                                        <button type="submit"
                                                class="button-2 ai-icon-action employer-dashboard-action-icon"
                                                title="@publishText"
                                                aria-label="@publishText">
                                            <i class="fa-solid @(job.Published ? "fa-eye-slash" : "fa-eye")" aria-hidden="true"></i>
                                            <span class="sr-only">@publishText</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("~/Plugins/Misc.AIInterview/Views/Shared/_MyActivityPager.cshtml", pagerModel)
    }
    else
    {
        <div class="fieldset scoreboard-deck-empty-state">
            <p>@T("Plugins.Misc.AIInterview.Employer.Jobs.Empty")</p>
        </div>
    }
</div>
