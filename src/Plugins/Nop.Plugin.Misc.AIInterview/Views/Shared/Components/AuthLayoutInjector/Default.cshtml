@{
    var returnUrl = Context.Request.Query["ReturnUrl"].ToString();
    var loginUrl = Url.RouteUrl(NopRouteNames.Standard.LOGIN, new { returnUrl });
    var registerUrl = Url.RouteUrl(NopRouteNames.Standard.REGISTER, new { returnUrl });

    NopHtml.AppendCssFileParts("~/Plugins/Misc.AIInterview/Content/css/aiinterview-auth-shell.css");
    NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/Plugins/Misc.AIInterview/Content/js/aiinterview-auth-shell.js");
}

<span class="aiinterview-auth-config"
      data-login-url="@loginUrl"
      data-register-url="@registerUrl"
      hidden></span>
