@model Nop.Web.Models.Catalog.ProductDetailsModel
@{
    bool hasCredits = ViewBag.HasCredits != null && (bool)ViewBag.HasCredits;
    bool hasSponsorCredits = ViewBag.HasSponsorCredits != null && (bool)ViewBag.HasSponsorCredits;
    int productId = ViewBag.ProductId != null ? (int)ViewBag.ProductId : 0;
    string sponsorToken = ViewBag.SponsorToken as string;
}

<div class="ai-interview-product-details">
    <h3>@T("Plugins.Misc.AIInterview.Interview.Title")</h3>

    @if (hasSponsorCredits)
    {
        <div class="sponsor-message alert alert-info">
            @T("Plugins.Misc.AIInterview.Runtime.SponsorMessage")
        </div>
    }
    else if (!hasCredits)
    {
        <div class="no-credits-message alert alert-warning">
            @T("Plugins.Misc.AIInterview.Runtime.Error.NoCredits")
            <a href="@Url.RouteUrl("Topic", new { SeName = "pricing" })">@T("Plugins.Misc.AIInterview.Runtime.Error.NoCredits.Link")</a>
        </div>
    }

    <div class="actions" style="margin-top: 15px;">
        <a href="@Url.Action("Apply", "AIInterview", new { jobTitle = Model.Name, productId })" class="button-1 apply-btn">
            @T("Plugins.Misc.AIInterview.Index.ApplyNow")
        </a>

        <a href="@Url.RouteUrl(AIInterviewDefaults.MockStartRouteName, new { productId, sponsorToken })" class="button-2 start-interview-btn">
            @T("Plugins.Misc.AIInterview.Index.StartInterview")
        </a>
    </div>
</div>
