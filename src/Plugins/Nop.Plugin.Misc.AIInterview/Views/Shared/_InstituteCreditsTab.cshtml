@model InstituteDashboardPageModel

<div class="institute-dashboard-tab-panel ai-institute-credits-page">
    <div class="institute-credit-summary-grid">
        <div class="institute-credit-summary-card">
            <span>Total Credits</span>
            <strong>@Model.TotalCredits.ToString("0.##")</strong>
        </div>
        <div class="institute-credit-summary-card">
            <span>Available Credits</span>
            <strong>@Model.AvailableCredits.ToString("0.##")</strong>
        </div>
        <div class="institute-credit-summary-card">
            <span>Consumed Credits</span>
            <strong>@Model.ConsumedCredits.ToString("0.##")</strong>
        </div>
    </div>

    <div class="institute-credits-candidates-section">
        <h2 class="institute-credits-candidates-heading">Applicant Balances</h2>
        @if (!Model.Candidates.Any())
        {
            <p class="institute-candidates-empty">No applicants have joined this institute yet.</p>
        }
        else
        {
            <div class="institute-candidates-table-wrapper">
                <table class="institute-candidates-table">
                    <thead>
                        <tr>
                            <th>Applicant</th>
                            <th>Email</th>
                            <th>Credit Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Candidates)
                        {
                            <tr class="institute-candidate-row">
                                <td data-label="Applicant">@c.CustomerName</td>
                                <td data-label="Email">
                                    <span class="candidate-email">@c.Email</span>
                                </td>
                                <td data-label="Credit Balance">
                                    <strong>@c.CreditBalance.ToString("0.##")</strong>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
