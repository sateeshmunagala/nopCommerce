@{
    Layout = "_ColumnsTwo";
    NopHtml.AddTitleParts("Institute Dashboard");
    NopHtml.AppendCssFileParts("~/Plugins/Misc.AIInterview/Content/css/aiinterview-public.css");
    NopHtml.AppendPageCssClassParts("html-account-page");
    NopHtml.AppendPageCssClassParts("html-aiinterview-view-page");
    NopHtml.AppendPageCssClassParts("html-aiinterview-institute-dashboard-page");

    var vendorName = ViewData["InstituteVendorName"] as string ?? string.Empty;
    var joinUrl = ViewData["InstituteJoinUrl"] as string ?? string.Empty;
    var candidatesUrl = Url.RouteUrl(AIInterviewDefaults.InstituteCandidatesRouteName);
    var creditsUrl = Url.RouteUrl(AIInterviewDefaults.InstituteCreditsRouteName);
}

@section left
{
    @await Component.InvokeAsync("CustomerNavigation",
        new { selectedTabId = AIInterviewDefaults.InstituteDashboardNavigationTab })
}

<div class="page ai-institute-dashboard-page">
    <div class="page-title">
        <h1>Institute Dashboard@(string.IsNullOrEmpty(vendorName) ? "" : $" - {vendorName}")</h1>
    </div>
    <div class="page-body">
        @if (!string.IsNullOrWhiteSpace(joinUrl))
        {
            <div class="institute-join-url-panel">
                <label class="institute-join-url-label">Your Student Registration Link</label>
                <div class="institute-join-url-row">
                    <input type="text" readonly value="@joinUrl"
                           class="institute-join-url-input"
                           id="institute-join-url" />
                    <button type="button"
                            class="button-2 institute-join-url-copy"
                            onclick="navigator.clipboard.writeText(document.getElementById('institute-join-url').value).then(function(){this.textContent='Copied!';setTimeout(function(){document.querySelector('.institute-join-url-copy').textContent='Copy Link';},2000);}.bind(this))">
                        Copy Link
                    </button>
                </div>
                <p class="institute-join-url-hint">
                    Share this link with your students. When they register using this link
                    they will automatically appear in your Candidates list.
                </p>
            </div>
        }

        <p class="institute-dashboard-intro">
            Welcome to your institute portal. Use the links below to manage your candidates
            and allocate interview credits to your students.
        </p>
        <div class="institute-dashboard-cards">
            <a class="institute-dashboard-card" href="@candidatesUrl">
                <span class="institute-dashboard-card-icon">&#128101;</span>
                <span class="institute-dashboard-card-label">Candidates</span>
                <span class="institute-dashboard-card-hint">View and manage your enrolled students</span>
            </a>
            <a class="institute-dashboard-card" href="@creditsUrl">
                <span class="institute-dashboard-card-icon">&#127881;</span>
                <span class="institute-dashboard-card-label">Credits</span>
                <span class="institute-dashboard-card-hint">Allocate interview credits</span>
            </a>
        </div>
    </div>
</div>
