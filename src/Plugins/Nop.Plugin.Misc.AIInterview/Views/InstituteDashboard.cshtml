@model InstituteDashboardPageModel

@{
    Layout = "_ColumnsTwo";
    NopHtml.AddTitleParts("Institute Dashboard");
    NopHtml.AppendCssFileParts("~/Plugins/Misc.AIInterview/Content/css/aiinterview-public.css");
    NopHtml.AppendPageCssClassParts("html-account-page");
    NopHtml.AppendPageCssClassParts("html-aiinterview-view-page");
    NopHtml.AppendPageCssClassParts("html-aiinterview-institute-dashboard-page");
    NopHtml.AppendPageCssClassParts("html-vendor-portal-page");

    var dashboardUrl = Url.RouteUrl(AIInterviewDefaults.InstituteDashboardRouteName, new { tab = AIInterviewDefaults.InstituteDashboardTabKey });
    var creditsUrl = Url.RouteUrl(AIInterviewDefaults.InstituteDashboardRouteName, new { tab = AIInterviewDefaults.InstituteCreditsTabKey });
    var candidatesUrl = Url.RouteUrl(AIInterviewDefaults.InstituteDashboardRouteName, new { tab = AIInterviewDefaults.InstituteCandidatesTabKey });
}

@section left
{
    @await Component.InvokeAsync("CustomerNavigation",
        new { selectedTabId = Model.SelectedNavigationTab })
}

<div class="page ai-institute-dashboard-page">
    <div class="page-title">
        <h1>Institute Dashboard@(string.IsNullOrEmpty(Model.VendorName) ? "" : $" - {Model.VendorName}")</h1>
    </div>
    <div class="page-body">
        <div class="institute-dashboard-shell">
            <nav class="institute-dashboard-tabs" aria-label="Institute portal">
                <a class="institute-dashboard-tab @(Model.ActiveTab == AIInterviewDefaults.InstituteDashboardTabKey ? "is-active" : null)"
                   href="@dashboardUrl"
                   data-institute-tab="@AIInterviewDefaults.InstituteDashboardTabKey"
                   hx-get="@dashboardUrl"
                   hx-target="#institute-dashboard-content"
                   hx-swap="innerHTML"
                   hx-push-url="true"
                   aria-current="@(Model.ActiveTab == AIInterviewDefaults.InstituteDashboardTabKey ? "page" : null)">
                    Dashboard
                </a>
                <a class="institute-dashboard-tab @(Model.ActiveTab == AIInterviewDefaults.InstituteCreditsTabKey ? "is-active" : null)"
                   href="@creditsUrl"
                   data-institute-tab="@AIInterviewDefaults.InstituteCreditsTabKey"
                   hx-get="@creditsUrl"
                   hx-target="#institute-dashboard-content"
                   hx-swap="innerHTML"
                   hx-push-url="true"
                   aria-current="@(Model.ActiveTab == AIInterviewDefaults.InstituteCreditsTabKey ? "page" : null)">
                    Credits
                </a>
                <a class="institute-dashboard-tab @(Model.ActiveTab == AIInterviewDefaults.InstituteCandidatesTabKey ? "is-active" : null)"
                   href="@candidatesUrl"
                   data-institute-tab="@AIInterviewDefaults.InstituteCandidatesTabKey"
                   hx-get="@candidatesUrl"
                   hx-target="#institute-dashboard-content"
                   hx-swap="innerHTML"
                   hx-push-url="true"
                   aria-current="@(Model.ActiveTab == AIInterviewDefaults.InstituteCandidatesTabKey ? "page" : null)">
                    Candidates
                </a>
            </nav>

            <section id="institute-dashboard-content" class="institute-dashboard-content" aria-live="polite">
                @await Html.PartialAsync("~/Plugins/Misc.AIInterview/Views/Shared/_InstituteDashboardTabContent.cshtml", Model)
            </section>
        </div>
    </div>
</div>
