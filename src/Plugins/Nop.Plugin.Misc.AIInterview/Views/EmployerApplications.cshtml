@model ApplicationListModel
@using Nop.Plugin.Misc.AIInterview.Domain
@using Nop.Web.Models.Customer

@{
    Layout = "_ColumnsTwo";
    NopHtml.AppendCssFileParts("~/Plugins/Misc.AIInterview/Content/css/aiinterview-public.css");
    NopHtml.AppendPageCssClassParts("html-account-page");
    NopHtml.AppendPageCssClassParts("html-aiinterview-view-page");
    NopHtml.AppendPageCssClassParts("html-aiinterview-employer-applications-page");
    var viewReportText = T("Plugins.Misc.AIInterview.Report.ViewReport").Text;

    string GetStatusLabel(string status) => T($"Plugins.Misc.AIInterview.Status.{JobApplicationStatuses.Normalize(status)}").Text;
}

@section left
{
    @await Component.InvokeAsync("CustomerNavigation", new { selectedTabId = AIInterviewDefaults.EmployerApplicationsNavigationTab })
}

<div class="page employer-applications-page">
    <div class="page-title">
        <h1>@T("Plugins.Misc.AIInterview.Employer.Applications.Title")</h1>
    </div>
    <div class="page-body">
        <div class="section">
            <div class="fieldset">
                <form method="get" asp-action="EmployerApplications" class="employer-filter-form">
                <div class="employer-filter-shell">
                <div class="employer-filter-head">
                    <strong>@T("Plugins.Misc.AIInterview.Employer.Applications.FilterTitle")</strong>
                    <span>@T("Plugins.Misc.AIInterview.Employer.Applications.FilterSubtitle")</span>
                </div>
                <div class="employer-filter-grid">
                    <div class="employer-field employer-field-wide">
                        <label for="CandidateNameOrEmail">@T("Plugins.Misc.AIInterview.Employer.Applications.Candidate")</label>
                        <input id="CandidateNameOrEmail" name="CandidateNameOrEmail" value="@Model.CandidateNameOrEmail" />
                    </div>
                    <div class="employer-field">
                        <label for="Status">@T("Plugins.Misc.AIInterview.Employer.Applications.Status")</label>
                        <select id="Status" name="Status">
                            <option value="">@T("Admin.Common.All")</option>
                            @foreach (var status in JobApplicationStatuses.All)
                            {
                                <option value="@status" selected="@(Model.Status == status)">@GetStatusLabel(status)</option>
                            }
                        </select>
                    </div>
                    <div class="employer-field">
                        <label for="InterviewSort">@T("Plugins.Misc.AIInterview.Employer.Applications.InterviewSort")</label>
                        <select id="InterviewSort" name="InterviewSort">
                            <option value="TopScorersFirst" selected="@(Model.InterviewSort == "TopScorersFirst")">@T("Plugins.Misc.AIInterview.Employer.Applications.Sort.TopScorersFirst")</option>
                            <option value="LowestScorersFirst" selected="@(Model.InterviewSort == "LowestScorersFirst")">@T("Plugins.Misc.AIInterview.Employer.Applications.Sort.LowestScorersFirst")</option>
                            <option value="LatestApplied" selected="@(Model.InterviewSort == "LatestApplied")">@T("Plugins.Misc.AIInterview.Employer.Applications.Sort.LatestApplied")</option>
                        </select>
                    </div>
                    <div class="employer-field">
                        <label for="MinScore">@T("Plugins.Misc.AIInterview.Employer.Applications.MinScore")</label>
                        <input id="MinScore" name="MinScore" type="number" min="0" max="100" value="@Model.MinScore" />
                    </div>
                    <div class="employer-field">
                        <label for="MaxScore">@T("Plugins.Misc.AIInterview.Employer.Applications.MaxScore")</label>
                        <input id="MaxScore" name="MaxScore" type="number" min="0" max="100" value="@Model.MaxScore" />
                    </div>
                    <div class="employer-field">
                        <label for="StartDate">@T("Plugins.Misc.AIInterview.Employer.Applications.AppliedFromUtc")</label>
                        <input id="StartDate" name="StartDate" type="date" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="employer-field">
                        <label for="EndDate">@T("Plugins.Misc.AIInterview.Employer.Applications.AppliedToUtc")</label>
                        <input id="EndDate" name="EndDate" type="date" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="employer-field">
                        <label for="PageSize">@T("Plugins.Misc.AIInterview.Employer.Applications.PageSize")</label>
                        <select id="PageSize" name="PageSize">
                            <option value="10" selected="@(Model.PageSize == 10)">10</option>
                            <option value="20" selected="@(Model.PageSize == 20)">20</option>
                            <option value="50" selected="@(Model.PageSize == 50)">50</option>
                        </select>
                    </div>
                </div>

                <div class="employer-filter-meta">
                    <label class="employer-checkbox">
                        <input type="checkbox" name="OnlyWithInterviewScore" value="true" checked="@Model.OnlyWithInterviewScore" />
                        @T("Plugins.Misc.AIInterview.Employer.Applications.OnlyWithInterviewScore")
                    </label>
                </div>

                <div class="employer-filter-actions">
                    <button type="submit" class="button-1">@T("Plugins.Misc.AIInterview.Employer.Applications.Filter")</button>
                    <a class="button-2" href="@Url.Action("EmployerApplications")">@T("Plugins.Misc.AIInterview.Employer.Applications.Reset")</a>
                    <a class="button-2" href="@Url.RouteUrl("Plugin.Misc.AIInterview.ExportCsv", new {
                        CandidateNameOrEmail = Model.CandidateNameOrEmail,
                        Status = Model.Status,
                        MinScore = Model.MinScore,
                        MaxScore = Model.MaxScore,
                        StartDate = Model.StartDate?.ToString("o"),
                        EndDate = Model.EndDate?.ToString("o"),
                        InterviewSort = Model.InterviewSort,
                        OnlyWithInterviewScore = Model.OnlyWithInterviewScore
                    })">@T("Plugins.Misc.AIInterview.Employer.Applications.ExportCsv")</a>
                </div>
                </div>
                </form>

                <div class="results-toolbar">
                    <div class="filter-summary">
                        @string.Format(T("Plugins.Misc.AIInterview.Employer.Applications.ResultsSummary").Text, Model.TotalCount)
                    </div>
                    <div class="page-size-wrap">
                        @T("Plugins.Misc.AIInterview.Employer.Applications.PageSize") @Model.PageSize
                    </div>
                </div>

                <div class="table-wrapper">
                    <div class="employer-table-wrapper">
                    <table class="data-table employer-table">
                        <thead>
                            <tr>
                                <th class="col-candidate">@T("Plugins.Misc.AIInterview.Employer.Applications.Candidate")</th>
                                <th class="col-email">@T("Plugins.Misc.AIInterview.Employer.Applications.Email")</th>
                                <th class="col-phone">@T("Admin.Customers.Customers.Fields.Phone")</th>
                                <th class="col-charge">@T("Plugins.Misc.AIInterview.Employer.Applications.ChargeMode")</th>
                                <th class="col-score">@T("Plugins.Misc.AIInterview.Employer.Applications.InterviewScore")</th>
                                <th class="col-attempts">@T("Plugins.Misc.AIInterview.Employer.Applications.Attempts")</th>
                                <th class="col-applied">@T("Plugins.Misc.AIInterview.Employer.Applications.AppliedOn")</th>
                                <th class="col-message">@T("Plugins.Misc.AIInterview.Employer.Applications.CoverMessage")</th>
                                <th class="col-status">@T("Plugins.Misc.AIInterview.Employer.Applications.Status")</th>
                                <th class="col-report">@viewReportText</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var app in Model.Applications)
                            {
                                <tr>
                                    <td class="col-candidate">@app.CandidateName</td>
                                    <td class="col-email">@app.CandidateEmail</td>
                                    <td class="col-phone">@app.CandidatePhone</td>
                                    <td class="col-charge"><span class="charge-pill">@app.ChargeMode</span></td>
                                    <td class="col-score">
                                        @if (app.InterviewScore.HasValue)
                                        {
                                            <span class="score-badge">@Math.Round(app.InterviewScore.Value)</span>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    <td class="col-attempts">@app.AttemptCount</td>
                                    <td class="col-applied">@app.CreatedOn.ToString("yyyy-MM-dd HH:mm:ss")Z</td>
                                    <td class="col-message">@app.CoverMessage</td>
                                    <td class="col-status">
                                        <form asp-route="Plugin.Misc.AIInterview.UpdateStatus" method="post" class="status-form employer-status-form">
                                            <input type="hidden" name="Id" value="@app.Id" />
                                            <select name="Status" class="employer-status-select">
                                                @foreach (var status in JobApplicationStatuses.All)
                                                {
                                                    <option value="@status" selected="@(app.RawStatus == status)">@GetStatusLabel(status)</option>
                                                }
                                            </select>
                                            <input type="text" name="StatusComment" class="employer-status-comment" value="@app.StatusComment" placeholder="@T("Plugins.Misc.AIInterview.Employer.Applications.StatusComment")" />
                                            <button type="submit" class="button-2 employer-status-update">@T("Plugins.Misc.AIInterview.Employer.Applications.Update")</button>
                                        </form>
                                    </td>
                                    <td class="col-report">
                                        @if (!string.IsNullOrWhiteSpace(app.InterviewReportUrl))
                                        {
                                            var reportTitle = string.Format(T("Plugins.Misc.AIInterview.Report.JobReportTitle").Text, app.JobTitle);
                                            <a href="@app.InterviewReportUrl"
                                               class="ai-view-report-link js-open-report-drawer"
                                               data-report-panel-url="@app.InterviewReportPanelUrl"
                                               data-report-title="@reportTitle"><i class="fa fa-eye" aria-hidden="true"></i><span>@viewReportText</span></a>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("~/Plugins/Misc.AIInterview/Views/Shared/_CandidateReportDrawer.cshtml")
