@model Nop.Plugin.Misc.AIInterview.Models.InterviewReportModel
@{
    Layout = "_ColumnsTwo";
}

<style>
    .report-data { white-space: pre-line; }
</style>

<div class="page mock-report">
    <div class="page-title">
        <h1>@T("Plugins.Misc.AIInterview.Report.Title")</h1>
    </div>
    <div class="page-body">
        <p><strong>@T("Plugins.Misc.AIInterview.Report.Date"):</strong> @Model.CreatedOnUtc.ToString("f")</p>
        <p><strong>@T("Plugins.Misc.AIInterview.Report.Score"):</strong> @Model.Score.ToString("N2")</p>
        @if (!string.IsNullOrWhiteSpace(Model.RecordingUrl))
        {
            <p><strong>Recording:</strong> <a href="@Model.RecordingUrl" target="_blank" rel="noopener">Open recording</a></p>
        }

        @if (Model.ParsedQuestionScores?.Any() == true)
        {
            <div class="question-scores">
                <h3>Question Scores</h3>
                <ul>
                    @for (var i = 0; i < Model.ParsedQuestionScores.Count; i++)
                    {
                        <li>Question @(i + 1): @Model.ParsedQuestionScores[i]</li>
                    }
                </ul>
            </div>
        }

        @if (Model.Turns?.Any() == true)
        {
            <div class="turn-history">
                <h3>Interview Turns</h3>
                @foreach (var turn in Model.Turns)
                {
                    <div style="padding:12px 14px;border:1px solid rgba(15,23,42,.08);border-radius:14px;margin-bottom:12px;">
                        <div><strong>Q@turn.SequenceNumber.</strong> @turn.QuestionText</div>
                        <div><strong>Answer:</strong> @(string.IsNullOrWhiteSpace(turn.AnswerText) ? "(pending)" : turn.AnswerText)</div>
                        <div><strong>Score:</strong> @(turn.Score.HasValue ? turn.Score.Value.ToString("N2") : "-")</div>
                        <div><strong>Feedback:</strong> @turn.Feedback</div>
                        <div><strong>Asked:</strong> @turn.AskedOnUtc.ToString("g")</div>
                        @if (turn.AnsweredOnUtc.HasValue)
                        {
                            <div><strong>Answered:</strong> @turn.AnsweredOnUtc.Value.ToString("g")</div>
                        }
                    </div>
                }
            </div>
        }

        <div class="report-details">
            <h3>@T("Plugins.Misc.AIInterview.Report.Details")</h3>
            <div class="report-data">@Model.ReportData</div>
        </div>
    </div>
</div>
