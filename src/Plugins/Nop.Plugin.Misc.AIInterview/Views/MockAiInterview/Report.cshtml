@model Nop.Plugin.Misc.AIInterview.Models.InterviewReportModel
@{
    Layout = "_ColumnsTwo";
    NopHtml.AppendCssFileParts("~/Plugins/Misc.AIInterview/Content/css/aiinterview-public.css");
    NopHtml.AppendPageCssClassParts("html-account-page");
    NopHtml.AppendPageCssClassParts("html-aiinterview-view-page");
    NopHtml.AppendPageCssClassParts("html-aiinterview-mock-report-page");
}

@section left
{
    @await Component.InvokeAsync("CustomerNavigation", new { selectedTabId = AIInterviewDefaults.MyApplicationsNavigationTab })
}

<div class="page mock-report">
    <div class="page-title">
        <h1>@T("Plugins.Misc.AIInterview.Report.Title")</h1>
    </div>
    <div class="page-body">
        <div class="mock-report-wrap">
            @await Html.PartialAsync("~/Plugins/Misc.AIInterview/Views/Shared/_InterviewReportContent.cshtml", Model)
        </div>
    </div>
</div>
