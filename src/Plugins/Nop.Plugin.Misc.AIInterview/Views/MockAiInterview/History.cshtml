@model IList<Nop.Plugin.Misc.AIInterview.Domain.InterviewSession>
@using Nop.Web.Models.Customer
@{
    Layout = "_ColumnsTwo";
    NopHtml.AppendCssFileParts("~/Plugins/Misc.AIInterview/Content/css/aiinterview-public.css");
    NopHtml.AppendPageCssClassParts("html-account-page");
    NopHtml.AppendPageCssClassParts("html-aiinterview-view-page");
    NopHtml.AppendPageCssClassParts("html-aiinterview-history-page");
}

@section left
{
    @await Component.InvokeAsync("CustomerNavigation", new { selectedTabId = AIInterviewDefaults.MyApplicationsNavigationTab })
}

<div class="page mock-history">
    <div class="page-title">
        <h1>@T("Plugins.Misc.AIInterview.History.Title")</h1>
    </div>
    <div class="page-body">
        @if (Model.Any())
        {
            <table class="history-table">
                <thead>
                    <tr>
                        <th>@T("Plugins.Misc.AIInterview.History.Date")</th>
                        <th>@T("Plugins.Misc.AIInterview.History.Status")</th>
                        <th>@T("Plugins.Misc.AIInterview.History.Score")</th>
                        <th>@T("Plugins.Misc.AIInterview.Report.Title")</th>
                        <th>@T("Plugins.Misc.AIInterview.Report.Recording")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var session in Model)
                    {
                        <tr>
                            <td>@session.CreatedOnUtc.ToString("yyyy-MM-dd")</td>
                            <td>@(session.CompletedOnUtc.HasValue ? T("Plugins.Misc.AIInterview.Status.Completed").Text : T("Plugins.Misc.AIInterview.Status.Active").Text)</td>
                            <td>@session.Score</td>
                            <td>
                                @if (session.CompletedOnUtc.HasValue && !string.IsNullOrWhiteSpace(session.ReportData))
                                {
                                    <a href="@Url.Action("Report", "AIInterview", new { sessionId = session.Id })">@T("Plugins.Misc.AIInterview.Report.OpenReport")</a>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td>
                                @if (session.CompletedOnUtc.HasValue && !string.IsNullOrWhiteSpace(session.RecordingUrl))
                                {
                                    <a href="@Url.Action("Recording", "AIInterview", new { sessionId = session.Id })">@T("Plugins.Misc.AIInterview.Report.OpenRecording")</a>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>@T("Plugins.Misc.AIInterview.History.NoSessions")</p>
        }
    </div>
</div>
