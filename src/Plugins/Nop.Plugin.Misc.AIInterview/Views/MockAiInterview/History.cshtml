@model IList<Nop.Plugin.Misc.AIInterview.Models.InterviewHistoryItemModel>
@using Nop.Web.Models.Customer
@{
    Layout = "_ColumnsTwo";
    NopHtml.AppendCssFileParts("~/Plugins/Misc.AIInterview/Content/css/aiinterview-public.css");
    NopHtml.AppendPageCssClassParts("html-account-page");
    NopHtml.AppendPageCssClassParts("html-aiinterview-view-page");
    NopHtml.AppendPageCssClassParts("html-aiinterview-history-page");

    var interviewText = T("Plugins.Misc.AIInterview.Common.Interview").Text;
    var copyShareLinkText = T("Plugins.Misc.AIInterview.Report.CopyShareLink").Text;
    var shareText = T("Plugins.Misc.AIInterview.Report.Share").Text;
    var openSharePageText = T("Plugins.Misc.AIInterview.Report.OpenSharePage").Text;
    var jobReportTitleFormat = T("Plugins.Misc.AIInterview.Report.JobReportTitle").Text;
    var jobRecordingTitleFormat = T("Plugins.Misc.AIInterview.Report.JobRecordingTitle").Text;
    var viewReportText = T("Plugins.Misc.AIInterview.Report.ViewReport").Text;
}

@section left
{
    @await Component.InvokeAsync("CustomerNavigation", new { selectedTabId = AIInterviewDefaults.MyApplicationsNavigationTab })
}

<div class="page mock-history">
    <div class="page-title">
        <h1>@T("Plugins.Misc.AIInterview.History.Title")</h1>
    </div>
    <div class="page-body">
        @if (Model.Any())
        {
            <div class="history-table-wrapper">
                <table class="history-table">
                    <thead>
                        <tr>
                            <th>@interviewText</th>
                            <th>@T("Plugins.Misc.AIInterview.History.Date")</th>
                            <th>@T("Plugins.Misc.AIInterview.History.Status")</th>
                            <th>@T("Plugins.Misc.AIInterview.History.Score")</th>
                            <th>@T("Plugins.Misc.AIInterview.Report.Title")</th>
                            <th>@T("Plugins.Misc.AIInterview.Report.Recording")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var session in Model)
                        {
                            var reportTitle = string.Format(jobReportTitleFormat, session.JobTitle);
                            var recordingTitle = string.Format(jobRecordingTitleFormat, session.JobTitle);
                            var reportActionLabel = $"{viewReportText} - {session.JobTitle}";
                            var openRecordingLabel = $"{T("Plugins.Misc.AIInterview.Report.OpenRecording").Text} - {session.JobTitle}";
                            var copyShareLabel = $"{copyShareLinkText} - {session.JobTitle}";
                            var shareActionLabel = $"{shareText} - {session.JobTitle}";
                            <tr>
                                <td>@session.JobTitle</td>
                                <td>@session.CreatedOnUtc.ToString("yyyy-MM-dd")</td>
                                <td>@session.Status</td>
                                <td>@session.Score</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(session.InterviewReportUrl))
                                    {
                                        <a href="@session.InterviewReportUrl"
                                           class="js-open-report-drawer ai-view-report-link ai-icon-action"
                                           data-report-panel-url="@session.InterviewReportPanelUrl"
                                           data-report-title="@reportTitle"
                                           aria-label="@reportActionLabel"
                                           title="@reportActionLabel"><i class="fa-solid fa-eye" aria-hidden="true"></i><span class="sr-only">@viewReportText</span></a>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(session.RecordingUrl))
                                    {
                                        <div class="candidate-recording-actions">
                                            <a href="@session.RecordingUrl"
                                               target="_blank"
                                               rel="noopener"
                                               class="button-1 ai-report-action ai-report-action-primary ai-icon-action"
                                               aria-label="@openRecordingLabel"
                                               title="@openRecordingLabel"><i class="fa-solid fa-circle-play" aria-hidden="true"></i><span class="sr-only">@T("Plugins.Misc.AIInterview.Report.OpenRecording")</span></a>
                                            @if (!string.IsNullOrWhiteSpace(session.RecordingShareUrl))
                                            {
                                                <button type="button"
                                                        class="button-2 ai-copy-share-link ai-icon-action"
                                                        data-share-url="@session.RecordingShareUrl"
                                                        aria-label="@copyShareLabel"
                                                        title="@copyShareLabel"><i class="fa-solid fa-copy ai-copy-default-icon" aria-hidden="true"></i><i class="fa-solid fa-check ai-copy-success-icon" aria-hidden="true"></i><i class="fa-solid fa-xmark ai-copy-error-icon" aria-hidden="true"></i><span class="sr-only">@copyShareLinkText</span></button>
                                                <button type="button"
                                                        class="button-2 ai-native-share-link aiinterview-hidden ai-icon-action"
                                                        data-share-url="@session.RecordingShareUrl"
                                                        data-share-title="@recordingTitle"
                                                        aria-label="@shareActionLabel"
                                                        title="@shareActionLabel"><i class="fa-solid fa-share-nodes" aria-hidden="true"></i><span class="sr-only">@shareText</span></button>
                                                <noscript>
                                                    <a href="@session.RecordingShareUrl" target="_blank" rel="noopener">@openSharePageText</a>
                                                </noscript>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="responsive-data-list history-mobile-list" aria-label="@T("Plugins.Misc.AIInterview.History.Title")">
                @foreach (var session in Model)
                {
                    var reportTitle = string.Format(jobReportTitleFormat, session.JobTitle);
                    var recordingTitle = string.Format(jobRecordingTitleFormat, session.JobTitle);
                    var reportActionLabel = $"{viewReportText} - {session.JobTitle}";
                    var openRecordingLabel = $"{T("Plugins.Misc.AIInterview.Report.OpenRecording").Text} - {session.JobTitle}";
                    var copyShareLabel = $"{copyShareLinkText} - {session.JobTitle}";
                    var shareActionLabel = $"{shareText} - {session.JobTitle}";
                    <article class="responsive-data-card">
                        <div class="responsive-data-card-head">
                            <div class="responsive-data-card-head-copy">
                                <strong class="responsive-data-card-title">@session.JobTitle</strong>
                                <div class="applications-footnote">@session.CreatedOnUtc.ToString("yyyy-MM-dd")</div>
                            </div>
                            <div class="responsive-data-card-chip-group">
                                <span class="score-chip">@(string.IsNullOrWhiteSpace(session.Score) ? "-" : session.Score)</span>
                                <span class="status-pill">@session.Status</span>
                            </div>
                        </div>
                        <div class="responsive-data-card-grid">
                            <div class="responsive-data-card-item">
                                <span class="responsive-data-card-label">@T("Plugins.Misc.AIInterview.History.Date")</span>
                                <span class="responsive-data-card-value">@session.CreatedOnUtc.ToString("yyyy-MM-dd")</span>
                            </div>
                            <div class="responsive-data-card-item">
                                <span class="responsive-data-card-label">@T("Plugins.Misc.AIInterview.History.Score")</span>
                                <span class="responsive-data-card-value">@(string.IsNullOrWhiteSpace(session.Score) ? "-" : session.Score)</span>
                            </div>
                        </div>
                        <div class="responsive-data-card-actions">
                            @if (!string.IsNullOrWhiteSpace(session.InterviewReportUrl))
                            {
                                <a href="@session.InterviewReportUrl"
                                   class="js-open-report-drawer ai-view-report-link"
                                   data-report-panel-url="@session.InterviewReportPanelUrl"
                                   data-report-title="@reportTitle"
                                   aria-label="@reportActionLabel"
                                   title="@reportActionLabel">
                                    <i class="fa-solid fa-eye" aria-hidden="true"></i>
                                    <span>@viewReportText</span>
                                </a>
                            }
                            @if (!string.IsNullOrWhiteSpace(session.RecordingUrl))
                            {
                                <div class="candidate-recording-actions">
                                    <a href="@session.RecordingUrl"
                                       target="_blank"
                                       rel="noopener"
                                       class="button-1 ai-report-action ai-report-action-primary ai-icon-action"
                                       aria-label="@openRecordingLabel"
                                       title="@openRecordingLabel"><i class="fa-solid fa-circle-play" aria-hidden="true"></i><span class="sr-only">@T("Plugins.Misc.AIInterview.Report.OpenRecording")</span></a>
                                    @if (!string.IsNullOrWhiteSpace(session.RecordingShareUrl))
                                    {
                                        <button type="button"
                                                class="button-2 ai-copy-share-link ai-icon-action"
                                                data-share-url="@session.RecordingShareUrl"
                                                aria-label="@copyShareLabel"
                                                title="@copyShareLabel"><i class="fa-solid fa-copy ai-copy-default-icon" aria-hidden="true"></i><i class="fa-solid fa-check ai-copy-success-icon" aria-hidden="true"></i><i class="fa-solid fa-xmark ai-copy-error-icon" aria-hidden="true"></i><span class="sr-only">@copyShareLinkText</span></button>
                                        <button type="button"
                                                class="button-2 ai-native-share-link aiinterview-hidden ai-icon-action"
                                                data-share-url="@session.RecordingShareUrl"
                                                data-share-title="@recordingTitle"
                                                aria-label="@shareActionLabel"
                                                title="@shareActionLabel"><i class="fa-solid fa-share-nodes" aria-hidden="true"></i><span class="sr-only">@shareText</span></button>
                                        <noscript>
                                            <a href="@session.RecordingShareUrl" target="_blank" rel="noopener">@openSharePageText</a>
                                        </noscript>
                                    }
                                </div>
                            }
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <p>@T("Plugins.Misc.AIInterview.History.NoSessions")</p>
        }
    </div>
</div>

@await Html.PartialAsync("~/Plugins/Misc.AIInterview/Views/Shared/_CandidateReportDrawer.cshtml")
