@model IList<Nop.Plugin.Misc.AIInterview.Models.InterviewHistoryItemModel>

@{
    Layout = "_ColumnsTwo";
    NopHtml.AppendCssFileParts("~/Plugins/Misc.AIInterview/Content/css/aiinterview-public.css");
    NopHtml.AppendPageCssClassParts("html-account-page");
    NopHtml.AppendPageCssClassParts("html-aiinterview-view-page");
    NopHtml.AppendPageCssClassParts("html-aiinterview-history-page");
}

@section left
{
    @await Component.InvokeAsync("CustomerNavigation", new { selectedTabId = AIInterviewDefaults.MyActivityNavigationTab })
}

<div class="page aiinterview-history-page">
    <div class="page-title">
        <h1>@T("Plugins.Misc.AIInterview.History.MockTitle")</h1>
    </div>
    <div class="page-body">
        @await Html.PartialAsync("~/Plugins/Misc.AIInterview/Views/Shared/_MockInterviewHistoryContent.cshtml", Model)
    </div>
</div>
