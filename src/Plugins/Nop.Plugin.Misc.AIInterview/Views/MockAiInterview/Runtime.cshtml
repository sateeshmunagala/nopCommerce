        const slowSubmitStatusDelayMs = 2000;
        const fallbackFinalCompletionSpeech = 'Thank you for completing your interview. Your responses have been submitted successfully. We are now preparing your interview report. Best wishes.';
        const finalCompletionSpeech = (config.finalCompletionSpeech || '').trim() || fallbackFinalCompletionSpeech;
        const reportGenerationMessage = 'Generating your report...';
        const audioInputStorageKey = 'aiinterview.runtime.audioInputDeviceId';
        const audioOutputStorageKey = 'aiinterview.runtime.audioOutputDeviceId';
        const supportsAudioOutputSelection = typeof HTMLMediaElement !== 'undefined'
            && 'setSinkId' in HTMLMediaElement.prototype;

