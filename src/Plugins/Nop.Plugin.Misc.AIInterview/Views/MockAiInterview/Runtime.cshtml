@model Nop.Plugin.Misc.AIInterview.Models.InterviewRuntimeModel
@using System.Text.Json
@using System.Text.Json.Serialization
@{
    Layout = "_Root.Head";
    var jsonOptions = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
    };
    var clientSettings = JsonSerializer.Serialize(Model.ClientSettings ?? new Nop.Plugin.Misc.AIInterview.Models.RuntimeClientSettingsModel(), jsonOptions);
    var turns = JsonSerializer.Serialize(Model.Turns ?? Array.Empty<InterviewTurnViewModel>(), jsonOptions);
}

<style>
    body { margin: 0; background: #eef3fb; }
    .runtime-shell { min-height: 100vh; padding: 12px; box-sizing: border-box; }
    .runtime-page { min-height: calc(100vh - 24px); padding: 18px; border-radius: 28px; background: linear-gradient(180deg, #f8fafc 0%, #eef3fb 100%); box-shadow: 0 20px 50px rgba(15, 23, 42, 0.12); display: grid; gap: 18px; }
    .runtime-topbar { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
    .runtime-topbar h1 { margin: 0; font-size: 22px; color: #162033; }
    .runtime-meta { display: flex; align-items: center; gap: 12px; color: #667085; font-weight: 600; }
    .runtime-progress { height: 8px; border-radius: 999px; background: #dbe4f0; overflow: hidden; }
    .runtime-progress > span { display: block; height: 100%; width: 0; background: linear-gradient(90deg, #0f5bd7, #ff7a1a); transition: width .2s ease; }
    .runtime-layout { display: grid; grid-template-columns: minmax(0, 1.8fr) minmax(320px, .9fr); gap: 18px; min-height: 70vh; }
    .runtime-stage, .runtime-sidebar { display: grid; gap: 16px; padding: 18px; border-radius: 24px; background: #fff; border: 1px solid rgba(15, 23, 42, 0.08); }
    .runtime-video { position: relative; min-height: clamp(220px, 28vw, 252px); max-height: 252px; border-radius: 20px; background: linear-gradient(180deg, #d9e2f2 0%, #c8d7ea 100%); display: grid; place-items: center; color: #51627b; font-size: 28px; font-weight: 700; overflow: hidden; }
    .runtime-video video { width: 100%; height: 100%; object-fit: cover; display: none; }
    .runtime-avatar { position: absolute; top: 20px; right: 20px; width: 108px; height: 108px; border-radius: 20px; background: linear-gradient(180deg, #f7f9fc 0%, #dce6f3 100%); border: 1px solid rgba(255,255,255,0.85); box-shadow: 0 12px 22px rgba(15, 23, 42, 0.12); }
    .runtime-avatar::before, .runtime-avatar::after { content: ""; position: absolute; left: 50%; transform: translateX(-50%); background: #b5c3d0; }
    .runtime-avatar::before { top: 18px; width: 42px; height: 42px; border-radius: 50%; }
    .runtime-avatar::after { bottom: 18px; width: 54px; height: 34px; border-radius: 999px; }
    .runtime-controls { display: flex; justify-content: center; align-items: center; gap: 12px; padding: 14px 18px; border-radius: 999px; background: rgba(255,255,255,0.9); box-shadow: 0 12px 24px rgba(15, 23, 42, 0.12); width: fit-content; margin: -40px auto 0; position: relative; flex-wrap: wrap; }
    .runtime-dot { width: 20px; height: 20px; border-radius: 50%; background: #d0d5dd; }
    .runtime-dot.is-live { width: 42px; height: 42px; background: #ffffff; border: 2px solid #d0d5dd; }
    .runtime-sidebar h3 { margin: 0; color: #162033; }
    .runtime-question, .runtime-message { padding: 14px 16px; border-radius: 16px; border: 1px solid rgba(255, 122, 26, 0.35); background: #fff9f3; color: #a15c00; line-height: 1.6; }
    .runtime-message.is-info { background: #eef4ff; color: #0f5bd7; border-color: #c9dafd; }
    .runtime-conversation { display: grid; gap: 12px; align-content: start; }
    .turn-card { padding: 14px 16px; border: 1px solid rgba(15, 23, 42, 0.08); border-radius: 18px; background: #fff; }
    .turn-question { font-weight: 700; color: #162033; margin-bottom: 8px; }
    .turn-answer { color: #334155; margin-bottom: 8px; white-space: pre-wrap; }
    .turn-meta { color: #667085; font-size: 13px; display: flex; gap: 12px; flex-wrap: wrap; }
    .runtime-answer textarea { width: 100%; min-height: 120px; padding: 14px 16px; border: 1px solid rgba(15, 23, 42, 0.08); border-radius: 16px; resize: vertical; }
    .runtime-actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
    .button-1, .button-2 { border-radius: 999px; padding: 10px 20px; font-weight: 600; min-height: 44px; min-width: 120px; cursor: pointer; transition: all 0.2s ease; border: none; }
    .button-1 { background: #0f5bd7; color: #fff; border: 1px solid #0f5bd7; }
    .button-1:hover:not(:disabled) { background: #0d4eb8; border-color: #0d4eb8; }
    .button-2 { background: #eef4ff; color: #0f5bd7; border: 1px solid #c9dafd; }
    .button-2:hover:not(:disabled) { background: #dce7fa; }
    .button-1:disabled, .button-2:disabled { opacity: 0.6; cursor: not-allowed; }
    .button-1.is-loading, .button-2.is-loading { opacity: 0.8; cursor: wait; }
    .runtime-status { min-height: 24px; font-weight: 600; }
    .runtime-status.message-error { color: #b42318; }
    .runtime-status.message-success { color: #027a48; }
    .runtime-transcript { display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.45); z-index: 9999; padding: 24px; }
    .runtime-transcript.is-open { display: grid; place-items: center; }
    .runtime-transcript-card { width: min(900px, 100%); max-height: 80vh; overflow: auto; background: #fff; border-radius: 20px; padding: 20px; }
    .runtime-meter { display: flex; align-items: end; gap: 4px; height: 34px; }
    .runtime-meter span { width: 8px; height: 8px; border-radius: 999px; background: #cbd5e1; transition: height .15s ease, background .15s ease; }
    @@media (max-width: 1024px) { .runtime-layout { grid-template-columns: 1fr; } }
</style>

<div class="runtime-shell">
    <div class="runtime-page">
        <div class="runtime-topbar">
            <button type="button" id="stop-interview-top" class="button-2">Stop Interview</button>
            <h1>@Model.ProductName - @Model.Difficulty</h1>
            <div class="runtime-meta">
                <span id="runtime-timer">00:00</span>
                <button type="button" id="open-transcript" class="button-2">Transcript</button>
            </div>
        </div>

        <div class="runtime-progress"><span id="runtime-progress-bar"></span></div>

        <div class="runtime-layout">
            <section class="runtime-stage">
                <div class="runtime-video">
                    <div id="runtime-log" style="position: absolute; top: 12px; left: 12px; z-index: 10; background: rgba(255,255,255,0.85); border-radius: 8px; padding: 8px; font-size: 11px; max-width: 250px; max-height: 200px; overflow-y: auto; text-align: left;">
                        <div style="font-weight: 700; color: #333; margin-bottom: 4px;">Runtime Log</div>
                        <div id="runtime-log-body"></div>
                    </div>
                    <video id="runtime-video" autoplay playsinline muted></video>
                    <span id="camera-placeholder">Camera Off</span>
                    <div class="runtime-avatar"></div>
                </div>
                <div class="runtime-controls">
                    <span class="runtime-dot is-live"></span>
                    <span class="runtime-dot"></span>
                    <button type="button" id="toggle-camera" class="button-2">Camera On</button>
                    <button type="button" id="toggle-mic" class="button-2">Mic On</button>
                    <button type="button" id="toggle-recording" class="button-2">Recording Ready</button>
                    <button type="button" id="start-or-next" class="button-1">Start Interview</button>
                    <span class="runtime-dot"></span>
                    <span class="runtime-dot"></span>
                </div>
                <div class="runtime-status" id="recording-status"></div>
                @if (Model.IsMockMode)
                {
                    <div class="runtime-status message-info" style="color: #0f5bd7; text-align: center; margin-top: 10px; font-size: 13px; font-weight: 700;">
                        Development mock mode is enabled. Azure OpenAI is bypassed.
                    </div>
                }
                <div class="runtime-meter" id="audio-meter" aria-label="microphone level">
                    <span></span><span></span><span></span><span></span><span></span><span></span>
                </div>
            </section>

            <aside class="runtime-sidebar">
                <h3>Conversations</h3>
                <div id="runtime-question" class="runtime-question">@(string.IsNullOrWhiteSpace(Model.CurrentQuestion) ? "Welcome! Click Start Interview to begin." : Model.CurrentQuestion)</div>
                <div id="runtime-message" class="runtime-message is-info">Start the interview to load the first question.</div>

                <div class="runtime-conversation" id="conversation"></div>

                <div class="runtime-answer">
                    <textarea id="runtime-answer" placeholder="Enter your answer here..."></textarea>
                </div>

                <div class="runtime-actions">
                    <button type="button" id="submit-answer" class="button-1">Submit Answer</button>
                    <button type="button" id="stop-interview" class="button-2">Stop Interview</button>
                    <button type="button" id="view-report" class="button-2" style="display:none;">View Report</button>
                </div>

                <div id="runtime-status" class="runtime-status"></div>
                <div id="runtime-completion" class="runtime-message is-info" style="display:none;"></div>
            </aside>
        </div>
    </div>
</div>

<div id="runtime-transcript" class="runtime-transcript">
    <div class="runtime-transcript-card">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;">
            <h3 style="margin:0;">Transcript</h3>
            <button type="button" id="close-transcript" class="button-2">Close</button>
        </div>
        <div id="transcript-body" style="margin-top:16px;display:grid;gap:12px;"></div>
    </div>
</div>

<script asp-location="Footer">
    (() => {
        const config = @Html.Raw(clientSettings);
        console.log("Settings Config")
        console.log(config)
        const turns = @Html.Raw(turns);
        let sessionToken = config.token || '@Model.Token';
        let tokenExpiryUtc = config.tokenExpiryUtc ? new Date(config.tokenExpiryUtc) : null;
        const answerBox = document.getElementById('runtime-answer');
        const questionBox = document.getElementById('runtime-question');
        const messageBox = document.getElementById('runtime-message');
        const statusBox = document.getElementById('runtime-status');
        const completionBox = document.getElementById('runtime-completion');
        const transcript = document.getElementById('runtime-transcript');
        const transcriptBody = document.getElementById('transcript-body');
        const conversation = document.getElementById('conversation');
        const progressBar = document.getElementById('runtime-progress-bar');
        const video = document.getElementById('runtime-video');
        const cameraPlaceholder = document.getElementById('camera-placeholder');
        const recordingStatus = document.getElementById('recording-status');
        const recordingButton = document.getElementById('toggle-recording');
        const audioMeter = Array.from(document.querySelectorAll('#audio-meter span'));
        const reportButton = document.getElementById('view-report');
        let cameraStream = null;
        let micStream = null;
        let analyser = null;
        let audioContext = null;
        let meterFrame = null;
        let tokenRefreshTimer = null;
        let speechRecognizer = null;
        let speechSdkLoading = null;
        let speechSdkLoaded = false;
        let mediaRecorder = null;
        let recordingChunks = [];
        let recordingMimeType = 'video/webm';
        let recordingEnabled = false;
        let recordingUploadInFlight = false;
        let tokenRefreshInFlight = false;
        let interviewStarted = false;
        let completedRedirectTimer = null;
        let completedCountdown = null;

        let silenceTimer = null;
        let reminderTimer = null;
        let isSpeakingOrSubmitting = false;
        let isSubmittingAnswer = false;

        const resetTimers = () => {
            clearTimeout(silenceTimer);
            clearTimeout(reminderTimer);
            if (!interviewStarted || isSpeakingOrSubmitting) return;

            const text = (answerBox.value || '').trim();
            if (text) {
                logActivity('Timer scheduled for auto-submit.');
                silenceTimer = setTimeout(() => {
                    const submitText = (answerBox.value || '').trim();
                    if (!submitText) {
                        logActivity('Auto-submit skipped; answer is empty.');
                        reminderTimer = setTimeout(() => showReminder(), 0);
                        return;
                    }

                    logActivity('Auto-submitting answer due to silence.');
                    submitAnswer({ auto: true });
                }, 5000);
            } else {
                logActivity('Timer scheduled for silence reminder.');
                reminderTimer = setTimeout(async () => await showReminder(), 5000);
            }
        };

        answerBox.addEventListener('input', resetTimers);

        recordingEnabled = !!config.recordingAvailable;
        if (recordingButton) {
            recordingButton.disabled = !config.recordingAvailable;
            recordingButton.textContent = config.recordingAvailable ? 'Recording Ready' : 'Recording Unavailable';
        }

        const loadScriptOnce = (src) => {
            return new Promise((resolve, reject) => {
                const existing = document.querySelector(`script[data-ai-src="${src}"]`);
                if (existing) {
                    existing.dataset.loaded === 'true' ? resolve() : existing.addEventListener('load', () => resolve(), { once: true });
                    return;
                }

                const script = document.createElement('script');
                script.src = src;
                script.async = true;
                script.dataset.aiSrc = src;
                script.onload = () => {
                    script.dataset.loaded = 'true';
                    resolve();
                };
                script.onerror = () => reject(new Error(`Failed to load ${src}`));
                document.head.appendChild(script);
            });
        };

        const setStatus = (message, isError) => {
            statusBox.textContent = message || '';
            statusBox.className = `runtime-status ${isError ? 'message-error' : 'message-success'}`;
        };

        const setRecordingStatus = (message, isError) => {
            if (!recordingStatus)
                return;

            recordingStatus.textContent = message || '';
            recordingStatus.className = `runtime-status ${isError ? 'message-error' : 'message-success'}`;
        };

        const logActivity = (msg) => {
            console.debug(`[AIInterview Runtime] ${msg}`);
            const logPanel = document.getElementById('runtime-log-body');
            if (logPanel) {
                const p = document.createElement('p');
                p.textContent = `[${new Date().toLocaleTimeString()}] ${msg}`;
                p.style.margin = '4px 0';
                p.style.fontSize = '12px';
                p.style.color = '#334155';
                logPanel.prepend(p);
            }
        };

        const getValue = (result, camel, pascal) => {
            if (!result) return null;
            if (camel in result) return result[camel];
            if (pascal in result) return result[pascal];
            return null;
        };

        const isSuccess = (result) => {
            return getValue(result, "success", "Success") === true;
        };

        const getRuntimeMessage = (result, fallback) => {
            return getValue(result, "message", "Message") || getValue(result, "error", "Error") || fallback;
        };

        logActivity('Runtime initialized.');

        if (config.recordingAvailable)
            setRecordingStatus('Recording waiting for camera or mic.', false);
        else
            setRecordingStatus('Recording unavailable.', false);

        const isPlaceholderSpeechText = (text) => {
            const normalized = (text || '').trim();
            return !normalized
                || normalized === 'Welcome! Click Start Interview to begin.'
                || normalized === 'AI service unavailable.';
        };

        const applyTokenUpdate = (result) => {
            const newToken = getValue(result, 'newToken', 'NewToken');
            if (!newToken)
                return;

            sessionToken = newToken;
            config.token = newToken;
            const expiry = getValue(result, 'tokenExpiryUtc', 'TokenExpiryUtc');
            tokenExpiryUtc = expiry ? new Date(expiry) : tokenExpiryUtc;
            scheduleTokenRefresh();
        };

        const isTokenRefreshNeeded = () => {
            if (!config.refreshTokenUrl || !sessionToken)
                return false;

            if (!tokenExpiryUtc || isNaN(tokenExpiryUtc.getTime()))
                return true;

            return (tokenExpiryUtc.getTime() - Date.now()) <= 120000;
        };

        const refreshTokenWithRetry = async (attempt = 0) => {
            if (!config.refreshTokenUrl || !sessionToken || tokenRefreshInFlight)
                return false;

            tokenRefreshInFlight = true;
            try {
                const result = await postForm(config.refreshTokenUrl, new URLSearchParams({ token: sessionToken }));
                const newToken = getValue(result, 'newToken', 'NewToken');
                if (result && isSuccess(result) && newToken) {
                    logActivity('Session token refreshed.');
                    applyTokenUpdate(result);
                    return true;
                }

                if (attempt < 2 && isTokenRefreshNeeded()) {
                    const backoff = (attempt + 1) * 1500;
                    logActivity(`Token refresh retry scheduled in ${backoff / 1000}s.`);
                    setTimeout(() => refreshTokenWithRetry(attempt + 1), backoff);
                    return false;
                }

                if (tokenExpiryUtc && tokenExpiryUtc.getTime() <= Date.now()) {
                    setStatus('Unable to continue the interview right now. Please reload and try again.', true);
                }

                return false;
            } finally {
                tokenRefreshInFlight = false;
            }
        };

        const ensureRuntimeTokenFresh = async () => {
            if (!isTokenRefreshNeeded())
                return true;

            const expired = tokenExpiryUtc && !isNaN(tokenExpiryUtc.getTime()) && tokenExpiryUtc.getTime() <= Date.now();
            const refreshed = await refreshTokenWithRetry();
            if (!refreshed && expired) {
                logActivity('Token refresh failed for expired session token.');
                setStatus('Unable to continue the interview right now. Please reload and try again.', true);
                return false;
            }

            return true;
        };

        const showReminder = async () => {
            if (!interviewStarted || isSpeakingOrSubmitting)
                return;

            logActivity('Reminder shown.');
            setStatus('Please answer the question.', false);
            if (config.speechAvailable) {
                try {
                    await speakText('Please answer the question.', 'reminder');
                } catch {
                    logActivity('Reminder speech failed.');
                }
            }

            const currentText = (answerBox.value || '').trim();
            if (!currentText && interviewStarted && !isSpeakingOrSubmitting)
                resetTimers();
        };

        const setCompletedState = async (result) => {
            const reportUrl = getValue(result, 'reportUrl', 'ReportUrl') || config.reportUrl || '';
            const completionText = getValue(result, 'completion', 'Completion') || getValue(result, 'message', 'Message') || 'Interview completed.';
            clearTimeout(silenceTimer);
            clearTimeout(reminderTimer);
            isSpeakingOrSubmitting = true;
            await stopRecording(true);
            recordingEnabled = false;
            interviewStarted = false;
            if (recordingButton)
                recordingButton.disabled = true;
            cameraStream?.getTracks().forEach(track => track.stop());
            micStream?.getTracks().forEach(track => track.stop());
            cameraStream = null;
            micStream = null;
            audioContext?.close?.();
            audioContext = null;
            analyser = null;
            meterFrame && cancelAnimationFrame(meterFrame);
            meterFrame = null;
            video.srcObject = null;
            video.style.display = 'none';
            cameraPlaceholder.style.display = '';
            document.getElementById('toggle-camera').textContent = 'Camera On';
            document.getElementById('toggle-mic').textContent = 'Mic On';
            audioMeter.forEach(bar => { bar.style.height = '8px'; bar.style.background = '#cbd5e1'; });
            await stopSpeechRecognition();
            questionBox.textContent = completionText;
            messageBox.textContent = result.feedback || result.message || '';
            completionBox.style.display = '';
            completionBox.textContent = reportUrl
                ? `${completionText} You can open the report below, or you will be redirected shortly.`
                : completionText;
            answerBox.disabled = true;
            document.getElementById('submit-answer').disabled = true;
            document.getElementById('start-or-next').disabled = true;
            document.getElementById('start-or-next').textContent = 'Completed';
            if (reportUrl) {
                reportButton.style.display = 'inline-flex';
                reportButton.onclick = () => window.location.href = reportUrl;
                let remaining = 5;
                clearInterval(completedCountdown);
                clearTimeout(completedRedirectTimer);
                completedCountdown = setInterval(() => {
                    if (remaining <= 0) return;
                    completionBox.textContent = `${completionText} Redirecting to report in ${remaining}s.`;
                    remaining -= 1;
                }, 1000);
                completedRedirectTimer = setTimeout(() => {
                    clearInterval(completedCountdown);
                    window.location.href = reportUrl;
                }, 5000);
            } else {
                reportButton.style.display = 'none';
            }
            clearTimeout(tokenRefreshTimer);
        };

        const buildTurnCard = (turn, index) => {
            const card = document.createElement('div');
            card.className = 'turn-card';

            const question = document.createElement('div');
            question.className = 'turn-question';
            question.textContent = `Q${turn.sequenceNumber || index + 1}. ${turn.questionText || ''}`;

            const answer = document.createElement('div');
            answer.className = 'turn-answer';
            if (turn.answerText) {
                answer.textContent = turn.answerText;
            } else {
                const pending = document.createElement('em');
                pending.textContent = 'Awaiting answer...';
                answer.appendChild(pending);
            }

            const meta = document.createElement('div');
            meta.className = 'turn-meta';

            const score = document.createElement('span');
            score.textContent = `Score: ${turn.score ?? '-'}`;
            const feedback = document.createElement('span');
            feedback.textContent = turn.feedback || '';

            meta.appendChild(score);
            meta.appendChild(feedback);
            card.appendChild(question);
            card.appendChild(answer);
            card.appendChild(meta);
            return card;
        };

        const renderTranscript = () => {
            transcriptBody.replaceChildren();
            conversation.replaceChildren();
            (turns || []).forEach((turn, index) => {
                const conversationCard = buildTurnCard(turn, index);
                const transcriptCard = buildTurnCard(turn, index);
                conversation.appendChild(conversationCard);
                transcriptBody.appendChild(transcriptCard);
            });

            const answered = (turns || []).filter(turn => turn.answerText).length;
            const progress = Math.min(100, Math.max(0, (answered / Math.max(1, turns.length)) * 100));
            progressBar.style.width = `${progress}%`;
        };

        const timerStartedAt = Date.now();
        setInterval(() => {
            const elapsedSeconds = Math.floor((Date.now() - timerStartedAt) / 1000);
            const minutes = String(Math.floor(elapsedSeconds / 60)).padStart(2, '0');
            const seconds = String(elapsedSeconds % 60).padStart(2, '0');
            document.getElementById('runtime-timer').textContent = `${minutes}:${seconds}`;
        }, 1000);

        const postForm = async (url, formData) => {
            logActivity(`Request started: ${url}`);
            try {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: formData
                });

                if (!response.ok) {
                    const text = await response.text();
                    let msg = 'Unable to reach the interview service.';
                    try {
                        const parsed = JSON.parse(text);
                        msg = getRuntimeMessage(parsed, msg);
                    } catch {}
                    console.error(`[AIInterview] Request failed: ${url} (Status: ${response.status}) Body: ${text}`);
                    logActivity(`Request failed (${response.status}): ${msg}`);
                    return { success: false, message: msg, status: response.status };
                }

                try {
                    const result = await response.json();
                    logActivity(`Request success: ${url}`);
                    applyTokenUpdate(result);
                    return result;
                } catch {
                    console.error(`[AIInterview] Request JSON parse failed: ${url}`);
                    logActivity(`Request failed: Invalid JSON response.`);
                    return { success: false, message: 'Invalid response from server.' };
                }
            } catch (e) {
                console.error(`[AIInterview] Request exception: ${url}`, e);
                logActivity(`Request error: ${e.message}`);
                return { success: false, message: 'Unable to reach the interview service. Please check your network and try again.' };
            }
        };

        const postMultipart = async (url, formData) => {
            logActivity(`Multipart request started: ${url}`);
            try {
                const response = await fetch(url, {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) {
                    const text = await response.text();
                    let msg = 'Unable to reach the interview service.';
                    try {
                        const parsed = JSON.parse(text);
                        msg = getRuntimeMessage(parsed, msg);
                    } catch {}
                    console.error(`[AIInterview] Multipart request failed: ${url} (Status: ${response.status}) Body: ${text}`);
                    logActivity(`Multipart request failed (${response.status}): ${msg}`);
                    return { success: false, message: msg, status: response.status };
                }

                const contentType = response.headers.get('content-type') || '';
                if (!contentType.includes('application/json')) {
                    console.error(`[AIInterview] Multipart request non-JSON response: ${url}`);
                    logActivity(`Multipart request failed: non-JSON response.`);
                    return { success: false, message: 'Invalid response format from server.' };
                }

                try {
                    const result = await response.json();
                    logActivity(`Multipart request success: ${url}`);
                    applyTokenUpdate(result);
                    return result;
                } catch {
                    console.error(`[AIInterview] Multipart request JSON parse failed: ${url}`);
                    logActivity(`Multipart request failed: Invalid JSON response.`);
                    return { success: false, message: 'Invalid response from server.' };
                }
            } catch (e) {
                console.error(`[AIInterview] Multipart request exception: ${url}`, e);
                logActivity(`Multipart request error: ${e.message}`);
                return { success: false, message: 'Unable to reach the interview service. Please check your network and try again.' };
            }
        };

        const getActiveRecordingStream = () => {
            const tracks = [];
            const seenTrackIds = new Set();
            if (cameraStream?.getTracks)
                tracks.push(...cameraStream.getTracks().filter(track => track.readyState === 'live' && !seenTrackIds.has(track.id) && seenTrackIds.add(track.id)));
            if (micStream?.getTracks)
                tracks.push(...micStream.getTracks().filter(track => track.readyState === 'live' && !seenTrackIds.has(track.id) && seenTrackIds.add(track.id)));

            return tracks.length ? new MediaStream(tracks) : null;
        };

        const requestRecordingMediaForStart = async () => {
            if (!config.recordingAvailable || !recordingEnabled)
                return false;

            if (getActiveRecordingStream())
                return true;

            if (!navigator.mediaDevices?.getUserMedia) {
                setRecordingStatus('Recording waiting for camera or mic.', false);
                return false;
            }

            await setCamera(true, true);
            if (getActiveRecordingStream()) {
                setRecordingStatus('Recording ready.', false);
                return true;
            }

            await setMic(true, true);
            if (getActiveRecordingStream()) {
                setRecordingStatus('Recording ready.', false);
                return true;
            }

            setRecordingStatus('Recording waiting for camera or mic.', false);
            return false;
        };

        const uploadRecording = async (blob) => {
            if (!config.recordingUploadUrl || !blob || recordingUploadInFlight)
                return;

            recordingUploadInFlight = true;
            logActivity('Uploading recording...');
            try {
                const formData = new FormData();
                formData.append('token', sessionToken);
                formData.append('recording', blob, `interview-${Date.now()}.webm`);

                const result = await postMultipart(config.recordingUploadUrl, formData);
                const recordingUrl = getValue(result, 'recordingUrl', 'RecordingUrl');
                if (isSuccess(result) && recordingUrl) {
                    logActivity('Recording upload success.');
                    setRecordingStatus('Recording uploaded.', false);
                } else {
                    logActivity('Recording upload failure.');
                    setRecordingStatus(getRuntimeMessage(result, 'Recording upload failed.'), true);
                }
            } finally {
                recordingUploadInFlight = false;
            }
        };

        const stopRecording = async (upload = false) => {
            if (!mediaRecorder)
                return;

            const recorder = mediaRecorder;
            const mimeType = recordingMimeType || 'video/webm';
            mediaRecorder = null;

            await new Promise(resolve => {
                recorder.addEventListener('stop', async () => {
                    try {
                        const blob = recordingChunks.length ? new Blob(recordingChunks, { type: mimeType }) : null;
                        recordingChunks = [];
                        if (upload && blob)
                            await uploadRecording(blob);
                    } catch {
                        setRecordingStatus('Recording upload failed.', true);
                    } finally {
                        const toggleRecording = document.getElementById('toggle-recording');
                        if (toggleRecording)
                            toggleRecording.textContent = recordingEnabled ? 'Recording Ready' : 'Recording Off';
                        resolve();
                    }
                }, { once: true });

                try {
                    recorder.stop();
                } catch {
                    recordingChunks = [];
                    resolve();
                }
            });
        };

        const startRecording = async () => {
            if (!config.recordingAvailable || mediaRecorder)
                return;

            const stream = getActiveRecordingStream();
            if (!stream) {
                setRecordingStatus('Enable camera or microphone before recording.', true);
                return;
            }

            if (!window.MediaRecorder) {
                setRecordingStatus('Recording is not supported in this browser.', true);
                return;
            }

            try {
                const options = MediaRecorder.isTypeSupported('video/webm;codecs=vp9,opus')
                    ? { mimeType: 'video/webm;codecs=vp9,opus' }
                    : (MediaRecorder.isTypeSupported('video/webm') ? { mimeType: 'video/webm' } : {});
                mediaRecorder = new MediaRecorder(stream, options);
                recordingMimeType = mediaRecorder.mimeType || options.mimeType || 'video/webm';
                recordingChunks = [];
                mediaRecorder.addEventListener('dataavailable', event => {
                    if (event.data && event.data.size > 0)
                        recordingChunks.push(event.data);
                });
                mediaRecorder.start(1000);
                setRecordingStatus('Recording live.', false);
                const toggleRecording = document.getElementById('toggle-recording');
                if (toggleRecording)
                    toggleRecording.textContent = 'Recording Live';
            } catch {
                mediaRecorder = null;
                recordingChunks = [];
                setRecordingStatus('Recording could not be started.', true);
            }
        };

        const syncRecording = async () => {
            if (!config.recordingAvailable)
                return;

            if (recordingEnabled && interviewStarted && getActiveRecordingStream())
                await startRecording();
            else if (!getActiveRecordingStream() && recordingEnabled)
                setRecordingStatus('Recording waiting for camera or mic.', false);
        };

        const scheduleTokenRefresh = () => {
            clearTimeout(tokenRefreshTimer);
            if (!config.refreshTokenUrl || !tokenExpiryUtc || isNaN(tokenExpiryUtc.getTime()))
                return;

            const refreshAt = tokenExpiryUtc.getTime() - Date.now() - 120000;
            if (refreshAt <= 0) {
                refreshTokenWithRetry();
                return;
            }

            tokenRefreshTimer = setTimeout(() => refreshTokenWithRetry(), refreshAt);
        };

        const ensureSpeechSdk = async () => {
            if (!config.speechAvailable)
                return false;
            if (window.SpeechSDK)
                return true;
            if (speechSdkLoading)
                return speechSdkLoading;

            speechSdkLoading = loadScriptOnce('https://cdn.jsdelivr.net/npm/microsoft-cognitiveservices-speech-sdk@latest/distrib/browser/microsoft.cognitiveservices.speech.sdk.bundle-min.js')
                .then(() => {
                    speechSdkLoaded = !!window.SpeechSDK;
                    return speechSdkLoaded;
                })
                .catch(() => {
                    speechSdkLoaded = false;
                    return false;
                });
            return speechSdkLoading;
        };


        const stopSpeechRecognition = async () => {
            if (!speechRecognizer)
                return;

            await new Promise(resolve => {
                try {
                    speechRecognizer.stopContinuousRecognitionAsync(() => {
                        speechRecognizer.close();
                        speechRecognizer = null;
                        resolve();
                    }, () => {
                        speechRecognizer.close();
                        speechRecognizer = null;
                        resolve();
                    });
                } catch {
                    speechRecognizer = null;
                    resolve();
                }
            });
        };

        const requestSpeechToken = async () => {
            if (!await ensureRuntimeTokenFresh())
                return null;

            const tokenResult = await postForm(config.speechTokenUrl, new URLSearchParams({ token: sessionToken }));
            const speechToken = getValue(tokenResult, 'token', 'Token');
            const region = getValue(tokenResult, 'region', 'Region');
            if (!tokenResult || !isSuccess(tokenResult) || !speechToken) {
                return { success: false, message: getRuntimeMessage(tokenResult, 'Speech token service is unavailable.') };
            }

            return { success: true, token: speechToken, region: region };
        };

        const startSpeechRecognition = async () => {
            if (!config.speechAvailable)
                return;
            if (speechRecognizer)
                return;

            if (!(await ensureSpeechSdk())) {
                setStatus('Speech features are unavailable in this browser.', true);
                return;
            }

            const tokenResult = await requestSpeechToken();
            if (!tokenResult || !tokenResult.success) {
                logActivity('Speech token request failure.');
                setStatus(getRuntimeMessage(tokenResult, 'Speech token service is unavailable.'), true);
                return;
            }
            logActivity('Speech token request success.');

            try {
                const speechConfig = SpeechSDK.SpeechConfig.fromAuthorizationToken(tokenResult.token, tokenResult.region);
                speechConfig.speechRecognitionLanguage = 'en-US';
                const audioConfig = SpeechSDK.AudioConfig.fromDefaultMicrophoneInput();
                speechRecognizer = new SpeechSDK.SpeechRecognizer(speechConfig, audioConfig);

                speechRecognizer.recognizing = (_, e) => {
                    resetTimers();
                };

                speechRecognizer.recognized = (_, e) => {
                    if (e.result?.reason === SpeechSDK.ResultReason.RecognizedSpeech && e.result.text) {
                        answerBox.value = `${answerBox.value ? `${answerBox.value.trim()} ` : ''}${e.result.text}`.trim();
                        logActivity('Speech recognized and appended.');
                        resetTimers();
                    }
                };

                speechRecognizer.sessionStarted = () => logActivity('Speech recognition session started.');
                speechRecognizer.sessionStopped = () => logActivity('Speech recognition session stopped.');
                speechRecognizer.canceled = () => {
                    logActivity('Speech recognition canceled.');
                    setStatus('Speech recognition stopped.', false);
                };

                await new Promise((resolve, reject) => {
                    speechRecognizer.startContinuousRecognitionAsync(resolve, reject);
                });
            } catch {
                await stopSpeechRecognition();
                setStatus('Speech recognition could not be started.', true);
            }
        };

        const speakText = async (text, purpose = 'question') => {
            if (!config.speechAvailable || !text || isPlaceholderSpeechText(text))
                return;

            if (!(await ensureSpeechSdk()))
                return;

            if (purpose === 'question')
                logActivity('Speaking question.');
            else if (purpose === 'reminder')
                logActivity('Speaking reminder.');

            isSpeakingOrSubmitting = true;
            clearTimeout(silenceTimer);
            clearTimeout(reminderTimer);

            const tokenResult = await requestSpeechToken();
            if (!tokenResult || !tokenResult.success) {
                const failureReason = tokenResult?.message || 'Speech token service is unavailable.';
                logActivity(`${purpose === 'reminder' ? 'Reminder' : 'Question'} speech failed: ${failureReason}`);
                setStatus(failureReason, true);
                isSpeakingOrSubmitting = false;
                resetTimers();
                return;
            }

            try {
                const speechConfig = SpeechSDK.SpeechConfig.fromAuthorizationToken(tokenResult.token, tokenResult.region);
                const synthesizer = new SpeechSDK.SpeechSynthesizer(speechConfig);
                await new Promise((resolve, reject) => {
                    synthesizer.speakTextAsync(text, () => {
                        synthesizer.close();
                        resolve();
                    }, (result) => {
                        synthesizer.close();
                        reject(new Error(result?.errorDetails || result?.error || 'Speech synthesis failed.'));
                    });
                });
                if (purpose === 'question')
                    logActivity('Question speech completed.');
                else if (purpose === 'reminder')
                    logActivity('Reminder spoken.');
            } catch (error) {
                const reason = error?.message || 'Speech synthesis failed.';
                logActivity(`${purpose === 'reminder' ? 'Reminder' : 'Question'} speech failed: ${reason}`);
                setStatus(purpose === 'reminder' ? 'Reminder speech failed.' : 'Question speech failed.', true);
            } finally {
                isSpeakingOrSubmitting = false;
                resetTimers();
            }
        };

        const setCamera = async (enabled, skipRecordingSync = false) => {
            logActivity(`Camera requested: ${enabled}`);
            if (!navigator.mediaDevices?.getUserMedia) {
                logActivity('Camera unsupported.');
                setStatus('Camera is not supported in this browser.', true);
                return;
            }

            if (!enabled) {
                cameraStream?.getTracks().forEach(track => track.stop());
                cameraStream = null;
                video.style.display = 'none';
                cameraPlaceholder.style.display = '';
                document.getElementById('toggle-camera').textContent = 'Camera On';
                logActivity('Camera stopped.');
                if (recordingEnabled && mediaRecorder)
                    setRecordingStatus('Recording remains enabled. Turn recording off to discard or stop the interview to upload.', false);
                return;
            }

            try {
                cameraStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
                video.srcObject = cameraStream;
                video.style.display = 'block';
                cameraPlaceholder.style.display = 'none';
                document.getElementById('toggle-camera').textContent = 'Camera Off';
                logActivity('Camera started.');
                if (!skipRecordingSync)
                    await syncRecording();
            } catch {
                logActivity('Camera failed to start.');
                setStatus('Camera could not be started.', true);
            }
        };

        const setMic = async (enabled, skipRecordingSync = false) => {
            logActivity(`Mic requested: ${enabled}`);
            if (!navigator.mediaDevices?.getUserMedia) {
                logActivity('Mic unsupported.');
                setStatus('Microphone is not supported in this browser.', true);
                return;
            }

            if (!enabled) {
                micStream?.getTracks().forEach(track => track.stop());
                micStream = null;
                audioContext?.close?.();
                audioContext = null;
                analyser = null;
                audioMeter.forEach(bar => { bar.style.height = '8px'; bar.style.background = '#cbd5e1'; });
                document.getElementById('toggle-mic').textContent = 'Mic On';
                logActivity('Mic stopped.');
                await stopSpeechRecognition();
                if (recordingEnabled && mediaRecorder)
                    setRecordingStatus('Recording remains enabled. Turn recording off to discard or stop the interview to upload.', false);
                return;
            }

            try {
                micStream = await navigator.mediaDevices.getUserMedia({ video: false, audio: true });
                audioContext = new (window.AudioContext || window.webkitAudioContext)();
                const source = audioContext.createMediaStreamSource(micStream);
                analyser = audioContext.createAnalyser();
                analyser.fftSize = 32;
                source.connect(analyser);

                const buffer = new Uint8Array(analyser.frequencyBinCount);
                const updateMeter = () => {
                    if (!analyser)
                        return;
                    analyser.getByteFrequencyData(buffer);
                    const average = buffer.reduce((sum, value) => sum + value, 0) / buffer.length;
                    audioMeter.forEach((bar, index) => {
                        const height = Math.max(8, Math.min(34, average - (index * 2)));
                        bar.style.height = `${height}px`;
                        bar.style.background = height > 18 ? '#0f5bd7' : '#cbd5e1';
                    });
                    meterFrame = requestAnimationFrame(updateMeter);
                };
                updateMeter();
                document.getElementById('toggle-mic').textContent = 'Mic Off';
                logActivity('Mic started.');
                await startSpeechRecognition();
                if (!skipRecordingSync)
                    await syncRecording();
            } catch {
                logActivity('Mic failed to start.');
                setStatus('Microphone could not be started.', true);
            }
        };

        const submitAnswer = async (options = {}) => {
            if (!config.submitAnswerUrl) {
                setStatus('Answer submission is unavailable.', true);
                return;
            }

            const submitBtn = document.getElementById('submit-answer');
            if (submitBtn.disabled || isSubmittingAnswer) return;

            const auto = options.auto === true;
            const trimmedAnswer = (answerBox.value || '').trim();
            if (auto && !trimmedAnswer) {
                logActivity('Auto-submit skipped; answer is empty.');
                setStatus('Please answer the question.', false);
                resetTimers();
                return;
            }

            if (!(await ensureRuntimeTokenFresh())) {
                if (auto)
                    setStatus('Auto submit is unavailable right now.', true);
                return;
            }

            logActivity('Submitting answer...');
            isSpeakingOrSubmitting = true;
            isSubmittingAnswer = true;
            clearTimeout(silenceTimer);
            clearTimeout(reminderTimer);
            submitBtn.disabled = true;
            submitBtn.classList.add('is-loading');
            const originalText = submitBtn.textContent;
            submitBtn.textContent = auto ? 'Auto submitting...' : 'Submitting...';

            const body = new URLSearchParams({ token: sessionToken, answer: trimmedAnswer });
            const result = await postForm(config.submitAnswerUrl, body);

            submitBtn.disabled = false;
            submitBtn.classList.remove('is-loading');
            submitBtn.textContent = originalText;
            isSpeakingOrSubmitting = false;
            isSubmittingAnswer = false;

            if (!isSuccess(result)) {
                logActivity('Submit response failure: ' + getRuntimeMessage(result, 'Unable to submit answer.'));
                setStatus(getRuntimeMessage(result, 'Unable to submit answer.'), true);
                resetTimers();
                return;
            }
            logActivity('Submit response success: ' + getRuntimeMessage(result, 'Answer saved.'));

            const currentTurn = getValue(result, "turn", "Turn") || turns[turns.length - 1];
            if (currentTurn) {
                const targetIndex = turns.findIndex(turn => turn.turnId && currentTurn.turnId && turn.turnId === currentTurn.turnId);
                if (targetIndex >= 0)
                    turns[targetIndex] = currentTurn;
                else if (turns.length > 0)
                    turns[turns.length - 1] = currentTurn;
                else
                    turns.push(currentTurn);
            }

            const isTerminated = getValue(result, "isTerminated", "IsTerminated");
            const resultQuestion = getValue(result, "question", "Question");
            const resultMessage = getRuntimeMessage(result, '');
            const resultFeedback = getValue(result, "feedback", "Feedback");
            const resultCompletion = getValue(result, "completion", "Completion");

            if (!isTerminated && resultQuestion) {
                turns.push({
                    turnId: Date.now(),
                    sequenceNumber: (currentTurn?.sequenceNumber || turns.length) + 1,
                    questionText: resultQuestion,
                    answerText: '',
                    score: null,
                    feedback: '',
                    askedOnUtc: new Date().toISOString(),
                    answeredOnUtc: null
                });
            }

            questionBox.textContent = isTerminated ? (resultCompletion || 'Interview completed.') : resultQuestion;
            if (!isTerminated && resultQuestion) logActivity('Question shown: ' + resultQuestion);
            messageBox.textContent = resultMessage || resultFeedback || '';
            setStatus(resultFeedback || resultMessage || 'Answer saved.', false);
            answerBox.value = '';
            renderTranscript();

            if (isTerminated) {
                await setCompletedState(result);
                return;
            }

            document.getElementById('start-or-next').textContent = 'Next Question';
            if (config.speechAvailable && !isPlaceholderSpeechText(resultQuestion))
                await speakText(resultQuestion, 'question');
            else
                resetTimers();
        };

        const stopInterview = async () => {
            if (!config.stopInterviewUrl) {
                setStatus('Stop endpoint is unavailable.', true);
                return;
            }

            const stopBtn = document.getElementById('stop-interview');
            const stopTopBtn = document.getElementById('stop-interview-top');
            if (stopBtn && stopBtn.disabled) return;

            if (!(await ensureRuntimeTokenFresh()))
                return;

            logActivity('Stopping interview...');
            let originalText = '';
            if (stopBtn) {
                originalText = stopBtn.textContent;
                stopBtn.disabled = true;
                stopBtn.classList.add('is-loading');
                stopBtn.textContent = 'Stopping...';
            }
            if (stopTopBtn) {
                stopTopBtn.disabled = true;
                stopTopBtn.classList.add('is-loading');
                stopTopBtn.textContent = 'Stopping...';
            }

            const body = new URLSearchParams({ token: sessionToken });
            const result = await postForm(config.stopInterviewUrl, body);

            if (!isSuccess(result)) {
                if (stopBtn) {
                    stopBtn.disabled = false;
                    stopBtn.classList.remove('is-loading');
                    stopBtn.textContent = originalText;
                }
                if (stopTopBtn) {
                    stopTopBtn.disabled = false;
                    stopTopBtn.classList.remove('is-loading');
                    stopTopBtn.textContent = originalText;
                }

                logActivity('Stop response failure: ' + getRuntimeMessage(result, 'Unable to stop interview.'));
                setStatus(getRuntimeMessage(result, 'Unable to stop interview.'), true);
                return;
            }

            if (stopBtn) stopBtn.classList.remove('is-loading');
            if (stopTopBtn) stopTopBtn.classList.remove('is-loading');
            logActivity('Stop response success: ' + getRuntimeMessage(result, 'Interview completed.'));
            setStatus(getRuntimeMessage(result, 'Interview completed.'), false);
            renderTranscript();
            await setCompletedState(result);
            clearTimeout(silenceTimer);
            clearTimeout(reminderTimer);
        };

        const beginInterview = async () => {
            logActivity('Interview started clicked.');
            interviewStarted = true;
            setStatus('Interview started.', false);
            document.getElementById('start-or-next').textContent = 'Next Question';
            if (!(await ensureRuntimeTokenFresh())) {
                setStatus('Interview token refresh failed.', true);
                interviewStarted = false;
                return;
            }
            if (config.recordingAvailable && recordingEnabled)
                await requestRecordingMediaForStart();
            await syncRecording();
            if (questionBox.textContent) logActivity('Question shown: ' + questionBox.textContent);
            if (config.speechAvailable && !isPlaceholderSpeechText(questionBox.textContent))
                await speakText(questionBox.textContent, 'question');
            else
                resetTimers();
        };

        document.getElementById('submit-answer').addEventListener('click', submitAnswer);
        document.getElementById('start-or-next').addEventListener('click', beginInterview);
        document.getElementById('toggle-camera').addEventListener('click', async () => await setCamera(!cameraStream));
        document.getElementById('toggle-mic').addEventListener('click', async () => await setMic(!micStream));
        if (recordingButton) {
            recordingButton.addEventListener('click', async () => {
                if (!config.recordingAvailable)
                    return;

                recordingEnabled = !recordingEnabled;
                if (!recordingEnabled) {
                    await stopRecording(false);
                    setRecordingStatus('Recording disabled.', false);
                } else {
                    recordingButton.textContent = 'Recording Ready';
                    setRecordingStatus('Recording ready.', false);
                    await syncRecording();
                }
            });
        }
        document.getElementById('stop-interview').addEventListener('click', stopInterview);
        document.getElementById('stop-interview-top').addEventListener('click', stopInterview);
        document.getElementById('open-transcript').addEventListener('click', () => transcript.classList.add('is-open'));
        document.getElementById('close-transcript').addEventListener('click', () => transcript.classList.remove('is-open'));

        renderTranscript();
        scheduleTokenRefresh();
    })();
</script>
