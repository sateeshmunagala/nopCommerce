        const runtimeTabs = Array.from(document.querySelectorAll('[data-runtime-tab]'));
        const runtimePanels = Array.from(document.querySelectorAll('[data-runtime-panel]'));

        const setButtonLabel = (button, text) => {
            if (!button)
                return;

            button.textContent = text;
        };

        const createClientEventId = () => {
            if (window.crypto?.randomUUID)
                return window.crypto.randomUUID();

            return `speech-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
        };

        const readLocalStorageValue = (key) => {
            try {
                return window.localStorage?.getItem(key) || '';
            } catch {
                return '';
            }
        };

        const writeLocalStorageValue = (key, value) => {
            try {
                if (!window.localStorage)
                    return;

                if (value)
                    window.localStorage.setItem(key, value);
                else
                    window.localStorage.removeItem(key);
            } catch {}
        };

        const finalCompletionSpeechStorageKey = 'aiinterview.runtime.finalCompletionSpeech.@Model.SessionId';
        finalCompletionSpoken = readLocalStorageValue(finalCompletionSpeechStorageKey) === '1';

        const isPseudoAudioDeviceId = (deviceId) => {
            const normalized = (deviceId || '').toLowerCase();
            return normalized === 'default' || normalized === 'communications';
        };

        const loadPersistedAudioDeviceSelections = () => {
            selectedAudioInputId = readLocalStorageValue(audioInputStorageKey);
            selectedAudioOutputId = readLocalStorageValue(audioOutputStorageKey);

            if (isPseudoAudioDeviceId(selectedAudioInputId)) {
                selectedAudioInputId = '';
                writeLocalStorageValue(audioInputStorageKey, '');
            }

            if (isPseudoAudioDeviceId(selectedAudioOutputId)) {
                selectedAudioOutputId = '';
                writeLocalStorageValue(audioOutputStorageKey, '');
            }
        };

        const setAudioDeviceStatus = (message = '', isWarning = false) => {
            if (audioDeviceStatus)
                audioDeviceStatus.textContent = isWarning ? '' : message;
            if (isWarning)
                setRuntimeWarning(message);
        };

        const setAudioDevicePanelOpen = (open) => {
            audioDevicePanelOpen = open;
            audioDevicePanel?.classList.toggle('runtime-js-hidden', !open);
            audioDeviceToggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
        };

        const setSelectOptions = (select, devices, defaultLabel, itemLabelPrefix, selectedId) => {
            if (!select)
                return;

            const previousValue = selectedId || '';
            select.replaceChildren();
            const defaultOption = document.createElement('option');
            defaultOption.value = '';
            defaultOption.textContent = defaultLabel;
            select.appendChild(defaultOption);

            devices
                .filter(device => device.deviceId)
                .forEach((device, index) => {
                    const option = document.createElement('option');
                    option.value = device.deviceId;
                    option.textContent = device.label || `${itemLabelPrefix} ${index + 1}`;
                    select.appendChild(option);
                });

            select.value = Array.from(select.options).some(option => option.value === previousValue)
                ? previousValue
                : '';
        };

        const isPseudoAudioDevice = (device) => {
            const label = (device?.label || '').trim().toLowerCase();

            if (isPseudoAudioDeviceId(device?.deviceId))
                return true;

            return label === 'default'
                || label === 'communications'
                || label.startsWith('default -')
                || label.startsWith('communications -');
        };

        const hasPermissionBackedAudioDeviceList = (devices) => devices.some(device => {
            const deviceId = device.deviceId || '';
            return !!device.label || (!!deviceId && deviceId !== 'default' && deviceId !== 'communications');
        });

        const hasOnlyUnlabeledAudioDevices = (devices) => devices.length > 0
            && devices.every(device => !(device.label || '').trim());

        const getSelectedAudioInputConstraints = () => {
            if (!selectedAudioInputId)
                return true;

            return { deviceId: { exact: selectedAudioInputId } };
        };

        const isSelectedAudioInputFailure = (error) => {
            const name = error?.name || '';
            const message = error?.message || '';
            return name === 'OverconstrainedError'
                || name === 'ConstraintNotSatisfiedError'
                || name === 'NotFoundError'
                || /device|constraint|not found|not available/i.test(message);
        };

        const refreshAudioDevices = async () => {
            if (!navigator.mediaDevices?.enumerateDevices) {
                audioInputSelect && (audioInputSelect.disabled = true);
                audioOutputSelect && (audioOutputSelect.disabled = true);
                setAudioDeviceStatus('Audio device selection is not supported in this browser.', true);
                return;
            }

            try {
                const devices = await navigator.mediaDevices.enumerateDevices();
                availableAudioInputs = devices
                    .filter(device => device.kind === 'audioinput')
                    .filter(device => !isPseudoAudioDevice(device));
                availableAudioOutputs = devices
                    .filter(device => device.kind === 'audiooutput')
                    .filter(device => !isPseudoAudioDevice(device));
                const inputListCanConfirmAvailability = hasPermissionBackedAudioDeviceList(availableAudioInputs);

                const inputStillAvailable = !selectedAudioInputId
                    || availableAudioInputs.some(device => device.deviceId === selectedAudioInputId);
                if (!inputStillAvailable && inputListCanConfirmAvailability) {
                    selectedAudioInputId = '';
                    writeLocalStorageValue(audioInputStorageKey, '');
                    setAudioDeviceStatus('Selected microphone unavailable. Using default microphone.', true);
                }

                const outputStillAvailable = !selectedAudioOutputId
                    || availableAudioOutputs.some(device => device.deviceId === selectedAudioOutputId);
                if (!outputStillAvailable) {
                    selectedAudioOutputId = '';
                    writeLocalStorageValue(audioOutputStorageKey, '');
                    setAudioDeviceStatus('Using browser default speaker.');
                }

                setSelectOptions(audioInputSelect, availableAudioInputs, 'Default microphone', 'Microphone', selectedAudioInputId);
                setSelectOptions(audioOutputSelect, availableAudioOutputs, 'Default speaker', 'Speaker', selectedAudioOutputId);

                if (audioInputSelect)
                    audioInputSelect.disabled = false;
                if (audioOutputSelect)
                    audioOutputSelect.disabled = !supportsAudioOutputSelection;

                const currentStatus = (audioDeviceStatus?.textContent || '').trim();
                if (!supportsAudioOutputSelection && !currentStatus)
                    setAudioDeviceStatus('Speaker selection is not supported in this browser.', true);
                else if (supportsAudioOutputSelection && !availableAudioOutputs.some(device => device.deviceId) && !currentStatus)
                    setAudioDeviceStatus('Using browser default speaker.');
                else if (hasOnlyUnlabeledAudioDevices(availableAudioInputs) && !isMicActive() && !currentStatus)
                    setAudioDeviceStatus('Allow microphone access to show device names.', true);
                else if (!currentStatus)
                    setAudioDeviceStatus(selectedAudioOutputId ? 'Speaker selected.' : 'Using browser default speaker.');
            } catch (error) {
                logActivity(`Audio device enumeration failed. reason=${error?.message || error?.name || 'unknown'}`);
                setAudioDeviceStatus('Audio devices unavailable.', true);
            }
        };

        const ensureSpeechAudioElement = () => {
            if (speechAudioElement)
                return speechAudioElement;

            speechAudioElement = document.createElement('audio');
            speechAudioElement.preload = 'auto';
            speechAudioElement.className = 'runtime-js-hidden';
            speechAudioElement.setAttribute('aria-hidden', 'true');
            document.body.appendChild(speechAudioElement);
            return speechAudioElement;
        };

        const applySelectedAudioOutput = async (audioElement) => {
            if (!audioElement || !supportsAudioOutputSelection)
                return false;

            try {
                await audioElement.setSinkId(selectedAudioOutputId || '');
                setAudioDeviceStatus(selectedAudioOutputId ? 'Speaker selected.' : 'Using browser default speaker.');
                return true;
            } catch (error) {
                logActivity(`Speaker output selection failed. reason=${error?.message || error?.name || 'unknown'}`);
                selectedAudioOutputId = '';
                writeLocalStorageValue(audioOutputStorageKey, '');
                if (audioOutputSelect)
                    audioOutputSelect.value = '';
                setAudioDeviceStatus('Using browser default speaker.');
                return false;
            }
        };

        const getLiveTracks = (stream, kind = '') => stream?.getTracks?.()
            .filter(track => track.readyState === 'live' && (!kind || track.kind === kind)) || [];

        const createSingleKindStream = (stream, kind) => {
            const tracks = getLiveTracks(stream, kind);
            return tracks.length ? new MediaStream(tracks) : null;
        };

        const hasLiveAudioTrack = (stream) => getLiveTracks(stream, 'audio').length > 0;

        const hasSpeechAudioSource = () => !!(speechAudioElement?.currentSrc || speechAudioElement?.getAttribute('src'));

        const revokeSpeechAudioObjectUrl = () => {
            if (!speechAudioObjectUrl)
                return;

            try {
                URL.revokeObjectURL(speechAudioObjectUrl);
            } catch {}
            speechAudioObjectUrl = '';
        };

        const getSpeechAudioCaptureStream = () => {
            if (!hasSpeechAudioSource()) {
                speechAudioCaptureStream = null;
                return null;
            }

            if (hasLiveAudioTrack(speechAudioCaptureStream))
                return speechAudioCaptureStream;

            speechAudioCaptureStream = null;
            if (!speechAudioElement?.captureStream)
                return null;

            try {
                speechAudioCaptureStream = speechAudioElement.captureStream();
                return hasLiveAudioTrack(speechAudioCaptureStream) ? speechAudioCaptureStream : null;
            } catch {
                return null;
            }
        };

        const noteBotAudioRecordingFallback = () => {
            if (botAudioRecordingFallbackNotifiedForCurrentSpeech)
                return;

            botAudioCapturedForCurrentSpeech = false;
            botAudioRecordingFallbackNotifiedForCurrentSpeech = true;
            const message = 'Interviewer audio recording depends on screen audio in this browser.';
            logActivity('Interviewer voice recording is falling back to browser/system capture only.');
            if (recordingEnabled)
                setRecordingStatus(message, false, true);
            else
                setAudioDeviceStatus(message, true);
        };

        const disconnectRecordingAudioSources = () => {
            [recordingMicSource, recordingBotAudioSource, recordingScreenAudioSource].forEach(source => {
                try {
                    source?.disconnect?.();
                } catch {}
            });
            recordingMicSource = null;
            recordingBotAudioSource = null;
            recordingScreenAudioSource = null;
        };

        const getRecordingVideoTracks = () => {
            const screenTracks = getLiveTracks(screenShareStream, 'video');
            const cameraTracks = getLiveTracks(cameraStream, 'video');
            if (recordingSourceMode === 'CameraOnly')
                return cameraTracks;
            if (recordingSourceMode === 'ScreenOnly')
                return screenTracks;
            if (recordingSourceMode === 'ScreenAndCamera')
                return [...screenTracks, ...cameraTracks];

            return screenTracks.length ? screenTracks : cameraTracks;
        };

        const getRecordingSignature = () => {
            const screenTrackIds = new Set(getLiveTracks(screenShareStream, 'video').map(track => track.id));
            return [
                ...getRecordingVideoTracks().map(track => `${screenTrackIds.has(track.id) ? 'screen' : 'camera'}-video:${track.id}`),
                ...getLiveTracks(micStream, 'audio').map(track => `mic-audio:${track.id}`),
                ...getLiveTracks(screenShareStream, 'audio').map(track => `screen-audio:${track.id}`),
                ...getLiveTracks(getSpeechAudioCaptureStream(), 'audio').map(track => `bot-audio:${track.id}`)
            ].join('|');
        };

        const refreshRecordingAudioMix = () => {
            disconnectRecordingAudioSources();
            recordingAudioDestination = null;

            const AudioContextCtor = window.AudioContext || window.webkitAudioContext;
            if (!AudioContextCtor)
                return null;

            const micAudioStream = createSingleKindStream(micStream, 'audio');
            const screenAudioStream = createSingleKindStream(screenShareStream, 'audio');
            const botAudioStream = createSingleKindStream(getSpeechAudioCaptureStream(), 'audio');
            if (!micAudioStream && !screenAudioStream && !botAudioStream)
                return null;

            try {
                recordingAudioContext ??= new AudioContextCtor();
                if (recordingAudioContext.state === 'suspended')
                    recordingAudioContext.resume?.();

                recordingAudioDestination = recordingAudioContext.createMediaStreamDestination();
                if (micAudioStream) {
                    recordingMicSource = recordingAudioContext.createMediaStreamSource(micAudioStream);
                    recordingMicSource.connect(recordingAudioDestination);
                }
                if (screenAudioStream) {
                    recordingScreenAudioSource = recordingAudioContext.createMediaStreamSource(screenAudioStream);
                    recordingScreenAudioSource.connect(recordingAudioDestination);
                }
                if (botAudioStream) {
                    recordingBotAudioSource = recordingAudioContext.createMediaStreamSource(botAudioStream);
                    recordingBotAudioSource.connect(recordingAudioDestination);
                }
                recordingStreamSignature = getRecordingSignature();
                return recordingAudioDestination.stream;
            } catch (error) {
                logActivity(`Recording audio mix unavailable. reason=${error?.message || error?.name || 'unknown'}`);
                disconnectRecordingAudioSources();
                recordingAudioDestination = null;
                return null;
            }
        };

        const closeRecordingAudioMix = () => {
            disconnectRecordingAudioSources();
            recordingAudioDestination = null;
            recordingStreamSignature = '';
            try {
                recordingAudioContext?.close?.();
            } catch {}
            recordingAudioContext = null;
        };

        const stopMicPreview = async () => {
            if (meterFrame) {
                cancelAnimationFrame(meterFrame);
                meterFrame = null;
            }

            audioContext?.close?.();
            audioContext = null;
            analyser = null;
            audioMeter.forEach(bar => { bar.style.height = '8px'; bar.style.background = '#cbd5e1'; });
        };

        const stopMicStream = async () => {
            micStream?.getTracks().forEach(track => track.stop());
            micStream = null;
            await stopMicPreview();
        };

        const switchAudioInputDevice = async (deviceId) => {
            selectedAudioInputId = deviceId || '';
            writeLocalStorageValue(audioInputStorageKey, selectedAudioInputId);
            setAudioDeviceStatus('Microphone changed.');

            if (!isMicActive())
                return;

            await stopSpeechRecognition();
            await stopMicStream();
            await setMic(true);
        };

        const appendRecognitionDuration = () => {
            if (!recognitionActiveSinceMs)
                return;

            recognitionTurnDurationMs += Math.max(0, Date.now() - recognitionActiveSinceMs);
            recognitionActiveSinceMs = null;
        };

        const getRecognitionDurationMs = () => {
            const activeDuration = recognitionActiveSinceMs
                ? Math.max(0, Date.now() - recognitionActiveSinceMs)
                : 0;
            return recognitionTurnDurationMs + activeDuration;
        };

        const resetRecognitionTracking = (restartActiveTimer = false) => {
            recognitionTurnCharacters = 0;
            recognitionTurnDurationMs = 0;
            pendingRecognitionClientEventId = null;
            recognitionActiveSinceMs = restartActiveTimer && speechRecognizer ? Date.now() : null;
        };

        const getFinalCompletionSpeechText = () => finalCompletionSpeech;

        const hasAnswerText = (value) => !!(value || '').trim();

        const getNormalizedTurns = () => {
            const normalizedTurns = (turns || []).map((turn, index) => normalizeTurn(turn, index)).filter(Boolean);
            const turnsBySequence = new Map();

            normalizedTurns.forEach(turn => {
                const sequenceNumber = Math.max(1, Number(turn.sequenceNumber || 0));
                const existing = turnsBySequence.get(sequenceNumber);
                if (!existing) {
                    turnsBySequence.set(sequenceNumber, turn);
                    return;
                }

                const existingAnswered = hasAnswerText(existing.answerText);
                const candidateAnswered = hasAnswerText(turn.answerText);
                if (candidateAnswered && !existingAnswered) {
                    turnsBySequence.set(sequenceNumber, turn);
                    return;
                }

                if (candidateAnswered === existingAnswered) {
                    const existingAnsweredOn = existing.answeredOnUtc || existing.askedOnUtc || '';
                    const candidateAnsweredOn = turn.answeredOnUtc || turn.askedOnUtc || '';
                    if (candidateAnsweredOn >= existingAnsweredOn)
                        turnsBySequence.set(sequenceNumber, turn);
                }
            });

            return Array.from(turnsBySequence.values())
                .sort((left, right) => {
                    const sequenceDelta = (left.sequenceNumber || 0) - (right.sequenceNumber || 0);
                    if (sequenceDelta !== 0)
                        return sequenceDelta;
                    return (left.turnId || 0) - (right.turnId || 0);
                });
        };

        const getTurnState = () => {
            const normalizedTurns = getNormalizedTurns();
            const answeredTurns = normalizedTurns.filter(turn => hasAnswerText(turn.answerText));
            const nextSequenceNumber = answeredTurns.length >= totalQuestions
                ? totalQuestions
                : Math.min(totalQuestions, answeredTurns.length + 1);
            const activePendingTurn = normalizedTurns.find(turn =>
                !hasAnswerText(turn.answerText) &&
                turn.sequenceNumber === nextSequenceNumber) || null;

            return {
                normalizedTurns,
                answeredTurns,
                answeredCount: answeredTurns.length,
                activePendingTurn,
                currentQuestionNumber: activePendingTurn
                    ? Math.min(totalQuestions, activePendingTurn.sequenceNumber || nextSequenceNumber)
                    : (answeredTurns.length >= totalQuestions ? totalQuestions : 0)
            };
        };

        const replaceTurns = (nextTurns) => {
            const normalizedTurns = (nextTurns || []).map((turn, index) => normalizeTurn(turn, index)).filter(Boolean);
            turns.splice(0, turns.length, ...normalizedTurns);
        };

        const getActiveTurn = () => {
            const turnState = getTurnState();
            return turnState.activePendingTurn || turnState.normalizedTurns[turnState.normalizedTurns.length - 1] || null;
        };

        const reportSpeechSynthesisUsage = async ({ turnId, sequenceNumber, purpose, speechSynthesisCharacters, clientEventId }) => {
            if (purpose === 'completion')
                return;

            if (!config.speechUsageUrl || !speechSynthesisCharacters)
                return;

            if (!await ensureRuntimeTokenFresh())
                return;

            const body = new URLSearchParams({
                token: sessionToken,
                purpose: purpose || '',
                speechSynthesisCharacters: String(Math.max(0, speechSynthesisCharacters)),
                clientEventId: clientEventId || createClientEventId()
            });
            if (turnId)
                body.append('turnId', String(turnId));
            if (sequenceNumber)
                body.append('sequenceNumber', String(sequenceNumber));

            const result = await postForm(config.speechUsageUrl, body);
            if (!isSuccess(result))
                logActivity('Speech usage reporting failed: ' + getRuntimeMessage(result, 'Unable to save speech usage.'));
        };

        const setIconButtonState = (button, options) => {
            if (!button)
                return;

            const {
                icon,
                label,
                title,
                active = false,
                hidden = false,
                disabled = false
            } = options;

            button.classList.toggle('is-active', active);
            button.classList.toggle('runtime-js-hidden', hidden);
            button.disabled = disabled;
            button.setAttribute('aria-label', label);
            button.setAttribute('title', title || label);

            const iconNode = button.querySelector('i');
            if (iconNode && icon)
                iconNode.className = icon;

            const hiddenText = button.querySelector('.sr-only');
            if (hiddenText)
                hiddenText.textContent = label;
        };

        if (runtimeLog)
            runtimeLog.style.display = debugRuntime ? 'block' : 'none';

        const resetSubmitButtonText = () => {
            if (!primaryActionButton || primaryActionButton.classList.contains('is-loading'))
                return;

            if (!interviewStarted) {
                setButtonLabel(primaryActionButton, 'Start Interview');
                return;
            }

            if (isRequiredMediaBlockingInterview()) {
                setButtonLabel(primaryActionButton, getRequiredMediaResumeLabel());
                return;
            }

            if (hasActiveQuestion())
                setButtonLabel(primaryActionButton, 'Submit Answer');
        };

        const clearGuidelinesModalTimer = () => {
            clearTimeout(guidelinesModalTimer);
            guidelinesModalTimer = null;
        };

        let runtimeCaptionAnimationFrame = 0;

        const refreshRuntimeCaptionScroll = () => {
            if (!videoCaption || !videoCaptionTrack || !videoCaptionItem || !videoCaptionText || !videoCaptionCopy || videoCaption.hidden)
                return;

            cancelAnimationFrame(runtimeCaptionAnimationFrame);
            videoCaption.classList.remove('is-scrolling');
            videoCaptionCopy.hidden = true;
            runtimeCaptionAnimationFrame = requestAnimationFrame(() => {
                runtimeCaptionAnimationFrame = 0;
                if (videoCaption.hidden)
                    return;

                const shouldScroll = videoCaptionText.scrollWidth - videoCaptionText.clientWidth > 1;
                videoCaption.classList.toggle('is-scrolling', shouldScroll);
                videoCaptionCopy.hidden = !shouldScroll;

                if (shouldScroll) {
                    const captionTrackGap = parseFloat(window.getComputedStyle(videoCaptionTrack).columnGap) || 0;
                    const scrollDistance = videoCaptionItem.scrollWidth + captionTrackGap;
                    const durationSeconds = Math.min(22, Math.max(10, scrollDistance / 42));
                    videoCaption.style.setProperty('--runtime-caption-scroll-duration', `${durationSeconds}s`);
                } else {
                    videoCaption.style.removeProperty('--runtime-caption-scroll-duration');
                }
            });
        };

        const setRuntimeCaption = (speaker, text) => {
            if (!videoCaption || !videoCaptionItem || !videoCaptionSpeaker || !videoCaptionText || !videoCaptionCopy
                || !videoCaptionCopySpeaker || !videoCaptionCopyText)
                return;

            const normalizedText = (text || '').replace(/\s+/g, ' ').trim();
            if (!normalizedText) {
                videoCaption.classList.add('runtime-js-hidden');
                videoCaption.classList.remove('is-scrolling');
                videoCaption.hidden = true;
                videoCaption.parentElement?.classList.remove('has-caption');
                videoCaptionSpeaker.textContent = '';
                videoCaptionText.textContent = '';
                videoCaptionCopySpeaker.textContent = '';
                videoCaptionCopyText.textContent = '';
                videoCaptionCopy.hidden = true;
                videoCaption.style.removeProperty('--runtime-caption-scroll-duration');
                return;
            }

            const normalizedSpeaker = (speaker || '').replace(/\s+/g, ' ').trim();
            const maximumCaptionLength = 140;
            const overlayText = normalizedText.length > maximumCaptionLength
                ? `${normalizedText.slice(0, maximumCaptionLength - 3).trimEnd()}...`
                : normalizedText;
            const speakerLabel = normalizedSpeaker ? `${normalizedSpeaker}:` : '';

            videoCaptionSpeaker.textContent = speakerLabel;
            videoCaptionSpeaker.hidden = !speakerLabel;
            videoCaptionText.textContent = overlayText;
            videoCaptionCopySpeaker.textContent = speakerLabel;
            videoCaptionCopySpeaker.hidden = !speakerLabel;
            videoCaptionCopyText.textContent = overlayText;
            videoCaption.classList.remove('runtime-js-hidden');
            videoCaption.hidden = false;
            videoCaption.parentElement?.classList.add('has-caption');
            refreshRuntimeCaptionScroll();
        };

        if (videoCaption && typeof ResizeObserver === 'function') {
            const runtimeCaptionResizeObserver = new ResizeObserver(refreshRuntimeCaptionScroll);
            runtimeCaptionResizeObserver.observe(videoCaption);
        } else if (videoCaption) {
            window.addEventListener('resize', refreshRuntimeCaptionScroll);
        }

        if (document.fonts?.ready)
            document.fonts.ready.then(refreshRuntimeCaptionScroll).catch(() => { });

        const syncAnswerCaption = () => {
            const currentAnswer = (answerBox?.value || '').trim();
            if (currentAnswer) {
                setRuntimeCaption('You', currentAnswer);
                return;
            }

            if (hasActiveQuestion())
                setRuntimeCaption('Interviewer', currentQuestionText());
            else
                setRuntimeCaption('', '');
        };

        const setActiveRuntimePanel = (panelName) => {
            runtimeTabs.forEach(tab => {
                const isActive = tab.dataset.runtimeTab === panelName;
                tab.classList.toggle('is-active', isActive);
                tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
            });

            runtimePanels.forEach(panel => {
                const isActive = panel.dataset.runtimePanel === panelName;
                panel.classList.toggle('is-active', isActive);
                panel.hidden = !isActive;
            });
        };

        const setGuidelinesModalOpen = (open, closeReason = 'programmatic') => {
            if (!guidelinesModal)
                return;

            const wasOpen = guidelinesModal.classList.contains('is-open')
                || guidelinesModal.getAttribute('aria-hidden') === 'false';
            guidelinesModal.classList.toggle('is-open', open);
            guidelinesModal.setAttribute('aria-hidden', open ? 'false' : 'true');
            if (!open) {
                cleanupPermissionPrechecks();

                const isClosed = !guidelinesModal.classList.contains('is-open')
                    && guidelinesModal.getAttribute('aria-hidden') === 'true';
                if (wasOpen && isClosed) {
                    window.dispatchEvent(new CustomEvent('runtime:guidelines-closed', {
                        detail: {
                            reason: closeReason,
                            acknowledged: guidelinesAcknowledged
                        }
                    }));
                }
            }
        };

        const openGuidelinesModal = () => {
            clearGuidelinesModalTimer();
            guidelinesModal?.removeAttribute('data-runtime-guidelines-open-pending');
            renderPermissionFlow();
            setGuidelinesModalOpen(true);
        };

        const closeGuidelinesModal = (reason = 'programmatic') => setGuidelinesModalOpen(false, reason);

        const isPermissionStepComplete = (stepIndex) => {
            switch (stepIndex) {
                case 0:
                    return true;
                case 1:
                    return !!permissionState.camera;
                case 2:
                    return permissionState.internet.tested;
                case 3:
                    return !!permissionState.microphone;
                case 4:
                    return !!permissionState.speaker;
                case 5:
                    return !!permissionState.speechRecognition;
                case 6:
                    return permissionState.consent;
                default:
                    return false;
            }
        };

        const canNavigateToPermissionStep = (targetStep) => {
            if (targetStep <= permissionActiveStep)
                return true;

            for (let index = 0; index < targetStep; index++) {
                if (!isPermissionStepComplete(index))
                    return false;
            }

            return true;
        };

        const resetPrecheckMeter = () => {
            precheckAudioMeter.forEach(bar => {
                bar.style.height = '8px';
                bar.style.background = '';
            });
        };

        const stopPrecheckCamera = () => {
            precheckCameraStream?.getTracks?.().forEach(track => track.stop());
            precheckCameraStream = null;
            if (precheckCameraPreview)
                precheckCameraPreview.srcObject = null;
            precheckCameraPlaceholder?.classList.remove('runtime-js-hidden');
        };

        const stopPrecheckMic = async () => {
            if (precheckMeterFrame) {
                cancelAnimationFrame(precheckMeterFrame);
                precheckMeterFrame = null;
            }

            precheckMicStream?.getTracks?.().forEach(track => track.stop());
            precheckMicStream = null;
            try {
                await precheckAudioContext?.close?.();
            } catch {}
            precheckAudioContext = null;
            precheckAnalyser = null;
            resetPrecheckMeter();
        };

        const stopPrecheckSpeech = () => {
            if (!precheckSpeechRecognition)
                return;

            try {
                precheckSpeechRecognition.onresult = null;
                precheckSpeechRecognition.onerror = null;
                precheckSpeechRecognition.onend = null;
                precheckSpeechRecognition.stop();
            } catch {}
            precheckSpeechRecognition = null;
            precheckSpeechRecognizing = false;
            precheckSpeechStartButton?.classList.remove('runtime-js-hidden');
            precheckSpeechStopButton?.classList.add('runtime-js-hidden');
        };

        const cleanupPermissionPrechecks = async () => {
            stopPrecheckCamera();
            await stopPrecheckMic();
            stopPrecheckSpeech();
        };

        const getWorkingText = (value) => value === 'working' ? 'Working' : 'Not working';

        const setPermissionSummaryValue = (field, text, status) => {
            if (!field)
                return;

            field.textContent = text;
            field.classList.toggle('is-working', status === 'working');
            field.classList.toggle('is-not-working', status === 'not-working');
            field.classList.toggle('is-warning', status === 'warning');
        };

        const renderPermissionSummary = () => {
            setPermissionSummaryValue(permissionSummaryFields.camera, getWorkingText(permissionState.camera), permissionState.camera || 'not-working');
            setPermissionSummaryValue(permissionSummaryFields.microphone, getWorkingText(permissionState.microphone), permissionState.microphone || 'not-working');
            setPermissionSummaryValue(permissionSummaryFields.speaker, getWorkingText(permissionState.speaker), permissionState.speaker || 'not-working');
            setPermissionSummaryValue(permissionSummaryFields.speechRecognition, getWorkingText(permissionState.speechRecognition), permissionState.speechRecognition || 'not-working');

            if (!permissionState.internet.tested) {
                setPermissionSummaryValue(permissionSummaryFields.internet, 'Not tested', 'not-working');
                return;
            }

            setPermissionSummaryValue(
                permissionSummaryFields.internet,
                `${permissionState.internet.speedMbps?.toFixed?.(1) ?? permissionState.internet.speedMbps} Mbps`,
                permissionState.internet.passed ? 'working' : 'warning'
            );
        };

        const renderPermissionFlow = () => {
            permissionStepPanels.forEach(panel => {
                const isActive = Number(panel.dataset.permissionStep) === permissionActiveStep;
                panel.hidden = !isActive;
                panel.classList.toggle('is-active', isActive);
            });

            permissionStepButtons.forEach(button => {
                const stepIndex = Number(button.dataset.permissionStepJump);
                const completed = isPermissionStepComplete(stepIndex) && stepIndex !== permissionActiveStep;
                const active = stepIndex === permissionActiveStep;
                const blocked = !canNavigateToPermissionStep(stepIndex);
                const marker = button.querySelector('span');
                button.classList.toggle('is-active', active);
                button.classList.toggle('is-completed', completed);
                button.disabled = blocked;
                button.setAttribute('aria-current', active ? 'step' : 'false');
                if (marker)
                    marker.innerHTML = completed ? '<i class="fa-solid fa-check" aria-hidden="true"></i>' : String(stepIndex + 1);
            });

            if (permissionStepCaption)
                permissionStepCaption.textContent = permissionSteps[permissionActiveStep]?.label || '';

            permissionResultButtons.forEach(button => {
                const key = button.dataset.permissionResult;
                const selected = permissionState[key] === button.dataset.permissionValue;
                button.classList.toggle('is-selected', selected);
                button.setAttribute('aria-pressed', selected ? 'true' : 'false');
            });

            renderPermissionSummary();
            updateGuidelinesAcknowledgementState();
        };

        const setPermissionStep = (stepIndex) => {
            if (stepIndex < 0 || stepIndex >= permissionSteps.length || !canNavigateToPermissionStep(stepIndex))
                return;

            permissionActiveStep = stepIndex;
            renderPermissionFlow();
            if (permissionActiveStep === 1)
                startPrecheckCamera();
        };

        const estimateConnectionSpeed = async () => {
            const connectionDownlink = Number(navigator.connection?.downlink);
            if (connectionDownlink > 0)
                return connectionDownlink;

            const startedAt = performance.now();
            const response = await fetch(`${window.location.href}${window.location.href.includes('?') ? '&' : '?'}precheckSpeed=${Date.now()}`, {
                cache: 'no-store',
                credentials: 'same-origin'
            });
            const blob = await response.blob();
            const elapsedSeconds = Math.max((performance.now() - startedAt) / 1000, 0.05);
            return Number(((blob.size * 8) / elapsedSeconds / 1000000).toFixed(1));
        };

        const startPrecheckCamera = async () => {
            if (precheckCameraStream)
                return;

            if (!navigator.mediaDevices?.getUserMedia) {
                if (precheckCameraStatus)
                    precheckCameraStatus.textContent = 'Camera is not available. You can continue using text answers.';
                return;
            }

            try {
                precheckCameraStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
                if (precheckCameraPreview)
                    precheckCameraPreview.srcObject = precheckCameraStream;
                precheckCameraPlaceholder?.classList.add('runtime-js-hidden');
                if (precheckCameraStatus)
                    precheckCameraStatus.textContent = 'Camera is working!';
            } catch {
                stopPrecheckCamera();
                if (precheckCameraStatus)
                    precheckCameraStatus.textContent = 'Camera is not available. You can continue using text answers.';
            }
        };

        const testInternetSpeed = async () => {
            if (!precheckInternetButton || !precheckInternetStatus)
                return;

            precheckInternetButton.disabled = true;
            precheckInternetStatus.textContent = 'Testing internet speed...';
            try {
                const speed = await estimateConnectionSpeed();
                permissionState.internet = {
                    tested: true,
                    speedMbps: Number.isFinite(speed) ? speed : 0,
                    passed: Number.isFinite(speed) && speed >= 5
                };
                precheckInternetStatus.textContent = `Speed: ${permissionState.internet.speedMbps.toFixed(1)} Mbps`;
                precheckInternetStatus.classList.toggle('is-warning', !permissionState.internet.passed);
            } catch {
                permissionState.internet = { tested: true, speedMbps: 0, passed: false };
                precheckInternetStatus.textContent = 'Speed: 0.0 Mbps';
                precheckInternetStatus.classList.add('is-warning');
            } finally {
                precheckInternetButton.disabled = false;
                renderPermissionFlow();
            }
        };

        const requestPrecheckMic = async () => {
            if (!precheckMicButton || !precheckMicStatus)
                return;

            if (!navigator.mediaDevices?.getUserMedia) {
                precheckMicStatus.textContent = 'Microphone is not available.';
                return;
            }

            precheckMicButton.disabled = true;
            precheckMicStatus.textContent = 'Requesting microphone access...';
            try {
                await stopPrecheckMic();
                precheckMicStream = await navigator.mediaDevices.getUserMedia({ video: false, audio: true });
                precheckAudioContext = new (window.AudioContext || window.webkitAudioContext)();
                const source = precheckAudioContext.createMediaStreamSource(precheckMicStream);
                precheckAnalyser = precheckAudioContext.createAnalyser();
                precheckAnalyser.fftSize = 32;
                source.connect(precheckAnalyser);
                const buffer = new Uint8Array(precheckAnalyser.frequencyBinCount);
                const renderMeter = () => {
                    if (!precheckAnalyser)
                        return;

                    precheckAnalyser.getByteFrequencyData(buffer);
                    const average = buffer.reduce((sum, value) => sum + value, 0) / buffer.length;
                    precheckAudioMeter.forEach((bar, index) => {
                        const height = Math.max(8, Math.min(42, average - (index * 2)));
                        bar.style.height = `${height}px`;
                    });
                    precheckMeterFrame = requestAnimationFrame(renderMeter);
                };
                renderMeter();
                precheckMicStatus.textContent = 'Microphone access granted.';
            } catch {
                await stopPrecheckMic();
                precheckMicStatus.textContent = 'Microphone is not available.';
            } finally {
                precheckMicButton.disabled = false;
            }
        };

        const playSpeakerTone = async () => {
            if (!precheckSpeakerButton)
                return;

            precheckSpeakerButton.disabled = true;
            try {
                const toneContext = new (window.AudioContext || window.webkitAudioContext)();
                const oscillator = toneContext.createOscillator();
                const gain = toneContext.createGain();
                oscillator.type = 'sine';
                oscillator.frequency.value = 660;
                gain.gain.setValueAtTime(0.001, toneContext.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.18, toneContext.currentTime + 0.03);
                gain.gain.exponentialRampToValueAtTime(0.001, toneContext.currentTime + 0.75);
                oscillator.connect(gain);
                gain.connect(toneContext.destination);
                oscillator.start();
                oscillator.stop(toneContext.currentTime + 0.8);
                setTimeout(() => toneContext.close?.(), 900);
            } finally {
                setTimeout(() => {
                    precheckSpeakerButton.disabled = false;
                }, 900);
            }
        };

        const getBrowserSpeechRecognition = () => window.SpeechRecognition || window.webkitSpeechRecognition;

        const startPrecheckSpeech = () => {
            const SpeechRecognitionApi = getBrowserSpeechRecognition();
            if (!SpeechRecognitionApi) {
                if (precheckSpeechResult)
                    precheckSpeechResult.textContent = 'Speech recognition is not available in this browser.';
                return;
            }

            stopPrecheckSpeech();
            precheckSpeechRecognition = new SpeechRecognitionApi();
            precheckSpeechRecognition.lang = 'en-US';
            precheckSpeechRecognition.interimResults = true;
            precheckSpeechRecognition.continuous = false;
            precheckSpeechRecognition.onresult = (event) => {
                const recognized = Array.from(event.results)
                    .map(result => result[0]?.transcript || '')
                    .join(' ')
                    .trim();
                if (precheckSpeechResult)
                    precheckSpeechResult.textContent = recognized;
            };
            precheckSpeechRecognition.onerror = () => {
                if (precheckSpeechResult && !precheckSpeechResult.textContent)
                    precheckSpeechResult.textContent = 'Speech recognition could not capture audio.';
            };
            precheckSpeechRecognition.onend = () => {
                precheckSpeechRecognizing = false;
                precheckSpeechStartButton?.classList.remove('runtime-js-hidden');
                precheckSpeechStopButton?.classList.add('runtime-js-hidden');
            };

            precheckSpeechRecognizing = true;
            precheckSpeechResult && (precheckSpeechResult.textContent = '');
            precheckSpeechStartButton?.classList.add('runtime-js-hidden');
            precheckSpeechStopButton?.classList.remove('runtime-js-hidden');
            precheckSpeechRecognition.start();
        };

        const getSelectedFeedbackIssue = () => feedbackIssueSelect?.value || 'AI is not speaking';

        const isOtherFeedbackIssue = () => getSelectedFeedbackIssue() === 'Other issue';
        const isSupportFeedbackIssue = () => getSelectedFeedbackIssue() === 'Talk to support team';

        const setFeedbackStatus = (message = '', isError = false) => {
            if (!feedbackStatus)
                return;

            feedbackStatus.textContent = message;
            feedbackStatus.classList.toggle('is-error', !!message && isError);
            feedbackStatus.classList.toggle('is-success', !!message && !isError);
        };

        const updateFeedbackHelpfulnessState = (value = '') => {
            feedbackHelpfulness = value;
            feedbackHelpfulnessButtons.forEach(button => {
                const selected = button.dataset.feedbackHelpfulness === feedbackHelpfulness;
                button.classList.toggle('is-selected', selected);
                button.setAttribute('aria-pressed', selected ? 'true' : 'false');
            });
        };

        const getFeedbackOptionIndex = (value) => Math.max(0, feedbackIssueOptions.findIndex(option => option.dataset.feedbackIssueValue === value));

        const setFeedbackIssueListboxOpen = (open) => {
            if (!feedbackIssueButton || !feedbackIssueListbox)
                return;

            feedbackIssueListbox.classList.toggle('runtime-js-hidden', !open);
            feedbackIssueButton.setAttribute('aria-expanded', open ? 'true' : 'false');
        };

        const setActiveFeedbackIssueOption = (index) => {
            if (!feedbackIssueOptions.length)
                return;

            const normalizedIndex = Math.max(0, Math.min(index, feedbackIssueOptions.length - 1));
            feedbackIssueOptions.forEach((option, optionIndex) => {
                const active = optionIndex === normalizedIndex;
                option.classList.toggle('is-active', active);
                if (active)
                    option.scrollIntoView({ block: 'nearest' });
            });
        };

        const selectFeedbackIssue = (option, closeListbox = true) => {
            if (!option || !feedbackIssueSelect)
                return;

            const value = option.dataset.feedbackIssueValue || '';
            feedbackIssueSelect.value = value;
            feedbackIssueOptions.forEach(candidate => {
                const selected = candidate === option;
                candidate.setAttribute('aria-selected', selected ? 'true' : 'false');
                candidate.classList.toggle('is-active', selected);
            });
            if (feedbackIssueCurrentIcon)
                feedbackIssueCurrentIcon.className = option.dataset.feedbackIssueIcon || '';
            if (feedbackIssueCurrentText)
                feedbackIssueCurrentText.textContent = option.querySelector('span')?.textContent || value;
            if (closeListbox)
                setFeedbackIssueListboxOpen(false);
            updateFeedbackIssueState();
        };

        const updateFeedbackIssueState = () => {
            const issue = getSelectedFeedbackIssue();
            const otherIssue = isOtherFeedbackIssue();
            const supportIssue = isSupportFeedbackIssue();
            feedbackSolutionPanels.forEach(panel => {
                const isActive = panel.dataset.feedbackSolution === issue && !otherIssue;
                panel.classList.toggle('is-active', isActive);
                panel.classList.toggle('runtime-js-hidden', !isActive);
            });

            feedbackOtherPanel?.classList.toggle('runtime-js-hidden', !otherIssue);
            if (otherIssue || supportIssue)
                updateFeedbackHelpfulnessState('');
            if (feedbackSubmitButton)
                feedbackSubmitButton.textContent = otherIssue ? '@T("Plugins.Misc.AIInterview.Runtime.Feedback.SubmitReport")' : '@T("Plugins.Misc.AIInterview.Runtime.Feedback.GotIt")';
            setFeedbackStatus();
        };

        const handleFeedbackIssueButtonKeydown = (event) => {
            const isOpen = feedbackIssueButton?.getAttribute('aria-expanded') === 'true';
            const selectedIndex = getFeedbackOptionIndex(getSelectedFeedbackIssue());
            const activeIndex = Math.max(0, feedbackIssueOptions.findIndex(option => option.classList.contains('is-active')));

            if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
                event.preventDefault();
                setFeedbackIssueListboxOpen(true);
                const nextIndex = event.key === 'ArrowDown'
                    ? (isOpen ? Math.min(activeIndex + 1, feedbackIssueOptions.length - 1) : selectedIndex)
                    : (isOpen ? Math.max(activeIndex - 1, 0) : selectedIndex);
                setActiveFeedbackIssueOption(nextIndex);
                return;
            }

            if (event.key === 'Enter' || event.key === ' ') {
                event.preventDefault();
                if (!isOpen) {
                    setFeedbackIssueListboxOpen(true);
                    setActiveFeedbackIssueOption(selectedIndex);
                    return;
                }

                selectFeedbackIssue(feedbackIssueOptions[activeIndex] || feedbackIssueOptions[selectedIndex]);
                return;
            }

            if (event.key === 'Escape') {
                setFeedbackIssueListboxOpen(false);
                feedbackIssueButton?.focus();
            }
        };

        const getFeedbackFocusableElements = () => Array.from(feedbackModal?.querySelectorAll('button:not(:disabled):not([tabindex="-1"]), select:not(:disabled), textarea:not(:disabled), input:not(:disabled), a[href]') || [])
            .filter(element => element.offsetParent !== null);

        const trapFeedbackFocus = (event) => {
            if (!feedbackModal?.classList.contains('is-open') || event.key !== 'Tab')
                return;

            const focusable = getFeedbackFocusableElements();
            if (!focusable.length)
                return;

            const first = focusable[0];
            const last = focusable[focusable.length - 1];
            if (event.shiftKey && document.activeElement === first) {
                event.preventDefault();
                last.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
                event.preventDefault();
                first.focus();
            }
        };

        const setFeedbackModalOpen = (open) => {
            if (!feedbackModal)
                return;

            feedbackModal.classList.toggle('is-open', open);
            feedbackModal.setAttribute('aria-hidden', open ? 'false' : 'true');
            if (open) {
                feedbackLastFocusedElement = document.activeElement;
                updateFeedbackIssueState();
                window.setTimeout(() => feedbackIssueButton?.focus(), 0);
            } else {
                setFeedbackIssueListboxOpen(false);
                if (feedbackLastFocusedElement?.focus)
                    feedbackLastFocusedElement.focus();
            }
        };

        const closeFeedbackModal = () => setFeedbackModalOpen(false);

        const submitRuntimeFeedback = async () => {
            if (feedbackSubmitInFlight)
                return;

            if (!config.feedbackUrl) {
                setFeedbackStatus('Feedback endpoint is unavailable.', true);
                return;
            }

            const issue = getSelectedFeedbackIssue();
            const comment = feedbackComment?.value?.trim() || '';
            const otherIssue = issue === 'Other issue';
            const supportIssue = issue === 'Talk to support team';
            if (otherIssue && !comment) {
                setFeedbackStatus('@T("Plugins.Misc.AIInterview.Runtime.Feedback.CommentRequired")', true);
                feedbackComment?.focus();
                return;
            }

            if (!(await ensureRuntimeTokenFresh()))
                return;

            const formData = new FormData();
            formData.append('token', sessionToken);
            formData.append('issue', issue);
            formData.append('helpfulness', otherIssue || supportIssue ? '' : feedbackHelpfulness);
            formData.append('comment', otherIssue ? comment : '');
            if (otherIssue && feedbackAttachment?.files?.length)
                formData.append('attachment', feedbackAttachment.files[0]);

            feedbackSubmitInFlight = true;
            const originalText = feedbackSubmitButton?.textContent || '';
            if (feedbackSubmitButton) {
                feedbackSubmitButton.disabled = true;
                feedbackSubmitButton.classList.add('is-loading');
                feedbackSubmitButton.textContent = 'Submitting...';
            }
            setFeedbackStatus();

            const result = await postMultipart(config.feedbackUrl, formData);
            feedbackSubmitInFlight = false;
            if (feedbackSubmitButton) {
                feedbackSubmitButton.disabled = false;
                feedbackSubmitButton.classList.remove('is-loading');
                feedbackSubmitButton.textContent = originalText;
            }

            if (!isSuccess(result)) {
                setFeedbackStatus(getRuntimeMessage(result, 'Unable to submit feedback.'), true);
                return;
            }

            setFeedbackStatus(getRuntimeMessage(result, '@T("Plugins.Misc.AIInterview.Runtime.Feedback.Success")'), false);
            if (otherIssue && feedbackAttachment)
                feedbackAttachment.value = '';
            if (feedbackFileName)
                feedbackFileName.textContent = '';
        };

        const logGuidelinesAcknowledgement = () => {
            const payload = {
                acknowledged: true,
                acknowledgedTimestamp: guidelinesAcknowledgedAt,
                userAgent: navigator.userAgent,
                screenSize: `${window.screen?.width || 0}x${window.screen?.height || 0}`,
                viewportSize: `${window.innerWidth || 0}x${window.innerHeight || 0}`
            };
            logActivity(`Guidelines acknowledged: ${JSON.stringify(payload)}`);
            console.info('[AIInterview Runtime] Guidelines acknowledged', payload);
            return payload;
        };

        const setScreenShareStatus = (message, state = 'required') => {
            if (!screenShareStatus)
                return;

            screenShareStatus.textContent = message;
            const isVisible = state === 'warning' || state === 'error';
            const stateClass = state === 'active' ? 'is-active' : state === 'warning' ? 'is-warning' : state === 'error' ? 'is-error' : '';
            screenShareStatus.className = `runtime-screen-share-status ${stateClass} ${isVisible ? '' : 'runtime-js-hidden'}`.trim();
        };

        const setScreenShareInterruptionWarning = (visible) => {
            if (!screenShareInterruptionWarning)
                return;

            screenShareInterruptionWarning.textContent = 'Resume screen share to continue.';
            screenShareInterruptionWarning.classList.toggle('runtime-js-hidden', !visible || runtimeStoppedOrCompleted);
        };

        const updateStartButtonState = () => {
            if (!primaryActionButton)
                return;

            if (runtimeStoppedOrCompleted) {
                primaryActionButton.disabled = true;
                setButtonLabel(primaryActionButton, 'Completed');
                updateStopButtonsState();
                updateAuxiliaryControlsState();
                return;
            }

            if (!interviewStarted) {
                primaryActionButton.disabled = beginInterviewInProgress || creditRedirectPending || !guidelinesAcknowledged;
                setButtonLabel(primaryActionButton, 'Start Interview');
                updateStopButtonsState();
                updateAuxiliaryControlsState();
                return;
            }

            if (isRequiredMediaBlockingInterview()) {
                primaryActionButton.disabled = false;
                setButtonLabel(primaryActionButton, getRequiredMediaResumeLabel());
                updateStopButtonsState();
                updateAuxiliaryControlsState();
                return;
            }

            primaryActionButton.disabled = !hasActiveQuestion() || !(answerBox.value || '').trim();
            setButtonLabel(primaryActionButton, hasActiveQuestion() ? 'Submit Answer' : 'Interview Started');
            updateStopButtonsState();
            updateAuxiliaryControlsState();
        };

        const updateStopButtonsState = () => {
            const stopButtons = [document.getElementById('stop-interview'), document.getElementById('stop-interview-top')];
            const disableStop = !interviewStarted || runtimeStoppedOrCompleted || stopInProgress;
            stopButtons.forEach(button => {
                if (!button)
                    return;

                button.disabled = disableStop;
            });
        };

        const clearAnswerTimers = () => {
            clearInterval(countdownTimer);
            countdownTimer = null;
            countdownValue = autoSubmitDelaySeconds;
            resetSubmitButtonText();
        };

        const getScreenShareAudioTracks = () => screenShareStream?.getAudioTracks?.().filter(track => track.readyState === 'live') || [];

        const updateScreenShareAudioNotice = (shouldLog = false) => {
            if (!screenShareActive || screenShareInterrupted) {
                screenShareAudioAvailable = false;
                return;
            }

            const hasAudioTrack = getScreenShareAudioTracks().length > 0;
            screenShareAudioAvailable = hasAudioTrack;

            if (hasAudioTrack) {
                setScreenShareStatus('Screen sharing active', 'active');
                if (shouldLog)
                    logActivity('Screen sharing started with a system or tab audio track.');
                return;
            }

            setScreenShareStatus('Screen sharing active without system or tab audio. Continue if your browser does not offer audio sharing.', 'warning');
            if (shouldLog)
                logActivity('Screen sharing started without a system or tab audio track.');
        };

        const stopScreenShare = () => {
            screenShareStream?.getTracks().forEach(track => track.stop());
            screenShareStream = null;
            screenShareActive = false;
            screenShareInterrupted = false;
            screenShareAudioAvailable = false;
            if (!mediaRecorder)
                refreshRecordingAudioMix();
            setScreenShareInterruptionWarning(false);
            setScreenShareStatus(runtimeStoppedOrCompleted ? 'Screen sharing ended' : 'Screen sharing required');
            updateAuxiliaryControlsState();
        };

        const clearCompletedRedirectState = () => {
            completionWaitGeneration += 1;
            clearInterval(completedCountdown);
            clearInterval(completionStatusTimer);
            completedCountdown = null;
            completionStatusTimer = null;
            completionStatusRequestInFlight = false;
            if (!runtimeStoppedOrCompleted)
                reportNavigationStarted = false;
        };

        const clearActiveInterviewTimers = () => {
            clearAnswerTimers();
            clearGuidelinesModalTimer();
            clearInterval(runtimeTimerHandle);
            runtimeTimerHandle = null;
            updateRuntimeTimerDisplay();
            if (runtimeStoppedOrCompleted && timerLabel)
                timerLabel.textContent = 'Elapsed';
        };

        const clearAllRuntimeTimers = () => {
            clearActiveInterviewTimers();
            clearCompletedRedirectState();
        };

        const shouldWarnBeforeUnload = () => interviewStarted && !runtimeStoppedOrCompleted && !stopInProgress;

        const formatElapsedTime = (secondsValue = null) => {
            const elapsedSeconds = Number.isFinite(secondsValue)
                ? Math.max(0, Math.floor(secondsValue))
                : timerStartedAt
                    ? Math.floor((Date.now() - timerStartedAt) / 1000)
                    : 0;
            const minutes = String(Math.floor(elapsedSeconds / 60)).padStart(2, '0');
            const seconds = String(elapsedSeconds % 60).padStart(2, '0');
            return `${minutes}:${seconds}`;
        };

        const updateRuntimeTimerDisplay = () => {
            const value = formatElapsedTime();
            if (timerBox)
                timerBox.textContent = value;
            if (timerDetails)
                timerDetails.textContent = value;
        };

        const startRuntimeTimer = () => {
            if (runtimeTimerHandle)
                return;

            timerStartedAt = Date.now();
            if (timerLabel)
                timerLabel.textContent = 'Live';
            if (timerChip)
                timerChip.title = 'Live interview timer';
            updateRuntimeTimerDisplay();
            runtimeTimerHandle = setInterval(updateRuntimeTimerDisplay, 1000);
        };

        const startAutoSubmitCountdown = () => {
            clearAnswerTimers();
            const currentText = (answerBox.value || '').trim();
            if (!currentText || !interviewStarted || isSpeakingOrSubmitting || !hasActiveQuestion() || answerNeedsEditAfterFailure || isScreenShareBlockingInterview())
                return;

            countdownValue = autoSubmitDelaySeconds;
            primaryActionButton.textContent = `Submit Answer (${countdownValue})`;
            countdownTimer = setInterval(() => {
                if (!interviewStarted || isSpeakingOrSubmitting || !hasActiveQuestion() || answerNeedsEditAfterFailure || isScreenShareBlockingInterview()) {
                    clearAnswerTimers();
                    return;
                }

                const currentText = (answerBox.value || '').trim();
                if (!currentText) {
                    clearAnswerTimers();
                    return;
                }

                countdownValue -= 1;
                if (countdownValue <= 0) {
                    clearAnswerTimers();
                    submitAnswer({ auto: true });
                    return;
                }

                primaryActionButton.textContent = `Submit Answer (${countdownValue})`;
            }, 1000);
        };

        const resetTimers = () => {
            clearAnswerTimers();
            if (!interviewStarted || isSpeakingOrSubmitting || !hasActiveQuestion() || answerNeedsEditAfterFailure || isScreenShareBlockingInterview())
                return;

            if (!(answerBox.value || '').trim())
                return;

            startAutoSubmitCountdown();
        };

        answerBox.addEventListener('input', () => {
            answerNeedsEditAfterFailure = false;
            syncAnswerCaption();
            updateSubmitAvailability();
            resetTimers();
        });

        recordingEnabled = !!config.recordingAvailable;
        if (recordingButton) {
            recordingButton.disabled = !config.recordingAvailable;
            updateAuxiliaryControlsState();
        }

        const loadScriptOnce = (src) => {
            return new Promise((resolve, reject) => {
                const existing = document.querySelector(`script[data-ai-src="${src}"]`);
                if (existing) {
                    existing.dataset.loaded === 'true' ? resolve() : existing.addEventListener('load', () => resolve(), { once: true });
                    return;
                }

                const script = document.createElement('script');
                script.src = src;
                script.async = true;
                script.dataset.aiSrc = src;
                script.onload = () => {
                    script.dataset.loaded = 'true';
                    resolve();
                };
                script.onerror = () => reject(new Error(`Failed to load ${src}`));
                document.head.appendChild(script);
            });
        };

        const formatCountdown = (remainingSeconds) => {
            const safeRemainingSeconds = Math.max(0, Math.round(Number(remainingSeconds) || 0));
            const minutes = String(Math.floor(safeRemainingSeconds / 60)).padStart(2, '0');
            const seconds = String(safeRemainingSeconds % 60).padStart(2, '0');
            return `${minutes}:${seconds}`;
        };

        const shouldSuppressCompletedStatus = (message, isError) => {
            if (!runtimeStoppedOrCompleted || !isError || !message)
                return false;

            logActivity(`Post-completion status suppressed: ${message}`);
            return true;
        };

        const setStatus = (message, isError) => {
            if (shouldSuppressCompletedStatus(message, isError))
                return;

            statusBox.textContent = message || '';
            const isVisible = !!message && (isError || runtimeStoppedOrCompleted || stopInProgress);
            statusBox.className = `runtime-status ${isVisible ? '' : 'runtime-js-hidden'} ${isError ? 'message-error' : 'message-success'}`.trim();
        };

        const setRuntimeWarning = (message) => {
            if (!statusBox || runtimeStoppedOrCompleted)
                return;

            statusBox.textContent = message || '';
            statusBox.className = `runtime-status ${message ? '' : 'runtime-js-hidden'} message-warning`.trim();
        };

        const setHeaderStatus = (message, isError = false) => {
            if (!headerStatusBox)
                return;
            if (shouldSuppressCompletedStatus(message, isError))
                return;

            headerStatusBox.textContent = message || '';
            headerStatusBox.className = `runtime-header-status runtime-status ${message ? '' : 'runtime-js-hidden'} ${isError ? 'message-error' : 'message-success'}`.trim();
        };

        const setCreditWarning = (message, pricingUrl = '/pricing') => {
            if (!creditWarningBox || !creditWarningMessage || !creditUpgradeLink)
                return;

            creditWarningMessage.textContent = message || '';
            creditUpgradeLink.href = pricingUrl || '/pricing';
            creditWarningBox.classList.toggle('runtime-js-hidden', !message);
        };

        const clearRecoveredMediaBlockingStatus = () => {
            if (isRequiredMediaBlockingInterview())
                return;

            const currentStatus = (statusBox?.textContent || '').trim();
            if (currentStatus.startsWith('Screen sharing is required')
                || currentStatus.startsWith('Screen sharing ended')
                || currentStatus.startsWith('Camera must remain on')
                || currentStatus.startsWith('Microphone must remain on')
                || currentStatus.startsWith('Camera permission was denied')
                || currentStatus.startsWith('Microphone permission was denied')) {
                setStatus('', false);
            }

            const currentHeaderStatus = (headerStatusBox?.textContent || '').trim();
            if (currentHeaderStatus.startsWith('Screen sharing is required')
                || currentHeaderStatus.startsWith('Screen sharing ended')
                || currentHeaderStatus.startsWith('Resume screen share')
                || currentHeaderStatus.startsWith('Camera must remain on')
                || currentHeaderStatus.startsWith('Microphone must remain on')) {
                setHeaderStatus('', false);
            }
        };

        const setRecordingStatus = (message, isError, forceVisible = false) => {
            if (!recordingStatus)
                return;

            recordingStatus.textContent = message || '';
            const isVisible = !!message && !!config.recordingAvailable && (!!isError || !!forceVisible);
            recordingStatus.className = `runtime-status ${isVisible ? '' : 'runtime-js-hidden'} ${isError ? 'message-error' : 'message-success'}`.trim();
        };

        const logActivity = (msg) => {
            if (!debugRuntime)
                return;

            console.debug(`[AIInterview Runtime] ${msg}`);
            const logPanel = document.getElementById('runtime-log-body');
            if (logPanel) {
                const p = document.createElement('p');
                p.textContent = `[${new Date().toLocaleTimeString()}] ${msg}`;
                p.style.margin = '4px 0';
                p.style.fontSize = '12px';
                p.style.color = '#334155';
                logPanel.prepend(p);
            }
        };

        const getBlobByteSize = (parts) => {
            if (!parts || !parts.length)
                return 0;

            return parts.reduce((total, part) => total + (part?.size || 0), 0);
        };

        const getValue = (result, camel, pascal) => {
            if (!result) return null;
            if (camel in result) return result[camel];
            if (pascal in result) return result[pascal];
            return null;
        };

        const isSuccess = (result) => {
            return getValue(result, "success", "Success") === true;
        };

        const getRuntimeMessage = (result, fallback) => {
            return getValue(result, "message", "Message") || getValue(result, "error", "Error") || fallback;
        };

        logActivity(`Runtime debug enabled. speechAvailable=${!!config.speechAvailable}, recordingAvailable=${!!config.recordingAvailable}, mockMode=${!!config.isMockMode}`);

        setRecordingStatus('', false);

        const isPlaceholderSpeechText = (text) => {
            const normalized = (text || '').trim();
            return !normalized
                || normalized === 'Welcome! Click Start Interview to begin.'
                || normalized === 'AI service unavailable.'
                || normalized === 'AI service unavailable. Please try again later.';
        };

        const currentQuestionText = () => {
            const activeQuestion = (getTurnState().activePendingTurn?.questionText || '').trim();
            return activeQuestion || (questionBox.textContent || '').trim();
        };

        const hasActiveQuestion = () => !interviewUnavailable && !isPlaceholderSpeechText(currentQuestionText());

        const canAcceptTypedAnswer = () => interviewStarted
            && !runtimeStoppedOrCompleted
            && !stopInProgress
            && !interviewUnavailable
            && hasActiveQuestion();

        const canUseSpeechRecognition = () => canAcceptTypedAnswer()
            && config.speechAvailable
            && !speechUnavailable
            && isMicActive()
            && !answerBox.disabled;

        const updateAnswerInputState = () => {
            answerBox.disabled = !canAcceptTypedAnswer();
        };

        function isCameraActive() {
            return !!cameraStream?.getVideoTracks?.().some(track => track.readyState === 'live');
        }

        function isMicActive() {
            return !!micStream?.getAudioTracks?.().some(track => track.readyState === 'live');
        }

        function isRequiredMediaBlockingInterview() {
            return interviewStarted && (!isCameraActive() || !isMicActive() || isScreenShareBlockingInterview());
        }

        function getRequiredMediaResumeLabel() {
            if (!isCameraActive() || !isMicActive())
                return 'Enable Camera And Mic';

            return 'Resume Screen Share';
        }

        function isScreenShareBlockingInterview() {
            return screenShareRequired && interviewStarted && (!screenShareActive || screenShareInterrupted);
        }

        function updateAuxiliaryControlsState() {
            setIconButtonState(document.getElementById('toggle-camera'), {
                icon: isCameraActive() ? 'fa-solid fa-video' : 'fa-solid fa-video-slash',
                label: isCameraActive() ? 'Turn camera off' : 'Turn camera on',
                title: isCameraActive() ? 'Turn camera off' : 'Turn camera on',
                active: isCameraActive()
            });

            setIconButtonState(document.getElementById('toggle-mic'), {
                icon: isMicActive() ? 'fa-solid fa-microphone' : 'fa-solid fa-microphone-slash',
                label: isMicActive() ? 'Turn microphone off' : 'Turn microphone on',
                title: isMicActive() ? 'Turn microphone off' : 'Turn microphone on',
                active: isMicActive()
            });

            setIconButtonState(screenShareButton, {
                icon: 'fa-solid fa-display',
                label: screenShareActive && !screenShareInterrupted ? 'Screen share active' : 'Enable screen share',
                title: screenShareActive && !screenShareInterrupted ? 'Screen share active' : 'Enable screen share',
                active: screenShareActive && !screenShareInterrupted
            });

            setIconButtonState(recordingButton, {
                icon: 'fa-solid fa-circle',
                label: mediaRecorder ? 'Recording live' : 'Recording status',
                title: mediaRecorder ? 'Recording live' : 'Recording status',
                active: !!mediaRecorder,
                hidden: !config.recordingAvailable,
                disabled: !config.recordingAvailable
            });

            setIconButtonState(repeatQuestionButton, {
                icon: 'fa-solid fa-rotate-right',
                label: 'Repeat question',
                title: 'Repeat question',
                disabled: !interviewStarted || !hasActiveQuestion()
            });

            if (cameraStatusDetails)
                cameraStatusDetails.textContent = isCameraActive() ? 'On' : 'Off';
            if (micStatusDetails)
                micStatusDetails.textContent = isMicActive() ? 'On' : 'Off';
            if (screenShareDetailsStatus)
                screenShareDetailsStatus.textContent = screenShareActive && !screenShareInterrupted ? 'Active' : screenShareInterrupted ? 'Interrupted' : 'Required';
        }

        const updateSubmitAvailability = () => {
            if (!submitButton)
                return;

            updateAnswerInputState();

            const trimmedAnswer = (answerBox.value || '').trim();
            const disableSubmit = answerBox.disabled
                || !interviewStarted
                || runtimeStoppedOrCompleted
                || stopInProgress
                || !isCameraActive()
                || !isMicActive()
                || isScreenShareBlockingInterview()
                || interviewUnavailable
                || !hasActiveQuestion()
                || !trimmedAnswer;
            submitButton.disabled = disableSubmit;
            if (primaryActionButton && interviewStarted && !runtimeStoppedOrCompleted && !isRequiredMediaBlockingInterview())
                primaryActionButton.disabled = disableSubmit;
        };

        const sendGuidelinesAcknowledgementAudit = async (payload) => {
            if (!config.acknowledgeGuidelinesUrl || !payload)
                return;

            try {
                const result = await postForm(config.acknowledgeGuidelinesUrl, new URLSearchParams({
                    token: sessionToken,
                    acknowledgedTimestamp: payload.acknowledgedTimestamp || '',
                    userAgent: payload.userAgent || '',
                    screenSize: payload.screenSize || '',
                    viewportSize: payload.viewportSize || ''
                }));

                if (!isSuccess(result)) {
                    logActivity(`Guidelines acknowledgement audit failed: ${getRuntimeMessage(result, 'Unavailable')}`);
                    console.warn('[AIInterview Runtime] Guidelines acknowledgement audit failed.', result);
                    return;
                }

                logActivity('Guidelines acknowledgement audit logged.');
            } catch (error) {
                logActivity(`Guidelines acknowledgement audit exception: ${error?.message || 'unknown'}`);
                console.warn('[AIInterview Runtime] Guidelines acknowledgement audit exception.', error);
            }
        };

        const onScreenShareInterrupted = async () => {
            screenShareActive = false;
            screenShareInterrupted = true;
            screenShareAudioAvailable = false;
            clearAnswerTimers();
            await stopSpeechRecognition();
            if (recordingEnabled && mediaRecorder)
                await stopRecording(false, { preserveSegment: true, statusMessage: 'Recording paused until screen sharing resumes.' });
            refreshRecordingAudioMix();
            setScreenShareStatus('Screen sharing required');
            setScreenShareInterruptionWarning(true);
            updateStartButtonState();
            updateSubmitAvailability();
            updateAuxiliaryControlsState();
            if (recordingEnabled)
                logActivity('Recording paused until screen sharing resumes.');
        };

        const updateGuidelinesAcknowledgementState = () => {
            if (guidelinesCheckbox)
                permissionState.consent = guidelinesCheckbox.checked;

            if (permissionBackButton)
                permissionBackButton.disabled = permissionActiveStep === 0;

            if (permissionNextButton) {
                const isSummaryStep = permissionActiveStep === permissionSteps.length - 1;
                permissionNextButton.classList.toggle('runtime-js-hidden', isSummaryStep);
                permissionNextButton.disabled = isSummaryStep || !isPermissionStepComplete(permissionActiveStep);
            }

            if (guidelinesAgreeButton) {
                const isSummaryStep = permissionActiveStep === permissionSteps.length - 1;
                guidelinesAgreeButton.classList.toggle('runtime-js-hidden', !isSummaryStep);
                guidelinesAgreeButton.disabled = !isSummaryStep || !permissionState.consent;
            }
        };

        const requestScreenShareForInterviewStart = async () => {
            if (screenShareStream?.getTracks?.().some(track => track.readyState === 'live')) {
                screenShareActive = true;
                screenShareInterrupted = false;
                setScreenShareInterruptionWarning(false);
                updateScreenShareAudioNotice();
                refreshRecordingAudioMix();
                clearRecoveredMediaBlockingStatus();
                updateAuxiliaryControlsState();
                return true;
            }

            if (!navigator.mediaDevices?.getDisplayMedia) {
                setStatus('Screen sharing is required, but this browser does not support it.', true);
                logActivity('Screen sharing unavailable in this browser.');
                return false;
            }

            try {
                screenShareStream = await navigator.mediaDevices.getDisplayMedia({
                    video: true,
                    audio: true,
                    systemAudio: 'include',
                    surfaceSwitching: 'include',
                    selfBrowserSurface: 'exclude'
                });
                screenShareActive = true;
                screenShareInterrupted = false;
                setScreenShareInterruptionWarning(false);
                updateScreenShareAudioNotice(true);
                refreshRecordingAudioMix();
                clearRecoveredMediaBlockingStatus();
                const [screenTrack] = screenShareStream.getVideoTracks();
                if (screenTrack) {
                    screenTrack.addEventListener('ended', async () => {
                        screenShareStream = null;
                        if (!runtimeStoppedOrCompleted && !stopInProgress)
                            await onScreenShareInterrupted();
                    });
                }

                if (screenShareAudioAvailable)
                    logActivity('Screen sharing started.');
                updateStartButtonState();
                updateSubmitAvailability();
                updateAuxiliaryControlsState();
                if (recordingEnabled)
                    await syncRecording();
                return true;
            } catch (error) {
                stopScreenShare();
                screenShareAudioAvailable = false;
                logActivity('Screen sharing was denied or cancelled.');
                setStatus('Screen sharing is required to start the interview.', true);
                updateAuxiliaryControlsState();
                return false;
            }
        };

        const showUnavailableQuestionState = (message = 'AI service unavailable. Please try again later.') => {
            interviewUnavailable = true;
            clearAnswerTimers();
            setRuntimeCaption('', '');
            updateAnswerInputState();
            setStatus(message, true);
            updateSubmitAvailability();
        };

        const ensureRuntimeTokenFresh = async () => {
            if (runtimeStoppedOrCompleted || stopInProgress)
                return false;

            if (!tokenExpiryUtc || isNaN(tokenExpiryUtc.getTime())) {
                logActivity('Interview session token expiry is unavailable.');
                setStatus('Unable to continue the interview because the interview session deadline is unavailable. Please reload and try again.', true);
                return false;
            }

            if (tokenExpiryUtc.getTime() > Date.now())
                return true;

            logActivity('Interview session token expired.');
            setStatus('Unable to continue the interview because the interview session has expired. Please reload and try again.', true);
            return false;
        };

        const withTimeout = (promise, timeoutMs, timeoutMessage) => {
            let timeoutHandle = null;
            const timeoutPromise = new Promise((_, reject) => {
                timeoutHandle = setTimeout(() => reject(new Error(timeoutMessage || 'Operation timed out.')), timeoutMs);
            });

            return Promise.race([promise, timeoutPromise]).finally(() => clearTimeout(timeoutHandle));
        };

        const showReminder = async () => {
            if (!interviewStarted || isSpeakingOrSubmitting || !hasActiveQuestion() || isScreenShareBlockingInterview())
                return;

            logActivity('Reminder shown.');
            setStatus('Please speak or type something.', false);
            if (config.speechAvailable) {
                try {
                    await speakText('Please speak or type something.', 'reminder');
                } catch {
                    logActivity('Reminder speech failed.');
                }
            }

            const currentText = (answerBox.value || '').trim();
            if (!currentText && interviewStarted && !isSpeakingOrSubmitting && hasActiveQuestion() && !isScreenShareBlockingInterview())
                resetTimers();
        };

        const stopLiveMediaForCompletion = async () => {
            if (completionLiveMediaStopPromise)
                return completionLiveMediaStopPromise;

            completionLiveMediaStopPromise = (async () => {
                try {
                    stopScreenShare();
                    setScreenShareInterruptionWarning(false);
                    if (recordingButton)
                        recordingButton.disabled = true;
                    cameraStream?.getTracks().forEach(track => track.stop());
                    cameraStream = null;
                    await stopMicStream();
                    video.srcObject = null;
                    video.style.display = 'none';
                    cameraPlaceholder.style.display = '';
                    await stopSpeechRecognition();
                    updateAnswerInputState();
                    updateStartButtonState();
                    updateAuxiliaryControlsState();
                } catch (error) {
                    logActivity(`Completion live media stop failed: ${error?.message || 'unknown'}`);
                }

                closeRecordingAudioMix();
            })();

            return completionLiveMediaStopPromise;
        };

        const finalizeRecordingBeforeCompletion = async () => {
            if (completionRecordingCleanupPromise)
                return completionRecordingCleanupPromise;

            completionRecordingCleanupPromise = (async () => {
                if (!config.recordingAvailable || !recordingEnabled)
                {
                    await stopLiveMediaForCompletion();
                    return false;
                }

                if (!mediaRecorder && preservedRecordingSegments.length === 0 && recordingChunks.length === 0) {
                    setRecordingStatus('', false);
                    await stopLiveMediaForCompletion();
                    return false;
                }

                try {
                    setRecordingStatus('Uploading interview recording...', false, true);
                    logActivity('Final recording upload before completion started.');
                    const uploaded = await stopRecording(true);
                    logActivity('Final recording upload before completion finished.');
                    if (uploaded || (recordingStatus?.textContent || '') === 'Uploading interview recording...')
                        setRecordingStatus('', false);
                    await stopLiveMediaForCompletion();
                    return uploaded;
                } catch (error) {
                    const message = error?.message || 'Recording upload failed.';
                    logActivity(`Final recording upload before completion failed: ${message}`);
                    setRecordingStatus(
                        runtimeStoppedOrCompleted
                            ? 'Recording upload did not finish. Report generation continues.'
                            : 'Recording upload failed. Continuing to report.',
                        !runtimeStoppedOrCompleted,
                        runtimeStoppedOrCompleted);
                    await stopLiveMediaForCompletion();
                    return false;
                }
            })();

            return completionRecordingCleanupPromise;
        };

        const updateReportButton = (reportUrl) => {
            if (!reportButton || !reportReadyAction)
                return;

            const normalizedReportUrl = typeof reportUrl === 'string' ? reportUrl.trim() : '';
            if (normalizedReportUrl) {
                reportReadyAction.classList.remove('runtime-js-hidden');
                reportButton.classList.remove('runtime-js-hidden');
                reportButton.onclick = () => navigateToReport(normalizedReportUrl);
                return;
            }

            reportReadyAction.classList.add('runtime-js-hidden');
            reportButton.classList.add('runtime-js-hidden');
            reportButton.onclick = null;
        };

        const navigateToReport = (reportUrl) => {
            if (!reportUrl || reportNavigationStarted)
                return;

            reportNavigationStarted = true;
            window.location.href = reportUrl;
        };

        const renderCompletionWaitState = (remainingSeconds) => {
            setHeaderStatus(`${reportGenerationMessage} Time remaining: ${formatCountdown(remainingSeconds)}`, false);
            updateReportButton('');
        };

        const stopCompletionStatusPolling = () => {
            clearInterval(completionStatusTimer);
            completionStatusTimer = null;
            completionStatusRequestInFlight = false;
        };

        const pollCompletionStatusOnce = async (generation) => {
            if (!config.completionStatusUrl || completionStatusRequestInFlight || generation !== completionWaitGeneration)
                return;

            completionStatusRequestInFlight = true;
            try {
                const result = await postForm(config.completionStatusUrl, new URLSearchParams({ token: sessionToken }));
                if (generation !== completionWaitGeneration)
                    return;

                const reportReady = getValue(result, 'reportReady', 'ReportReady') === true;
                const reportFailed = getValue(result, 'reportGenerationFailed', 'ReportGenerationFailed') === true;
                const reportInProgress = getValue(result, 'reportGenerationInProgress', 'ReportGenerationInProgress') === true;
                const reportUrl = getValue(result, 'reportUrl', 'ReportUrl') || '';
                if (!reportReady || !reportUrl)
                    updateReportButton('');

                if (reportReady && reportUrl) {
                    stopCompletionStatusPolling();
                    clearInterval(completedCountdown);
                    completedCountdown = null;
                    setHeaderStatus('Your report is ready.', false);
                    updateReportButton(reportUrl);
                    return;
                }

                if (reportFailed || (!reportInProgress && !reportReady)) {
                    stopCompletionStatusPolling();
                    clearInterval(completedCountdown);
                    completedCountdown = null;
                    setHeaderStatus(getRuntimeMessage(result, 'Report generation failed. Please contact support if the report is not available from your interview history.'), true);
                    updateReportButton('');
                }
            } catch (error) {
                logActivity(`Completion status polling failed: ${error?.message || 'unknown'}`);
            } finally {
                completionStatusRequestInFlight = false;
            }
        };

        const startCompletionStatusPolling = (generation) => {
            stopCompletionStatusPolling();
            if (!config.completionStatusUrl)
                return;

            pollCompletionStatusOnce(generation);
            completionStatusTimer = setInterval(() => pollCompletionStatusOnce(generation), 3000);
        };

        const startReportGenerationWaitingState = (estimatedWaitSeconds = completionWaitSeconds) => {
            clearCompletedRedirectState();
            const generation = completionWaitGeneration;
            let remaining = Math.max(0, Number(estimatedWaitSeconds || completionWaitSeconds));
            const renderRemaining = () => {
                renderCompletionWaitState(remaining);
            };

            setStatus('', false);
            renderRemaining();
            startCompletionStatusPolling(generation);
            completedCountdown = setInterval(() => {
                if (generation !== completionWaitGeneration)
                    return;

                remaining = Math.max(0, remaining - 1);
                renderRemaining();
                if (remaining <= 0) {
                    clearInterval(completedCountdown);
                    completedCountdown = null;
                }
            }, 1000);
        };

        const finalizeCompletedState = async (result) => {
            isSpeakingOrSubmitting = true;
            try {
                const recordingUploaded = await withTimeout(
                    finalizeRecordingBeforeCompletion(),
                    finalizationWaitTimeoutMs,
                    'Recording upload timed out.');

                if (!recordingUploaded && config.recordingAvailable && recordingEnabled) {
                    logActivity('recording-upload-failed-before-report-redirect');
                    setRecordingStatus('Recording upload did not finish. Your report is ready.', false, true);
                }
            } catch (error) {
                const message = error?.message || 'Completion finalization failed.';
                logActivity(`Completion finalization failed: ${message}`);
                setRecordingStatus('Recording cleanup is still finishing. Report generation continues.', false, true);
            }
            recordingEnabled = false;
            await stopLiveMediaForCompletion();
            updateAnswerInputState();
            updateStartButtonState();
            updateAuxiliaryControlsState();
        };

        const setCompletedState = async (result) => {
            runtimeStoppedOrCompleted = true;
            stopInProgress = false;
            clearActiveInterviewTimers();
            interviewStarted = false;
            answerNeedsEditAfterFailure = false;
            setRuntimeCaption('', '');
            setStatus('', false);
            messageBox.classList.add('runtime-js-hidden');
            updateAnswerInputState();
            submitButton.disabled = true;
            updateStartButtonState();
            startReportGenerationWaitingState(getValue(result, 'estimatedWaitSeconds', 'EstimatedWaitSeconds') || completionWaitSeconds);
            updateAuxiliaryControlsState();
        };

        const normalizeTurn = (turn, index = 0) => {
            if (!turn)
                return null;

            return {
                turnId: getValue(turn, 'turnId', 'TurnId') ?? Date.now() + index,
                sequenceNumber: getValue(turn, 'sequenceNumber', 'SequenceNumber') ?? index + 1,
                questionText: getValue(turn, 'questionText', 'QuestionText') || '',
                answerText: getValue(turn, 'answerText', 'AnswerText') || '',
                askedOnUtc: getValue(turn, 'askedOnUtc', 'AskedOnUtc') || null,
                answeredOnUtc: getValue(turn, 'answeredOnUtc', 'AnsweredOnUtc') || null
            };
        };

        const buildChatMessage = (role, text, options = {}) => {
            const message = document.createElement('div');
            message.className = `runtime-chat-message is-${role}`;

            const avatar = document.createElement('div');
            avatar.className = 'runtime-chat-avatar';
            const icon = document.createElement('i');
            icon.className = role === 'bot' ? 'fa-solid fa-robot' : 'fa-solid fa-user';
            icon.setAttribute('aria-hidden', 'true');
            avatar.appendChild(icon);

            const bubble = document.createElement('div');
            bubble.className = 'runtime-chat-bubble';

            const label = document.createElement('div');
            label.className = 'runtime-chat-label';
            label.textContent = role === 'bot' ? 'AI Interviewer' : 'You';

            const body = document.createElement('div');
            body.className = 'runtime-chat-text';
            body.textContent = text || '';

            bubble.appendChild(label);
            bubble.appendChild(body);

            if (options.pending) {
                const pending = document.createElement('div');
                pending.className = 'runtime-chat-meta';
                pending.textContent = 'Awaiting answer...';
                bubble.appendChild(pending);
            }

            message.appendChild(avatar);
            message.appendChild(bubble);
            return message;
        };

        const buildChatPlaceholder = (title, message) => {
            const placeholder = document.createElement('div');
            placeholder.className = 'runtime-chat-placeholder';

            const iconWrap = document.createElement('div');
            iconWrap.className = 'runtime-chat-placeholder-icon';
            const icon = document.createElement('i');
            icon.className = 'fa-solid fa-comments';
            icon.setAttribute('aria-hidden', 'true');
            iconWrap.appendChild(icon);

            const copy = document.createElement('div');
            copy.className = 'runtime-chat-placeholder-copy';

            const heading = document.createElement('div');
            heading.className = 'runtime-chat-placeholder-title';
            heading.textContent = title || 'Welcome! Click Start Interview to begin.';

            const body = document.createElement('div');
            body.className = 'runtime-chat-placeholder-text';
            body.textContent = message || 'Click Start Interview to begin.';

            copy.appendChild(heading);
            copy.appendChild(body);
            placeholder.appendChild(iconWrap);
            placeholder.appendChild(copy);
            return placeholder;
        };

        const buildTurnCard = (turn, index) => {
            const normalizedTurn = normalizeTurn(turn, index) || {};
            const card = document.createElement('div');
            card.className = 'turn-card';

            const question = document.createElement('div');
            question.className = 'turn-question';
            question.textContent = `Q${normalizedTurn.sequenceNumber || index + 1}. ${normalizedTurn.questionText || ''}`;

            const answer = document.createElement('div');
            answer.className = 'turn-answer';
            if (normalizedTurn.answerText) {
                answer.textContent = normalizedTurn.answerText;
            } else {
                const pending = document.createElement('em');
                pending.textContent = 'Awaiting answer...';
                answer.appendChild(pending);
            }

            const meta = document.createElement('div');
            meta.className = 'turn-meta';

            const status = document.createElement('span');
            status.textContent = normalizedTurn.answerText ? 'Answer saved.' : 'Awaiting answer...';
            meta.appendChild(status);
            card.appendChild(question);
            card.appendChild(answer);
            card.appendChild(meta);
            return card;
        };

        const renderTranscript = () => {
            transcriptBody.replaceChildren();
            conversation.replaceChildren();
            const turnState = getTurnState();
            const normalizedTurns = turnState.normalizedTurns;
            if (!normalizedTurns.length) {
                if (hasActiveQuestion())
                    conversation.appendChild(buildChatMessage('bot', currentQuestionText(), { pending: interviewStarted }));
                else
                    conversation.appendChild(buildChatPlaceholder(currentQuestionText(), (messageBox.textContent || '').trim()));
            }
            normalizedTurns.forEach((turn, index) => {
                const transcriptCard = buildTurnCard(turn, index);
                if (turn?.questionText)
                    conversation.appendChild(buildChatMessage('bot', turn.questionText, { pending: !turn.answerText }));
                if (turn?.answerText)
                    conversation.appendChild(buildChatMessage('user', turn.answerText));
                transcriptBody.appendChild(transcriptCard);
            });

            const answered = turnState.answeredCount;
            const activeQuestionNumber = turnState.currentQuestionNumber || (interviewStarted && hasActiveQuestion() ? 1 : 0);
            const progress = Math.min(100, Math.max(0, (answered / totalQuestions) * 100));
            progressBar.style.width = `${progress}%`;
            if (questionCounter) {
                questionCounter.textContent = activeQuestionNumber > 0 ? `Question ${activeQuestionNumber}/${totalQuestions}` : '';
                questionCounter.classList.toggle('runtime-js-hidden', activeQuestionNumber <= 0);
                questionCounter.hidden = activeQuestionNumber <= 0;
            }
            if (questionCountDetails)
                questionCountDetails.textContent = `${answered} / ${totalQuestions} answered`;
            conversation.scrollTop = conversation.scrollHeight;
            transcriptBody.scrollTop = transcriptBody.scrollHeight;
        };

        const normalizeRuntimeFailureMessage = (message) => {
            const normalized = (message || '')
                .replace(/[\r\n]+/g, ' ')
                .replace(/[^\w\s.,:;!?()_-]/g, ' ')
                .replace(/\s+/g, ' ')
                .trim();
            return normalized.length > 180 ? normalized.slice(0, 180) : normalized;
        };

        const getRuntimeRequestName = (url) => {
            try {
                const loggingPath = config.runtimeClientEventUrl
                    ? new URL(config.runtimeClientEventUrl, window.location.origin).pathname.toLowerCase()
                    : '';
                const requestPath = new URL(url || '', window.location.origin).pathname.toLowerCase();
                if (loggingPath && requestPath === loggingPath)
                    return 'runtime-client-event';

                if (requestPath.endsWith('/submit-answer')) return 'submit-answer';
                if (requestPath.endsWith('/begin')) return 'begin';
                if (requestPath.endsWith('/prepare')) return 'prepare';
                if (requestPath.endsWith('/speech-token')) return 'speech-token';
                if (requestPath.endsWith('/speech-usage')) return 'speech-usage';
                if (requestPath.endsWith('/upload-recording')) return 'upload-recording';
                if (requestPath.endsWith('/refresh-token')) return 'refresh-token';
                if (requestPath.endsWith('/feedback')) return 'feedback';
                if (requestPath.endsWith('/acknowledge-guidelines')) return 'acknowledge-guidelines';
                if (requestPath.endsWith('/stop')) return 'stop';
            } catch {}

            return 'unknown';
        };

        const shouldIgnoreCompletedAsyncFailure = (requestName) => {
            if (!runtimeStoppedOrCompleted)
                return false;

            return !['feedback', 'runtime-client-event', 'upload-recording'].includes(requestName || 'unknown');
        };

        const reportRuntimeClientRequestFailure = (event) => {
            if (!config.runtimeClientEventUrl || !event || event.requestName === 'runtime-client-event')
                return;

            try {
                const payload = new URLSearchParams({
                    token: sessionToken,
                    eventType: 'network-request-failed',
                    requestName: event.requestName || 'unknown',
                    failureKind: event.failureKind || 'unknown',
                    message: normalizeRuntimeFailureMessage(event.message || 'Runtime request failed.'),
                    elapsedMilliseconds: String(Math.max(0, Math.round(event.elapsedMilliseconds || 0)))
                });

                if (Number.isFinite(event.statusCode))
                    payload.append('statusCode', String(event.statusCode));

                fetch(config.runtimeClientEventUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: payload
                }).catch(error => logActivity(`Runtime client-event log failed: ${error?.message || 'unknown'}`));
            } catch (error) {
                logActivity(`Runtime client-event log skipped: ${error?.message || 'unknown'}`);
            }
        };

        const reportRuntimeClientStageTiming = (stageName, elapsedMilliseconds, success = true, token = null) => {
            if (!config.runtimeClientEventUrl || !stageName)
                return;

            try {
                const payload = new URLSearchParams({
                    token: token || sessionToken,
                    eventType: 'stage-timing',
                    requestName: stageName,
                    elapsedMilliseconds: String(Math.max(0, Math.round(elapsedMilliseconds || 0))),
                    success: success === true ? 'true' : 'false'
                });

                fetch(config.runtimeClientEventUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: payload
                }).catch(error => logActivity(`Runtime client-stage log failed: ${error?.message || 'unknown'}`));
            } catch (error) {
                logActivity(`Runtime client-stage log skipped: ${error?.message || 'unknown'}`);
            }
        };

        if (completionUploadTimeoutMismatch) {
            reportRuntimeClientRequestFailure({
                requestName: 'upload-recording',
                failureKind: 'completion-upload-timeout-mismatch',
                message: `Completion finalization timeout ${receivedFinalizationWaitTimeoutMs}ms is less than required minimum ${minimumFinalizationWaitMs}ms.`,
                elapsedMilliseconds: 0
            });
        }

        const postForm = async (url, formData) => {
            logActivity('Request started.');
            const requestName = getRuntimeRequestName(url);
            const requestStartedAt = performance.now();
            try {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: formData
                });

                if (!response.ok) {
                    const text = await response.text();
                    let msg = 'Unable to reach the interview service.';
                    try {
                        const parsed = JSON.parse(text);
                        msg = getRuntimeMessage(parsed, msg);
                    } catch {}
                    logActivity(`Request failed (${response.status}): ${msg}`);
                    reportRuntimeClientRequestFailure({
                        requestName,
                        statusCode: response.status,
                        failureKind: 'http-status',
                        message: msg,
                        elapsedMilliseconds: performance.now() - requestStartedAt
                    });
                    if (shouldIgnoreCompletedAsyncFailure(requestName))
                        return { success: false, ignored: true, message: '' };

                    return { success: false, message: msg, status: response.status };
                }

                try {
                    const result = await response.json();
                    logActivity('Request success.');
                    return result;
                } catch {
                    logActivity(`Request failed: Invalid JSON response.`);
                    reportRuntimeClientRequestFailure({
                        requestName,
                        statusCode: response.status,
                        failureKind: 'invalid-json',
                        message: 'Invalid JSON response from server.',
                        elapsedMilliseconds: performance.now() - requestStartedAt
                    });
                    if (shouldIgnoreCompletedAsyncFailure(requestName))
                        return { success: false, ignored: true, message: '' };

                    return { success: false, message: 'Invalid response from server.' };
                }
            } catch (e) {
                logActivity(`Request error: ${e.message}`);
                reportRuntimeClientRequestFailure({
                    requestName,
                    failureKind: 'fetch-exception',
                    message: e?.message || 'Network request failed.',
                    elapsedMilliseconds: performance.now() - requestStartedAt
                });
                if (shouldIgnoreCompletedAsyncFailure(requestName))
                    return { success: false, ignored: true, message: '' };

                return { success: false, message: 'Unable to reach the interview service. Please check your network and try again.' };
            }
        };

        let prepareInterviewPromise = null;
        const startPrepareInterview = () => {
            if (!config.prepareInterviewUrl || prepareInterviewPromise)
                return prepareInterviewPromise;

            prepareInterviewPromise = (async () => {
                if (!(await ensureRuntimeTokenFresh()))
                    return null;

                logActivity('Runtime preparation started.');
                const prepareStartedAt = performance.now();
                const prepareToken = sessionToken;
                const result = await postForm(config.prepareInterviewUrl, new URLSearchParams({ token: prepareToken }));
                const ready = !!getValue(result, 'ready', 'Ready');
                if (isSuccess(result) && ready) {
                    const prepareTelemetryToken = sessionToken;
                    preloadSpeechResources();
                    reportRuntimeClientStageTiming('prepare-response', performance.now() - prepareStartedAt, true, prepareTelemetryToken);
                }
                const expected = getValue(result, 'expectedQuestionCount', 'ExpectedQuestionCount');
                const persisted = getValue(result, 'persistedQuestionCount', 'PersistedQuestionCount');
                logActivity(`Runtime preparation finished. ready=${ready}; persisted=${persisted}; expected=${expected}`);
                return result;
            })().finally(() => {
                prepareInterviewPromise = null;
            });

            return prepareInterviewPromise;
        };

        const postMultipart = async (url, formData, timeoutMs = 0) => {
            logActivity('Multipart request started.');
            const requestName = getRuntimeRequestName(url);
            const requestStartedAt = performance.now();
            const abortController = timeoutMs > 0 && window.AbortController ? new AbortController() : null;
            const abortTimer = abortController
                ? setTimeout(() => abortController.abort(), timeoutMs)
                : null;
            try {
                const response = await fetch(url, {
                    method: 'POST',
                    body: formData,
                    signal: abortController?.signal
                });

                if (!response.ok) {
                    const text = await response.text();
                    let msg = 'Unable to reach the interview service.';
                    try {
                        const parsed = JSON.parse(text);
                        msg = getRuntimeMessage(parsed, msg);
                    } catch {}
                    logActivity(`Multipart request failed (${response.status}): ${msg}`);
                    reportRuntimeClientRequestFailure({
                        requestName,
                        statusCode: response.status,
                        failureKind: 'http-status',
                        message: msg,
                        elapsedMilliseconds: performance.now() - requestStartedAt
                    });
                    if (shouldIgnoreCompletedAsyncFailure(requestName))
                        return { success: false, ignored: true, message: '' };

                    return { success: false, message: msg, status: response.status };
                }

                const contentType = response.headers.get('content-type') || '';
                if (!contentType.includes('application/json')) {
                    logActivity(`Multipart request failed: non-JSON response.`);
                    reportRuntimeClientRequestFailure({
                        requestName,
                        statusCode: response.status,
                        failureKind: 'non-json-response',
                        message: 'Non-JSON response from server.',
                        elapsedMilliseconds: performance.now() - requestStartedAt
                    });
                    if (shouldIgnoreCompletedAsyncFailure(requestName))
                        return { success: false, ignored: true, message: '' };

                    return { success: false, message: 'Invalid response format from server.' };
                }

                try {
                    const result = await response.json();
                    logActivity('Multipart request success.');
                    return result;
                } catch {
                    logActivity(`Multipart request failed: Invalid JSON response.`);
                    reportRuntimeClientRequestFailure({
                        requestName,
                        statusCode: response.status,
                        failureKind: 'invalid-json',
                        message: 'Invalid JSON response from server.',
                        elapsedMilliseconds: performance.now() - requestStartedAt
                    });
                    if (shouldIgnoreCompletedAsyncFailure(requestName))
                        return { success: false, ignored: true, message: '' };

                    return { success: false, message: 'Invalid response from server.' };
                }
            } catch (e) {
                const timedOut = e?.name === 'AbortError';
                const message = timedOut ? 'Recording upload timed out.' : e?.message;
                logActivity(`Multipart request error: ${message}`);
                reportRuntimeClientRequestFailure({
                    requestName,
                    failureKind: 'fetch-exception',
                    message: message || 'Network request failed.',
                    elapsedMilliseconds: performance.now() - requestStartedAt
                });
                if (shouldIgnoreCompletedAsyncFailure(requestName))
                    return { success: false, ignored: true, message: '' };

                return { success: false, message: timedOut ? 'Recording upload timed out.' : 'Unable to reach the interview service. Please check your network and try again.' };
            } finally {
                if (abortTimer)
                    clearTimeout(abortTimer);
            }
        };

        const getActiveRecordingStream = () => {
            const tracks = [];
            const seenTrackIds = new Set();
            const signature = getRecordingSignature();
            if (!mediaRecorder && signature !== recordingStreamSignature)
                refreshRecordingAudioMix();

            tracks.push(...getRecordingVideoTracks().filter(track => !seenTrackIds.has(track.id) && seenTrackIds.add(track.id)));

            const mixedAudioTracks = recordingAudioDestination?.stream?.getAudioTracks?.().filter(track => track.readyState === 'live') || [];
            if (mixedAudioTracks.length) {
                tracks.push(...mixedAudioTracks.filter(track => !seenTrackIds.has(track.id) && seenTrackIds.add(track.id)));
            } else {
                if (screenShareStream?.getTracks)
                    tracks.push(...screenShareStream.getTracks().filter(track => track.kind === 'audio' && track.readyState === 'live' && !seenTrackIds.has(track.id) && seenTrackIds.add(track.id)));
                if (micStream?.getTracks)
                    tracks.push(...micStream.getTracks().filter(track => track.kind === 'audio' && track.readyState === 'live' && !seenTrackIds.has(track.id) && seenTrackIds.add(track.id)));
            }

            return tracks.length ? new MediaStream(tracks) : null;
        };

        const clearPreservedRecordingSegments = () => {
            preservedRecordingSegments = [];
        };

        const canStartRecording = () => {
            if (!config.recordingAvailable || !recordingEnabled || !interviewStarted)
                return false;

            if (screenShareRequired && (!screenShareActive || screenShareInterrupted))
                return false;

            return !!getActiveRecordingStream();
        };

        const requestRecordingMediaForStart = async () => {
            if (!config.recordingAvailable || !recordingEnabled)
                return false;

            if (getActiveRecordingStream())
                return true;

            if (screenShareActive && getActiveRecordingStream()) {
                logActivity('Recording ready.');
                return true;
            }

            if (!navigator.mediaDevices?.getUserMedia) {
                logActivity(screenShareActive ? 'Recording ready with screen share.' : 'Recording waiting for screen share, camera, or microphone.');
                return false;
            }

            await setCamera(true, true);
            if (getActiveRecordingStream()) {
                logActivity('Recording ready.');
                return true;
            }

            await setMic(true, true);
            if (getActiveRecordingStream()) {
                logActivity('Recording ready.');
                return true;
            }

            if (screenShareActive && getActiveRecordingStream()) {
                logActivity('Recording ready with screen share.');
                return true;
            }

            logActivity('Recording waiting for screen share, camera, or microphone.');
            return false;
        };

        const ensureRequiredMediaReady = async () => {
            await setCamera(true, true);
            await setMic(true, true);

            if (!isCameraActive() || !isMicActive()) {
                const missingCamera = !isCameraActive();
                const missingMic = !isMicActive();
                let message = 'Camera and microphone access are required to start the interview.';
                if (missingCamera && !missingMic)
                    message = 'Camera access is required to start the interview.';
                else if (!missingCamera && missingMic)
                    message = 'Microphone access is required to start the interview.';

                setStatus(message, true);
                updateSubmitAvailability();
                updateStartButtonState();
                updateAuxiliaryControlsState();
                return false;
            }

            return true;
        };

        const uploadRecording = async (blob) => {
            if (!config.recordingUploadUrl || !blob || recordingUploadInFlight)
                return false;

            if ((blob.size || 0) > recordingUploadMaxBytes) {
                const maxMb = Math.round(recordingUploadMaxBytes / 1024 / 1024);
                logActivity(`Recording upload blocked before request. blobBytes=${blob.size || 0}; maxBytes=${recordingUploadMaxBytes}`);
                setRecordingStatus(`Recording is larger than the ${maxMb} MB upload limit.`, true);
                return false;
            }

            recordingUploadInFlight = true;
            logActivity(`Recording upload request start. blobBytes=${blob.size || 0}`);
            try {
                const formData = new FormData();
                formData.append('token', sessionToken);
                formData.append('recording', blob, `interview-${Date.now()}.webm`);

                const result = await postMultipart(config.recordingUploadUrl, formData, recordingUploadTimeoutMs);
                const recordingUrl = getValue(result, 'recordingUrl', 'RecordingUrl');
                if (isSuccess(result) && recordingUrl) {
                    logActivity(`Recording upload response success. url=${recordingUrl}`);
                    logActivity('Recording uploaded.');
                    return true;
                } else {
                    logActivity(`Recording upload response failure. message=${getRuntimeMessage(result, 'Recording upload failed.')}`);
                    setRecordingStatus(getRuntimeMessage(result, 'Recording upload failed.'), true);
                    return false;
                }
            } catch (error) {
                logActivity(`Recording upload request exception. message=${error?.message || 'unknown'}`);
                setRecordingStatus('Recording upload failed.', true);
                return false;
            } finally {
                recordingUploadInFlight = false;
            }
        };

        const stopRecording = async (upload = false, options = {}) => {
            if (!mediaRecorder) {
                if (upload && preservedRecordingSegments.length > 0) {
                    const preservedBlob = preservedRecordingSegments.length === 1
                        ? preservedRecordingSegments[0]
                        : new Blob(preservedRecordingSegments, { type: recordingMimeType || 'video/webm' });
                    const uploaded = await uploadRecording(preservedBlob);
                    clearPreservedRecordingSegments();
                    return uploaded;
                }

                return false;
            }

            const preserveSegment = options.preserveSegment === true;
            const statusMessage = options.statusMessage || '';
            const recorder = mediaRecorder;
            const mimeType = recordingMimeType || 'video/webm';
            mediaRecorder = null;
            activeRecordingSignature = '';
            let uploaded = false;

            await new Promise(resolve => {
                recorder.addEventListener('stop', async () => {
                    try {
                        const blob = recordingChunks.length ? new Blob(recordingChunks, { type: mimeType }) : null;
                        if (blob)
                            logActivity(`Recording segment finalized. segmentBytes=${blob.size || 0}; preserve=${preserveSegment}; upload=${upload}`);
                        recordingChunks = [];
                        if (blob && preserveSegment)
                            preservedRecordingSegments.push(blob);

                        if (upload) {
                            const segments = [...preservedRecordingSegments];
                            if (blob && !preserveSegment)
                                segments.push(blob);

                            if (segments.length > 0) {
                                const finalBlob = segments.length === 1 ? segments[0] : new Blob(segments, { type: mimeType });
                                logActivity(`Recording final blob ready. segments=${segments.length}; totalBytes=${finalBlob.size || 0}`);
                                uploaded = await uploadRecording(finalBlob);
                            }

                            clearPreservedRecordingSegments();
                        } else if (!preserveSegment) {
                            clearPreservedRecordingSegments();
                        }
                    } catch {
                        setRecordingStatus('Recording upload failed.', true);
                    } finally {
                        const toggleRecording = document.getElementById('toggle-recording');
                        if (toggleRecording)
                            updateAuxiliaryControlsState();
                        if (statusMessage)
                            logActivity(statusMessage);
                        resolve();
                    }
                }, { once: true });

                try {
                    recorder.stop();
                } catch {
                    recordingChunks = [];
                    if (!preserveSegment && !upload)
                        clearPreservedRecordingSegments();
                    resolve();
                }
            });

            return uploaded;
        };

        const startRecording = async () => {
            if (!config.recordingAvailable || mediaRecorder)
                return;

            const stream = getActiveRecordingStream();
            if (!stream) {
                setRecordingStatus('Enable screen share, camera, or microphone before recording.', true);
                return;
            }

            if (!window.MediaRecorder) {
                setRecordingStatus('Recording is not supported in this browser.', true);
                return;
            }

            try {
                const options = MediaRecorder.isTypeSupported('video/webm;codecs=vp9,opus')
                    ? { mimeType: 'video/webm;codecs=vp9,opus' }
                    : (MediaRecorder.isTypeSupported('video/webm') ? { mimeType: 'video/webm' } : {});
                options.videoBitsPerSecond = recordingVideoBitsPerSecond;
                options.audioBitsPerSecond = recordingAudioBitsPerSecond;
                logActivity(`MediaRecorder support confirmed. requestedMimeType=${options.mimeType || 'browser-default'}`);
                mediaRecorder = new MediaRecorder(stream, options);
                activeRecordingSignature = recordingStreamSignature || getRecordingSignature();
                recordingMimeType = mediaRecorder.mimeType || options.mimeType || 'video/webm';
                recordingChunks = [];
                mediaRecorder.addEventListener('dataavailable', event => {
                    if (event.data && event.data.size > 0) {
                        recordingChunks.push(event.data);
                        logActivity(`Recording chunk captured. chunkCount=${recordingChunks.length}; totalBytes=${getBlobByteSize(recordingChunks)}`);
                    }
                });
                mediaRecorder.start(1000);
                logActivity(`Recording start success. mimeType=${recordingMimeType}`);
                setRecordingStatus('Recording live.', false);
                if (mediaRecorder.state === 'recording')
                    reportRuntimeClientStageTiming('recording-started', 0, true);
                const toggleRecording = document.getElementById('toggle-recording');
                if (toggleRecording)
                    updateAuxiliaryControlsState();
            } catch (error) {
                mediaRecorder = null;
                activeRecordingSignature = '';
                recordingChunks = [];
                logActivity(`Recording start failure. reason=${error?.message || error?.name || 'unknown'}`);
                setRecordingStatus('Recording could not be started.', true);
            }
        };

        const syncRecording = async () => {
            if (!config.recordingAvailable)
                return;

            if (screenShareRequired && (!screenShareActive || screenShareInterrupted)) {
                if (recordingEnabled)
                    logActivity('Recording paused until screen sharing resumes.');
                return;
            }

            if (mediaRecorder && activeRecordingSignature && getRecordingSignature() !== activeRecordingSignature && canStartRecording()) {
                await stopRecording(false, { preserveSegment: true, statusMessage: 'Recording restarting with updated media tracks.' });
                await startRecording();
            } else if (canStartRecording()) {
                await startRecording();
            } else if (!getActiveRecordingStream() && recordingEnabled && mediaPermissionDenied && !screenShareActive) {
                logActivity('Recording is waiting for screen share because camera or microphone permission was denied.');
            } else if (!getActiveRecordingStream() && recordingEnabled) {
                logActivity('Recording waiting for screen share, camera, or microphone.');
            }
        };

        const ensureSpeechSdk = async () => {
            if (!config.speechAvailable)
                return false;
            if (window.SpeechSDK)
                return true;
            if (speechSdkLoading)
                return speechSdkLoading;

            speechSdkLoading = loadScriptOnce('https://cdn.jsdelivr.net/npm/microsoft-cognitiveservices-speech-sdk@latest/distrib/browser/microsoft.cognitiveservices.speech.sdk.bundle-min.js')
                .then(() => {
                    speechSdkLoaded = !!window.SpeechSDK;
                    return speechSdkLoaded;
                })
                .catch(() => {
                    speechSdkLoaded = false;
                    return false;
                });
            return speechSdkLoading;
        };


        const stopSpeechRecognition = async () => {
            appendRecognitionDuration();

            if (!speechRecognizer)
                return;

            await new Promise(resolve => {
                try {
                    speechRecognizer.stopContinuousRecognitionAsync(() => {
                        speechRecognizer.close();
                        speechRecognizer = null;
                        resolve();
                    }, () => {
                        speechRecognizer.close();
                        speechRecognizer = null;
                        resolve();
                    });
                } catch {
                    speechRecognizer = null;
                    resolve();
                }
            });
        };

        const disableSpeechForRuntime = async (message = voiceUnavailableMessage, options = {}) => {
            speechUnavailable = true;
            config.speechAvailable = false;
            await stopSpeechRecognition();
            updateAnswerInputState();
            updateAuxiliaryControlsState();
            updateStartButtonState();
            updateSubmitAvailability();
            if (!options.suppressCandidateMessage && canAcceptTypedAnswer())
                setHeaderStatus(message || voiceUnavailableMessage, true);
            logActivity(`Speech disabled for this page: ${message || voiceUnavailableMessage}`);
        };

        const requestSpeechToken = async (options = {}) => {
            if (runtimeStoppedOrCompleted)
                return null;
            if (speechUnavailable || !config.speechAvailable)
                return { success: false, message: voiceUnavailableMessage };
            if (!await ensureRuntimeTokenFresh())
                return null;

            if (speechTokenCache?.token && speechTokenCache.expiresAt > Date.now())
                return { success: true, token: speechTokenCache.token, region: speechTokenCache.region };

            if (speechTokenRequestPromise)
                return speechTokenRequestPromise;

            speechTokenRequestPromise = (async () => {
                const tokenStartedAt = performance.now();
                const tokenResult = await postForm(config.speechTokenUrl, new URLSearchParams({ token: sessionToken }));
                if (runtimeStoppedOrCompleted)
                    return null;

                const speechToken = getValue(tokenResult, 'token', 'Token');
                const region = getValue(tokenResult, 'region', 'Region');
                if (!tokenResult || !isSuccess(tokenResult) || !speechToken) {
                    const message = getRuntimeMessage(tokenResult, voiceUnavailableMessage);
                    speechTokenCache = null;
                    await disableSpeechForRuntime(message, options);
                    return { success: false, message: message };
                }

                const expiresInSeconds = Math.max(60, Number(getValue(tokenResult, 'expiresInSeconds', 'ExpiresInSeconds')) || 600);
                speechTokenCache = {
                    token: speechToken,
                    region,
                    expiresAt: Date.now() + Math.max(30000, (expiresInSeconds - 60) * 1000)
                };
                if (region)
                    reportRuntimeClientStageTiming('speech-token-ready', performance.now() - tokenStartedAt, true);
                return { success: true, token: speechToken, region: region };
            })().finally(() => {
                speechTokenRequestPromise = null;
            });

            return speechTokenRequestPromise;
        };

        const prefetchFinalCompletionSpeechToken = async () => {
            if (!config.speechAvailable || speechUnavailable)
                return null;

            try {
                const tokenResult = await requestSpeechToken({ suppressCandidateMessage: true });
                if (!tokenResult || !tokenResult.success)
                    logActivity(`Final completion speech prefetch failed: ${tokenResult?.message || voiceUnavailableMessage}`);
                return tokenResult;
            } catch (error) {
                logActivity(`Final completion speech prefetch failed: ${error?.message || 'unknown'}`);
                return null;
            }
        };

        const preloadSpeechResources = () => {
            if (!config.speechAvailable || speechUnavailable || runtimeStoppedOrCompleted)
                return null;

            const preload = ensureSpeechSdk()
                .then(loaded => loaded ? requestSpeechToken() : null)
                .catch(error => {
                    logActivity(`Speech preload failed: ${error?.message || 'unknown'}`);
                    return null;
                });

            return preload;
        };

        const startSpeechRecognition = async () => {
            updateAnswerInputState();
            if (!canUseSpeechRecognition())
                return;
            if (runtimeStoppedOrCompleted)
                return;
            if (speechRecognizer)
                return;

            if (!(await ensureSpeechSdk())) {
                if (runtimeStoppedOrCompleted)
                    return;

                setStatus('Speech features are unavailable in this browser.', true);
                return;
            }

            const tokenResult = await requestSpeechToken();
            if (runtimeStoppedOrCompleted)
                return;

            if (!tokenResult || !tokenResult.success) {
                logActivity('Speech token request failure.');
                setStatus(getRuntimeMessage(tokenResult, voiceUnavailableMessage), true);
                return;
            }
            logActivity('Speech token request success.');

            try {
                const speechConfig = SpeechSDK.SpeechConfig.fromAuthorizationToken(tokenResult.token, tokenResult.region);
                speechConfig.speechRecognitionLanguage = 'en-US';
                let audioConfig = null;
                if (selectedAudioInputId && SpeechSDK.AudioConfig.fromMicrophoneInput) {
                    try {
                        audioConfig = SpeechSDK.AudioConfig.fromMicrophoneInput(selectedAudioInputId);
                    } catch (error) {
                        logActivity(`Selected speech microphone unavailable. reason=${error?.message || error?.name || 'unknown'}`);
                        selectedAudioInputId = '';
                        writeLocalStorageValue(audioInputStorageKey, '');
                        if (audioInputSelect)
                            audioInputSelect.value = '';
                    }
                }
                audioConfig ??= SpeechSDK.AudioConfig.fromDefaultMicrophoneInput();
                speechRecognizer = new SpeechSDK.SpeechRecognizer(speechConfig, audioConfig);
                recognitionActiveSinceMs ??= Date.now();

                speechRecognizer.recognizing = (_, e) => {
                    if (!canUseSpeechRecognition())
                        return;

                    const interimText = (e.result?.text || '').trim();
                    if (interimText) {
                        const committedText = (answerBox.value || '').trim();
                        const combinedText = `${committedText ? `${committedText} ` : ''}${interimText}`.trim();
                        setRuntimeCaption('You', combinedText);
                    }
                    resetTimers();
                };

                speechRecognizer.recognized = (_, e) => {
                    if (!canUseSpeechRecognition()) {
                        logActivity('Speech recognized result ignored because answer input is not accepting voice.');
                        return;
                    }

                    const recognizedText = (e.result?.text || '').trim();
                    if (e.result?.reason === SpeechSDK.ResultReason.RecognizedSpeech && recognizedText) {
                        answerBox.value = `${answerBox.value ? `${answerBox.value.trim()} ` : ''}${e.result.text}`.trim();
                        recognitionTurnCharacters += recognizedText.length;
                        pendingRecognitionClientEventId ??= createClientEventId();
                        logActivity('Speech recognized and appended.');
                        syncAnswerCaption();
                        updateSubmitAvailability();
                        resetTimers();
                    }
                };

                speechRecognizer.sessionStarted = () => {
                    recognitionActiveSinceMs ??= Date.now();
                    logActivity('Speech recognition session started.');
                };
                speechRecognizer.sessionStopped = () => {
                    appendRecognitionDuration();
                    logActivity('Speech recognition session stopped.');
                };
                speechRecognizer.speechStartDetected = () => {
                    recognitionActiveSinceMs ??= Date.now();
                    logActivity('Speech start detected.');
                };
                speechRecognizer.speechEndDetected = () => {
                    appendRecognitionDuration();
                    logActivity('Speech end detected.');
                };
                speechRecognizer.canceled = async (_, eventArgs) => {
                    appendRecognitionDuration();
                    const cancellationReason = eventArgs?.reason;
                    const cancellationDetails = (eventArgs?.errorDetails || '').trim();
                    const isSpeechError = cancellationReason === SpeechSDK.CancellationReason?.Error || !!cancellationDetails;
                    logActivity(`Speech recognition canceled. reason=${cancellationReason || 'unknown'} details=${cancellationDetails || 'none'}`);
                    if (runtimeStoppedOrCompleted)
                        return;

                    if (isSpeechError) {
                        await disableSpeechForRuntime(voiceInputUnavailableMessage);
                        setHeaderStatus(voiceInputUnavailableMessage, true);
                        return;
                    }

                    setStatus('Speech recognition stopped.', false);
                };

                await new Promise((resolve, reject) => {
                    speechRecognizer.startContinuousRecognitionAsync(resolve, reject);
                });
            } catch {
                appendRecognitionDuration();
                await stopSpeechRecognition();
                if (runtimeStoppedOrCompleted)
                    return;

                setStatus('Speech recognition could not be started.', true);
            }
        };

        const resumeSpeechRecognitionForActiveQuestion = async () => {
            updateAnswerInputState();
            if (canUseSpeechRecognition())
                await startSpeechRecognition();
        };

        const synthesizeSpeechAudioData = async (speechConfig, text, onSynthesisStarted = null) => {
            if (SpeechSDK.SpeechSynthesisOutputFormat?.Audio24Khz48KBitRateMonoMp3)
                speechConfig.speechSynthesisOutputFormat = SpeechSDK.SpeechSynthesisOutputFormat.Audio24Khz48KBitRateMonoMp3;

            const synthesizer = new SpeechSDK.SpeechSynthesizer(speechConfig, null);
            try {
                return await new Promise((resolve, reject) => {
                    synthesizer.speakTextAsync(text, (result) => {
                        if (result?.audioData?.byteLength) {
                            resolve(result.audioData);
                            return;
                        }

                        reject(new Error(result?.errorDetails || 'Speech synthesis produced no audio data.'));
                    }, (result) => {
                        reject(new Error(result?.errorDetails || result?.error || 'Speech synthesis failed.'));
                    });
                    onSynthesisStarted?.();
                });
            } finally {
                synthesizer.close();
            }
        };

        const playControlledSpeechAudio = async (audioData) => {
            const audioElement = ensureSpeechAudioElement();
            botAudioCapturedForCurrentSpeech = false;
            botAudioRecordingFallbackNotifiedForCurrentSpeech = false;
            revokeSpeechAudioObjectUrl();

            const audioBlob = new Blob([audioData], { type: 'audio/mpeg' });
            speechAudioObjectUrl = URL.createObjectURL(audioBlob);
            audioElement.src = speechAudioObjectUrl;
            audioElement.load?.();
            if (!hasLiveAudioTrack(speechAudioCaptureStream))
                speechAudioCaptureStream = null;
            await applySelectedAudioOutput(audioElement);

            speechAudioCaptureStream = getSpeechAudioCaptureStream();
            botAudioCapturedForCurrentSpeech = hasLiveAudioTrack(speechAudioCaptureStream);
            if (!botAudioCapturedForCurrentSpeech)
                noteBotAudioRecordingFallback();

            if (recordingEnabled)
                await syncRecording();

            await new Promise((resolve, reject) => {
                const cleanup = () => {
                    audioElement.removeEventListener('ended', handleEnded);
                    audioElement.removeEventListener('error', handleError);
                };
                const cleanupFailedPlayback = () => {
                    revokeSpeechAudioObjectUrl();
                    audioElement.removeAttribute('src');
                    audioElement.load?.();
                    speechAudioCaptureStream = null;
                    botAudioCapturedForCurrentSpeech = false;
                };
                const handleEnded = () => {
                    cleanup();
                    revokeSpeechAudioObjectUrl();
                    resolve();
                };
                const handleError = () => {
                    cleanup();
                    cleanupFailedPlayback();
                    reject(new Error('Speech audio playback failed.'));
                };

                audioElement.addEventListener('ended', handleEnded, { once: true });
                audioElement.addEventListener('error', handleError, { once: true });
                audioElement.currentTime = 0;
                audioElement.play().catch(error => {
                    cleanup();
                    cleanupFailedPlayback();
                    reject(error);
                });
            });
        };

        const speakTextWithDefaultOutput = async (speechConfig, text, onSynthesisStarted = null, options = {}) => {
            const synthesizer = new SpeechSDK.SpeechSynthesizer(speechConfig);
            const handleSynthesisCanceled = async (_, eventArgs) => {
                const cancellationDetails = (eventArgs?.errorDetails || '').trim();
                logActivity(`Speech synthesis canceled. ${cancellationDetails || 'No additional details.'}`);
                await disableSpeechForRuntime(voicePlaybackUnavailableMessage, options);
                if (!options.suppressCandidateMessage)
                    setHeaderStatus(voicePlaybackUnavailableMessage, true);
            };
            synthesizer.SynthesisCanceled = handleSynthesisCanceled;
            synthesizer.synthesisCanceled = handleSynthesisCanceled;
            try {
                await new Promise((resolve, reject) => {
                    synthesizer.speakTextAsync(text, () => {
                        resolve();
                    }, (result) => {
                        reject(new Error(result?.errorDetails || result?.error || 'Speech synthesis failed.'));
                    });
                    onSynthesisStarted?.();
                });
            } finally {
                synthesizer.close();
            }
        };

        const speakText = async (text, purpose = 'question', prefetchedTokenResult = undefined) => {
            if (!config.speechAvailable || !text || isPlaceholderSpeechText(text))
                return;

            const shouldStopRecognitionForPlayback = !!speechRecognizer && isMicActive();
            const shouldResumeRecognition = purpose !== 'completion' && shouldStopRecognitionForPlayback;
            if (shouldStopRecognitionForPlayback)
                await stopSpeechRecognition();

            if (!(await ensureSpeechSdk())) {
                if (purpose === 'completion')
                    logActivity('Final completion speech failed: Speech SDK unavailable.');
                return;
            }

            let ttsStartedAt = 0;
            let ttsStartedReported = false;
            const reportTtsStartedOnce = () => {
                if (purpose === 'completion')
                    return;

                if (ttsStartedReported)
                    return;

                ttsStartedReported = true;
                ttsStartedAt = performance.now();
                reportRuntimeClientStageTiming('tts-started', 0, true);
            };
            if (purpose === 'question')
                logActivity('Speaking question.');
            else if (purpose === 'reminder')
                logActivity('Speaking reminder.');
            else if (purpose === 'completion')
                logActivity('Speaking final completion message.');

            isSpeakingOrSubmitting = true;
            clearAnswerTimers();

            const tokenResult = prefetchedTokenResult !== undefined
                ? prefetchedTokenResult
                : await requestSpeechToken();
            if (!tokenResult || !tokenResult.success) {
                const failureReason = tokenResult?.message || voiceUnavailableMessage;
                if (purpose === 'completion')
                    logActivity(`Final completion speech failed: ${failureReason}`);
                else
                    logActivity(`${purpose === 'reminder' ? 'Reminder' : 'Question'} speech failed: ${failureReason}`);
                if (purpose !== 'completion' && !runtimeStoppedOrCompleted)
                    setHeaderStatus(failureReason, true);
                isSpeakingOrSubmitting = false;
                if (shouldResumeRecognition && !speechUnavailable && isMicActive())
                    await startSpeechRecognition();
                resetTimers();
                return;
            }

            try {
                const speechConfig = SpeechSDK.SpeechConfig.fromAuthorizationToken(tokenResult.token, tokenResult.region);
                if (purpose === 'question')
                    setHeaderStatus('Playing interviewer audio.', false);
                botAudioCapturedForCurrentSpeech = false;
                botAudioRecordingFallbackNotifiedForCurrentSpeech = false;

                try {
                    const audioData = await synthesizeSpeechAudioData(speechConfig, text, reportTtsStartedOnce);
                    await playControlledSpeechAudio(audioData);
                } catch (controlledPlaybackError) {
                    logActivity(`Controlled speech playback unavailable. reason=${controlledPlaybackError?.message || controlledPlaybackError?.name || 'unknown'}`);
                    noteBotAudioRecordingFallback();
                    await speakTextWithDefaultOutput(speechConfig, text, reportTtsStartedOnce, { suppressCandidateMessage: purpose === 'completion' });
                } finally {
                    if (purpose === 'question')
                        setHeaderStatus('', false);
                }

                if (purpose === 'question')
                    logActivity('Question speech completed.');
                else if (purpose === 'reminder')
                    logActivity('Reminder spoken.');
                else if (purpose === 'completion')
                    logActivity('Final completion message spoken.');
                if (purpose !== 'completion')
                    reportRuntimeClientStageTiming('tts-completed', performance.now() - ttsStartedAt, true);
                if (purpose === 'repeat')
                    setHeaderStatus('Question replayed in voice.', false);
                const activeTurn = getActiveTurn();
                await reportSpeechSynthesisUsage({
                    turnId: activeTurn?.turnId,
                    sequenceNumber: activeTurn?.sequenceNumber,
                    purpose,
                    speechSynthesisCharacters: text.length,
                    clientEventId: createClientEventId()
                });
            } catch (error) {
                const reason = error?.message || 'Speech synthesis failed.';
                if (purpose === 'completion') {
                    logActivity(`Final completion speech failed: ${reason}`);
                } else {
                    logActivity(`${purpose === 'reminder' ? 'Reminder' : 'Question'} speech failed: ${reason}`);
                    await disableSpeechForRuntime(voicePlaybackUnavailableMessage);
                }
                if (purpose !== 'completion' && !runtimeStoppedOrCompleted)
                    setHeaderStatus(voicePlaybackUnavailableMessage, true);
            } finally {
                isSpeakingOrSubmitting = false;
                if (shouldResumeRecognition && !runtimeStoppedOrCompleted && !speechUnavailable && isMicActive())
                    await startSpeechRecognition();
                resetTimers();
            }
        };

        const setCamera = async (enabled, skipRecordingSync = false) => {
            logActivity(`Camera requested: ${enabled}`);
            if (!navigator.mediaDevices?.getUserMedia) {
                logActivity('Camera unsupported.');
                setStatus('Camera is not supported in this browser.', true);
                return;
            }

            if (!enabled) {
                cameraStream?.getTracks().forEach(track => track.stop());
                cameraStream = null;
                video.style.display = 'none';
                cameraPlaceholder.style.display = '';
                logActivity('Camera stopped.');
                if (interviewStarted)
                    setStatus('Camera must remain on during the interview.', true);
                updateAuxiliaryControlsState();
                updateStartButtonState();
                updateSubmitAvailability();
                if (recordingEnabled && mediaRecorder)
                    logActivity('Recording remains enabled. Turn recording off to discard or stop the interview to upload.');
                return;
            }

            try {
                cameraStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
                video.srcObject = cameraStream;
                video.style.display = 'block';
                cameraPlaceholder.style.display = 'none';
                logActivity('Camera started.');
                await refreshAudioDevices();
                clearRecoveredMediaBlockingStatus();
                updateAuxiliaryControlsState();
                updateStartButtonState();
                updateSubmitAvailability();
                if (!skipRecordingSync)
                    await syncRecording();
            } catch (error) {
                logActivity('Camera failed to start.');
                if (error?.name === 'NotAllowedError' || /denied|permission/i.test(error?.message || '')) {
                    mediaPermissionDenied = true;
                    setStatus('Camera permission was denied. Camera access is required for this interview.', true);
                    logActivity(screenShareActive ? 'Recording remains available with screen share.' : 'Recording is waiting for screen share because camera or microphone permission was denied.');
                } else {
                    setStatus('Camera could not be started.', true);
                }
                updateAuxiliaryControlsState();
            }
        };

        const setMic = async (enabled, skipRecordingSync = false) => {
            logActivity(`Mic requested: ${enabled}`);
            if (!navigator.mediaDevices?.getUserMedia) {
                logActivity('Mic unsupported.');
                setStatus('Microphone is not supported in this browser.', true);
                return;
            }

            if (!enabled) {
                await stopMicStream();
                logActivity('Mic stopped.');
                await stopSpeechRecognition();
                if (interviewStarted)
                    setStatus('Microphone must remain on during the interview.', true);
                updateAuxiliaryControlsState();
                updateStartButtonState();
                updateSubmitAvailability();
                if (recordingEnabled && mediaRecorder)
                    logActivity('Recording remains enabled. Turn recording off to discard or stop the interview to upload.');
                return;
            }

            try {
                try {
                    micStream = await navigator.mediaDevices.getUserMedia({
                        video: false,
                        audio: getSelectedAudioInputConstraints()
                    });
                } catch (error) {
                    if (!selectedAudioInputId || !isSelectedAudioInputFailure(error))
                        throw error;

                    logActivity(`Selected microphone unavailable. reason=${error?.message || error?.name || 'unknown'}`);
                    selectedAudioInputId = '';
                    writeLocalStorageValue(audioInputStorageKey, '');
                    if (audioInputSelect)
                        audioInputSelect.value = '';
                    setAudioDeviceStatus('Selected microphone unavailable. Using default microphone.', true);
                    micStream = await navigator.mediaDevices.getUserMedia({ video: false, audio: true });
                }
                await refreshAudioDevices();
                audioContext = new (window.AudioContext || window.webkitAudioContext)();
                const source = audioContext.createMediaStreamSource(micStream);
                analyser = audioContext.createAnalyser();
                analyser.fftSize = 32;
                source.connect(analyser);

                const buffer = new Uint8Array(analyser.frequencyBinCount);
                const updateMeter = () => {
                    if (!analyser)
                        return;
                    analyser.getByteFrequencyData(buffer);
                    const average = buffer.reduce((sum, value) => sum + value, 0) / buffer.length;
                    audioMeter.forEach((bar, index) => {
                        const height = Math.max(8, Math.min(34, average - (index * 2)));
                        bar.style.height = `${height}px`;
                        bar.style.background = height > 18 ? '#0f5bd7' : '#cbd5e1';
                    });
                    meterFrame = requestAnimationFrame(updateMeter);
                };
                updateMeter();
                logActivity('Mic started.');
                refreshRecordingAudioMix();
                await resumeSpeechRecognitionForActiveQuestion();
                clearRecoveredMediaBlockingStatus();
                updateAuxiliaryControlsState();
                updateStartButtonState();
                updateSubmitAvailability();
                if (!skipRecordingSync)
                    await syncRecording();
            } catch (error) {
                logActivity('Mic failed to start.');
                if (error?.name === 'NotAllowedError' || /denied|permission/i.test(error?.message || '')) {
                    mediaPermissionDenied = true;
                    setStatus('Microphone permission was denied. Microphone access is required for this interview.', true);
                    logActivity(screenShareActive ? 'Recording remains available with screen share.' : 'Recording is waiting for screen share because camera or microphone permission was denied.');
                } else {
                    setStatus('Microphone could not be started.', true);
                }
                updateAuxiliaryControlsState();
            }
        };

        const submitAnswer = async (options = {}) => {
            if (!config.submitAnswerUrl) {
                setStatus('Answer submission is unavailable.', true);
                return;
            }

            if (!interviewStarted) {
                setStatus('Click Start Interview to begin.', false);
                return;
            }

            const submitBtn = primaryActionButton;
            if (submitButton.disabled || isSubmittingAnswer) return;

            const auto = options.auto === true;
            if (isScreenShareBlockingInterview()) {
                logActivity(`${auto ? 'Auto-submit' : 'Manual submit'} blocked; screen sharing is inactive.`);
                setScreenShareInterruptionWarning(true);
                updateSubmitAvailability();
                return;
            }

            const trimmedAnswer = (answerBox.value || '').trim();
            if (!trimmedAnswer) {
                logActivity(`${auto ? 'Auto-submit' : 'Manual submit'} skipped; answer is empty.`);
                setStatus('Please speak or type something.', false);
                updateSubmitAvailability();
                if (auto)
                    resetTimers();
                return;
            }

            if (!(await ensureRuntimeTokenFresh())) {
                if (auto)
                    setStatus('Auto submit is unavailable right now.', true);
                return;
            }

            if (!hasActiveQuestion()) {
                showUnavailableQuestionState();
                return;
            }

            const submitStartedAt = performance.now();
            let slowSubmitTimer = null;
            let slowerSubmitTimer = null;
            let nextTurnWaitTimer = null;
            logActivity('Submitting answer...');
            isSpeakingOrSubmitting = true;
            isSubmittingAnswer = true;
            clearAnswerTimers();
            const turnStateBeforeSubmit = getTurnState();
            const activeTurn = turnStateBeforeSubmit.activePendingTurn;
            const willCompleteOnSubmit = (turnStateBeforeSubmit.answeredCount + 1) >= totalQuestions ||
                (activeTurn?.sequenceNumber || 0) >= totalQuestions;
            let finalCompletionSpeechTokenResult = null;
            if (willCompleteOnSubmit && config.speechAvailable && !speechUnavailable)
                finalCompletionSpeechTokenResult = await prefetchFinalCompletionSpeechToken();
            setHeaderStatus(auto ? 'Auto submitting answer...' : 'Submitting answer...', false);
            const setNextTurnWaitStatus = (message = 'Preparing your next question...') => {
                const elapsedSeconds = Math.max(0, Math.floor((performance.now() - submitStartedAt) / 1000));
                setHeaderStatus(`${message} Elapsed ${formatElapsedTime(elapsedSeconds)}`, false);
            };
            slowSubmitTimer = setTimeout(() => {
                if (willCompleteOnSubmit) {
                    setHeaderStatus(reportGenerationMessage, false);
                } else {
                    setNextTurnWaitStatus();
                    nextTurnWaitTimer = setInterval(() => setNextTurnWaitStatus(), 1000);
                }
                logActivity('Answer submission is still pending.');
            }, slowSubmitStatusDelayMs);
            slowerSubmitTimer = setTimeout(() => {
                if (!willCompleteOnSubmit) {
                    clearInterval(nextTurnWaitTimer);
                    nextTurnWaitTimer = setInterval(() => setNextTurnWaitStatus('Still preparing the next question. Please keep this page open.'), 1000);
                    setNextTurnWaitStatus('Still preparing the next question. Please keep this page open.');
                }
            }, 8000);
            submitBtn.disabled = true;
            submitBtn.classList.add('is-loading');
            const originalText = submitBtn.textContent;
            submitBtn.textContent = auto ? 'Auto submitting...' : 'Submitting...';

            const speechRecognitionCharacters = Math.max(0, recognitionTurnCharacters);
            const speechRecognitionDurationMs = Math.max(0, Math.round(getRecognitionDurationMs()));
            if ((speechRecognitionCharacters > 0 || speechRecognitionDurationMs > 0) && !pendingRecognitionClientEventId)
                pendingRecognitionClientEventId = createClientEventId();

            const body = new URLSearchParams({ token: sessionToken, answer: trimmedAnswer });
            if (activeTurn?.turnId)
                body.append('turnId', String(activeTurn.turnId));
            if (activeTurn?.sequenceNumber)
                body.append('sequenceNumber', String(activeTurn.sequenceNumber));
            if (speechRecognitionCharacters > 0)
                body.append('speechRecognitionCharacters', String(speechRecognitionCharacters));
            if (speechRecognitionDurationMs > 0)
                body.append('speechRecognitionDurationMs', String(speechRecognitionDurationMs));
            if (pendingRecognitionClientEventId)
                body.append('speechRecognitionClientEventId', pendingRecognitionClientEventId);
            const result = await postForm(config.submitAnswerUrl, body);
            const submitElapsedMs = Math.round(performance.now() - submitStartedAt);
            clearTimeout(slowSubmitTimer);
            clearTimeout(slowerSubmitTimer);
            clearInterval(nextTurnWaitTimer);
            logActivity(`Answer submission finished. elapsedMs=${submitElapsedMs}`);

            submitBtn.classList.remove('is-loading');
            isSpeakingOrSubmitting = false;
            isSubmittingAnswer = false;

            if (!isSuccess(result)) {
                logActivity('Submit response failure: ' + getRuntimeMessage(result, 'Unable to submit answer.'));
                setStatus(getRuntimeMessage(result, 'Unable to submit answer.'), true);
                answerNeedsEditAfterFailure = true;
                updateSubmitAvailability();
                resetSubmitButtonText();
                clearCompletedRedirectState();
                setHeaderStatus('', false);
                return;
            }
            logActivity('Submit response success: ' + getRuntimeMessage(result, 'Answer saved.'));
            if (!willCompleteOnSubmit)
                setHeaderStatus('', false);
            answerNeedsEditAfterFailure = false;

            const isTerminated = getValue(result, "isTerminated", "IsTerminated");
            const resultQuestion = getValue(result, "question", "Question");
            const resultMessage = getRuntimeMessage(result, '');
            if (!isTerminated && willCompleteOnSubmit) {
                clearCompletedRedirectState();
                setHeaderStatus('', false);
            }
            const returnedTurns = getValue(result, 'turns', 'Turns');
            if (Array.isArray(returnedTurns))
                replaceTurns(returnedTurns);

            questionBox.textContent = isTerminated ? currentQuestionText() : resultQuestion;
            if (!isTerminated && resultQuestion) logActivity('Question shown: ' + resultQuestion);
            if (!isTerminated && resultQuestion)
                interviewUnavailable = false;
            messageBox.textContent = isTerminated ? '' : 'Please answer the next question.';
            messageBox.classList.add('runtime-js-hidden');
            if (!isTerminated)
                messageBox.textContent = 'Please answer the next question.';
            setStatus(isTerminated ? '' : (resultMessage || 'Answer saved.'), false);
            answerBox.value = '';
            if (!isTerminated && resultQuestion)
                setRuntimeCaption('Interviewer', resultQuestion);
            else
                syncAnswerCaption();
            renderTranscript();
            updateSubmitAvailability();
            resetSubmitButtonText();

            if (isTerminated) {
                await setCompletedState(result);
                try {
                    if (!finalCompletionSpoken) {
                        finalCompletionSpoken = true;
                        writeLocalStorageValue(finalCompletionSpeechStorageKey, '1');
                        await speakText(getFinalCompletionSpeechText(), 'completion', finalCompletionSpeechTokenResult);
                    }
                } catch {
                    logActivity('Final completion speech failed.');
                } finally {
                    await finalizeCompletedState(result);
                }
                return;
            }

            updateStartButtonState();
            updateSubmitAvailability();
            if (config.speechAvailable && !isPlaceholderSpeechText(resultQuestion)) {
                await speakText(resultQuestion, 'question');
                await resumeSpeechRecognitionForActiveQuestion();
                resetRecognitionTracking(!!speechRecognizer);
            } else {
                await resumeSpeechRecognitionForActiveQuestion();
                resetRecognitionTracking(!!speechRecognizer);
                resetTimers();
            }
        };

        const stopInterview = async () => {
            if (!config.stopInterviewUrl) {
                setStatus('Stop endpoint is unavailable.', true);
                return;
            }

            const stopBtn = document.getElementById('stop-interview');
            const stopTopBtn = document.getElementById('stop-interview-top');
            if (stopBtn && stopBtn.disabled) return;

            if (!(await ensureRuntimeTokenFresh()))
                return;

            logActivity('Stopping interview...');
            stopInProgress = true;
            clearAnswerTimers();
            let originalText = '';
            if (stopBtn) {
                originalText = stopBtn.textContent;
                stopBtn.disabled = true;
                stopBtn.classList.add('is-loading');
                stopBtn.textContent = 'Stopping...';
            }
            if (stopTopBtn) {
                stopTopBtn.disabled = true;
                stopTopBtn.classList.add('is-loading');
                stopTopBtn.textContent = 'Stopping...';
            }
            if (mediaRecorder && recordingEnabled)
                await stopRecording(true);

            const body = new URLSearchParams({ token: sessionToken });
            const result = await postForm(config.stopInterviewUrl, body);

            if (!isSuccess(result)) {
                stopInProgress = false;
                if (stopBtn) {
                    stopBtn.disabled = false;
                    stopBtn.classList.remove('is-loading');
                    stopBtn.textContent = originalText;
                }
                if (stopTopBtn) {
                    stopTopBtn.disabled = false;
                    stopTopBtn.classList.remove('is-loading');
                    stopTopBtn.textContent = originalText;
                }

                logActivity('Stop response failure: ' + getRuntimeMessage(result, 'Unable to stop interview.'));
                clearCompletedRedirectState();
                setStatus(getRuntimeMessage(result, 'Unable to stop interview.'), true);
                updateStartButtonState();
                updateSubmitAvailability();
                if (interviewStarted && hasActiveQuestion() && !answerNeedsEditAfterFailure)
                    resetTimers();
                return;
            }

            if (stopBtn) stopBtn.classList.remove('is-loading');
            if (stopTopBtn) stopTopBtn.classList.remove('is-loading');
            logActivity('Stop response success: ' + getRuntimeMessage(result, 'Interview completed.'));
            setStatus(getRuntimeMessage(result, 'Interview completed.'), false);
            const returnedTurns = getValue(result, 'turns', 'Turns');
            if (Array.isArray(returnedTurns))
                replaceTurns(returnedTurns);
            renderTranscript();
            await setCompletedState(result);
            await finalizeCompletedState(result);
        };

        const beginInterview = async () => {
            logActivity('Interview started clicked.');
            if (interviewStarted) {
                if (!isCameraActive() || !isMicActive()) {
                    const mediaReady = await ensureRequiredMediaReady();
                    if (mediaReady) {
                        setStatus('Camera and microphone are active. You can continue the interview.', false);
                        clearRecoveredMediaBlockingStatus();
                        if (recordingEnabled)
                            await syncRecording();
                        if (hasActiveQuestion() && !answerNeedsEditAfterFailure)
                            resetTimers();
                    }
                    return;
                }

                if (screenShareRequired && (!screenShareActive || screenShareInterrupted)) {
                    if (await requestScreenShareForInterviewStart()) {
                        if (recordingEnabled && mediaRecorder)
                            await stopRecording(false, { preserveSegment: true, statusMessage: 'Recording restarting with resumed screen share.' });
                        if (recordingEnabled)
                            await syncRecording();
                        setScreenShareStatus('Screen sharing resumed', 'active');
                        setScreenShareInterruptionWarning(false);
                        clearRecoveredMediaBlockingStatus();
                        setStatus('Screen sharing resumed. You can continue the interview.', false);
                        if (hasActiveQuestion() && !answerNeedsEditAfterFailure)
                            resetTimers();
                    }
                    return;
                }

                if (hasActiveQuestion()) {
                    await submitAnswer();
                    return;
                }

                if (config.speechAvailable && currentQuestionText())
                    await speakText(questionBox.textContent, 'question');
                return;
            }
            if (beginInterviewInProgress || creditRedirectPending)
                return;

            const finishBeginAttempt = () => {
                beginInterviewInProgress = false;
                primaryActionButton?.classList.remove('is-loading');
                updateStartButtonState();
            };
            beginInterviewInProgress = true;
            primaryActionButton.disabled = true;
            primaryActionButton.classList.add('is-loading');

            if (!guidelinesAcknowledged) {
                openGuidelinesModal();
                setStatus('Please review and accept the interview guidelines before starting.', false);
                finishBeginAttempt();
                return;
            }
            if (!(await ensureRequiredMediaReady())) {
                interviewStarted = false;
                finishBeginAttempt();
                return;
            }
            if (!(await requestScreenShareForInterviewStart())) {
                interviewStarted = false;
                finishBeginAttempt();
                return;
            }
            if (!(await ensureRuntimeTokenFresh())) {
                stopScreenShare();
                interviewStarted = false;
                finishBeginAttempt();
                updateSubmitAvailability();
                return;
            }
            if (!config.beginInterviewUrl) {
                stopScreenShare();
                interviewStarted = false;
                setStatus('Interview start endpoint is unavailable.', true);
                finishBeginAttempt();
                return;
            }

            preloadSpeechResources();
            const beginStartedAt = performance.now();
            const beginResult = await postForm(config.beginInterviewUrl, new URLSearchParams({ token: sessionToken }));
            logActivity('Begin response received.');
            if (!isSuccess(beginResult)) {
                stopScreenShare();
                interviewStarted = false;
                const beginMessage = getRuntimeMessage(beginResult, 'AI service unavailable. Please try again later.');
                logActivity(`Begin interview failed. message=${beginMessage}`);
                const insufficientCredits = !!getValue(beginResult, 'insufficientCredits', 'InsufficientCredits');
                if (insufficientCredits) {
                    const pricingUrl = getValue(beginResult, 'redirect', 'Redirect') || config.pricingUrl || '/pricing';
                    const redirectDelay = clampNumber(getValue(beginResult, 'redirectDelayMilliseconds', 'RedirectDelayMilliseconds'), 5000, 1000, 30000);
                    creditRedirectPending = true;
                    setCreditWarning(beginMessage, pricingUrl);
                    finishBeginAttempt();
                    window.setTimeout(() => { window.location.href = pricingUrl; }, redirectDelay);
                    return;
                }
                showUnavailableQuestionState(beginMessage);
                finishBeginAttempt();
                return;
            }
            const firstQuestion = getValue(beginResult, "question", "Question");
            const firstTurn = normalizeTurn(getValue(beginResult, "turn", "Turn"), turns.length);
            const returnedTurns = getValue(beginResult, 'turns', 'Turns');
            if (!firstQuestion) {
                stopScreenShare();
                interviewStarted = false;
                showUnavailableQuestionState();
                finishBeginAttempt();
                return;
            }
            reportRuntimeClientStageTiming('begin-response', performance.now() - beginStartedAt, true);

            if (Array.isArray(returnedTurns)) {
                replaceTurns(returnedTurns);
            } else if (firstTurn) {
                const existingTurnIndex = turns.findIndex((turn, index) => normalizeTurn(turn, index)?.turnId === firstTurn.turnId);
                if (existingTurnIndex >= 0)
                    turns[existingTurnIndex] = firstTurn;
                else
                    turns.push(firstTurn);
            }

            interviewUnavailable = false;
            interviewStarted = true;
            setCreditWarning('');
            screenShareActive = true;
            screenShareInterrupted = false;
            setScreenShareStatus('Screen sharing active', 'active');
            updateAnswerInputState();
            questionBox.textContent = firstQuestion;
            startRuntimeTimer();
            setStatus('Please answer the question.', false);
            messageBox.textContent = 'Please answer the question.';
            messageBox.classList.add('runtime-js-hidden');
            setRuntimeCaption('Interviewer', firstQuestion);
            renderTranscript();
            finishBeginAttempt();
            if (questionBox.textContent) logActivity('Question shown: ' + questionBox.textContent);
            logActivity('First question rendered.');
            reportRuntimeClientStageTiming('first-question-rendered', performance.now() - beginStartedAt, true);
            updateSubmitAvailability();
            updateAuxiliaryControlsState();
            const recordingStartPromise = (async () => {
                try {
                    if (config.recordingAvailable && recordingEnabled)
                        await requestRecordingMediaForStart();
                    await syncRecording();
                    if (mediaRecorder?.state === 'recording')
                        logActivity('Recording started.');
                } catch (error) {
                    logActivity(`Recording start failed independently: ${error?.message || 'unknown'}`);
                    setRecordingStatus('Recording could not start. You can continue with typed answers.', true, true);
                }
            })();
            if (config.speechAvailable && hasActiveQuestion()) {
                setStatus('Preparing interviewer voice...', false);
                speakText(questionBox.textContent, 'question')
                    .then(() => logActivity('First question TTS completed.'))
                    .catch(() => logActivity('First question TTS failed.'))
                    .finally(async () => {
                        await resumeSpeechRecognitionForActiveQuestion();
                        resetRecognitionTracking(!!speechRecognizer);
                    });
            } else {
                await resumeSpeechRecognitionForActiveQuestion();
                resetRecognitionTracking(!!speechRecognizer);
                resetTimers();
            }
            recordingStartPromise.catch(error => logActivity(`Recording start promise failed: ${error?.message || 'unknown'}`));
        };

        if (guidelinesButton)
            guidelinesButton.addEventListener('click', openGuidelinesModal);
        permissionStepButtons.forEach(button => {
            button.addEventListener('click', () => setPermissionStep(Number(button.dataset.permissionStepJump)));
        });
        if (permissionBackButton) {
            permissionBackButton.addEventListener('click', () => {
                setPermissionStep(permissionActiveStep - 1);
            });
        }
        if (permissionNextButton) {
            permissionNextButton.addEventListener('click', () => {
                if (!isPermissionStepComplete(permissionActiveStep))
                    return;

                setPermissionStep(permissionActiveStep + 1);
            });
        }
        permissionResultButtons.forEach(button => {
            button.addEventListener('click', () => {
                const key = button.dataset.permissionResult;
                if (!key || !(key in permissionState))
                    return;

                permissionState[key] = button.dataset.permissionValue || '';
                renderPermissionFlow();
            });
        });
        if (precheckInternetButton)
            precheckInternetButton.addEventListener('click', testInternetSpeed);
        if (precheckMicButton)
            precheckMicButton.addEventListener('click', requestPrecheckMic);
        if (precheckSpeakerButton)
            precheckSpeakerButton.addEventListener('click', playSpeakerTone);
        if (precheckSpeechStartButton)
            precheckSpeechStartButton.addEventListener('click', startPrecheckSpeech);
        if (precheckSpeechStopButton)
            precheckSpeechStopButton.addEventListener('click', stopPrecheckSpeech);
        if (feedbackTrigger)
            feedbackTrigger.addEventListener('click', () => setFeedbackModalOpen(true));
        if (feedbackCloseButton)
            feedbackCloseButton.addEventListener('click', closeFeedbackModal);
        if (feedbackCancelButton)
            feedbackCancelButton.addEventListener('click', closeFeedbackModal);
        if (feedbackSubmitButton)
            feedbackSubmitButton.addEventListener('click', submitRuntimeFeedback);
        if (feedbackIssueButton) {
            feedbackIssueButton.addEventListener('click', (event) => {
                event.stopPropagation();
                const isOpen = feedbackIssueButton.getAttribute('aria-expanded') === 'true';
                setFeedbackIssueListboxOpen(!isOpen);
                setActiveFeedbackIssueOption(getFeedbackOptionIndex(getSelectedFeedbackIssue()));
            });
            feedbackIssueButton.addEventListener('keydown', handleFeedbackIssueButtonKeydown);
        }
        feedbackIssueOptions.forEach(option => {
            option.addEventListener('click', (event) => {
                event.stopPropagation();
                selectFeedbackIssue(option);
                feedbackIssueButton?.focus();
            });
            option.addEventListener('mousemove', () => setActiveFeedbackIssueOption(feedbackIssueOptions.indexOf(option)));
        });
        feedbackHelpfulnessButtons.forEach(button => {
            button.addEventListener('click', () => updateFeedbackHelpfulnessState(button.dataset.feedbackHelpfulness || ''));
        });
        if (feedbackAttachment) {
            feedbackAttachment.addEventListener('change', () => {
                const file = feedbackAttachment.files?.[0];
                if (feedbackFileName)
                    feedbackFileName.textContent = file?.name || '';
            });
        }
        if (feedbackModal) {
            feedbackModal.addEventListener('click', (event) => {
                if (event.target === feedbackModal)
                    closeFeedbackModal();
                else if (!event.target.closest?.('.runtime-feedback-select-wrap'))
                    setFeedbackIssueListboxOpen(false);
            });
            feedbackModal.addEventListener('keydown', trapFeedbackFocus);
        }
        runtimeTabs.forEach(tab => {
            tab.addEventListener('click', () => setActiveRuntimePanel(tab.dataset.runtimeTab));
        });
        if (guidelinesAcknowledgeLabel) {
            guidelinesAcknowledgeLabel.addEventListener('click', (event) => {
                if (event.target === guidelinesCheckbox || event.target === guidelinesAgreeButton)
                    return;

                if (event.target instanceof HTMLElement && event.target.closest('button'))
                    return;

                if (event.target !== guidelinesCheckbox) {
                    event.preventDefault();
                    guidelinesCheckbox.checked = !guidelinesCheckbox.checked;
                    guidelinesCheckbox.dispatchEvent(new Event('change', { bubbles: true }));
                }
            });
        }
        if (guidelinesCheckbox) {
            guidelinesCheckbox.addEventListener('change', renderPermissionFlow);
            guidelinesCheckbox.addEventListener('keydown', (event) => {
                if (event.code !== 'Space' && event.key !== ' ')
                    return;

                event.preventDefault();
                guidelinesCheckbox.checked = !guidelinesCheckbox.checked;
                guidelinesCheckbox.dispatchEvent(new Event('change', { bubbles: true }));
            });
        }
        if (guidelinesAgreeButton) {
            guidelinesAgreeButton.addEventListener('click', async () => {
                if (!guidelinesCheckbox?.checked)
                    return;

                guidelinesAcknowledged = true;
                guidelinesAcknowledgedAt = new Date().toISOString();
                closeGuidelinesModal('agree');
                updateStartButtonState();
                setStatus('Guidelines acknowledged. You can start the interview.', false);
                const payload = logGuidelinesAcknowledgement();
                await sendGuidelinesAcknowledgementAudit(payload);
            });
        }
        document.getElementById('guidelines-cancel').addEventListener('click', () => {
            closeGuidelinesModal('cancel');
            updateStartButtonState();
            setStatus('Please acknowledge the interview guidelines before starting.', false);
        });
        if (guidelinesModal) {
            guidelinesModal.addEventListener('click', (event) => {
                if (event.target === guidelinesModal) {
                    closeGuidelinesModal('backdrop');
                    updateStartButtonState();
                    if (!guidelinesAcknowledged)
                        setStatus('Please acknowledge the interview guidelines before starting.', false);
                }
            });
        }
        if (audioDeviceToggle) {
            audioDeviceToggle.addEventListener('click', async (event) => {
                event.stopPropagation();
                setAudioDevicePanelOpen(!audioDevicePanelOpen);
                if (audioDevicePanelOpen)
                    await refreshAudioDevices();
            });
        }
        if (audioDevicePanel) {
            audioDevicePanel.addEventListener('click', event => event.stopPropagation());
        }
        if (audioInputSelect) {
            audioInputSelect.addEventListener('change', async () => {
                await switchAudioInputDevice(audioInputSelect.value);
            });
        }
        if (audioOutputSelect) {
            audioOutputSelect.addEventListener('change', async () => {
                selectedAudioOutputId = audioOutputSelect.value || '';
                writeLocalStorageValue(audioOutputStorageKey, selectedAudioOutputId);
                await applySelectedAudioOutput(ensureSpeechAudioElement());
            });
        }
        document.addEventListener('click', () => setAudioDevicePanelOpen(false));
        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
                setFeedbackIssueListboxOpen(false);
                setAudioDevicePanelOpen(false);
                if (feedbackModal?.classList.contains('is-open'))
                    closeFeedbackModal();
            }
        });
        navigator.mediaDevices?.addEventListener?.('devicechange', () => {
            refreshAudioDevices().catch(error => logActivity(`Audio device refresh failed. reason=${error?.message || 'unknown'}`));
        });
        document.getElementById('toggle-camera').addEventListener('click', async () => await setCamera(!isCameraActive()));
        document.getElementById('toggle-mic').addEventListener('click', async () => await setMic(!isMicActive()));
        if (screenShareButton) {
            screenShareButton.addEventListener('click', async () => {
                await requestScreenShareForInterviewStart();
            });
        }
        if (repeatQuestionButton) {
            repeatQuestionButton.addEventListener('click', async () => {
                if (!hasActiveQuestion())
                    return;

                if (!config.speechAvailable) {
                    setHeaderStatus(voicePlaybackUnavailableMessage, true);
                    return;
                }

                setHeaderStatus('Replaying question audio.', false);
                await speakText(questionBox.textContent, 'repeat');
            });
        }
        if (recordingButton) {
            recordingButton.addEventListener('click', async () => {
                if (!config.recordingAvailable)
                    return;

                recordingEnabled = !recordingEnabled;
                if (!recordingEnabled) {
                    await stopRecording(false);
                    logActivity('Recording disabled.');
                } else {
                    logActivity('Recording ready.');
                    await syncRecording();
                }
                updateAuxiliaryControlsState();
            });
        }
        startPrepareInterview();
        submitButton.addEventListener('click', submitAnswer);
        primaryActionButton.addEventListener('click', beginInterview);
        document.getElementById('stop-interview').addEventListener('click', stopInterview);
        document.getElementById('stop-interview-top').addEventListener('click', stopInterview);
        document.getElementById('open-transcript')?.addEventListener('click', () => transcript.classList.add('is-open'));
        document.getElementById('close-transcript')?.addEventListener('click', () => transcript.classList.remove('is-open'));
        if (runtimeBackButton) {
            runtimeBackButton.addEventListener('click', () => {
                if (window.history.length > 1) {
                    window.history.back();
                    return;
                }

                if (document.referrer) {
                    try {
                        const referrerUrl = new URL(document.referrer, window.location.origin);
                        if (referrerUrl.origin === window.location.origin) {
                            window.location.href = referrerUrl.href;
                            return;
                        }
                    } catch {}
                }

                window.location.href = '/';
            });
        }
        window.addEventListener('beforeunload', (event) => {
            if (!shouldWarnBeforeUnload())
                return;

            event.preventDefault();
            event.returnValue = '';
            return '';
        });
        window.addEventListener('pagehide', () => {
            stopScreenShare();
            cleanupPermissionPrechecks();
            clearAllRuntimeTimers();
            closeRecordingAudioMix();
            revokeSpeechAudioObjectUrl();
        });

        loadPersistedAudioDeviceSelections();
        renderTranscript();
        setActiveRuntimePanel('conversation');
        updateAnswerInputState();
        submitButton.disabled = true;
        updateStopButtonsState();
        if (config.creditEligible === false)
            setCreditWarning(config.creditWarningMessage || 'You do not have enough credits to start this interview. Please upgrade your plan or buy additional credits.', config.pricingUrl || '/pricing');
        setStatus('Click Start Interview to begin.', false);
        setScreenShareStatus('Screen sharing required');
        setScreenShareInterruptionWarning(false);
        renderPermissionFlow();
        updateStartButtonState();
        updateSubmitAvailability();
        updateAuxiliaryControlsState();
        updateFeedbackIssueState();
        refreshAudioDevices().catch(error => logActivity(`Audio device refresh failed. reason=${error?.message || 'unknown'}`));
        syncAnswerCaption();
        guidelinesModal?.setAttribute('data-runtime-guidelines-open-pending', 'true');
        guidelinesModalTimer = setTimeout(openGuidelinesModal, 3000);
    })();
</script>
