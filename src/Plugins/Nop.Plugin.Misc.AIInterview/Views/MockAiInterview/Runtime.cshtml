@{
    Layout = "_ColumnsTwo";
}
<div class="page mock-runtime">
    <div class="page-title">
        <h1>@T("Plugins.Misc.AIInterview.Interview.Title")</h1>
    </div>
    <div class="page-body">
        <div id="mock-interview-container">
            <p>@T("Plugins.Misc.AIInterview.Interview.InitialQuestion")</p>
            <textarea id="mock-answer" placeholder="@T("Plugins.Misc.AIInterview.Interview.AnswerPlaceholder")"></textarea>
            <button id="submit-mock-answer" class="button-1">@T("Plugins.Misc.AIInterview.Interview.SubmitAnswer")</button>
        </div>
    </div>
</div>
