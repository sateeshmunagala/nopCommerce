@model Nop.Plugin.Misc.AIInterview.Models.InterviewRuntimeModel
@using System.Text.Json
@{
    Layout = "_Root.Head";
    var clientSettings = JsonSerializer.Serialize(Model.ClientSettings ?? new Nop.Plugin.Misc.AIInterview.Models.RuntimeClientSettingsModel());
}

<style>
    body {
        margin: 0;
        background: #eef3fb;
    }

    .runtime-shell {
        min-height: 100vh;
        padding: 12px;
        box-sizing: border-box;
    }

    .runtime-page {
        min-height: calc(100vh - 24px);
        padding: 18px;
        border-radius: 28px;
        background: linear-gradient(180deg, #f8fafc 0%, #eef3fb 100%);
        box-shadow: 0 20px 50px rgba(15, 23, 42, 0.12);
        display: grid;
        gap: 18px;
    }

    .runtime-topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .runtime-topbar h1 {
        margin: 0;
        font-size: 22px;
        color: #162033;
    }

    .runtime-meta {
        display: flex;
        align-items: center;
        gap: 12px;
        color: #667085;
        font-weight: 600;
    }

    .runtime-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.8fr) minmax(320px, 0.9fr);
        gap: 18px;
        min-height: 70vh;
    }

    .runtime-stage, .runtime-sidebar {
        display: grid;
        gap: 16px;
        padding: 18px;
        border-radius: 24px;
        background: #fff;
        border: 1px solid rgba(15, 23, 42, 0.08);
    }

    .runtime-video {
        position: relative;
        min-height: 420px;
        border-radius: 20px;
        background: linear-gradient(180deg, #d9e2f2 0%, #c8d7ea 100%);
        display: grid;
        place-items: center;
        color: #51627b;
        font-size: 28px;
        font-weight: 700;
    }

    .runtime-avatar {
        position: absolute;
        top: 20px;
        right: 20px;
        width: 108px;
        height: 108px;
        border-radius: 20px;
        background: linear-gradient(180deg, #f7f9fc 0%, #dce6f3 100%);
        border: 1px solid rgba(255,255,255,0.85);
        box-shadow: 0 12px 22px rgba(15, 23, 42, 0.12);
    }

    .runtime-avatar::before,
    .runtime-avatar::after {
        content: "";
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        background: #b5c3d0;
    }

    .runtime-avatar::before {
        top: 18px;
        width: 42px;
        height: 42px;
        border-radius: 50%;
    }

    .runtime-avatar::after {
        bottom: 18px;
        width: 54px;
        height: 34px;
        border-radius: 999px;
    }

    .runtime-controls {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        padding: 14px 18px;
        border-radius: 999px;
        background: rgba(255,255,255,0.9);
        box-shadow: 0 12px 24px rgba(15, 23, 42, 0.12);
        width: fit-content;
        margin: -40px auto 0;
        position: relative;
    }

    .runtime-dot {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: #d0d5dd;
    }

    .runtime-dot.is-live {
        width: 42px;
        height: 42px;
        background: #ffffff;
        border: 2px solid #d0d5dd;
    }

    .runtime-sidebar h3 {
        margin: 0;
        color: #162033;
    }

    .runtime-question, .runtime-message {
        padding: 14px 16px;
        border-radius: 16px;
        border: 1px solid rgba(255, 122, 26, 0.35);
        background: #fff9f3;
        color: #a15c00;
        line-height: 1.6;
    }

    .runtime-message.is-info {
        background: #eef4ff;
        color: #0f5bd7;
        border-color: #c9dafd;
    }

    .runtime-answer textarea {
        width: 100%;
        min-height: 120px;
        padding: 14px 16px;
        border: 1px solid rgba(15, 23, 42, 0.08);
        border-radius: 16px;
        resize: vertical;
    }

    .runtime-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
    }

    .button-1, .button-2 {
        border-radius: 999px;
    }

    .button-1 {
        background: #0f5bd7;
        color: #fff;
    }

    .button-2 {
        background: #eef4ff;
        color: #0f5bd7;
        border: 1px solid #c9dafd;
    }

    .runtime-status {
        min-height: 24px;
        font-weight: 600;
    }

    .runtime-status.message-error {
        color: #b42318;
    }

    .runtime-status.message-success {
        color: #027a48;
    }

    .runtime-transcript {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.45);
        z-index: 9999;
        padding: 24px;
    }

    .runtime-transcript.is-open {
        display: grid;
        place-items: center;
    }

    .runtime-transcript-card {
        width: min(900px, 100%);
        max-height: 80vh;
        overflow: auto;
        background: #fff;
        border-radius: 20px;
        padding: 20px;
    }

    @@media (max-width: 1024px) {
        .runtime-layout {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="runtime-shell">
    <div class="runtime-page">
        <div class="runtime-topbar">
            <button type="button" id="stop-interview-top" class="button-2">Stop Interview</button>
            <h1>@Model.ProductName - @Model.Difficulty</h1>
            <div class="runtime-meta">
                <span id="runtime-timer">00:00</span>
                <button type="button" id="open-transcript" class="button-2">Transcript</button>
            </div>
        </div>

        <div class="runtime-layout">
            <section class="runtime-stage">
                <div class="runtime-video">
                    <span>Camera Off</span>
                    <div class="runtime-avatar"></div>
                </div>
                <div class="runtime-controls">
                    <span class="runtime-dot is-live"></span>
                    <span class="runtime-dot"></span>
                    <button type="button" id="start-or-next" class="button-1">Start Interview</button>
                    <span class="runtime-dot"></span>
                    <span class="runtime-dot"></span>
                </div>
            </section>

            <aside class="runtime-sidebar">
                <h3>Conversations</h3>
                <div id="runtime-question" class="runtime-question">@(string.IsNullOrWhiteSpace(Model.CurrentQuestion) ? "Welcome! Click Start Interview to begin." : Model.CurrentQuestion)</div>
                <div id="runtime-message" class="runtime-message is-info">Start the interview to load the first question.</div>

                <div class="runtime-answer">
                    <textarea id="runtime-answer" placeholder="Enter your answer here..."></textarea>
                </div>

                <div class="runtime-actions">
                    <button type="button" id="submit-answer" class="button-1">Submit Answer</button>
                    <button type="button" id="stop-interview" class="button-2">Stop Interview</button>
                </div>

                <div id="runtime-status" class="runtime-status"></div>
            </aside>
        </div>
    </div>
</div>

<div id="runtime-transcript" class="runtime-transcript">
    <div class="runtime-transcript-card">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;">
            <h3 style="margin:0;">Transcript</h3>
            <button type="button" id="close-transcript" class="button-2">Close</button>
        </div>
        <div id="transcript-body" style="margin-top:16px;display:grid;gap:12px;"></div>
    </div>
</div>

<script asp-location="Footer">
    (() => {
        const config = @Html.Raw(clientSettings);
        const turns = @Html.Raw(JsonSerializer.Serialize(Model.Turns ?? Array.Empty<object>()));
        const sessionToken = config.token || '@Model.Token';
        const answerBox = document.getElementById('runtime-answer');
        const questionBox = document.getElementById('runtime-question');
        const messageBox = document.getElementById('runtime-message');
        const statusBox = document.getElementById('runtime-status');
        const transcript = document.getElementById('runtime-transcript');
        const transcriptBody = document.getElementById('transcript-body');

        const setStatus = (message, isError) => {
            statusBox.textContent = message || '';
            statusBox.className = `runtime-status ${isError ? 'message-error' : 'message-success'}`;
        };

        const renderTranscript = () => {
            transcriptBody.innerHTML = '';
            (turns || []).forEach((turn, index) => {
                const item = document.createElement('div');
                item.style.padding = '12px 14px';
                item.style.border = '1px solid rgba(15,23,42,0.08)';
                item.style.borderRadius = '14px';
                item.innerHTML = `<strong>Q${index + 1}.</strong> ${turn.questionText || ''}<br/><strong>Answer:</strong> ${turn.answerText || '(pending)'}<br/><strong>Score:</strong> ${turn.score ?? ''}<br/><strong>Feedback:</strong> ${turn.feedback || ''}`;
                transcriptBody.appendChild(item);
            });
        };

        const startTimer = (() => {
            const startedAt = Date.now();
            setInterval(() => {
                const elapsedSeconds = Math.floor((Date.now() - startedAt) / 1000);
                const minutes = String(Math.floor(elapsedSeconds / 60)).padStart(2, '0');
                const seconds = String(elapsedSeconds % 60).padStart(2, '0');
                document.getElementById('runtime-timer').textContent = `${minutes}:${seconds}`;
            }, 1000);
        })();

        const postForm = async (url, formData) => {
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: formData
            });
            return await response.json();
        };

        const beginInterview = () => {
            if (messageBox.classList.contains('is-info') || !messageBox.textContent)
                messageBox.textContent = 'Interview started. Answer the displayed question.';
            setStatus('Interview started.', false);
            document.getElementById('start-or-next').disabled = true;
        };

        const submitAnswer = async () => {
            const body = new URLSearchParams({
                token: sessionToken,
                answer: answerBox.value || ''
            });
            const result = await postForm(config.submitAnswerUrl, body);
            if (!result.success) {
                setStatus(result.message || result.error || 'Unable to submit answer.', true);
                return;
            }

            setStatus(result.feedback || result.message || 'Answer saved.', false);
            messageBox.textContent = result.question || result.completion || messageBox.textContent;
            if (result.question) {
                questionBox.textContent = result.question;
                turns.push({ questionText: result.question, answerText: '', score: null, feedback: '', askedOnUtc: new Date().toISOString() });
                answerBox.value = '';
                renderTranscript();
            }

            if (result.isTerminated) {
                questionBox.textContent = result.completion || 'Interview completed.';
                answerBox.disabled = true;
                document.getElementById('submit-answer').disabled = true;
                document.getElementById('start-or-next').disabled = true;
                window.setTimeout(() => {
                    if (config.completeInterviewUrl) {
                        // keep the page stable if completion happens server-side
                    }
                }, 0);
            }
        };

        const stopInterview = async () => {
            const body = new URLSearchParams({ token: sessionToken });
            const result = await postForm(config.stopInterviewUrl, body);
            if (!result.success) {
                setStatus(result.message || result.error || 'Unable to stop interview.', true);
                return;
            }

            setStatus(result.message || 'Interview completed.', false);
            questionBox.textContent = result.completion || questionBox.textContent;
            renderTranscript();
            document.getElementById('submit-answer').disabled = true;
            document.getElementById('start-or-next').disabled = true;
            answerBox.disabled = true;
        };

        document.getElementById('submit-answer').addEventListener('click', submitAnswer);
        document.getElementById('start-or-next').addEventListener('click', beginInterview);
        document.getElementById('stop-interview').addEventListener('click', stopInterview);
        document.getElementById('stop-interview-top').addEventListener('click', stopInterview);
        document.getElementById('open-transcript').addEventListener('click', () => transcript.classList.add('is-open'));
        document.getElementById('close-transcript').addEventListener('click', () => transcript.classList.remove('is-open'));

        renderTranscript();
    })();
</script>
