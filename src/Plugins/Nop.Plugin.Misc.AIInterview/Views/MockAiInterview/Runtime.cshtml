@model Nop.Plugin.Misc.AIInterview.Models.InterviewRuntimeModel
@using System.Text.Json
@using System.Text.Json.Serialization
@{
    Layout = "_Root.Head";
    var practiceSkill = !string.IsNullOrWhiteSpace(Model.PracticeSkill) ? Model.PracticeSkill : string.Empty;
    var runtimeTopic = !string.IsNullOrWhiteSpace(Model.RuntimeTopic) ? Model.RuntimeTopic : Model.ProductName;
    var runtimeTitle = Model.IsPracticeInterview
        ? (!string.IsNullOrWhiteSpace(practiceSkill) || !string.IsNullOrWhiteSpace(Model.Difficulty)
            ? $"Interview on {(!string.IsNullOrWhiteSpace(practiceSkill) ? practiceSkill : "Resume Practice")}{(!string.IsNullOrWhiteSpace(Model.Difficulty) ? $" - {Model.Difficulty}" : string.Empty)}"
            : $"Interview on {(!string.IsNullOrWhiteSpace(Model.ProductName) ? Model.ProductName : "Interview")}")
        : $"Interview for {runtimeTopic}";
    var jsonOptions = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
    };
    var clientSettings = JsonSerializer.Serialize(Model.ClientSettings ?? new Nop.Plugin.Misc.AIInterview.Models.RuntimeClientSettingsModel(), jsonOptions);
    var turns = JsonSerializer.Serialize(Model.Turns ?? Array.Empty<InterviewTurnViewModel>(), jsonOptions);
    NopHtml.AppendCssFileParts("~/Plugins/Misc.AIInterview/Content/css/aiinterview-public.css");
    NopHtml.AppendPageCssClassParts("html-aiinterview-runtime-page");
}

<div class="runtime-shell">
    <div class="runtime-page">
        <div class="runtime-topbar">
            <div class="runtime-topbar-main">
                <button type="button" id="runtime-back" class="runtime-icon-button runtime-back-button" aria-label="Back" title="Back">
                    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                    <span class="sr-only">Back</span>
                </button>
                <div class="runtime-title-block">
                    <div class="runtime-title-line">
                        <h3>@runtimeTitle</h3>
                        @if (Model.QuestionCount > 0)
                        {
                            <span id="runtime-question-counter" class="runtime-question-counter runtime-js-hidden" aria-label="Interview question count" hidden></span>
                        }
                    </div>
                </div>
            </div>
            <div class="runtime-meta">
                <button type="button" id="open-runtime-feedback" class="button-2 runtime-feedback-trigger" aria-haspopup="dialog" aria-controls="runtime-feedback-modal" aria-label="@T("Plugins.Misc.AIInterview.Runtime.Feedback.Trigger")">
                    <i class="fa-regular fa-circle-question" aria-hidden="true"></i>
                    <span>@T("Plugins.Misc.AIInterview.Runtime.Feedback.Trigger")</span>
                </button>
                <button type="button" id="btn-runtime-tour" class="runtime-icon-button button-2" title="@T("Plugins.Misc.AIInterview.Tour.TriggerLabel")" aria-label="@T("Plugins.Misc.AIInterview.Tour.TriggerLabel")">
                    <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                    <span class="sr-only">@T("Plugins.Misc.AIInterview.Tour.TriggerLabel")</span>
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.CandidateName))
                {
                    <span class="runtime-candidate-chip">@Model.CandidateName</span>
                }
                <span id="runtime-timer-chip" class="runtime-timer-chip" title="Interview timer"><i class="fa-regular fa-clock" aria-hidden="true"></i><span id="runtime-timer-label">Timer</span><span id="runtime-timer">00:00</span></span>
                <button type="button" id="stop-interview-top" class="button-2 runtime-stop-button" disabled>@T("Plugins.Misc.AIInterview.Runtime.StopInterview")</button>
            </div>
        </div>

        <div class="runtime-status-region">
            <div id="runtime-credit-warning" class="runtime-credit-warning runtime-js-hidden" role="alert" aria-live="assertive">
                <span id="runtime-credit-warning-message"></span>
                <a id="runtime-credit-upgrade" class="button-1 runtime-credit-upgrade" href="/pricing">Upgrade</a>
            </div>
            <div id="runtime-report-ready-row" class="runtime-report-ready-row">
                <div id="runtime-header-status" class="runtime-header-status runtime-status runtime-js-hidden" aria-live="polite"></div>
                <div id="runtime-report-ready-action" class="runtime-report-ready-action runtime-js-hidden">
                    <button type="button" id="view-report" class="button-2 runtime-js-hidden">@T("Plugins.Misc.AIInterview.Runtime.ViewReport")</button>
                </div>
            </div>
            <div id="screen-share-interruption-warning" class="runtime-screen-share-interruption-warning runtime-js-hidden" aria-live="assertive">Resume screen share to continue.</div>
            <div id="screen-share-status" class="runtime-screen-share-status runtime-js-hidden" aria-live="polite"></div>
            <div class="runtime-status runtime-js-hidden" id="recording-status" role="status" aria-live="polite"></div>
            @if (Model.IsMockMode)
            {
                <div class="runtime-status message-info runtime-mock-warning">
                    @T("Plugins.Misc.AIInterview.Runtime.MockMode.Warning")
                </div>
            }
            <div id="runtime-status" class="runtime-status runtime-js-hidden" role="status" aria-live="polite"></div>

            <div class="runtime-progress"><span id="runtime-progress-bar"></span></div>
        </div>

        <details id="runtime-log" class="runtime-log-panel">
            <summary class="runtime-log-title">@T("Plugins.Misc.AIInterview.Runtime.Log")</summary>
            <div id="runtime-log-body"></div>
        </details>

        <div class="runtime-layout">
            <section class="runtime-stage">
                <div class="runtime-video">
                    <video id="runtime-video" autoplay playsinline muted></video>
                    <div id="camera-placeholder" class="runtime-camera-placeholder">
                        <i class="fa-solid fa-video-slash" aria-hidden="true"></i>
                        <span>Camera preview</span>
                    </div>
                    <div class="runtime-avatar">
                        <div class="runtime-avatar-status">
                            <span class="runtime-avatar-status-dot"></span>
                            <span>Listening live</span>
                        </div>
                        <div class="runtime-avatar-label">
                            <i class="fa-solid fa-robot" aria-hidden="true"></i>
                            <span>AI Interviewer</span>
                            <small>Role-based interviewer</small>
                        </div>
                    </div>
                    <div id="runtime-video-caption" class="runtime-video-caption runtime-js-hidden" aria-live="polite" hidden>
                        <div id="runtime-video-caption-track" class="runtime-video-caption-track">
                            <span id="runtime-video-caption-item" class="runtime-video-caption-item">
                                <span id="runtime-video-caption-speaker" class="runtime-video-caption-speaker"></span>
                                <span id="runtime-video-caption-text" class="runtime-video-caption-text"></span>
                            </span>
                            <span id="runtime-video-caption-copy" class="runtime-video-caption-item runtime-video-caption-copy" aria-hidden="true" hidden>
                                <span id="runtime-video-caption-copy-speaker" class="runtime-video-caption-speaker"></span>
                                <span id="runtime-video-caption-copy-text" class="runtime-video-caption-text"></span>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="runtime-controls">
                    <div class="runtime-control-group runtime-control-group-left">
                        <div class="runtime-meter" id="audio-meter" aria-label="microphone level">
                            <span></span><span></span><span></span><span></span><span></span><span></span>
                        </div>
                        <button type="button" id="view-guidelines" class="runtime-icon-button button-2" aria-label="Guidelines" title="Guidelines">
                            <i class="fa-solid fa-book-open" aria-hidden="true"></i>
                            <span class="sr-only">@T("Plugins.Misc.AIInterview.Runtime.Guidelines.Title")</span>
                        </button>
                    </div>
                    <div class="runtime-control-group runtime-control-group-center">
                        <div class="runtime-audio-device-control" id="runtime-audio-device-control">
                            <button type="button" id="toggle-audio-devices" class="runtime-icon-button button-2" aria-label="Audio devices" title="Audio devices" aria-expanded="false" aria-controls="runtime-audio-device-panel">
                                <i class="fa-solid fa-headphones" aria-hidden="true"></i>
                                <span class="sr-only">Audio devices</span>
                            </button>
                            <div id="runtime-audio-device-panel" class="runtime-audio-device-panel runtime-js-hidden" role="dialog" aria-label="Audio devices">
                                <div class="runtime-audio-device-field">
                                    <label for="runtime-audio-input"><i class="fa-solid fa-microphone" aria-hidden="true"></i><span>Microphone</span></label>
                                    <select id="runtime-audio-input"></select>
                                </div>
                                <div class="runtime-audio-device-field">
                                    <label for="runtime-audio-output"><i class="fa-solid fa-volume-high" aria-hidden="true"></i><span>Speaker</span></label>
                                    <select id="runtime-audio-output"></select>
                                </div>
                                <div id="runtime-audio-device-status" class="runtime-audio-device-status" aria-live="polite"></div>
                            </div>
                        </div>
                        <button type="button" id="toggle-mic" class="runtime-icon-button button-2" aria-label="Turn microphone on" title="Turn microphone on">
                            <i class="fa-solid fa-microphone" aria-hidden="true"></i>
                            <span class="sr-only">Turn microphone on</span>
                        </button>
                        <button type="button" id="start-or-next" class="button-1" disabled>@T("Plugins.Misc.AIInterview.Runtime.StartInterview")</button>
                        <button type="button" id="toggle-camera" class="runtime-icon-button button-2" aria-label="Turn camera on" title="Turn camera on">
                            <i class="fa-solid fa-video" aria-hidden="true"></i>
                            <span class="sr-only">Turn camera on</span>
                        </button>
                    </div>
                    <div class="runtime-control-group runtime-control-group-right">
                        <div class="runtime-control-icons">
                            <button type="button" id="toggle-screen-share" class="runtime-icon-button button-2" aria-label="Enable screen share" title="Enable screen share">
                                <i class="fa-solid fa-display" aria-hidden="true"></i>
                                <span class="sr-only">Enable screen share</span>
                            </button>
                            <button type="button" id="toggle-recording" class="runtime-icon-button button-2" aria-label="Recording status" title="Recording status">
                                <i class="fa-solid fa-circle" aria-hidden="true"></i>
                                <span class="sr-only">Recording status</span>
                            </button>
                        </div>
                    </div>
                </div>
            </section>

            <aside class="runtime-sidebar">
                <div class="runtime-sidebar-head">
                    <div class="runtime-sidebar-tabs" role="tablist" aria-label="Runtime panels">
                        <button type="button" class="runtime-tab is-active" id="runtime-tab-conversation" data-runtime-tab="conversation" role="tab" aria-selected="true" aria-controls="runtime-panel-conversation">Conversation</button>
                        <button type="button" class="runtime-tab" id="runtime-tab-details" data-runtime-tab="details" role="tab" aria-selected="false" aria-controls="runtime-panel-details">Interview details</button>
                    </div>
                </div>
                <div class="runtime-sidebar-panels">
                    <section class="runtime-sidebar-panel is-active" id="runtime-panel-conversation" data-runtime-panel="conversation" role="tabpanel" aria-labelledby="runtime-tab-conversation">
                        <div id="runtime-question" class="runtime-question runtime-js-hidden">@(string.IsNullOrWhiteSpace(Model.CurrentQuestion) ? T("Plugins.Misc.AIInterview.Runtime.WelcomePrompt").Text : Model.CurrentQuestion)</div>
                        <div id="runtime-message" class="runtime-message is-info runtime-js-hidden" hidden aria-hidden="true">@T("Plugins.Misc.AIInterview.Runtime.StartPrompt")</div>

                        <div class="runtime-conversation" id="conversation">
                            <div class="runtime-chat-placeholder" id="conversation-empty-state">
                                <div class="runtime-chat-placeholder-icon">
                                    <i class="fa-solid fa-comments" aria-hidden="true"></i>
                                </div>
                                <div class="runtime-chat-placeholder-copy">
                                    @* <div class="runtime-chat-placeholder-title">@(string.IsNullOrWhiteSpace(Model.CurrentQuestion) ? T("Plugins.Misc.AIInterview.Runtime.WelcomePrompt").Text : Model.CurrentQuestion)</div> *@
                                    <div class="runtime-chat-placeholder-text">@T("Plugins.Misc.AIInterview.Runtime.StartPrompt")</div>
                                </div>
                            </div>
                        </div>

                        <div class="runtime-answer">
                            <label class="sr-only" for="runtime-answer">Your answer</label>
                            <div class="runtime-answer-composer">
                                <textarea id="runtime-answer" placeholder="@T("Plugins.Misc.AIInterview.Runtime.AnswerPlaceholder")" disabled></textarea>
                                <button type="button" id="submit-answer" class="button-1 runtime-composer-send runtime-js-hidden" disabled title="Send answer">
                                    <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
                                    <span class="sr-only">@T("Plugins.Misc.AIInterview.Interview.SubmitAnswer")</span>
                                </button>
                            </div>
                        </div>
                    </section>

                    <section class="runtime-sidebar-panel" id="runtime-panel-details" data-runtime-panel="details" role="tabpanel" aria-labelledby="runtime-tab-details" hidden>
                        <div class="runtime-detail-list">
                            <div class="runtime-detail-item">
                                <span class="runtime-detail-label">Interview</span>
                                <span class="runtime-detail-value">@runtimeTitle</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Model.CandidateName))
                            {
                                <div class="runtime-detail-item">
                                    <span class="runtime-detail-label">Candidate</span>
                                    <span class="runtime-detail-value">@Model.CandidateName</span>
                                </div>
                            }
                            <div class="runtime-detail-item">
                                <span class="runtime-detail-label">Progress</span>
                                <span class="runtime-detail-value" id="runtime-question-count">0 / @Model.QuestionCount answered</span>
                            </div>
                            <div class="runtime-detail-item">
                                <span class="runtime-detail-label">Timer</span>
                                <span class="runtime-detail-value" id="runtime-timer-details">00:00</span>
                            </div>
                            <div class="runtime-detail-item">
                                <span class="runtime-detail-label">Camera</span>
                                <span class="runtime-detail-value" id="runtime-camera-status">Off</span>
                            </div>
                            <div class="runtime-detail-item">
                                <span class="runtime-detail-label">Microphone</span>
                                <span class="runtime-detail-value" id="runtime-mic-status">Off</span>
                            </div>
                            <div class="runtime-detail-item">
                                <span class="runtime-detail-label">Screen share</span>
                                <span class="runtime-detail-value" id="runtime-screen-share-details-status">Required</span>
                            </div>
                        </div>
                        <div id="runtime-actions" class="runtime-actions runtime-js-hidden">
                            <button type="button" id="stop-interview" class="button-2 runtime-js-hidden" disabled tabindex="-1" aria-hidden="true">@T("Plugins.Misc.AIInterview.Runtime.StopInterview")</button>
                        </div>
                    </section>
                </div>
            </aside>
        </div>
    </div>
</div>

<div id="runtime-transcript" class="runtime-transcript">
    <div class="runtime-transcript-card">
        <div class="runtime-modal-head">
            <h3>@T("Plugins.Misc.AIInterview.Runtime.Transcript")</h3>
            <button type="button" id="close-transcript" class="button-2">@T("Plugins.Misc.AIInterview.Runtime.Close")</button>
        </div>
        <div id="transcript-body" class="runtime-transcript-body"></div>
    </div>
</div>

<div id="guidelines-modal" class="runtime-modal" aria-hidden="true">
    <div class="runtime-modal-card runtime-permissions-card" role="dialog" aria-modal="true" aria-labelledby="guidelines-title">
        <div class="runtime-permissions-head">
            <div>
                <h3 id="guidelines-title">Media &amp; Permissions Test</h3>
                <p id="runtime-permissions-step-caption">Guidelines</p>
            </div>
            <button type="button" id="guidelines-cancel" class="runtime-feedback-close" aria-label="@T("Plugins.Misc.AIInterview.Runtime.Close")">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
        </div>

        <ol id="runtime-permissions-stepper" class="runtime-permissions-stepper" aria-label="Media and permissions steps">
            <li><button type="button" data-permission-step-jump="0"><span>1</span><strong>Guidelines</strong></button></li>
            <li><button type="button" data-permission-step-jump="1"><span>2</span><strong>Camera</strong></button></li>
            <li><button type="button" data-permission-step-jump="2"><span>3</span><strong>Internet</strong></button></li>
            <li><button type="button" data-permission-step-jump="3"><span>4</span><strong>Microphone</strong></button></li>
            <li><button type="button" data-permission-step-jump="4"><span>5</span><strong>Speaker</strong></button></li>
            <li><button type="button" data-permission-step-jump="5"><span>6</span><strong>Speech Recognition</strong></button></li>
            <li><button type="button" data-permission-step-jump="6"><span>7</span><strong>Summary</strong></button></li>
        </ol>

        <div class="runtime-permissions-body">
            <section class="runtime-permissions-step" data-permission-step="0">
                <p class="runtime-permissions-intro">Before starting the interview, we need to test your system to ensure optimal performance.</p>
                <ul class="runtime-guidelines">
                    <li>Camera and microphone access for video communication</li>
                    <li>Speaker functionality for audio feedback</li>
                    <li>Internet connection speed for stable interview experience</li>
                    <li>Speech recognition readiness for voice interaction</li>
                </ul>
                <p class="runtime-permissions-note">This process should take 2-3 minutes. All tests are optional but recommended.</p>
            </section>

            <section class="runtime-permissions-step" data-permission-step="1" hidden>
                <h4>Camera check</h4>
                <div class="runtime-permissions-video-frame">
                    <video id="runtime-precheck-camera-preview" autoplay muted playsinline></video>
                    <div id="runtime-precheck-camera-placeholder" class="runtime-permissions-placeholder">
                        <i class="fa-solid fa-video" aria-hidden="true"></i>
                    </div>
                </div>
                <p id="runtime-precheck-camera-status" class="runtime-permissions-status">Camera preview will appear here.</p>
                <div class="runtime-permissions-choice-row" role="group" aria-label="Camera result">
                    <button type="button" class="button-2" data-permission-result="camera" data-permission-value="working">Yes, I can see myself</button>
                    <button type="button" class="button-2" data-permission-result="camera" data-permission-value="not-working">No, it is not working</button>
                </div>
            </section>

            <section class="runtime-permissions-step" data-permission-step="2" hidden>
                <h4>Test your internet connection speed</h4>
                <button type="button" id="runtime-precheck-internet-test" class="button-2">Test Internet Speed</button>
                <p id="runtime-precheck-internet-status" class="runtime-permissions-status">Run the speed test to continue.</p>
            </section>

            <section class="runtime-permissions-step" data-permission-step="3" hidden>
                <h4>Request microphone permission to proceed</h4>
                <button type="button" id="runtime-precheck-mic-request" class="button-2">Request Microphone Access</button>
                <div class="runtime-permissions-meter" id="runtime-precheck-audio-meter" aria-label="microphone level">
                    <span></span><span></span><span></span><span></span><span></span>
                </div>
                <p id="runtime-precheck-mic-status" class="runtime-permissions-status">Microphone level will appear after permission is granted.</p>
                <div class="runtime-permissions-choice-row" role="group" aria-label="Microphone result">
                    <button type="button" class="button-2" data-permission-result="microphone" data-permission-value="working">Yes, I can see the level bar moving</button>
                    <button type="button" class="button-2" data-permission-result="microphone" data-permission-value="not-working">No, it is not working</button>
                </div>
            </section>

            <section class="runtime-permissions-step" data-permission-step="4" hidden>
                <h4>Click the button below to test your speakers</h4>
                <button type="button" id="runtime-precheck-speaker-test" class="button-2">Play Test Sound</button>
                <p class="runtime-permissions-status">Did you hear the test tone?</p>
                <div class="runtime-permissions-choice-row" role="group" aria-label="Speaker result">
                    <button type="button" class="button-2" data-permission-result="speaker" data-permission-value="working">Yes</button>
                    <button type="button" class="button-2" data-permission-result="speaker" data-permission-value="not-working">No</button>
                </div>
            </section>

            <section class="runtime-permissions-step" data-permission-step="5" hidden>
                <h4>Speech Recognition</h4>
                <p class="runtime-permissions-phrase">"The quick brown fox jumps over the lazy dog today"</p>
                <div class="runtime-permissions-choice-row">
                    <button type="button" id="runtime-precheck-speech-start" class="button-2">Start Recording</button>
                    <button type="button" id="runtime-precheck-speech-stop" class="button-2 runtime-js-hidden">Stop Recording</button>
                </div>
                <div id="runtime-precheck-speech-result" class="runtime-permissions-speech-result" aria-live="polite"></div>
                <p class="runtime-permissions-status">Is it working?</p>
                <div class="runtime-permissions-choice-row" role="group" aria-label="Speech recognition result">
                    <button type="button" class="button-2" data-permission-result="speechRecognition" data-permission-value="working">Yes, it works</button>
                    <button type="button" class="button-2" data-permission-result="speechRecognition" data-permission-value="not-working">No, not accurate</button>
                </div>
            </section>

            <section class="runtime-permissions-step" data-permission-step="6" hidden>
                <div class="runtime-permissions-summary-list">
                    <div><span>Camera</span><strong id="runtime-precheck-summary-camera">Not working</strong></div>
                    <div><span>Microphone</span><strong id="runtime-precheck-summary-microphone">Not working</strong></div>
                    <div><span>Speaker</span><strong id="runtime-precheck-summary-speaker">Not working</strong></div>
                    <div><span>Internet</span><strong id="runtime-precheck-summary-internet">Not tested</strong></div>
                    <div><span>Speech Recognition</span><strong id="runtime-precheck-summary-speech">Not working</strong></div>
                </div>
                <label class="runtime-guidelines-ack runtime-permissions-consent" for="guidelines-acknowledge">
                    <input type="checkbox" id="guidelines-acknowledge" />
                    <span>I consent to use my camera, microphone, and other media devices for this interview. I understand that my video and audio will be recorded and shared with the recruiter.</span>
                </label>
            </section>
        </div>

        <div class="runtime-modal-actions runtime-permissions-actions">
            <button type="button" id="runtime-permissions-back" class="button-2" disabled>Back</button>
            <button type="button" id="runtime-permissions-next" class="button-1">Next</button>
            <button type="button" id="guidelines-agree" class="button-1 runtime-js-hidden" disabled>Continue to Interview</button>
        </div>
    </div>
</div>

<div id="runtime-feedback-modal" class="runtime-modal runtime-feedback-modal" aria-hidden="true">
    <div class="runtime-modal-card runtime-feedback-card" role="dialog" aria-modal="true" aria-labelledby="runtime-feedback-title">
        <div class="runtime-feedback-head">
            <div class="runtime-feedback-title-row">
                <span class="runtime-feedback-title-icon"><i class="fa-regular fa-circle-question" aria-hidden="true"></i></span>
                <h3 id="runtime-feedback-title">@T("Plugins.Misc.AIInterview.Runtime.Feedback.Title")</h3>
            </div>
            <button type="button" id="runtime-feedback-close" class="runtime-feedback-close" aria-label="@T("Plugins.Misc.AIInterview.Runtime.Close")">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
        </div>
        <p class="runtime-feedback-intro">@T("Plugins.Misc.AIInterview.Runtime.Feedback.Intro")</p>
        <div class="runtime-feedback-field">
            <label for="runtime-feedback-issue-button">@T("Plugins.Misc.AIInterview.Runtime.Feedback.IssueLabel")</label>
            <div class="runtime-feedback-select-wrap">
                <input type="hidden" id="runtime-feedback-issue" value="AI is not speaking" />
                <button type="button" id="runtime-feedback-issue-button" class="runtime-feedback-issue-button" aria-haspopup="listbox" aria-expanded="false" aria-controls="runtime-feedback-issue-listbox">
                    <span class="runtime-feedback-issue-current">
                        <i id="runtime-feedback-issue-current-icon" class="fa-solid fa-volume-xmark" aria-hidden="true"></i>
                        <span id="runtime-feedback-issue-current-text">@T("Plugins.Misc.AIInterview.Runtime.Feedback.Option.AiNotSpeaking")</span>
                    </span>
                    <span class="runtime-feedback-chevron"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                </button>
                <div id="runtime-feedback-issue-listbox" class="runtime-feedback-issue-listbox runtime-js-hidden" role="listbox" aria-labelledby="runtime-feedback-issue-button">
                    <button type="button" class="runtime-feedback-issue-option is-active" role="option" tabindex="-1" aria-selected="true" data-feedback-issue-value="AI is not speaking" data-feedback-issue-icon="fa-solid fa-volume-xmark">
                        <i class="fa-solid fa-volume-xmark" aria-hidden="true"></i>
                        <span>@T("Plugins.Misc.AIInterview.Runtime.Feedback.Option.AiNotSpeaking")</span>
