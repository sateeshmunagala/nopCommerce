@model Nop.Plugin.Misc.AIInterview.Models.AIInterviewConfigureModel
@using Nop.Plugin.Misc.AIInterview
@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = T("Plugins.Misc.AIInterview.Admin.Configure.Title").Text;
    NopHtml.AppendCssFileParts("~/Plugins/Misc.AIInterview/Content/css/aiinterview-admin.css");
    NopHtml.AppendPageCssClassParts("html-aiinterview-plugin-admin-page");
    NopHtml.AppendPageCssClassParts("html-aiinterview-admin-mock-config-page");
}

<form asp-route="@AIInterviewDefaults.ConfigurationRouteName" method="post">
    <div class="content-header clearfix aiinterview-admin-header">
        <div class="float-left">
            <h1>@T("Plugins.Misc.AIInterview.Admin.Configure.Title")</h1>
            <div class="aiinterview-admin-subtitle">@T("Plugins.Misc.AIInterview.Admin.MockConfigure.Subtitle")</div>
        </div>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-save"></i> @T("Admin.Common.Save")
            </button>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid aiinterview-admin-shell aiinterview-admin-config-shell">
            <div class="aiinterview-admin-summary">
                <div class="aiinterview-admin-summary-card">
                    <span class="aiinterview-admin-summary-label">@T("Plugins.Misc.AIInterview.Admin.Configure.General")</span>
                    <strong class="aiinterview-admin-summary-value">@T("Plugins.Misc.AIInterview.Admin.MockConfigure.General.Summary")</strong>
                </div>
                <div class="aiinterview-admin-summary-card">
                    <span class="aiinterview-admin-summary-label">@T("Plugins.Misc.AIInterview.Admin.Configure.Service")</span>
                    <strong class="aiinterview-admin-summary-value">@T("Plugins.Misc.AIInterview.Admin.MockConfigure.Service.Summary")</strong>
                </div>
                <div class="aiinterview-admin-summary-card">
                    <span class="aiinterview-admin-summary-label">@T("Plugins.Misc.AIInterview.Admin.Configure.CreditPack")</span>
                    <strong class="aiinterview-admin-summary-value">@T("Plugins.Misc.AIInterview.Admin.MockConfigure.CreditPack.Summary")</strong>
                </div>
            </div>

            <div class="cards-group aiinterview-admin-grid">
                <div class="card card-default aiinterview-admin-card">
                    <div class="card-header">@T("Plugins.Misc.AIInterview.Admin.Configure.General")</div>
                    <div class="card-body aiinterview-admin-copy">
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="Enabled" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="Enabled" />
                                <span asp-validation-for="Enabled"></span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="MockInterviewQuestionCount" />
                            </div>
                            <div class="col-md-9">
                                <input asp-for="MockInterviewQuestionCount" class="form-control" type="number" min="1" max="10" step="1" />
                                <small class="form-text text-muted">@T("Plugins.Misc.AIInterview.Admin.Configure.MockInterviewQuestionCount.Hint")</small>
                                <span asp-validation-for="MockInterviewQuestionCount"></span>
                            </div>
                        </div>
                        <p>@T("Plugins.Misc.AIInterview.Admin.MockConfigure.General.Body")</p>
                    </div>
                </div>
                <div class="card card-default aiinterview-admin-card">
                    <div class="card-header">@T("Plugins.Misc.AIInterview.Admin.Configure.Service")</div>
                    <div class="card-body aiinterview-admin-copy">
                        <p>@T("Plugins.Misc.AIInterview.Admin.MockConfigure.Service.Body")</p>
                    </div>
                </div>
                <div class="card card-default aiinterview-admin-card">
                    <div class="card-header">@T("Plugins.Misc.AIInterview.Admin.Configure.CreditPack")</div>
                    <div class="card-body aiinterview-admin-copy">
                        <p>@T("Plugins.Misc.AIInterview.Admin.MockConfigure.CreditPack.Body")</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
