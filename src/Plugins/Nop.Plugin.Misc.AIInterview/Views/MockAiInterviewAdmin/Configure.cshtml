@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = T("Plugins.Misc.AIInterview.Admin.Configure.Title").Text;
    NopHtml.AppendCssFileParts("~/Plugins/Misc.AIInterview/Content/css/aiinterview-admin.css");
    NopHtml.AppendPageCssClassParts("html-aiinterview-plugin-admin-page");
    NopHtml.AppendPageCssClassParts("html-aiinterview-admin-mock-config-page");
}

<div class="content-header clearfix aiinterview-admin-header">
    <div class="float-left">
        <h1>@T("Plugins.Misc.AIInterview.Admin.Configure.Title")</h1>
        <div class="aiinterview-admin-subtitle">Mock administration workspace</div>
    </div>
</div>

<section class="content">
    <div class="container-fluid aiinterview-admin-shell aiinterview-admin-config-shell">
        <div class="aiinterview-admin-summary">
            <div class="aiinterview-admin-summary-card">
                <span class="aiinterview-admin-summary-label">Mode</span>
                <strong class="aiinterview-admin-summary-value">Mock interview administration</strong>
            </div>
            <div class="aiinterview-admin-summary-card">
                <span class="aiinterview-admin-summary-label">Purpose</span>
                <strong class="aiinterview-admin-summary-value">Preview plugin-owned admin navigation and layout</strong>
            </div>
            <div class="aiinterview-admin-summary-card">
                <span class="aiinterview-admin-summary-label">Scope</span>
                <strong class="aiinterview-admin-summary-value">Informational only</strong>
            </div>
        </div>

        <div class="cards-group aiinterview-admin-grid">
            <div class="card card-default aiinterview-admin-card">
                <div class="card-header">Workspace overview</div>
                <div class="card-body aiinterview-admin-copy">
                    <p>This mock page keeps the existing admin entry point available while presenting a finished plugin layout.</p>
                    <p>Use the production AIInterview configuration screens for live service settings, routing, and operational changes.</p>
                </div>
            </div>
            <div class="card card-default aiinterview-admin-card">
                <div class="card-header">Included in this view</div>
                <div class="card-body">
                    <ul class="aiinterview-admin-list">
                        <li>Readable plugin-owned page hierarchy and spacing.</li>
                        <li>Clear separation between preview-only guidance and live operational settings.</li>
                        <li>Consistent AIInterview admin card, badge, and action styling.</li>
                    </ul>
                </div>
            </div>
            <div class="card card-default aiinterview-admin-card">
                <div class="card-header">Not changed in this pass</div>
                <div class="card-body">
                    <ul class="aiinterview-admin-list">
                        <li>No new save actions or controller behavior.</li>
                        <li>No changes to routes, secrets, localization, or database state.</li>
                        <li>No new mock workflow beyond this informational layout.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
