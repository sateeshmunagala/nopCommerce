@model Nop.Web.Models.Catalog.ProductDetailsModel

@using Microsoft.AspNetCore.Mvc.Rendering
@using Nop.Core
@using Nop.Core.Domain.Catalog
@using Nop.Core.Domain.Media
@using Nop.Core.Domain.Seo
@using Nop.Plugin.Misc.AIInterview.Services
@using Nop.Services.Customers
@using Nop.Services.Helpers
@using Nop.Services.Media
@inject IWorkContext workContext
@inject ICustomerService customerService
@inject IInterviewSessionService interviewSessionService
@inject IDateTimeHelper dateTimeHelper
@inject IDownloadService downloadService
@inject IWebHelper webHelper
@inject SeoSettings seoSettings

@{
    Layout = "_ColumnsOne";

    NopHtml.AddTitleParts(string.IsNullOrWhiteSpace(Model.MetaTitle) ? Model.Name : Model.MetaTitle);
    NopHtml.AddMetaDescriptionParts(Model.MetaDescription);
    NopHtml.AddMetaKeywordParts(Model.MetaKeywords);
    NopHtml.AppendCssFileParts("~/Plugins/Misc.AIInterview/Content/css/aiinterview-public.css");
    NopHtml.AppendPageCssClassParts("html-product-details-page");
    NopHtml.AppendPageCssClassParts("html-aiinterview-mock-practice-product-page");

    if (seoSettings.CanonicalUrlsEnabled)
    {
        var canonicalUrl = Url.RouteUrl("Product", new { SeName = Model.SeName }, webHelper.GetCurrentRequestProtocol())?.ToLowerInvariant();
        if (!string.IsNullOrWhiteSpace(canonicalUrl))
            NopHtml.AddCanonicalUrlParts(canonicalUrl, seoSettings.QueryStringInCanonicalUrlsEnabled);
    }
    NopHtml.AddJsonLdParts(Model.JsonLd);

    var customer = await workContext.GetCurrentCustomerAsync();
    var isAuthenticated = customer != null && !await customerService.IsGuestAsync(customer);
    var resumeEntries = isAuthenticated
        ? await interviewSessionService.GetPreviousResumeSourcesAsync(customer.Id) ?? new List<PreviousResumeSource>()
        : new List<PreviousResumeSource>();
    var availableResumes = new List<SelectListItem>();
    if (isAuthenticated)
    {
        foreach (var entry in resumeEntries)
        {
            var download = await downloadService.GetDownloadByIdAsync(entry.ResumeDownloadId);
            if (download == null)
                continue;

            var fileName = string.IsNullOrWhiteSpace(download.Filename)
                ? $"{entry.DefaultLabel} #{entry.ResumeDownloadId}"
                : download.Filename;
            var createdLabel = entry.CreatedOnUtc == default
                ? string.Empty
                : (await dateTimeHelper.ConvertToUserTimeAsync(entry.CreatedOnUtc, DateTimeKind.Utc)).ToString("yyyy-MM-dd");
            var optionText = string.IsNullOrWhiteSpace(createdLabel)
                ? fileName
                : $"{fileName} ({createdLabel})";

            availableResumes.Add(new SelectListItem
            {
                Value = entry.ResumeDownloadId.ToString(),
                Text = optionText
            });
        }
    }

    var summary = !string.IsNullOrWhiteSpace(Model.ShortDescription)
        ? Model.ShortDescription
        : "Choose a difficulty level and either select a skill or upload a resume. The AI interview will use those selections to create questions without connecting you to any company, job post, or application.";
    string[] practiceDifficultyKeywords =
    {
        "practice difficulty",
        "difficulty",
        "interview difficulty"
    };
    string[] practiceSkillKeywords =
    {
        "practice skill",
        "skill",
        "skills",
        "interview skill"
    };
    string NormalizeAttributeLabel(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        var sanitized = new string(value
            .Trim()
            .Select(character => char.IsLetterOrDigit(character) ? char.ToLowerInvariant(character) : ' ')
            .ToArray());

        return string.Join(" ", sanitized
            .Split(new[] { ' ', '\t', '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries))
            .ToLowerInvariant();
    }
    bool MatchesAttributeKeyword(Nop.Web.Models.Catalog.ProductDetailsModel.ProductAttributeModel attribute, IEnumerable<string> keywords)
    {
        var normalizedCandidates = new[] { attribute?.Name, attribute?.TextPrompt }
            .Select(NormalizeAttributeLabel)
            .Where(candidate => !string.IsNullOrWhiteSpace(candidate))
            .Distinct(StringComparer.Ordinal)
            .ToList();

        return normalizedCandidates.Any(candidate => keywords.Any(keyword =>
        {
            var normalizedKeyword = NormalizeAttributeLabel(keyword);
            return string.Equals(candidate, normalizedKeyword, StringComparison.Ordinal) ||
                candidate.Contains(normalizedKeyword, StringComparison.Ordinal);
        }));
    }
    var difficultyAttributes = Model.ProductAttributes
        .Where(attribute => MatchesAttributeKeyword(attribute, practiceDifficultyKeywords))
        .ToList();
    var skillAttributes = Model.ProductAttributes
        .Where(attribute =>
            !difficultyAttributes.Contains(attribute) &&
            MatchesAttributeKeyword(attribute, practiceSkillKeywords))
        .ToList();
    var additionalAttributes = Model.ProductAttributes
        .Where(attribute =>
            !difficultyAttributes.Contains(attribute) &&
            !skillAttributes.Contains(attribute))
        .ToList();
    var difficultyModel = new Nop.Web.Models.Catalog.ProductDetailsModel
    {
        Id = Model.Id,
        AllowAddingOnlyExistingAttributeCombinations = Model.AllowAddingOnlyExistingAttributeCombinations,
        DisplayAttributeCombinationImagesOnly = Model.DisplayAttributeCombinationImagesOnly,
        ProductAttributes = difficultyAttributes
    };
    var skillModel = new Nop.Web.Models.Catalog.ProductDetailsModel
    {
        Id = Model.Id,
        AllowAddingOnlyExistingAttributeCombinations = Model.AllowAddingOnlyExistingAttributeCombinations,
        DisplayAttributeCombinationImagesOnly = Model.DisplayAttributeCombinationImagesOnly,
        ProductAttributes = skillAttributes
    };
    var additionalModel = new Nop.Web.Models.Catalog.ProductDetailsModel
    {
        Id = Model.Id,
        AllowAddingOnlyExistingAttributeCombinations = Model.AllowAddingOnlyExistingAttributeCombinations,
        DisplayAttributeCombinationImagesOnly = Model.DisplayAttributeCombinationImagesOnly,
        ProductAttributes = additionalAttributes
    };
}

@section Breadcrumb
{
    @await Html.PartialAsync("_ProductBreadcrumb", Model.Breadcrumb)
}

<div class="page product-details-page practice-details-page">
    <div class="page-body">
        <div class="job-shell practice-shell">
            <section class="job-hero">
                <div class="job-hero-copy">
                    <p class="job-kicker">@Model.Name</p>
                    <div class="job-lead">@Html.Raw(summary)</div>
                    <div class="job-grid">
                        <div class="job-card">
                            <strong>Session length</strong>
                            <span>15-25 minutes</span>
                        </div>
                        <div class="job-card">
                            <strong>Question style</strong>
                            <span>Role based</span>
                        </div>
                        <div class="job-card">
                            <strong>Difficulty</strong>
                            <span>Low to advanced</span>
                        </div>
                        <div class="job-card">
                            <strong>Input</strong>
                            <span>Skill or resume</span>
                        </div>
                    </div>
                </div>

                <div class="job-ai-panel practice-start-panel">
                    <div class="job-ai-grid">
                        <div>
                            <h2>Start Interview</h2>
                        </div>

                        @if (!isAuthenticated)
                        {
                            <div class="job-ai-card">
                                <p class="job-ai-lead">Sign in to start a saved AI practice session and keep your report in your account.</p>
                                <a class="button-1" href="@Url.RouteUrl("Login")">Sign in</a>
                            </div>
                        }
                        else
                        {
                            <div class="job-ai-card">
                                <form asp-route="@AIInterviewDefaults.MockStartRouteName" method="post" enctype="multipart/form-data" class="practice-start-form" id="product-details-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@Model.Id" />
                                    <section class="practice-difficulty-section" aria-labelledby="practice-difficulty-heading">
                                        <div class="practice-field-heading" id="practice-difficulty-heading">
                                            <span>Difficulty</span><span class="practice-required-marker" aria-hidden="true">*</span>
                                            <span class="practice-required-text">Required</span>
                                        </div>
                                        <p class="practice-field-help">Select the difficulty level for this AI interview.</p>
                                        <div class="practice-pathway practice-difficulty-pathway">
                                            @{
                                                var difficultyViewData = new ViewDataDictionary(ViewData);
                                                difficultyViewData.TemplateInfo.HtmlFieldPrefix = $"attributes_{Model.Id}";
                                                @await Html.PartialAsync("_ProductAttributes", difficultyModel, difficultyViewData)
                                            }
                                        </div>
                                    </section>

                                    <fieldset class="practice-alternative-inputs" aria-describedby="practice-alternative-guidance">
                                        <legend>Choose a Skill or Resume</legend>
                                        <p class="practice-alternative-guidance" id="practice-alternative-guidance">
                                            At least one is required: select a Skill, or select or upload a Resume.
                                        </p>

                                        <div class="practice-pathway practice-skill-pathway">
                                            <div class="practice-field-heading">
                                                <span>Skill</span>
                                                <span class="practice-optional-badge">Optional if you upload or select a resume</span>
                                            </div>
                                            <p class="practice-field-help">Choose a skill when you want questions focused on a specific topic.</p>
                                            @{
                                                var skillViewData = new ViewDataDictionary(ViewData);
                                                skillViewData.TemplateInfo.HtmlFieldPrefix = $"attributes_{Model.Id}";
                                                @await Html.PartialAsync("_ProductAttributes", skillModel, skillViewData)
                                            }
                                        </div>

                                        <div class="practice-or-divider" role="separator" aria-label="or">
                                            <span>OR</span>
                                        </div>

                                        <div class="practice-pathway practice-resume-pathway">
                                            <div class="practice-field-heading">
                                                <span>Resume</span>
                                                <span class="practice-optional-badge">Optional if you select a skill</span>
                                            </div>
                                            <p class="practice-field-help">Use a previous resume or upload a new one to tailor questions to your experience.</p>

                                            @if (availableResumes.Any())
                                            {
                                                <div class="practice-resume-choice">
                                                    <label for="practice-existing-resume">Previous resume</label>
                                                    <select id="practice-existing-resume" name="SelectedResumeDownloadId">
                                                        <option value="0">Select a previous resume</option>
                                                        @foreach (var option in availableResumes)
                                                        {
                                                            <option value="@option.Value">@option.Text</option>
                                                        }
                                                    </select>
                                                </div>
                                            }

                                            <div class="practice-resume-choice">
                                                <label for="practice-resume-upload">Upload new resume</label>
                                                <input id="practice-resume-upload" name="ResumeFile" type="file" accept=".pdf,.docx" />
                                            </div>
                                            <p class="job-ai-note">Upload a resume only when you want the AI interview to pull questions from your actual experience.</p>
                                        </div>
                                    </fieldset>

                                    @if (additionalAttributes.Any())
                                    {
                                        <section class="practice-additional-section" aria-labelledby="practice-additional-heading">
                                            <div class="practice-field-heading" id="practice-additional-heading">
                                                <span>Additional practice preferences</span>
                                            </div>
                                            <p class="practice-field-help">Complete any additional practice fields below. Required fields are marked with an asterisk.</p>
                                            <div class="practice-additional-inputs">
                                                @{
                                                    var additionalViewData = new ViewDataDictionary(ViewData);
                                                    additionalViewData.TemplateInfo.HtmlFieldPrefix = $"attributes_{Model.Id}";
                                                    @await Html.PartialAsync("_ProductAttributes", additionalModel, additionalViewData)
                                                }
                                            </div>
                                        </section>
                                    }

                                    <div class="message-error practice-start-error aiinterview-hidden" data-practice-start-error="true" role="alert" aria-live="polite"></div>

                                    <div class="job-ai-actions">
                                        <button type="submit" class="button-1" data-practice-start-submit="true">Start AI Interview</button>
                                    </div>
                                    <div class="practice-start-progress aiinterview-hidden" data-practice-start-progress="true" role="status" aria-live="polite" style="min-height: 48px; margin-top: 12px;">
                                        <div data-practice-start-progress-message="true"></div>
                                        <strong data-practice-start-progress-elapsed="true">00:00</strong>
                                    </div>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </section>

            <div class="job-content-grid practice-content-grid">
                @if (!string.IsNullOrWhiteSpace(Model.FullDescription))
                {
                    <section class="job-card">
                        <h2>About this AI Interview</h2>
                        <div class="practice-description">
                            @Html.Raw(Model.FullDescription)
                        </div>
                    </section>
                }
            </div>
        </div>
    </div>
</div>

<script asp-location="Footer">
    (() => {
        const form = document.querySelector('.practice-start-form');
        if (!form)
            return;

        const button = form.querySelector('[data-practice-start-submit="true"]');
        const errorContainer = form.querySelector('[data-practice-start-error="true"]');
        const progressContainer = form.querySelector('[data-practice-start-progress="true"]');
        const progressMessage = form.querySelector('[data-practice-start-progress-message="true"]');
        const progressElapsed = form.querySelector('[data-practice-start-progress-elapsed="true"]');
        const safeRequestError = 'Unable to start the practice interview. Please try again.';
        const originalButtonText = button?.textContent || 'Start AI Interview';
        let progressTimer = null;
        let progressStartedAt = 0;

        const setBusy = (isBusy) => {
            if (button) {
                button.disabled = !!isBusy;
                button.textContent = isBusy ? 'Starting interview...' : originalButtonText;
            }
        };

        const formatElapsed = (seconds) => {
            const minutes = Math.floor(seconds / 60);
            const remainder = seconds % 60;
            return `${String(minutes).padStart(2, '0')}:${String(remainder).padStart(2, '0')}`;
        };

        const updateProgress = () => {
            if (!progressContainer)
                return;

            const elapsedSeconds = Math.max(0, Math.floor((Date.now() - progressStartedAt) / 1000));
            if (progressElapsed)
                progressElapsed.textContent = formatElapsed(elapsedSeconds);
            if (progressMessage) {
                progressMessage.textContent = elapsedSeconds >= 25
                    ? 'This is taking a little longer than usual. Please keep this page open.'
                    : elapsedSeconds >= 8
                        ? 'Your resume is ready. We are preparing your interview questions...'
                        : 'Uploading your resume and preparing your interview...';
            }
        };

        const startProgress = () => {
            progressStartedAt = Date.now();
            progressContainer?.classList.remove('aiinterview-hidden');
            updateProgress();
            progressTimer = window.setInterval(updateProgress, 1000);
        };

        const stopProgress = () => {
            if (progressTimer)
                window.clearInterval(progressTimer);
            progressTimer = null;
            progressContainer?.classList.add('aiinterview-hidden');
        };

        const showError = (message) => {
            if (!errorContainer)
                return;

            errorContainer.textContent = message || safeRequestError;
            errorContainer.classList.remove('aiinterview-hidden');
        };

        const clearError = () => {
            if (!errorContainer)
                return;

            errorContainer.textContent = '';
            errorContainer.classList.add('aiinterview-hidden');
        };

        form.addEventListener('submit', async (event) => {
            event.preventDefault();
            if (button?.disabled)
                return;

            clearError();
            setBusy(true);
            startProgress();

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    credentials: 'same-origin',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });
                const contentType = response.headers.get('content-type') || '';
                let result = null;
                if (contentType.includes('application/json')) {
                    try {
                        result = await response.json();
                    } catch {
                    }
                }

                if (!response.ok) {
                    showError(result?.error || result?.message || safeRequestError);
                    return;
                }

                if (!contentType.includes('application/json')) {
                    let responseText = '';
                    try {
                        responseText = (await response.text()).trim();
                    } catch {
                    }

                    showError(responseText || safeRequestError);
                    return;
                }

                if (!result) {
                    showError(safeRequestError);
                    return;
                }

                if (result?.runtimeUrl) {
                    window.location.href = result.runtimeUrl;
                    return;
                }

                showError(result?.error || result?.message || safeRequestError);
            } catch {
                showError(safeRequestError);
            } finally {
                if (!window.location.href.includes('/mockaiinterview/runtime')) {
                    stopProgress();
                    setBusy(false);
                }
            }
        });
    })();
</script>
