@using Nop.Web.Models.Customer
@model VendorJobModel
@{
    Layout = "_ColumnsTwo";
    NopHtml.AddTitleParts(T("Plugins.Misc.AIInterview.VendorJobCreation.Title").Text);
}

@section left
{
    @await Component.InvokeAsync("CustomerNavigation", new { selectedTabId = AIInterviewDefaults.VendorJobCreationNavigationTab })
}

<style>
    .vendor-job-creation-page .page-body {
        display: grid;
        gap: 20px;
    }

    .vendor-job-form {
        padding: 24px;
        border: 1px solid #d9e1ec;
        border-radius: 8px;
        background: #fff;
    }

    .vendor-job-form-grid {
        display: grid;
        gap: 16px;
    }

    .vendor-job-form-row {
        display: grid;
        grid-template-columns: minmax(170px, 210px) minmax(0, 1fr);
        gap: 12px 18px;
        align-items: start;
    }

    .vendor-job-form-row.vendor-job-form-row-top {
        align-items: center;
    }

    .vendor-job-form-label {
        padding-top: 10px;
        font-weight: 600;
        color: #24364b;
    }

    .vendor-job-form-label label {
        display: inline-block;
        margin: 0;
    }

    .vendor-job-form-control {
        min-width: 0;
    }

    .vendor-job-form-control input[type="text"],
    .vendor-job-form-control input[type="date"],
    .vendor-job-form-control input[type="number"],
    .vendor-job-form-control textarea,
    .vendor-job-form-control select {
        width: 100%;
        min-height: 44px;
        padding: 10px 12px;
        border: 1px solid #c8d3e1;
        border-radius: 6px;
        background: #fff;
        box-sizing: border-box;
    }

    .vendor-job-form-control textarea {
        min-height: 120px;
        resize: vertical;
    }

    .vendor-job-form-hint {
        display: block;
        margin-top: 6px;
        color: #6c7a89;
        font-size: 0.9rem;
    }

    .vendor-job-form-control .field-validation-error,
    .vendor-job-form-control .field-validation-valid {
        display: block;
        margin-top: 6px;
    }

    .vendor-job-form-checkbox-list {
        display: grid;
        gap: 10px;
        padding-top: 8px;
    }

    .vendor-job-form-checkbox {
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 24px;
    }

    .vendor-job-form-checkbox label {
        margin: 0;
        font-weight: 500;
    }

    .vendor-job-form-actions {
        margin-left: 188px;
        padding-top: 8px;
    }

    .vendor-job-submit {
        min-width: 160px;
    }

    @@media (max-width: 820px) {
        .vendor-job-form {
            padding: 20px;
        }

        .vendor-job-form-row {
            grid-template-columns: 1fr;
            gap: 8px;
        }

        .vendor-job-form-label {
            padding-top: 0;
        }

        .vendor-job-form-checkbox-list {
            padding-top: 0;
        }

        .vendor-job-form-actions {
            margin-left: 0;
        }
    }
</style>

<div class="page vendor-job-creation-page">
    <div class="page-title">
        <h1>@T("Plugins.Misc.AIInterview.VendorJobCreation.Title")</h1>
    </div>
    <div class="page-body">
        <form asp-route="@AIInterviewDefaults.VendorJobCreationRouteName" method="post" class="vendor-job-form">
            <div asp-validation-summary="ModelOnly" class="message-error"></div>

            <div class="vendor-job-form-grid">
                <div class="vendor-job-form-row">
                    <div class="vendor-job-form-label">
                        <label asp-for="Name" asp-postfix=":"></label>
                        <nop-required />
                    </div>
                    <div class="vendor-job-form-control">
                        <input asp-for="Name" />
                        <span asp-validation-for="Name"></span>
                    </div>
                </div>

                <div class="vendor-job-form-row vendor-job-form-row-top">
                    <div class="vendor-job-form-label">
                        <label asp-for="Sku" asp-postfix=":"></label>
                    </div>
                    <div class="vendor-job-form-control">
                        <input asp-for="Sku" />
                        <span asp-validation-for="Sku"></span>
                    </div>
                </div>

                <div class="vendor-job-form-row vendor-job-form-row-top">
                    <div class="vendor-job-form-label">
                        <label asp-for="ApplyUntilUtc" asp-postfix=":"></label>
                    </div>
                    <div class="vendor-job-form-control">
                        <input asp-for="ApplyUntilUtc" type="date" />
                        <span asp-validation-for="ApplyUntilUtc"></span>
                    </div>
                </div>

                @if (Model.AvailableExperienceLevels.Any())
                {
                    <div class="vendor-job-form-row vendor-job-form-row-top">
                        <div class="vendor-job-form-label">
                            <label asp-for="ExperienceLevelOptionId" asp-postfix=":"></label>
                        </div>
                        <div class="vendor-job-form-control">
                            <select asp-for="ExperienceLevelOptionId" asp-items="Model.AvailableExperienceLevels"></select>
                            <span asp-validation-for="ExperienceLevelOptionId"></span>
                        </div>
                    </div>
                }

                @if (Model.AvailableWorkModes.Any())
                {
                    <div class="vendor-job-form-row vendor-job-form-row-top">
                        <div class="vendor-job-form-label">
                            <label asp-for="WorkModeOptionId" asp-postfix=":"></label>
                        </div>
                        <div class="vendor-job-form-control">
                            <select asp-for="WorkModeOptionId" asp-items="Model.AvailableWorkModes"></select>
                            <span asp-validation-for="WorkModeOptionId"></span>
                        </div>
                    </div>
                }

                @if (Model.AvailableEmploymentTypes.Any())
                {
                    <div class="vendor-job-form-row vendor-job-form-row-top">
                        <div class="vendor-job-form-label">
                            <label asp-for="EmploymentTypeOptionId" asp-postfix=":"></label>
                        </div>
                        <div class="vendor-job-form-control">
                            <select asp-for="EmploymentTypeOptionId" asp-items="Model.AvailableEmploymentTypes"></select>
                            <span asp-validation-for="EmploymentTypeOptionId"></span>
                        </div>
                    </div>
                }

                <div class="vendor-job-form-row vendor-job-form-row-top">
                    <div class="vendor-job-form-label">
                        <label asp-for="JobLocation" asp-postfix=":"></label>
                    </div>
                    <div class="vendor-job-form-control">
                        <input asp-for="JobLocation" />
                        <span asp-validation-for="JobLocation"></span>
                    </div>
                </div>

                <div class="vendor-job-form-row vendor-job-form-row-top">
                    <div class="vendor-job-form-label">
                        <label asp-for="SalaryRange" asp-postfix=":"></label>
                    </div>
                    <div class="vendor-job-form-control">
                        <input asp-for="SalaryRange" />
                        <span asp-validation-for="SalaryRange"></span>
                    </div>
                </div>

                <div class="vendor-job-form-row">
                    <div class="vendor-job-form-label">
                        <label asp-for="ShortDescription" asp-postfix=":"></label>
                    </div>
                    <div class="vendor-job-form-control">
                        <textarea asp-for="ShortDescription"></textarea>
                        <span asp-validation-for="ShortDescription"></span>
                    </div>
                </div>

                <div class="vendor-job-form-row">
                    <div class="vendor-job-form-label">
                        <label asp-for="FullDescription" asp-postfix=":"></label>
                    </div>
                    <div class="vendor-job-form-control">
                        <textarea asp-for="FullDescription" rows="8"></textarea>
                        <span asp-validation-for="FullDescription"></span>
                    </div>
                </div>

                <div class="vendor-job-form-row">
                    <div class="vendor-job-form-label">
                        @T("Plugins.Misc.AIInterview.VendorJobCreation.Settings")
                    </div>
                    <div class="vendor-job-form-control">
                        <div class="vendor-job-form-checkbox-list">
                            <div class="vendor-job-form-checkbox">
                                <input asp-for="Published" />
                                <label asp-for="Published"></label>
                            </div>
                            <div class="vendor-job-form-checkbox">
                                <input type="hidden" name="ResumeRequired" value="false" />
                                <input asp-for="ResumeRequired" />
                                <label asp-for="ResumeRequired"></label>
                            </div>
                            <div class="vendor-job-form-checkbox">
                                <input type="hidden" name="InterviewRequired" value="false" />
                                <input asp-for="InterviewRequired" />
                                <label asp-for="InterviewRequired"></label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="vendor-job-form-row aiinterview-minimum-score-row" @(Model.InterviewRequired ? string.Empty : "style=\"display:none;\"")>
                    <div class="vendor-job-form-label">
                        <label asp-for="MinimumScore" asp-postfix=":"></label>
                    </div>
                    <div class="vendor-job-form-control">
                        <input asp-for="MinimumScore" type="number" min="0" step="0.01" @(Model.InterviewRequired ? null : "disabled") />
                        <input type="hidden"
                               id="MinimumScoreHidden"
                               name="MinimumScore"
                               value="@Model.MinimumScore.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                               @(Model.InterviewRequired ? "disabled" : null) />
                        <small class="vendor-job-form-hint">@T("Plugins.Misc.AIInterview.VendorJobCreation.MinimumScore.Hint")</small>
                        <span asp-validation-for="MinimumScore"></span>
                    </div>
                </div>

                <div class="vendor-job-form-row aiinterview-question-count-row" @(Model.InterviewRequired ? string.Empty : "style=\"display:none;\"")>
                    <div class="vendor-job-form-label">
                        <label asp-for="QuestionCount" asp-postfix=":"></label>
                    </div>
                    <div class="vendor-job-form-control">
                        <input asp-for="QuestionCount" type="number" min="1" max="10" step="1" @(Model.InterviewRequired ? null : "disabled") />
                        <input type="hidden"
                               id="QuestionCountHidden"
                               name="QuestionCount"
                               value="@Model.QuestionCount"
                               @(Model.InterviewRequired ? "disabled" : null) />
                        <small class="vendor-job-form-hint">@T("Plugins.Misc.AIInterview.VendorJobCreation.QuestionCount.Hint")</small>
                        <span asp-validation-for="QuestionCount"></span>
                    </div>
                </div>
            </div>

            <div class="vendor-job-form-actions">
                <button type="submit" class="button-1 vendor-job-submit">@T("Plugins.Misc.AIInterview.VendorJobCreation.Submit")</button>
            </div>
        </form>
    </div>
</div>

<script asp-location="Footer">
    (() => {
        const interviewRequired = document.getElementById('InterviewRequired');
        const minimumScoreRow = document.querySelector('.aiinterview-minimum-score-row');
        const questionCountRow = document.querySelector('.aiinterview-question-count-row');
        const minimumScoreInput = document.getElementById('MinimumScore');
        const questionCountInput = document.getElementById('QuestionCount');
        const minimumScoreHidden = document.getElementById('MinimumScoreHidden');
        const questionCountHidden = document.getElementById('QuestionCountHidden');

        if (!interviewRequired || !minimumScoreRow || !questionCountRow || !minimumScoreInput || !questionCountInput || !minimumScoreHidden || !questionCountHidden)
            return;

        const syncHiddenValues = () => {
            minimumScoreHidden.value = minimumScoreInput.value;
            questionCountHidden.value = questionCountInput.value;
        };

        const updateVisibility = () => {
            const enabled = interviewRequired.checked;

            minimumScoreRow.style.display = enabled ? '' : 'none';
            questionCountRow.style.display = enabled ? '' : 'none';

            minimumScoreInput.disabled = !enabled;
            questionCountInput.disabled = !enabled;
            minimumScoreHidden.disabled = enabled;
            questionCountHidden.disabled = enabled;

            syncHiddenValues();
        };

        minimumScoreInput.addEventListener('input', syncHiddenValues);
        questionCountInput.addEventListener('input', syncHiddenValues);
        interviewRequired.addEventListener('change', updateVisibility);
        updateVisibility();
    })();
</script>
