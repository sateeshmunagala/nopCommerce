@using Nop.Web.Models.Customer
@model VendorJobModel
@{
    Layout = "_ColumnsTwo";
    NopHtml.AddTitleParts(T("Plugins.Misc.AIInterview.VendorJobCreation.Title").Text);
    NopHtml.AppendCssFileParts("~/Plugins/Misc.AIInterview/Content/css/aiinterview-public.css");
    NopHtml.AppendPageCssClassParts("html-account-page");
    NopHtml.AppendPageCssClassParts("html-aiinterview-view-page");
    NopHtml.AppendPageCssClassParts("html-aiinterview-vendor-job-creation-page");
}

@section left
{
    @await Component.InvokeAsync("CustomerNavigation", new { selectedTabId = AIInterviewDefaults.VendorJobCreationNavigationTab })
}

<div class="page vendor-job-creation-page">
    <div class="page-title">
        <h1>@T("Plugins.Misc.AIInterview.VendorJobCreation.Title")</h1>
    </div>
    <div class="page-body">
        <div class="section">
            <div class="title">
                <strong>@T("Plugins.Misc.AIInterview.VendorJobCreation.Title")</strong>
            </div>
            <form asp-route="@AIInterviewDefaults.VendorJobCreationRouteName" method="post" class="vendor-job-form-shell">
                <div class="fieldset">
                    <div class="vendor-job-fieldset">
                    <div asp-validation-summary="ModelOnly" class="message-error"></div>
                    <div class="vendor-job-form-grid">
                <div class="vendor-job-form-section">
                    <div class="vendor-job-form-section-title">@T("Plugins.Misc.AIInterview.VendorJobCreation.Section.RoleOverview")</div>
                <div class="vendor-job-form-row">
                    <div class="vendor-job-form-label">
                        <label asp-for="Name" asp-postfix=":"></label>
                        <nop-required />
                    </div>
                    <div class="vendor-job-form-control">
                        <input asp-for="Name" />
                        <span asp-validation-for="Name"></span>
                    </div>
                </div>
                <input asp-for="Sku" type="hidden" />

                <div class="vendor-job-form-row vendor-job-form-row-top">
                    <div class="vendor-job-form-label">
                        <label asp-for="ApplyUntilUtc" asp-postfix=":"></label>
                    </div>
                    <div class="vendor-job-form-control">
                        <input asp-for="ApplyUntilUtc" type="date" />
                        <span asp-validation-for="ApplyUntilUtc"></span>
                    </div>
                </div>

                @if (Model.AvailableExperienceLevels.Any())
                {
                    <div class="vendor-job-form-row vendor-job-form-row-top">
                        <div class="vendor-job-form-label">
                            <label asp-for="ExperienceLevelOptionId" asp-postfix=":"></label>
                        </div>
                        <div class="vendor-job-form-control">
                            <select asp-for="ExperienceLevelOptionId" asp-items="Model.AvailableExperienceLevels"></select>
                            <span asp-validation-for="ExperienceLevelOptionId"></span>
                        </div>
                    </div>
                }

                @if (Model.AvailableWorkModes.Any())
                {
                    <div class="vendor-job-form-row vendor-job-form-row-top">
                        <div class="vendor-job-form-label">
                            <label asp-for="WorkModeOptionId" asp-postfix=":"></label>
                        </div>
                        <div class="vendor-job-form-control">
                            <select asp-for="WorkModeOptionId" asp-items="Model.AvailableWorkModes"></select>
                            <span asp-validation-for="WorkModeOptionId"></span>
                        </div>
                    </div>
                }

                @if (Model.AvailableEmploymentTypes.Any())
                {
                    <div class="vendor-job-form-row vendor-job-form-row-top">
                        <div class="vendor-job-form-label">
                            <label asp-for="EmploymentTypeOptionId" asp-postfix=":"></label>
                        </div>
                        <div class="vendor-job-form-control">
                            <select asp-for="EmploymentTypeOptionId" asp-items="Model.AvailableEmploymentTypes"></select>
                            <span asp-validation-for="EmploymentTypeOptionId"></span>
                        </div>
                    </div>
                }

                <div class="vendor-job-form-row vendor-job-form-row-top">
                    <div class="vendor-job-form-label">
                        <label asp-for="JobLocationOptionId" asp-postfix=":"></label>
                    </div>
                    <div class="vendor-job-form-control">
                        @if (Model.AvailableJobLocations.Any())
                        {
                            <select asp-for="JobLocationOptionId" asp-items="Model.AvailableJobLocations"></select>
                        }
                        else
                        {
                            <div class="vendor-job-form-unsupported">@T("Plugins.Misc.AIInterview.VendorJobCreation.JobLocation.Unsupported")</div>
                        }
                        <span asp-validation-for="JobLocationOptionId"></span>
                    </div>
                </div>

                <div class="vendor-job-form-row vendor-job-form-row-top">
                    <div class="vendor-job-form-label">
                        <label asp-for="SalaryRange" asp-postfix=":"></label>
                    </div>
                    <div class="vendor-job-form-control">
                        <input asp-for="SalaryRange" />
                        <span asp-validation-for="SalaryRange"></span>
                    </div>
                </div>
                </div>

                <div class="vendor-job-form-section">
                    <div class="vendor-job-form-section-title">@T("Plugins.Misc.AIInterview.VendorJobCreation.Section.JobContent")</div>
                <div class="vendor-job-form-row">
                    <div class="vendor-job-form-label">
                        <label asp-for="ShortDescription" asp-postfix=":"></label>
                    </div>
                    <div class="vendor-job-form-control">
                        <textarea asp-for="ShortDescription" rows="2"></textarea>
                        <span asp-validation-for="ShortDescription"></span>
                    </div>
                </div>

                <div class="vendor-job-form-row">
                    <div class="vendor-job-form-label">
                        <label asp-for="FullDescription" asp-postfix=":"></label>
                    </div>
                    <div class="vendor-job-form-control">
                        <textarea asp-for="FullDescription" rows="8"></textarea>
                        <span asp-validation-for="FullDescription"></span>
                    </div>
                </div>
                </div>

                <div class="vendor-job-form-section">
                    <div class="vendor-job-form-section-title">@T("Plugins.Misc.AIInterview.VendorJobCreation.Section.InterviewSettings")</div>
                <div class="vendor-job-form-row">
                    <div class="vendor-job-form-label">
                        @T("Plugins.Misc.AIInterview.VendorJobCreation.Settings")
                    </div>
                    <div class="vendor-job-form-control">
                        <div class="vendor-job-form-checkbox-list">
                            <div class="vendor-job-form-checkbox">
                                <input asp-for="Published" />
                                <label asp-for="Published"></label>
                            </div>
                            <div class="vendor-job-form-checkbox">
                                <input type="hidden" name="ResumeRequired" value="false" />
                                <input asp-for="ResumeRequired" />
                                <label asp-for="ResumeRequired"></label>
                            </div>
                            <div class="vendor-job-form-checkbox">
                                <input type="hidden" name="InterviewRequired" value="false" />
                                <input asp-for="InterviewRequired" />
                                <label asp-for="InterviewRequired"></label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="vendor-job-form-row vendor-job-form-actions">
                    <div class="vendor-job-form-label"></div>
                    <div class="vendor-job-form-control">
                        <button type="submit" class="button-1 vendor-job-submit">@T("Plugins.Misc.AIInterview.VendorJobCreation.Submit")</button>
                    </div>
                </div>
                </div>
                    </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
