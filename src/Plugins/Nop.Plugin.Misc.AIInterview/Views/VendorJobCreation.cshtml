@using Nop.Web.Models.Customer
@model VendorJobModel
@{
    Layout = "_ColumnsTwo";
    NopHtml.AddTitleParts(T("Plugins.Misc.AIInterview.VendorJobCreation.Title").Text);
}

@section left
{
    @await Component.InvokeAsync("CustomerNavigation", new { selectedTabId = AIInterviewDefaults.VendorJobCreationNavigationTab })
}

<style>
    .vendor-job-creation-page .page-body {
        display: grid;
        gap: 24px;
    }

    .vendor-job-form {
        padding: 28px;
        border: 1px solid #dbe3ef;
        border-radius: 24px;
        background: #fff;
        box-shadow: 0 16px 40px rgba(15, 35, 64, 0.08);
    }

    .vendor-job-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px 20px;
    }

    .vendor-job-form .inputs {
        margin: 0;
    }

    .vendor-job-form .inputs.wide {
        grid-column: 1 / -1;
    }

    .vendor-job-form label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
    }

    .vendor-job-form input[type="text"],
    .vendor-job-form input[type="date"],
    .vendor-job-form textarea,
    .vendor-job-form select {
        width: 100%;
        min-height: 46px;
        padding: 10px 12px;
        border: 1px solid #cfd9e7;
        border-radius: 12px;
        background: #fff;
    }

    .vendor-job-form textarea {
        min-height: 120px;
        resize: vertical;
    }

    .vendor-job-form .checkbox-row {
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 46px;
        padding-top: 28px;
    }

    .vendor-job-form .buttons {
        margin-top: 24px;
    }

    @@media (max-width: 820px) {
        .vendor-job-form-grid {
            grid-template-columns: 1fr;
        }

        .vendor-job-form .inputs.wide {
            grid-column: auto;
        }
    }
</style>

<div class="page vendor-job-creation-page">
    <div class="page-title">
        <h1>@T("Plugins.Misc.AIInterview.VendorJobCreation.Title")</h1>
    </div>
    <div class="page-body">
        <form asp-route="@AIInterviewDefaults.VendorJobCreationRouteName" method="post" class="vendor-job-form">
            <div asp-validation-summary="ModelOnly" class="message-error"></div>

            <div class="vendor-job-form-grid">
                <div class="inputs wide">
                    <label asp-for="Name" asp-postfix=":"></label>
                    <input asp-for="Name" />
                    <nop-required />
                    <span asp-validation-for="Name"></span>
                </div>

                <div class="inputs">
                    <label asp-for="Sku" asp-postfix=":"></label>
                    <input asp-for="Sku" />
                </div>

                <div class="inputs">
                    <label for="ApplyUntilUtc">Apply Until:</label>
                    <input asp-for="ApplyUntilUtc" type="date" />
                </div>

                @if (Model.AvailableExperienceLevels.Any())
                {
                    <div class="inputs">
                        <label for="ExperienceLevelOptionId">Experience Level:</label>
                        <select asp-for="ExperienceLevelOptionId" asp-items="Model.AvailableExperienceLevels"></select>
                    </div>
                }

                @if (Model.AvailableWorkModes.Any())
                {
                    <div class="inputs">
                        <label for="WorkModeOptionId">Work Mode:</label>
                        <select asp-for="WorkModeOptionId" asp-items="Model.AvailableWorkModes"></select>
                    </div>
                }

                @if (Model.AvailableEmploymentTypes.Any())
                {
                    <div class="inputs">
                        <label for="EmploymentTypeOptionId">Employment Type:</label>
                        <select asp-for="EmploymentTypeOptionId" asp-items="Model.AvailableEmploymentTypes"></select>
                    </div>
                }

                <div class="inputs">
                    <label for="JobLocation">Job Location:</label>
                    <input asp-for="JobLocation" />
                </div>

                <div class="inputs">
                    <label for="SalaryRange">Salary Range:</label>
                    <input asp-for="SalaryRange" />
                </div>

                <div class="inputs wide">
                    <label asp-for="ShortDescription" asp-postfix=":"></label>
                    <textarea asp-for="ShortDescription"></textarea>
                </div>

                <div class="inputs wide">
                    <label asp-for="FullDescription" asp-postfix=":"></label>
                    <textarea asp-for="FullDescription" rows="8"></textarea>
                </div>

                <div class="inputs">
                    <div class="checkbox-row">
                        <input asp-for="Published" />
                        <label asp-for="Published"></label>
                    </div>
                </div>

                <div class="inputs">
                    <div class="checkbox-row">
                        <input type="hidden" name="ResumeRequired" value="false" />
                        <input asp-for="ResumeRequired" />
                        <label asp-for="ResumeRequired"></label>
                    </div>
                </div>

                <div class="inputs">
                    <div class="checkbox-row">
                        <input type="hidden" name="InterviewRequired" value="false" />
                        <input asp-for="InterviewRequired" />
                        <label asp-for="InterviewRequired"></label>
                    </div>
                </div>

                <div class="inputs">
                    <label asp-for="MinimumScore" asp-postfix=":"></label>
                    <input asp-for="MinimumScore" type="number" min="0" step="0.01" />
                    <small class="form-text text-muted">@T("Plugins.Misc.AIInterview.VendorJobCreation.MinimumScore.Hint")</small>
                </div>
            </div>

            <div class="buttons">
                <button type="submit" class="button-1">@T("Plugins.Misc.AIInterview.VendorJobCreation.Submit")</button>
            </div>
        </form>
    </div>
</div>
