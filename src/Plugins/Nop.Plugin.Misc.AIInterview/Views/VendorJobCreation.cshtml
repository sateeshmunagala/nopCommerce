@using Nop.Web.Models.Customer
@model VendorJobModel
@{
    Layout = "_ColumnsTwo";
    var pageTitle = Model.IsEditMode
        ? T("Plugins.Misc.AIInterview.VendorJobCreation.EditTitle").Text
        : T("Plugins.Misc.AIInterview.VendorJobCreation.Title").Text;
    var submitText = Model.IsEditMode
        ? T("Plugins.Misc.AIInterview.VendorJobCreation.SubmitEdit").Text
        : T("Plugins.Misc.AIInterview.VendorJobCreation.Submit").Text;
    var backToJobsUrl = Url.RouteUrl(AIInterviewDefaults.EmployerDashboardRouteName, new { tab = AIInterviewDefaults.EmployerDashboardJobsTabKey });
    NopHtml.AddTitleParts(pageTitle);
    NopHtml.AppendCssFileParts("~/Plugins/Misc.AIInterview/Content/css/aiinterview-public.css");
    NopHtml.AppendPageCssClassParts("html-account-page");
    NopHtml.AppendPageCssClassParts("html-aiinterview-view-page");
    NopHtml.AppendPageCssClassParts("html-aiinterview-vendor-job-creation-page");

    IEnumerable<IGrouping<string, Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>> BuildSalaryGroups()
    {
        static decimal ParseLpaText(string text)
        {
            var normalized = (text ?? string.Empty).Replace("LPA", string.Empty, StringComparison.OrdinalIgnoreCase).Trim();
            return decimal.TryParse(normalized, out var value) ? value : -1m;
        }

        static string ResolveGroupLabel(decimal lpa)
        {
            if (lpa < 0m)
                return "Select";
            if (lpa <= 10m)
                return "0-10 LPA";
            if (lpa <= 25m)
                return "10.5-25 LPA";
            if (lpa <= 50m)
                return "25.5-50 LPA";
            if (lpa <= 75m)
                return "50.5-75 LPA";

            return "75.5-100 LPA";
        }

        return Model.AvailableSalaryLpaOptions.GroupBy(option => ResolveGroupLabel(ParseLpaText(option.Text)));
    }

    var salaryGroups = BuildSalaryGroups().ToList();
}

@section left
{
    @await Component.InvokeAsync("CustomerNavigation", new { selectedTabId = AIInterviewDefaults.EmployerDashboardNavigationTab })
}

<div class="page vendor-job-creation-page">
    <div class="page-title">
        <div class="vendor-job-page-header">
            <div class="vendor-job-page-heading">
                <h1>@pageTitle</h1>
            </div>
            <div class="vendor-job-page-tools">
                <a class="button-2 vendor-job-page-link" href="@backToJobsUrl" title="@T("Plugins.Misc.AIInterview.VendorJobCreation.BackToJobs")">@T("Plugins.Misc.AIInterview.VendorJobCreation.BackToJobs")</a>
                @if (Model.IsEditMode && !string.IsNullOrWhiteSpace(Model.PublicJobUrl))
                {
                    <a class="button-2 vendor-job-page-link" href="@Model.PublicJobUrl" title="@T("Plugins.Misc.AIInterview.VendorJobCreation.ViewJob")">@T("Plugins.Misc.AIInterview.VendorJobCreation.ViewJob")</a>
                }
            </div>
        </div>
    </div>
    <div class="page-body">
        <div class="section vendor-job-page-section">
            <form asp-action="@(Model.IsEditMode ? "VendorJobEdit" : "VendorJobCreation")"
                  asp-route-productId="@(Model.IsEditMode ? Model.Id : (int?)null)"
                  method="post"
                  class="vendor-job-form-shell">
                <input asp-for="Id" type="hidden" />
                <input asp-for="IsEditMode" type="hidden" />
                <input asp-for="Sku" type="hidden" />
                <div class="fieldset">
                    <div class="vendor-job-posting-shell">
                        <div asp-validation-summary="ModelOnly" class="message-error"></div>

                        <section class="vendor-job-form-section">
                            <h3 class="vendor-job-form-section-title">@T("Plugins.Misc.AIInterview.VendorJobCreation.Section.RoleOverview")</h3>
                            <div class="vendor-job-form-simple-grid">
                                <div class="vendor-job-form-field vendor-job-form-field-wide">
                                    <label asp-for="Name" asp-postfix=":"></label>
                                    <nop-required />
                                    <input asp-for="Name" />
                                    <span asp-validation-for="Name"></span>
                                </div>
                            </div>
                        </section>

                        <section class="vendor-job-form-section">
                            <h3 class="vendor-job-form-section-title">@T("Plugins.Misc.AIInterview.VendorJobCreation.Section.Requirements")</h3>
                            <div class="vendor-job-form-simple-grid">
                                <div class="vendor-job-form-field vendor-job-form-field-salary">
                                    <label asp-for="SalaryMinCtcPa" asp-postfix=":"></label>
                                    <select asp-for="SalaryMinCtcPa">
                                        @foreach (var group in salaryGroups)
                                        {
                                            if (string.Equals(group.Key, "Select", StringComparison.Ordinal))
                                            {
                                                foreach (var option in group)
                                                {
                                                    <option value="@option.Value" selected="@option.Selected">@option.Text</option>
                                                }
                                            }
                                            else
                                            {
                                                <optgroup label="@group.Key">
                                                    @foreach (var option in group)
                                                    {
                                                        <option value="@option.Value" selected="@option.Selected">@option.Text</option>
                                                    }
                                                </optgroup>
                                            }
                                        }
                                    </select>
                                    <span class="vendor-job-form-hint">0.5 LPA increments, grouped for faster scanning.</span>
                                    <span asp-validation-for="SalaryMinCtcPa"></span>
                                </div>
                                <div class="vendor-job-form-field vendor-job-form-field-salary">
                                    <label asp-for="SalaryMaxCtcPa" asp-postfix=":"></label>
                                    <select asp-for="SalaryMaxCtcPa">
                                        @foreach (var group in salaryGroups)
                                        {
                                            if (string.Equals(group.Key, "Select", StringComparison.Ordinal))
                                            {
                                                foreach (var option in group)
                                                {
                                                    <option value="@option.Value" selected="@option.Selected">@option.Text</option>
                                                }
                                            }
                                            else
                                            {
                                                <optgroup label="@group.Key">
                                                    @foreach (var option in group)
                                                    {
                                                        <option value="@option.Value" selected="@option.Selected">@option.Text</option>
                                                    }
                                                </optgroup>
                                            }
                                        }
                                    </select>
                                    <span class="vendor-job-form-hint">Use the closest band, then fine-tune within the range.</span>
                                    <span asp-validation-for="SalaryMaxCtcPa"></span>
                                </div>
                                @if (Model.AvailableExperienceLevels.Any())
                                {
                                    <div class="vendor-job-form-field">
                                        <label asp-for="ExperienceLevelOptionId" asp-postfix=":"></label>
                                        <select asp-for="ExperienceLevelOptionId" asp-items="Model.AvailableExperienceLevels"></select>
                                        <span asp-validation-for="ExperienceLevelOptionId"></span>
                                    </div>
                                }

                                @if (Model.AvailableWorkModes.Any())
                                {
                                    <div class="vendor-job-form-field">
                                        <label asp-for="WorkModeOptionId" asp-postfix=":"></label>
                                        <select asp-for="WorkModeOptionId" asp-items="Model.AvailableWorkModes"></select>
                                        <span asp-validation-for="WorkModeOptionId"></span>
                                    </div>
                                }

                                @if (Model.AvailableEmploymentTypes.Any())
                                {
                                    <div class="vendor-job-form-field">
                                        <label asp-for="EmploymentTypeOptionId" asp-postfix=":"></label>
                                        <select asp-for="EmploymentTypeOptionId" asp-items="Model.AvailableEmploymentTypes"></select>
                                        <span asp-validation-for="EmploymentTypeOptionId"></span>
                                    </div>
                                }

                                <div class="vendor-job-form-field">
                                    <label asp-for="JobLocationOptionId" asp-postfix=":"></label>
                                    @if (Model.AvailableJobLocations.Any())
                                    {
                                        <select asp-for="JobLocationOptionId" asp-items="Model.AvailableJobLocations"></select>
                                    }
                                    else
                                    {
                                        <div class="vendor-job-form-unsupported">@T("Plugins.Misc.AIInterview.VendorJobCreation.JobLocation.Unsupported")</div>
                                    }
                                    <span asp-validation-for="JobLocationOptionId"></span>
                                </div>
                            </div>
                        </section>

                        <section class="vendor-job-form-section">
                            <h3 class="vendor-job-form-section-title">@T("Plugins.Misc.AIInterview.VendorJobCreation.Section.JobContent")</h3>
                            <div class="vendor-job-form-simple-grid">
                                <div class="vendor-job-form-field vendor-job-form-field-wide">
                                    <label asp-for="ShortDescription" asp-postfix=":"></label>
                                    <textarea asp-for="ShortDescription" rows="2"></textarea>
                                    <span asp-validation-for="ShortDescription"></span>
                                </div>

                                <div class="vendor-job-form-field vendor-job-form-field-wide">
                                    <label asp-for="FullDescription" asp-postfix=":"></label>
                                    <textarea asp-for="FullDescription" rows="8"></textarea>
                                    <span asp-validation-for="FullDescription"></span>
                                </div>
                            </div>
                        </section>

                        <section class="vendor-job-form-section">
                            <h3 class="vendor-job-form-section-title">@T("Plugins.Misc.AIInterview.VendorJobCreation.Section.InterviewSettings")</h3>
                            <div class="vendor-job-form-simple-grid vendor-job-form-interview-grid">
                                <div class="vendor-job-form-field">
                                    <label class="vendor-job-form-toggle" for="@Html.IdFor(model => model.ResumeRequired)">
                                        <input type="hidden" name="@Html.NameFor(model => model.ResumeRequired)" value="false" />
                                        <input type="checkbox"
                                               id="@Html.IdFor(model => model.ResumeRequired)"
                                               name="@Html.NameFor(model => model.ResumeRequired)"
                                               value="true"
                                               checked="@(Model.ResumeRequired ? "checked" : null)" />
                                        <span>@T("Plugins.Misc.AIInterview.VendorJobCreation.ResumeRequired")</span>
                                    </label>
                                </div>
                                <div class="vendor-job-form-field">
                                    <label class="vendor-job-form-toggle" for="@Html.IdFor(model => model.InterviewRequired)">
                                        <input type="hidden" name="@Html.NameFor(model => model.InterviewRequired)" value="false" />
                                        <input type="checkbox"
                                               id="@Html.IdFor(model => model.InterviewRequired)"
                                               name="@Html.NameFor(model => model.InterviewRequired)"
                                               value="true"
                                               checked="@(Model.InterviewRequired ? "checked" : null)" />
                                        <span>@T("Plugins.Misc.AIInterview.VendorJobCreation.InterviewRequired")</span>
                                    </label>
                                </div>
                                <div class="vendor-job-form-field">
                                    <label asp-for="ApplyUntilUtc" asp-postfix=":"></label>
                                    <input asp-for="ApplyUntilUtc" type="date" />
                                    <span asp-validation-for="ApplyUntilUtc"></span>
                                </div>
                                <div class="vendor-job-form-field">
                                    <label class="vendor-job-form-field-label">@T("Plugins.Misc.AIInterview.VendorJobCreation.Published")</label>
                                    <label class="vendor-job-form-toggle" for="@Html.IdFor(model => model.Published)">
                                        <input type="hidden" name="@Html.NameFor(model => model.Published)" value="false" />
                                        <input type="checkbox"
                                               id="@Html.IdFor(model => model.Published)"
                                               name="@Html.NameFor(model => model.Published)"
                                               value="true"
                                               checked="@(Model.Published ? "checked" : null)" />
                                        <span>@T("Plugins.Misc.AIInterview.VendorJobCreation.Published")</span>
                                    </label>
                                </div>
                            </div>
                        </section>

                        <div class="vendor-job-form-actions">
                            <button type="submit" class="button-1 vendor-job-submit" title="@submitText">@submitText</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
