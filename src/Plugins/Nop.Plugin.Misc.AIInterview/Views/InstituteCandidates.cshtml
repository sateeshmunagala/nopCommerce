@using Nop.Plugin.Misc.AIInterview.Models
@model InstituteCandidatesPageModel
@{
    Layout = "_ColumnsTwo";
    NopHtml.AddTitleParts("Candidates");
    NopHtml.AppendCssFileParts("~/Plugins/Misc.AIInterview/Content/css/aiinterview-public.css");
    NopHtml.AppendPageCssClassParts("html-account-page");
    NopHtml.AppendPageCssClassParts("html-aiinterview-view-page");
    NopHtml.AppendPageCssClassParts("html-aiinterview-institute-candidates-page");
    var joinUrl = ViewData["InstituteJoinUrl"] as string ?? string.Empty;
}

@section left
{
    @await Component.InvokeAsync("CustomerNavigation",
        new { selectedTabId = AIInterviewDefaults.InstituteDashboardNavigationTab })
}

<div class="page ai-institute-candidates-page">
    <div class="page-title"><h1>Candidates</h1></div>
    <div class="page-body">

        @if (!string.IsNullOrWhiteSpace(joinUrl))
        {
            <div class="institute-join-url-panel">
                <label class="institute-join-url-label">Student Registration Link</label>
                <div class="institute-join-url-row">
                    <input type="text" readonly value="@joinUrl"
                           class="institute-join-url-input"
                           id="institute-join-url-candidates" />
                    <button type="button"
                            class="button-2 institute-join-url-copy"
                            onclick="navigator.clipboard.writeText(document.getElementById('institute-join-url-candidates').value).then(function(){this.textContent='Copied!';setTimeout(function(){document.querySelector('.institute-join-url-copy').textContent='Copy Link';},2000);}.bind(this))">
                        Copy Link
                    </button>
                </div>
                <p class="institute-join-url-hint">
                    Share this link with your students. Registered students appear below automatically.
                </p>
            </div>
        }

        @if (!Model.Candidates.Any())
        {
            <p class="institute-candidates-empty">
                No students yet. Share your registration link above to onboard students.
            </p>
        }
        else
        {
            <div class="institute-candidates-table-wrapper">
                <table class="institute-candidates-table">
                    <thead>
                        <tr>
                            <th>Email / Name</th>
                            <th>Status</th>
                            <th>Credits</th>
                            <th>Joined On</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Candidates)
                        {
                            <tr class="institute-candidate-row">
                                <td data-label="Email / Name">
                                    <span class="candidate-email">@c.Email</span>
                                    @if (!string.IsNullOrWhiteSpace(c.CustomerName))
                                    {
                                        <span class="candidate-name">@c.CustomerName</span>
                                    }
                                </td>
                                <td data-label="Status">
                                    <span class="candidate-status-badge badge-accepted">Active</span>
                                </td>
                                <td data-label="Credits">@c.CreditBalance.ToString("0.##")</td>
                                <td data-label="Joined On">@c.CreatedOnUtc.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
