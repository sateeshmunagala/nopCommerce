@using Nop.Plugin.Misc.AIInterview.Models
@model InstituteCandidatesPageModel
@{
    Layout = "_ColumnsTwo";
    NopHtml.AddTitleParts("Candidates");
    NopHtml.AppendCssFileParts("~/Plugins/Misc.AIInterview/Content/css/aiinterview-public.css");
    NopHtml.AppendPageCssClassParts("html-account-page");
    NopHtml.AppendPageCssClassParts("html-aiinterview-view-page");
    NopHtml.AppendPageCssClassParts("html-aiinterview-institute-candidates-page");
}

@section left
{
    @await Component.InvokeAsync("CustomerNavigation",
        new { selectedTabId = AIInterviewDefaults.InstituteDashboardNavigationTab })
}

<div class="page ai-institute-candidates-page">
    <div class="page-title"><h1>Candidates</h1></div>
    <div class="page-body">
        <div class="institute-invite-form-panel">
            <h2 class="institute-invite-form-heading">Invite a Student</h2>
            <form asp-route="@AIInterviewDefaults.InstituteCandidateInviteRouteName"
                  method="post"
                  class="institute-invite-form">
                <div class="institute-invite-row">
                    <input type="email"
                           name="email"
                           placeholder="student@example.com"
                           class="institute-invite-email-input"
                           required />
                    <button type="submit" class="button-1 institute-invite-submit">
                        Invite
                    </button>
                </div>
            </form>
        </div>

        @if (!Model.Candidates.Any())
        {
            <p class="institute-candidates-empty">
                No candidates yet. Invite your first student using the form above.
            </p>
        }
        else
        {
            <div class="institute-candidates-table-wrapper">
                <table class="institute-candidates-table">
                    <thead>
                        <tr>
                            <th>Email / Name</th>
                            <th>Status</th>
                            <th>Credits</th>
                            <th>Invited On</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Candidates)
                        {
                            <tr class="institute-candidate-row @(c.IsAccepted ? "is-accepted" : "is-pending")">
                                <td data-label="Email / Name">
                                    <span class="candidate-email">@c.Email</span>
                                    @if (!string.IsNullOrWhiteSpace(c.CustomerName))
                                    {
                                        <span class="candidate-name">@c.CustomerName</span>
                                    }
                                </td>
                                <td data-label="Status">
                                    <span class="candidate-status-badge @(c.IsAccepted ? "badge-accepted" : "badge-pending")">
                                        @(c.IsAccepted ? "Accepted" : "Pending")
                                    </span>
                                </td>
                                <td data-label="Credits">@c.CreditBalance.ToString("0.##")</td>
                                <td data-label="Invited On">@c.CreatedOnUtc.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
