@model Nop.Plugin.Misc.AIInterview.Models.ConfigurationModel

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = "AI Interview Configuration";
}

<form asp-controller="AIInterviewAdmin" asp-action="Configure" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            AI Interview Configuration
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.Save")
            </button>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="form-horizontal">
                <div class="cards-group">
                    <div class="card card-default">
                        <div class="card-header">
                            General Settings
                        </div>
                        <div class="card-body">
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="Enabled" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="Enabled" />
                                    <span asp-validation-for="Enabled"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="ResumeRequired" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="ResumeRequired" />
                                    <span asp-validation-for="ResumeRequired"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="InterviewRequired" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="InterviewRequired" />
                                    <span asp-validation-for="InterviewRequired"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="MinimumScore" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="MinimumScore" />
                                    <span asp-validation-for="MinimumScore"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card card-default">
                        <div class="card-header">
                            AI Service Settings
                        </div>
                        <div class="card-body">
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="UseMockResponses" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="UseMockResponses" />
                                    <span asp-validation-for="UseMockResponses"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="Provider" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="Provider" />
                                    <span asp-validation-for="Provider"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="ApiKey" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="ApiKey" />
                                    <span asp-validation-for="ApiKey"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="Model" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="Model" />
                                    <span asp-validation-for="Model"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="Prompt" />
                                </div>
                                <div class="col-md-9">
                                    <nop-textarea asp-for="Prompt" />
                                    <span asp-validation-for="Prompt"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="ServiceSettings" />
                                </div>
                                <div class="col-md-9">
                                    <nop-textarea asp-for="ServiceSettings" />
                                    <span asp-validation-for="ServiceSettings"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card card-default">
                        <div class="card-header">
                            Credit Pack Settings
                        </div>
                        <div class="card-body">
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="CreditPackAmount" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="CreditPackAmount" />
                                    <span asp-validation-for="CreditPackAmount"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="CreditPackPrice" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="CreditPackPrice" />
                                    <span asp-validation-for="CreditPackPrice"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
