@model Nop.Plugin.Misc.AIInterview.Models.AiServiceSettingsModel
@using Nop.Plugin.Misc.AIInterview

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = T("Plugins.Misc.AIInterview.Admin.AiService.Title").Text;
    NopHtml.SetActiveMenuItemSystemName(AIInterviewDefaults.AdminAiServiceMenuSystemName);
}

<form asp-route="@AIInterviewDefaults.AdminAiServiceRouteName" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">@T("Plugins.Misc.AIInterview.Admin.AiService.Title")</h1>
        <div class="float-right">
            <button type="submit" class="btn btn-primary">
                <i class="far fa-save"></i> @T("Admin.Common.Save")
            </button>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            @await Component.InvokeAsync(typeof(StoreScopeConfigurationViewComponent))
            <div class="card card-default">
                <div class="card-body">
                    <h4>General / Model</h4>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-override-store-checkbox asp-for="UseMockResponses_OverrideForStore" asp-input="UseMockResponses" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                            <nop-label asp-for="UseMockResponses" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="UseMockResponses" />
                            <small class="form-text text-warning font-weight-bold" id="mock-responses-hint" style="display: none;">Development AI mode is enabled. Azure OpenAI is bypassed.</small>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-override-store-checkbox asp-for="MockInterviewQuestionCount_OverrideForStore" asp-input="MockInterviewQuestionCount" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                            <nop-label asp-for="MockInterviewQuestionCount" />
                        </div>
                        <div class="col-md-9">
                            <input asp-for="MockInterviewQuestionCount" class="form-control" type="number" min="1" max="10" step="1" />
                            <small class="form-text text-muted">@T("Plugins.Misc.AIInterview.Admin.Configure.MockInterviewQuestionCount.Hint")</small>
                            <span asp-validation-for="MockInterviewQuestionCount"></span>
                        </div>
                    </div>
                    <script>
                        $(document).ready(function() {
                            function toggleMockHint() {
                                if ($('#@Html.IdFor(model => model.UseMockResponses)').is(':checked')) {
                                    $('#mock-responses-hint').show();
                                } else {
                                    $('#mock-responses-hint').hide();
                                }
                            }
                            $('#@Html.IdFor(model => model.UseMockResponses)').change(toggleMockHint);
                            toggleMockHint();
                        });
                    </script>
                    <div class="form-group row"><div class="col-md-3"><nop-label asp-for="Provider" /></div><div class="col-md-9"><nop-select asp-for="Provider" asp-items="Model.AvailableProviders" /></div></div>
