                        <div class="col-md-3">
                            <nop-override-store-checkbox asp-for="ApiKey_OverrideForStore" asp-input="ApiKey" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                            <nop-label asp-for="ApiKey" />
                        </div>
                        <div class="col-md-9">
                            <input asp-for="ApiKey" class="form-control" type="text" autocomplete="off" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-override-store-checkbox asp-for="Model_OverrideForStore" asp-input="Model" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                            <label class="col-form-label">@T("Plugins.Misc.AIInterview.Model")</label>
                        </div>
                        <div class="col-md-9">
                            <input class="form-control" type="text" name="Model" id="Model" value="@Model.Model" />
