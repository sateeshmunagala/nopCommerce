                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-override-store-checkbox asp-for="StrengthsSummaryMaxCompletionTokens_OverrideForStore" asp-input="StrengthsSummaryMaxCompletionTokens" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                            <nop-label asp-for="StrengthsSummaryMaxCompletionTokens" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="StrengthsSummaryMaxCompletionTokens" />
                            <small class="form-text text-muted">@T("Plugins.Misc.AIInterview.Admin.AiService.StrengthsSummaryMaxCompletionTokens.Hint")</small>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3"></div>
                        <div class="col-md-9">
                            <button type="button" class="btn btn-secondary" id="test-azure-openai-connection">
                                <i class="fas fa-plug"></i> @T("Plugins.Misc.AIInterview.Admin.AiService.TestConnection")
                            </button>
                            <span id="test-azure-openai-connection-result" class="ml-2"></span>
                        </div>
                    </div>
                    <script>
                        $(document).ready(function() {
                            $('#test-azure-openai-connection').on('click', function() {
                                var $button = $(this);
                                var $result = $('#test-azure-openai-connection-result');
                                $button.prop('disabled', true);
                                $result.removeClass('text-success text-danger').addClass('text-muted').text('@T("Plugins.Misc.AIInterview.Admin.AiService.TestConnection.Progress")');

                                $.ajax({
                                    type: 'POST',
                                    url: '@Url.Action("TestAzureOpenAiConnection", "AIInterviewAdmin", new { area = "Admin" })',
                                    data: {
                                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                                    }
                                }).done(function(response) {
                                    $result
                                        .removeClass('text-muted text-success text-danger')
                                        .addClass(response && response.success ? 'text-success' : 'text-danger')
                                        .text(response && response.message ? response.message : '@T("Plugins.Misc.AIInterview.Admin.AiService.TestConnection.UnknownFailure")');
                                }).fail(function() {
                                    $result
                                        .removeClass('text-muted text-success')
                                        .addClass('text-danger')
                                        .text('@T("Plugins.Misc.AIInterview.Admin.AiService.TestConnection.UnknownFailure")');
                                }).always(function() {
                                    $button.prop('disabled', false);
                                });
                            });
                        });
                    </script>
