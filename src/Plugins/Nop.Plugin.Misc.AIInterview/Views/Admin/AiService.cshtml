@model Nop.Plugin.Misc.AIInterview.Models.AiServiceSettingsModel

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = T("Plugins.Misc.AIInterview.Admin.AiService.Title").Text;
}

<form asp-controller="AIInterviewAdmin" asp-action="AiService" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">@T("Plugins.Misc.AIInterview.Admin.AiService.Title")</h1>
        <div class="float-right">
            <button type="submit" class="btn btn-primary">
                <i class="far fa-save"></i> @T("Admin.Common.Save")
            </button>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="card card-default">
                <div class="card-body">
                    <div class="form-group row"><div class="col-md-3"><nop-label asp-for="UseMockResponses" /></div><div class="col-md-9"><nop-editor asp-for="UseMockResponses" /></div></div>
                    <div class="form-group row"><div class="col-md-3"><nop-label asp-for="Provider" /></div><div class="col-md-9"><nop-editor asp-for="Provider" /></div></div>
                    <div class="form-group row"><div class="col-md-3"><nop-label asp-for="ApiKey" /></div><div class="col-md-9"><nop-editor asp-for="ApiKey" /></div></div>
                    <div class="form-group row"><div class="col-md-3"><nop-label asp-for="Model" /></div><div class="col-md-9"><nop-editor asp-for="Model" /></div></div>
                    <div class="form-group row"><div class="col-md-3"><nop-label asp-for="Prompt" /></div><div class="col-md-9"><nop-textarea asp-for="Prompt" /></div></div>
                    <div class="form-group row"><div class="col-md-3"><nop-label asp-for="ServiceSettings" /></div><div class="col-md-9"><nop-textarea asp-for="ServiceSettings" /></div></div>
                    <hr />
                    <div class="form-group row"><div class="col-md-3"><nop-label asp-for="AzureOpenAiEndpointUrl" /></div><div class="col-md-9"><nop-editor asp-for="AzureOpenAiEndpointUrl" /></div></div>
                    <div class="form-group row"><div class="col-md-3"><nop-label asp-for="AzureOpenAiApiKey" /></div><div class="col-md-9"><nop-editor asp-for="AzureOpenAiApiKey" /></div></div>
                    <div class="form-group row"><div class="col-md-3"><nop-label asp-for="AzureOpenAiDeploymentOrModel" /></div><div class="col-md-9"><nop-editor asp-for="AzureOpenAiDeploymentOrModel" /></div></div>
                    <div class="form-group row"><div class="col-md-3"><nop-label asp-for="AgoraAppId" /></div><div class="col-md-9"><nop-editor asp-for="AgoraAppId" /></div></div>
                    <div class="form-group row"><div class="col-md-3"><nop-label asp-for="AgoraTokenServiceUrl" /></div><div class="col-md-9"><nop-editor asp-for="AgoraTokenServiceUrl" /></div></div>
                    <div class="form-group row"><div class="col-md-3"><nop-label asp-for="AzureSpeechKey" /></div><div class="col-md-9"><nop-editor asp-for="AzureSpeechKey" /></div></div>
                    <div class="form-group row"><div class="col-md-3"><nop-label asp-for="AzureSpeechRegion" /></div><div class="col-md-9"><nop-editor asp-for="AzureSpeechRegion" /></div></div>
                </div>
            </div>
        </div>
    </section>
</form>
