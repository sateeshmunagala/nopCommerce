@model Nop.Plugin.Misc.AIInterview.Models.AiServiceSettingsModel
@using Nop.Plugin.Misc.AIInterview

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = T("Plugins.Misc.AIInterview.Admin.AiService.Title").Text;
    NopHtml.SetActiveMenuItemSystemName(AIInterviewDefaults.AdminAiServiceMenuSystemName);
}

<form asp-route="@AIInterviewDefaults.AdminAiServiceRouteName" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">@T("Plugins.Misc.AIInterview.Admin.AiService.Title")</h1>
        <div class="float-right">
            <button type="submit" class="btn btn-primary">
                <i class="far fa-save"></i> @T("Admin.Common.Save")
            </button>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="card card-default">
                <div class="card-body">
                    <h4>General / Model</h4>
                    <div class="form-group row">
                        <div class="col-md-3"><nop-label asp-for="UseMockResponses" /></div>
                        <div class="col-md-9">
                            <nop-editor asp-for="UseMockResponses" />
                            <small class="form-text text-warning font-weight-bold" id="mock-responses-hint" style="display: none;">Development mock mode is enabled. Azure OpenAI is bypassed.</small>
                        </div>
                    </div>
                    <script>
                        $(document).ready(function() {
                            function toggleMockHint() {
                                if ($('#@Html.IdFor(model => model.UseMockResponses)').is(':checked')) {
                                    $('#mock-responses-hint').show();
                                } else {
                                    $('#mock-responses-hint').hide();
                                }
                            }
                            $('#@Html.IdFor(model => model.UseMockResponses)').change(toggleMockHint);
                            toggleMockHint();
                        });
                    </script>
                    <div class="form-group row"><div class="col-md-3"><nop-label asp-for="Provider" /></div><div class="col-md-9"><nop-select asp-for="Provider" asp-items="Model.AvailableProviders" /></div></div>
                    <div class="form-group row">
                        <div class="col-md-3"><nop-label asp-for="ApiKey" /></div>
                        <div class="col-md-9">
                            <input asp-for="ApiKey" class="form-control" type="text" autocomplete="off" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <label class="col-form-label">@T("Plugins.Misc.AIInterview.Model")</label>
                        </div>
                        <div class="col-md-9">
                            <input class="form-control" type="text" name="Model" id="Model" value="@Model.Model" />
                        </div>
                    </div>
                    <div class="form-group row"><div class="col-md-3"><nop-label asp-for="Prompt" /></div><div class="col-md-9"><nop-textarea asp-for="Prompt" /></div></div>
                    <div class="form-group row"><div class="col-md-3"><nop-label asp-for="ServiceSettings" /></div><div class="col-md-9"><nop-textarea asp-for="ServiceSettings" /></div></div>
                    <div class="form-group row">
                        <div class="col-md-3"><nop-label asp-for="SupportPhoneNumber" /></div>
                        <div class="col-md-9">
                            <nop-editor asp-for="SupportPhoneNumber" />
                            <small class="form-text text-muted">@T("Plugins.Misc.AIInterview.Admin.AiService.SupportPhoneNumber.Hint")</small>
                        </div>
                    </div>
                    <hr />
                    <h4>Azure OpenAI</h4>
                    <div class="form-group row"><div class="col-md-3"><nop-label asp-for="AzureOpenAiEndpointUrl" /></div><div class="col-md-9"><nop-editor asp-for="AzureOpenAiEndpointUrl" /></div></div>
                    <div class="form-group row">
                        <div class="col-md-3"><nop-label asp-for="AzureOpenAiApiKey" /></div>
                        <div class="col-md-9">
                            <input asp-for="AzureOpenAiApiKey" class="form-control" type="text" autocomplete="off" />
                        </div>
                    </div>
                    <div class="form-group row"><div class="col-md-3"><nop-label asp-for="AzureOpenAiDeploymentOrModel" /></div><div class="col-md-9"><nop-editor asp-for="AzureOpenAiDeploymentOrModel" /></div></div>
                    <hr />
                    <h4>Azure Speech</h4>
                    <div class="form-group row">
                        <div class="col-md-3"><nop-label asp-for="AzureSpeechKey" /></div>
                        <div class="col-md-9">
                            <input asp-for="AzureSpeechKey" class="form-control" type="text" autocomplete="off" />
                        </div>
                    </div>
                    <div class="form-group row"><div class="col-md-3"><nop-label asp-for="AzureSpeechRegion" /></div><div class="col-md-9"><nop-editor asp-for="AzureSpeechRegion" /></div></div>
                    <hr />
                    <h4>Azure Document Intelligence</h4>
                    <div class="form-group row">
                        <div class="col-md-3"><nop-label asp-for="AzureDocumentIntelligenceEndpointUrl" /></div>
                        <div class="col-md-9">
                            <nop-editor asp-for="AzureDocumentIntelligenceEndpointUrl" />
                            <small class="form-text text-muted">@T("Plugins.Misc.AIInterview.Admin.AiService.AzureDocumentIntelligenceEndpointUrl.Hint")</small>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3"><nop-label asp-for="AzureDocumentIntelligenceApiKey" /></div>
                        <div class="col-md-9">
                            <input asp-for="AzureDocumentIntelligenceApiKey" class="form-control" type="text" value="" autocomplete="off" />
                            <small class="form-text text-muted">@T("Plugins.Misc.AIInterview.Admin.AiService.AzureDocumentIntelligenceApiKey.Hint")</small>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3"><nop-label asp-for="AzureDocumentIntelligenceModelId" /></div>
                        <div class="col-md-9">
                            <nop-editor asp-for="AzureDocumentIntelligenceModelId" />
                            <small class="form-text text-muted">@T("Plugins.Misc.AIInterview.Admin.AiService.AzureDocumentIntelligenceModelId.Hint")</small>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3"><nop-label asp-for="AzureDocumentIntelligenceTimeoutSeconds" /></div>
                        <div class="col-md-9">
                            <nop-editor asp-for="AzureDocumentIntelligenceTimeoutSeconds" />
                            <small class="form-text text-muted">@T("Plugins.Misc.AIInterview.Admin.AiService.AzureDocumentIntelligenceTimeoutSeconds.Hint")</small>
                        </div>
                    </div>
                    <hr />
                    <h4>Usage tracking / pricing</h4>
                    <div class="form-group row"><div class="col-md-3"><nop-label asp-for="TrackAzureOpenAiUsage" /></div><div class="col-md-9"><nop-editor asp-for="TrackAzureOpenAiUsage" /></div></div>
                    <div class="form-group row"><div class="col-md-3"><nop-label asp-for="TrackAzureSpeechUsage" /></div><div class="col-md-9"><nop-editor asp-for="TrackAzureSpeechUsage" /></div></div>
                    <div class="form-group row"><div class="col-md-3"><nop-label asp-for="CalculateAzureCostPerInterview" /></div><div class="col-md-9"><nop-editor asp-for="CalculateAzureCostPerInterview" /></div></div>
                    <div class="form-group row"><div class="col-md-3"><nop-label asp-for="AzureOpenAiPromptTokenPricePerThousand" /></div><div class="col-md-9"><nop-editor asp-for="AzureOpenAiPromptTokenPricePerThousand" /></div></div>
                    <div class="form-group row"><div class="col-md-3"><nop-label asp-for="AzureOpenAiCompletionTokenPricePerThousand" /></div><div class="col-md-9"><nop-editor asp-for="AzureOpenAiCompletionTokenPricePerThousand" /></div></div>
                    <div class="form-group row"><div class="col-md-3"><nop-label asp-for="AzureSpeechRecognitionPricePerHour" /></div><div class="col-md-9"><nop-editor asp-for="AzureSpeechRecognitionPricePerHour" /></div></div>
                    <div class="form-group row"><div class="col-md-3"><nop-label asp-for="AzureSpeechSynthesisPricePerThousandCharacters" /></div><div class="col-md-9"><nop-editor asp-for="AzureSpeechSynthesisPricePerThousandCharacters" /></div></div>
                    <div class="form-group row"><div class="col-md-3"><nop-label asp-for="AzureUsageCurrencyCode" /></div><div class="col-md-9"><nop-editor asp-for="AzureUsageCurrencyCode" /></div></div>
                    <h4>Azure Blob storage</h4>
                    <div class="form-group row">
                        <div class="col-md-3"><nop-label asp-for="AzureBlobStorageContainerUrl" /></div>
                        <div class="col-md-9">
                            <nop-editor asp-for="AzureBlobStorageContainerUrl" />
                            <small class="form-text text-muted">@T("Plugins.Misc.AIInterview.Admin.AiService.AzureBlobStorageContainerUrl.Hint")</small>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3"><nop-label asp-for="AzureBlobStorageSasToken" /></div>
                        <div class="col-md-9">
                            <input asp-for="AzureBlobStorageSasToken" class="form-control" type="text" autocomplete="off" />
                            <small class="form-text text-muted">@T("Plugins.Misc.AIInterview.Admin.AiService.AzureBlobStorageSasToken.Hint")</small>
                        </div>
                    </div>
                    <hr />
                    <h4>Credits</h4>
                    <div class="form-group row">
                        <div class="col-md-3"><nop-label asp-for="CreditProductSkuMappingsJson" /></div>
                        <div class="col-md-9">
                            <nop-textarea asp-for="CreditProductSkuMappingsJson" />
                            <small class="form-text text-muted">@T("Plugins.Misc.AIInterview.Admin.AiService.CreditProductSkuMappingsJson.Hint")</small>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3"><nop-label asp-for="CreditPurchasePageUrl" /></div>
                        <div class="col-md-9">
                            <nop-editor asp-for="CreditPurchasePageUrl" />
                            <small class="form-text text-muted">@T("Plugins.Misc.AIInterview.Admin.AiService.CreditPurchasePageUrl.Hint")</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
