                    <div class="form-group row"><div class="col-md-3"><nop-override-store-checkbox asp-for="RuntimeScoringSystemPrompt_OverrideForStore" asp-input="RuntimeScoringSystemPrompt" asp-store-scope="@Model.ActiveStoreScopeConfiguration" /><nop-label asp-for="RuntimeScoringSystemPrompt" /></div><div class="col-md-9"><nop-textarea asp-for="RuntimeScoringSystemPrompt" /><small class="form-text text-muted">@T("Plugins.Misc.AIInterview.Admin.AiService.RuntimeScoringSystemPrompt.Hint")</small></div></div>
                    <div class="form-group row"><div class="col-md-3"><nop-override-store-checkbox asp-for="RuntimeScoringRetryAddendumPrompt_OverrideForStore" asp-input="RuntimeScoringRetryAddendumPrompt" asp-store-scope="@Model.ActiveStoreScopeConfiguration" /><nop-label asp-for="RuntimeScoringRetryAddendumPrompt" /></div><div class="col-md-9"><nop-textarea asp-for="RuntimeScoringRetryAddendumPrompt" /><small class="form-text text-muted">@T("Plugins.Misc.AIInterview.Admin.AiService.RuntimeScoringRetryAddendumPrompt.Hint")</small></div></div>
