@model Nop.Plugin.Misc.AIInterview.Models.CreditManagementModel
@using Nop.Plugin.Misc.AIInterview

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = T("Plugins.Misc.AIInterview.Admin.Credits.VendorTitle").Text;
    NopHtml.SetActiveMenuItemSystemName(AIInterviewDefaults.AdminVendorCreditsMenuSystemName);
}

<form asp-controller="AIInterviewAdmin" asp-action="VendorCredits" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">@T("Plugins.Misc.AIInterview.Admin.Credits.VendorTitle")</h1>
        <div class="float-right">
            <button type="submit" class="btn btn-primary">@T("Plugins.Misc.AIInterview.Admin.Credits.TopUp")</button>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="card card-default">
                <div class="card-body">
                    <div class="form-group row"><div class="col-md-3"><nop-label asp-for="CustomerId" /></div><div class="col-md-9"><nop-select asp-for="CustomerId" asp-items="Model.AvailableCustomers" /></div></div>
                    <div class="form-group row"><div class="col-md-3"><nop-label asp-for="Amount" /></div><div class="col-md-9"><nop-editor asp-for="Amount" /></div></div>
                    <div class="form-group row">
                        <div class="col-md-3">Selected Vendor</div>
                        <div class="col-md-9">
                            @if (!string.IsNullOrWhiteSpace(Model.CustomerAdminUrl))
                            {
                                <a href="@Model.CustomerAdminUrl">@Model.CustomerName</a>
                            }
                            else
                            {
                                <strong>@Model.CustomerName</strong>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.CustomerEmail))
                            {
                                <span class="text-muted"> (@Model.CustomerEmail)</span>
                            }
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">Wallet Balance</div>
                        <div class="col-md-9"><strong>@Model.WalletBalance</strong></div>
                    </div>
                </div>
            </div>

            <div class="card card-default">
                <div class="card-header">Ledger</div>
                <div class="card-body">
                    <table class="table table-bordered table-striped">
                        <thead><tr><th>Customer</th><th>Amount</th><th>Type</th><th>Remarks</th><th>UTC</th></tr></thead>
                        <tbody>
                            @foreach (var entry in Model.LedgerEntries)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(entry.CustomerAdminUrl))
                                        {
                                            <a href="@entry.CustomerAdminUrl">@entry.CustomerName</a>
                                        }
                                        else
                                        {
                                            @entry.CustomerName
                                        }
                                    </td>
                                    <td>@entry.Amount</td>
                                    <td>@entry.TransactionType</td>
                                    <td>@entry.Remarks</td>
                                    <td>@entry.CreatedOnUtc.ToString("yyyy-MM-dd HH:mm:ss")Z</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
</form>
