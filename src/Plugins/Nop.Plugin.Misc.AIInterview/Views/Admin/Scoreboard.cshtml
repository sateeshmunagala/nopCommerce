@model Nop.Plugin.Misc.AIInterview.Models.ScoreboardFilterModel
@using Microsoft.AspNetCore.Routing
@using Nop.Plugin.Misc.AIInterview
@using Nop.Plugin.Misc.AIInterview.Models
@using Nop.Web.Framework.Models.DataTables

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = T("Plugins.Misc.AIInterview.Admin.Scoreboard.Title").Text;
    NopHtml.AppendCssFileParts("~/Plugins/Misc.AIInterview/Content/css/aiinterview-admin.css");
    NopHtml.AppendPageCssClassParts("html-aiinterview-plugin-admin-page");
    NopHtml.AppendPageCssClassParts("html-aiinterview-admin-scoreboard-page");
    NopHtml.SetActiveMenuItemSystemName(AIInterviewDefaults.AdminScoreboardMenuSystemName);
}

<div class="content-header clearfix aiinterview-admin-header">
    <div class="float-left">
        <h1>@T("Plugins.Misc.AIInterview.Admin.Scoreboard.Title")</h1>
        <div class="aiinterview-admin-subtitle">@T("Plugins.Misc.AIInterview.Admin.Scoreboard.Filter")</div>
    </div>
    <div class="float-right">
        <form asp-controller="AIInterviewAdmin" asp-action="ScoreboardExportCsv" method="post" class="d-inline">
            <input type="hidden" asp-for="Candidate" />
            <input type="hidden" asp-for="Vendor" />
            <input type="hidden" asp-for="JobPosting" />
            <input type="hidden" asp-for="Status" />
            <input type="hidden" asp-for="MinScore" />
            <input type="hidden" asp-for="MaxScore" />
            <input type="hidden" asp-for="StartDate" />
            <input type="hidden" asp-for="EndDate" />
            <button type="submit" class="btn btn-secondary aiinterview-admin-link-button" aria-label="@T("Plugins.Misc.AIInterview.Admin.Scoreboard.Export")" title="@T("Plugins.Misc.AIInterview.Admin.Scoreboard.Export")">
                <i class="fas fa-download"></i> @T("Plugins.Misc.AIInterview.Admin.Scoreboard.Export")
            </button>
        </form>
    </div>
</div>

<section class="content">
    <div class="container-fluid aiinterview-admin-shell aiinterview-admin-scoreboard-shell">
        <div class="aiinterview-admin-summary">
            <div class="aiinterview-admin-summary-card">
                <span class="aiinterview-admin-summary-label">@T("Plugins.Misc.AIInterview.Admin.Scoreboard.Candidate")</span>
                <strong class="aiinterview-admin-summary-value">@(!string.IsNullOrWhiteSpace(Model.Candidate) ? Model.Candidate : "-")</strong>
            </div>
            <div class="aiinterview-admin-summary-card">
                <span class="aiinterview-admin-summary-label">@T("Plugins.Misc.AIInterview.Admin.Scoreboard.Vendor")</span>
                <strong class="aiinterview-admin-summary-value">@(!string.IsNullOrWhiteSpace(Model.Vendor) ? Model.Vendor : "-")</strong>
            </div>
            <div class="aiinterview-admin-summary-card">
                <span class="aiinterview-admin-summary-label">@T("Plugins.Misc.AIInterview.Admin.Scoreboard.JobPosting")</span>
                <strong class="aiinterview-admin-summary-value">@(!string.IsNullOrWhiteSpace(Model.JobPosting) ? Model.JobPosting : "-")</strong>
            </div>
        </div>

        <div class="card card-default card-search aiinterview-admin-card aiinterview-admin-search-card">
            <div class="card-body">
                <div class="search-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <nop-label asp-for="Candidate" />
                                </div>
                                <div class="col-md-8">
                                    <nop-editor asp-for="Candidate" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <nop-label asp-for="Vendor" />
                                </div>
                                <div class="col-md-8">
                                    <nop-editor asp-for="Vendor" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <nop-label asp-for="JobPosting" />
                                </div>
                                <div class="col-md-8">
                                    <nop-editor asp-for="JobPosting" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <nop-label asp-for="Status" />
                                </div>
                                <div class="col-md-8">
                                    <nop-select asp-for="Status" asp-items="Model.AvailableStatuses" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <nop-label asp-for="MinScore" />
                                </div>
                                <div class="col-md-8">
                                    <nop-editor asp-for="MinScore" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <nop-label asp-for="MaxScore" />
                                </div>
                                <div class="col-md-8">
                                    <nop-editor asp-for="MaxScore" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <nop-label asp-for="StartDate" />
                                </div>
                                <div class="col-md-8">
                                    <nop-editor asp-for="StartDate" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <nop-label asp-for="EndDate" />
                                </div>
                                <div class="col-md-8">
                                    <nop-editor asp-for="EndDate" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="text-center col-12">
                            <button type="button" id="search-scoreboard" class="btn btn-primary btn-search aiinterview-admin-action-button" aria-label="@T("Plugins.Misc.AIInterview.Admin.Scoreboard.Filter")" title="@T("Plugins.Misc.AIInterview.Admin.Scoreboard.Filter")">
                                <i class="fas fa-magnifying-glass"></i>
                                @T("Plugins.Misc.AIInterview.Admin.Scoreboard.Filter")
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card card-default aiinterview-admin-card">
            <div class="card-body">
                @await Html.PartialAsync("Table", new DataTablesModel
                {
                    Name = "scoreboard-grid",
                    UrlRead = new DataUrl("ScoreboardList", "AIInterviewAdmin", null),
                    SearchButtonId = "search-scoreboard",
                    Length = Model.PageSize,
                    LengthMenu = Model.AvailablePageSizes,
                    Filters = new List<FilterParameter>
                    {
                        new FilterParameter(nameof(Model.Candidate)),
                        new FilterParameter(nameof(Model.Vendor)),
                        new FilterParameter(nameof(Model.JobPosting)),
                        new FilterParameter(nameof(Model.Status)),
                        new FilterParameter(nameof(Model.MinScore)),
                        new FilterParameter(nameof(Model.MaxScore)),
                        new FilterParameter(nameof(Model.StartDate)),
                        new FilterParameter(nameof(Model.EndDate))
                    },
                    ColumnCollection = new List<ColumnProperty>
                    {
                        new ColumnProperty(nameof(ScoreboardRowModel.CandidateName))
                        {
                            Title = T("Plugins.Misc.AIInterview.Admin.Scoreboard.Candidate").Text,
                            Render = new RenderCustom("renderScoreboardCandidate")
                        },
                        new ColumnProperty(nameof(ScoreboardRowModel.VendorName))
                        {
                            Title = T("Plugins.Misc.AIInterview.Admin.Scoreboard.Vendor").Text,
                            Render = new RenderCustom("renderScoreboardVendor")
                        },
                        new ColumnProperty(nameof(ScoreboardRowModel.JobTitle))
                        {
                            Title = T("Plugins.Misc.AIInterview.Admin.Scoreboard.JobPosting").Text,
                            Render = new RenderCustom("renderScoreboardJob")
                        },
                        new ColumnProperty(nameof(ScoreboardRowModel.Status))
                        {
                            Title = T("Plugins.Misc.AIInterview.Admin.Scoreboard.Status").Text
                        },
                        new ColumnProperty(nameof(ScoreboardRowModel.Score))
                        {
                            Title = T("Plugins.Misc.AIInterview.Admin.Scoreboard.MinScore").Text
                        },
                        new ColumnProperty(nameof(ScoreboardRowModel.CompletedOn))
                        {
                            Title = T("Plugins.Misc.AIInterview.Admin.Scoreboard.EndDate").Text,
                            Render = new RenderCustom("renderScoreboardCompleted")
                        },
                        new ColumnProperty(nameof(ScoreboardRowModel.ReportUrl))
                        {
                            Title = T("Plugins.Misc.AIInterview.Admin.Scoreboard.Report").Text,
                            Width = "120",
                            ClassName = NopColumnClassDefaults.Button,
                            Render = new RenderCustom("renderScoreboardReport")
                        }
                    }
                })
            </div>
        </div>
    </div>
</section>

<script>
    function scoreboardEncodeHtml(value) {
        if (value === null || value === undefined) {
            return '';
        }

        return String(value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function renderScoreboardLink(url, text) {
        if (!url) {
            return scoreboardEncodeHtml(text || '');
        }

        return '<a href="' + scoreboardEncodeHtml(url) + '">' + scoreboardEncodeHtml(text || '') + '</a>';
    }

    function renderScoreboardCandidate(data, type, row) {
        if (type !== 'display') {
            return data;
        }

        return renderScoreboardLink(row.CandidateAdminUrl, row.CandidateName);
    }

    function renderScoreboardVendor(data, type, row) {
        if (type !== 'display') {
            return data;
        }

        return renderScoreboardLink(row.VendorAdminUrl, row.VendorName);
    }

    function renderScoreboardJob(data, type, row) {
        if (type !== 'display') {
            return data;
        }

        return renderScoreboardLink(row.ProductAdminUrl, row.JobTitle);
    }

    function renderScoreboardCompleted(data, type, row) {
        if (type !== 'display') {
            return data;
        }

        return row.CompletedOn || '-';
    }

    function renderScoreboardReport(data, type, row) {
        if (type !== 'display') {
            return data;
        }

        if (!row.ReportUrl) {
            return '';
        }

        return '<a class="btn btn-default aiinterview-admin-link-button" href="' + scoreboardEncodeHtml(row.ReportUrl) + '" title="@T("Plugins.Misc.AIInterview.Admin.Scoreboard.Report").Text" aria-label="@T("Plugins.Misc.AIInterview.Admin.Scoreboard.Report").Text">@T("Plugins.Misc.AIInterview.Admin.Scoreboard.Report").Text</a>';
    }
</script>
