@model Nop.Plugin.Misc.AIInterview.Models.CreditManagementModel
@using Nop.Plugin.Misc.AIInterview
@using Microsoft.AspNetCore.Routing
@using Nop.Web.Framework.Models.DataTables
@inject Nop.Services.Common.IGenericAttributeService genericAttributeService
@inject Nop.Core.IWorkContext workContext

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = T("Plugins.Misc.AIInterview.Admin.Credits.ApplicantTitle").Text;
    NopHtml.SetActiveMenuItemSystemName(AIInterviewDefaults.AdminApplicantCreditsMenuSystemName);
}

@{
    const string hideSearchBlockAttributeName = "AIInterviewApplicantCredits.HideSearchBlock";
    var hideSearchBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideSearchBlockAttributeName);
}

<div class="content-header clearfix">
    <h1 class="float-left">@T("Plugins.Misc.AIInterview.Admin.Credits.ApplicantTitle")</h1>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card card-default">
            <div class="card-header">@T("Plugins.Misc.AIInterview.Admin.Credits.Activity.Title")</div>
            <div class="card-body">
                <form asp-controller="AIInterviewAdmin" asp-action="ApplicantCredits" method="get">
                    <div class="form-group row">
                        <div class="col-md-3"><nop-label asp-for="LoadCustomerId" /></div>
                        <div class="col-md-3"><nop-editor asp-for="LoadCustomerId" /></div>
                        <div class="col-md-3"><nop-label asp-for="LoadCustomerEmail" /></div>
                        <div class="col-md-3"><nop-editor asp-for="LoadCustomerEmail" /></div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3"><nop-label asp-for="CustomerId" /></div>
                        <div class="col-md-6"><nop-select asp-for="CustomerId" asp-items="Model.AvailableCustomers" /></div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-secondary">@T("Plugins.Misc.AIInterview.Admin.Credits.Activity.LoadApplicant")</button>
                        </div>
                    </div>
                </form>

                <div class="card card-default card-search">
                    <div class="card-body">
                        <div class="row search-row @(!hideSearchBlock ? "opened" : "")" data-hideAttribute="@hideSearchBlockAttributeName">
                            <div class="search-text">@T("Admin.Common.Search")</div>
                            <div class="icon-search"><i class="fas fa-magnifying-glass" aria-hidden="true"></i></div>
                            <div class="icon-collapse"><i class="far fa-angle-@(!hideSearchBlock ? "up" : "down")" aria-hidden="true"></i></div>
                        </div>

                        <div class="search-body @(hideSearchBlock ? "closed" : "")">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="ActivitySearchModel.SearchCustomerId" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-editor asp-for="ActivitySearchModel.SearchCustomerId" />
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="ActivitySearchModel.SearchKeyword" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-editor asp-for="ActivitySearchModel.SearchKeyword" />
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="ActivitySearchModel.SearchHasPositiveBalanceOnly" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-editor asp-for="ActivitySearchModel.SearchHasPositiveBalanceOnly" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="ActivitySearchModel.SearchActivityDateFromUtc" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-editor asp-for="ActivitySearchModel.SearchActivityDateFromUtc" />
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="ActivitySearchModel.SearchActivityDateToUtc" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-editor asp-for="ActivitySearchModel.SearchActivityDateToUtc" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="text-center col-12">
                                    <button type="button" id="search-applicant-credits" class="btn btn-primary btn-search">
                                        <i class="fas fa-magnifying-glass"></i>
                                        @T("Admin.Common.Search")
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @await Html.PartialAsync("Table", new DataTablesModel
                {
                    Name = "applicant-credits-grid",
                    UrlRead = new DataUrl("ApplicantCreditActivityList", "AIInterviewAdmin", null),
                    SearchButtonId = "search-applicant-credits",
                    Length = Model.ActivitySearchModel.PageSize,
                    LengthMenu = Model.ActivitySearchModel.AvailablePageSizes,
                    Filters = new List<FilterParameter>
                    {
                        new FilterParameter(nameof(Model.ActivitySearchModel.SearchCustomerId), nameof(Model.ActivitySearchModel)),
                        new FilterParameter(nameof(Model.ActivitySearchModel.SearchKeyword), nameof(Model.ActivitySearchModel)),
                        new FilterParameter(nameof(Model.ActivitySearchModel.SearchHasPositiveBalanceOnly), nameof(Model.ActivitySearchModel)),
                        new FilterParameter(nameof(Model.ActivitySearchModel.SearchActivityDateFromUtc), nameof(Model.ActivitySearchModel)),
                        new FilterParameter(nameof(Model.ActivitySearchModel.SearchActivityDateToUtc), nameof(Model.ActivitySearchModel))
                    },
                    ColumnCollection = new List<ColumnProperty>
                    {
                        new ColumnProperty(nameof(Nop.Plugin.Misc.AIInterview.Models.ApplicantCreditActivityRowModel.CustomerId))
                        {
                            Title = T("Plugins.Misc.AIInterview.Admin.Credits.CustomerId").Text
                        },
                        new ColumnProperty(nameof(Nop.Plugin.Misc.AIInterview.Models.ApplicantCreditActivityRowModel.CustomerName))
                        {
                            Title = T("Admin.Customers.Customers").Text,
                            Render = new RenderCustom("renderApplicantCreditCustomer")
                        },
                        new ColumnProperty(nameof(Nop.Plugin.Misc.AIInterview.Models.ApplicantCreditActivityRowModel.WalletBalance))
                        {
                            Title = T("Plugins.Misc.AIInterview.Admin.Credits.Activity.WalletBalance").Text
                        },
                        new ColumnProperty(nameof(Nop.Plugin.Misc.AIInterview.Models.ApplicantCreditActivityRowModel.TotalDeposited))
                        {
                            Title = T("Plugins.Misc.AIInterview.Admin.Credits.Activity.TotalDeposited").Text
                        },
                        new ColumnProperty(nameof(Nop.Plugin.Misc.AIInterview.Models.ApplicantCreditActivityRowModel.TotalWithdrawn))
                        {
                            Title = T("Plugins.Misc.AIInterview.Admin.Credits.Activity.TotalWithdrawn").Text
                        },
                        new ColumnProperty(nameof(Nop.Plugin.Misc.AIInterview.Models.ApplicantCreditActivityRowModel.LastCreditActivityUtc))
                        {
                            Title = T("Plugins.Misc.AIInterview.Admin.Credits.Activity.LastCreditActivityUtc").Text,
                            Render = new RenderCustom("renderApplicantCreditDate")
                        },
                        new ColumnProperty(nameof(Nop.Plugin.Misc.AIInterview.Models.ApplicantCreditActivityRowModel.ViewLedgerUrl))
                        {
                            Title = T("Plugins.Misc.AIInterview.Admin.Credits.Activity.ViewLedger").Text,
                            Width = "120",
                            ClassName = NopColumnClassDefaults.Button,
                            Render = new RenderCustom("renderApplicantCreditViewLedger")
                        }
                    }
                })
            </div>
        </div>

        <form asp-controller="AIInterviewAdmin" asp-action="ApplicantCredits" method="post">
            <input asp-for="CustomerId" type="hidden" />

            <div class="card card-default">
                <div class="card-header">@T("Plugins.Misc.AIInterview.Admin.Credits.Activity.SelectedApplicant")</div>
                <div class="card-body">
                    <div class="form-group row">
                        <div class="col-md-3">@T("Plugins.Misc.AIInterview.Admin.Credits.Activity.SelectedApplicant")</div>
                        <div class="col-md-9">
                            @if (!string.IsNullOrWhiteSpace(Model.CustomerAdminUrl))
                            {
                                <a href="@Model.CustomerAdminUrl">@Model.CustomerName</a>
                            }
                            else if (!string.IsNullOrWhiteSpace(Model.CustomerName))
                            {
                                <strong>@Model.CustomerName</strong>
                            }
                            else
                            {
                                <span class="text-muted">@T("Plugins.Misc.AIInterview.Admin.Credits.Activity.SelectApplicant")</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.CustomerEmail))
                            {
                                <span class="text-muted"> (@Model.CustomerEmail)</span>
                            }
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">@T("Plugins.Misc.AIInterview.Admin.Credits.Activity.WalletBalance")</div>
                        <div class="col-md-9"><strong>@Model.WalletBalance</strong></div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3"><nop-label asp-for="Amount" /></div>
                        <div class="col-md-6"><nop-editor asp-for="Amount" /></div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary">@T("Plugins.Misc.AIInterview.Admin.Credits.TopUp")</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card card-default">
                <div class="card-header">@T("Plugins.Misc.AIInterview.Admin.Credits.Ledger.Title")</div>
                <div class="card-body">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>@T("Plugins.Misc.AIInterview.Admin.Credits.Ledger.Customer")</th>
                                <th>@T("Plugins.Misc.AIInterview.Admin.Credits.Ledger.Amount")</th>
                                <th>@T("Plugins.Misc.AIInterview.Admin.Credits.Ledger.Type")</th>
                                <th>@T("Plugins.Misc.AIInterview.Admin.Credits.Ledger.Remarks")</th>
                                <th>@T("Plugins.Misc.AIInterview.Admin.Credits.Ledger.Utc")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.LedgerEntries.Any())
                            {
                                foreach (var entry in Model.LedgerEntries)
                                {
                                    <tr>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(entry.CustomerAdminUrl))
                                            {
                                                <a href="@entry.CustomerAdminUrl">@entry.CustomerName</a>
                                            }
                                            else
                                            {
                                                @entry.CustomerName
                                            }
                                        </td>
                                        <td>@entry.Amount</td>
                                        <td>@entry.TransactionType</td>
                                        <td>@entry.Remarks</td>
                                        <td>@entry.CreatedOnUtc.ToString("yyyy-MM-dd HH:mm:ss")Z</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5">@T("Plugins.Misc.AIInterview.Admin.Credits.Ledger.Empty")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </form>
    </div>
</section>

<script>
    function applicantCreditEncodeHtml(value) {
        if (value === null || value === undefined) {
            return '';
        }

        return String(value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function applicantCreditEncodeUrl(value) {
        return applicantCreditEncodeHtml(value);
    }

    function renderApplicantCreditCustomer(data, type, row) {
        if (type !== 'display') {
            return data;
        }

        var name = row.CustomerName || '';
        var email = row.CustomerEmail ? '<div class="text-muted">' + applicantCreditEncodeHtml(row.CustomerEmail) + '</div>' : '';
        if (row.CustomerAdminUrl) {
            return '<a href="' + applicantCreditEncodeUrl(row.CustomerAdminUrl) + '">' + applicantCreditEncodeHtml(name) + '</a>' + email;
        }

        return applicantCreditEncodeHtml(name) + email;
    }

    function renderApplicantCreditDate(data, type, row) {
        if (type !== 'display') {
            return data;
        }

        return row.LastCreditActivityUtc ? row.LastCreditActivityUtc : '';
    }

    function renderApplicantCreditViewLedger(data, type, row) {
        if (type !== 'display') {
            return data;
        }

        if (!row.ViewLedgerUrl) {
            return '';
        }

        return '<a class="btn btn-default" href="' + applicantCreditEncodeUrl(row.ViewLedgerUrl) + '">@T("Plugins.Misc.AIInterview.Admin.Credits.Activity.ViewLedger").Text</a>';
    }
</script>
