@model Nop.Plugin.Misc.AIInterview.Models.CreditManagementModel
@using Nop.Plugin.Misc.AIInterview

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = T("Plugins.Misc.AIInterview.Admin.Credits.ApplicantTitle").Text;
    NopHtml.SetActiveMenuItemSystemName(AIInterviewDefaults.AdminApplicantCreditsMenuSystemName);
}

<div class="content-header clearfix">
    <h1 class="float-left">@T("Plugins.Misc.AIInterview.Admin.Credits.ApplicantTitle")</h1>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card card-default">
            <div class="card-header">Applicant Credit Activity</div>
            <div class="card-body">
                <form asp-controller="AIInterviewAdmin" asp-action="ApplicantCredits" method="get">
                    <div class="form-group row">
                        <div class="col-md-3"><nop-label asp-for="CustomerId" /></div>
                        <div class="col-md-6"><nop-select asp-for="CustomerId" asp-items="Model.AvailableCustomers" /></div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-secondary">Load Applicant</button>
                        </div>
                    </div>
                </form>

                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Wallet Balance</th>
                            <th>Total Deposited</th>
                            <th>Total Withdrawn</th>
                            <th>Last Credit Activity UTC</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ActivityCustomers.Any())
                        {
                            foreach (var customer in Model.ActivityCustomers)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(customer.CustomerAdminUrl))
                                        {
                                            <a href="@customer.CustomerAdminUrl">@customer.CustomerName</a>
                                        }
                                        else
                                        {
                                            @customer.CustomerName
                                        }
                                        @if (!string.IsNullOrWhiteSpace(customer.CustomerEmail))
                                        {
                                            <div class="text-muted">@customer.CustomerEmail</div>
                                        }
                                    </td>
                                    <td>@customer.WalletBalance</td>
                                    <td>@customer.TotalDeposited</td>
                                    <td>@customer.TotalWithdrawn</td>
                                    <td>@(customer.LastCreditActivityUtc.HasValue ? $"{customer.LastCreditActivityUtc.Value:yyyy-MM-dd HH:mm:ss}Z" : string.Empty)</td>
                                    <td>
                                        <a class="btn btn-sm btn-primary" asp-controller="AIInterviewAdmin" asp-action="ApplicantCredits" asp-route-customerId="@customer.CustomerId">View Ledger</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6">No applicant credit activity found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <form asp-controller="AIInterviewAdmin" asp-action="ApplicantCredits" method="post">
            <input asp-for="CustomerId" type="hidden" />

            <div class="card card-default">
                <div class="card-header">Selected Applicant</div>
                <div class="card-body">
                    <div class="form-group row">
                        <div class="col-md-3">Selected Customer</div>
                        <div class="col-md-9">
                            @if (!string.IsNullOrWhiteSpace(Model.CustomerAdminUrl))
                            {
                                <a href="@Model.CustomerAdminUrl">@Model.CustomerName</a>
                            }
                            else if (!string.IsNullOrWhiteSpace(Model.CustomerName))
                            {
                                <strong>@Model.CustomerName</strong>
                            }
                            else
                            {
                                <span class="text-muted">Select applicant</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.CustomerEmail))
                            {
                                <span class="text-muted"> (@Model.CustomerEmail)</span>
                            }
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">Wallet Balance</div>
                        <div class="col-md-9"><strong>@Model.WalletBalance</strong></div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3"><nop-label asp-for="Amount" /></div>
                        <div class="col-md-6"><nop-editor asp-for="Amount" /></div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary">@T("Plugins.Misc.AIInterview.Admin.Credits.TopUp")</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card card-default">
                <div class="card-header">Ledger</div>
                <div class="card-body">
                    <table class="table table-bordered table-striped">
                        <thead><tr><th>Customer</th><th>Amount</th><th>Type</th><th>Remarks</th><th>UTC</th></tr></thead>
                        <tbody>
                            @if (Model.LedgerEntries.Any())
                            {
                                foreach (var entry in Model.LedgerEntries)
                                {
                                    <tr>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(entry.CustomerAdminUrl))
                                            {
                                                <a href="@entry.CustomerAdminUrl">@entry.CustomerName</a>
                                            }
                                            else
                                            {
                                                @entry.CustomerName
                                            }
                                        </td>
                                        <td>@entry.Amount</td>
                                        <td>@entry.TransactionType</td>
                                        <td>@entry.Remarks</td>
                                        <td>@entry.CreatedOnUtc.ToString("yyyy-MM-dd HH:mm:ss")Z</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5">No ledger entries found for the selected applicant.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </form>
    </div>
</section>
