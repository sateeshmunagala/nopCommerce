@model Nop.Web.Areas.Admin.Models.Catalog.ProductModel
@using Nop.Plugin.Misc.AIInterview

@{
    var resumeRequired = ViewBag.ResumeRequired != null && (bool)ViewBag.ResumeRequired;
    var interviewRequired = ViewBag.InterviewRequired != null && (bool)ViewBag.InterviewRequired;
}

<nop-card asp-name="aiinterview-job-requirements"
          asp-icon="fas fa-briefcase"
          asp-title="@T("Plugins.Misc.AIInterview.Admin.ProductRequirements.Title")"
          asp-advanced="false">
    <div class="form-group row">
        <div class="col-md-12 text-muted">
            @T("Plugins.Misc.AIInterview.Admin.ProductRequirements.Hint")
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <label class="col-form-label" for="AIInterviewJobResumeRequired">@T("Plugins.Misc.AIInterview.Admin.ProductRequirements.ResumeRequired")</label>
        </div>
        <div class="col-md-9">
            <input type="hidden" name="AIInterviewJobResumeRequired" value="false" />
            <input type="checkbox"
                   class="form-check-input"
                   id="AIInterviewJobResumeRequired"
                   name="AIInterviewJobResumeRequired"
                   value="true"
                   @(resumeRequired ? "checked" : null) />
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <label class="col-form-label" for="AIInterviewJobInterviewRequired">@T("Plugins.Misc.AIInterview.Admin.ProductRequirements.InterviewRequired")</label>
        </div>
        <div class="col-md-9">
            <input type="hidden" name="AIInterviewJobInterviewRequired" value="false" />
            <input type="checkbox"
                   class="form-check-input"
                   id="AIInterviewJobInterviewRequired"
                   name="AIInterviewJobInterviewRequired"
                   value="true"
                   @(interviewRequired ? "checked" : null) />
        </div>
    </div>
</nop-card>
