@model Nop.Web.Models.Catalog.ProductDetailsModel

@using Nop.Web.Components
@using Nop.Web.Framework.Infrastructure

@{
    Layout = "_ColumnsOne";
    NopHtml.AddTitleParts(!string.IsNullOrEmpty(Model.MetaTitle) ? Model.MetaTitle : Model.Name);
    NopHtml.AddMetaDescriptionParts(Model.MetaDescription);
    NopHtml.AddMetaKeywordParts(Model.MetaKeywords);
    NopHtml.AppendPageCssClassParts("html-job-details-page");
}

@section Breadcrumb
{
    @await Html.PartialAsync("~/Views/Product/_ProductBreadcrumb.cshtml", Model.Breadcrumb)
}

<div class="page product-details-page job-details-page">
    <div class="page-title">
        <h1>@Model.Name</h1>
    </div>
    <div class="page-body">
        @if (Model.ShowVendor && !string.IsNullOrWhiteSpace(Model.VendorModel?.Name))
        {
            <div class="job-employer">
                <strong>@T("Products.Vendor"):</strong> @Model.VendorModel.Name
            </div>
        }

        @if (Model.ShowSku && !string.IsNullOrWhiteSpace(Model.Sku))
        {
            <div class="job-reference">
                <strong>@T("Products.Sku"):</strong> @Model.Sku
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ShortDescription))
        {
            <div class="short-description">@Html.Raw(Model.ShortDescription)</div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.FullDescription))
        {
            <div class="full-description">@Html.Raw(Model.FullDescription)</div>
        }

        @await Component.InvokeAsync(typeof(WidgetViewComponent), new
        {
            widgetZone = PublicWidgetZones.ProductDetailsBeforeCollateral,
            additionalData = Model
        })
    </div>
</div>
