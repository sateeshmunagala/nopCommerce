@model Nop.Web.Models.Customer.CustomerNavigationModel

<li class="customer-appointment-services @(Model.SelectedTab == AppointmentBookingDefaults.AccountServicesTabId ? "active" : "inactive")">
    <a href="@Url.RouteUrl(AppointmentBookingDefaults.AccountServicesRouteName)">Services</a>
</li>
<li class="customer-appointment-calendar @(Model.SelectedTab == AppointmentBookingDefaults.AccountAvailabilityTabId ? "active" : "inactive")">
    <a href="@Url.RouteUrl(AppointmentBookingDefaults.AccountAvailabilityRouteName)">Availability / Calendar</a>
</li>
<li class="customer-appointment-bookings @(Model.SelectedTab == AppointmentBookingDefaults.AccountBookingsTabId ? "active" : "inactive")">
    <a href="@Url.RouteUrl(AppointmentBookingDefaults.AccountBookingsRouteName)">Bookings</a>
</li>
