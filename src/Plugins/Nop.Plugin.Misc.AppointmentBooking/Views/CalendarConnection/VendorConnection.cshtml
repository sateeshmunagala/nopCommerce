@model CalendarConnectionModel

@{
    NopHtml.AddCssFileParts(@"~/Plugins/Misc.AppointmentBooking/Content/appointment-booking.css", null);
}

<section class="vendor-calendar-connection">
    <h2>Calendar connection</h2>
    <div class="vendor-calendar-connection__body">
        <p>@Model.StatusMessage</p>
        <div class="vendor-calendar-connection__actions">
            @if (Model.IsConnected)
            {
                <a class="button-1" href="@Model.ConnectUrl">Reconnect calendar</a>
                <a class="button-2" href="@Model.DisconnectUrl">Disconnect calendar</a>
            }
            else
            {
                <a class="button-1" href="@Model.ConnectUrl">Connect calendar</a>
            }
        </div>
    </div>
</section>
