@model ServiceAdminModel

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = Model.Id > 0 ? "Edit appointment service" : "Add appointment service";
    NopHtml.SetActiveMenuItemSystemName(AppointmentBookingDefaults.ServicesAdminMenuSystemName);
}

<form asp-controller="AppointmentBooking" asp-action="EditService" asp-area="Admin" method="post">
    <input asp-for="Id" type="hidden" />
    <div class="content-header clearfix">
        <h1 class="float-left">@ViewBag.PageTitle</h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-save"></i>
                Save
            </button>
        </div>
    </div>
    <section class="content">
        <div class="container-fluid">
            <div class="card card-default">
                <div class="card-body">
                    <div class="form-group row">
                        <div class="col-md-3"><label asp-for="Name"></label></div>
                        <div class="col-md-9"><input asp-for="Name" class="form-control" /></div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3"><label asp-for="Description"></label></div>
                        <div class="col-md-9"><textarea asp-for="Description" class="form-control"></textarea></div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3"><label asp-for="VendorId"></label></div>
                        <div class="col-md-9"><input asp-for="VendorId" class="form-control" /></div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3"><label asp-for="MappedProductId"></label></div>
                        <div class="col-md-9"><input asp-for="MappedProductId" class="form-control" /></div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3"><label asp-for="DurationMinutes"></label></div>
                        <div class="col-md-9"><input asp-for="DurationMinutes" class="form-control" /></div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3"><label asp-for="BufferBeforeMinutes"></label></div>
                        <div class="col-md-9"><input asp-for="BufferBeforeMinutes" class="form-control" /></div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3"><label asp-for="BufferAfterMinutes"></label></div>
                        <div class="col-md-9"><input asp-for="BufferAfterMinutes" class="form-control" /></div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3"><label asp-for="MinAdvanceBookingHours"></label></div>
                        <div class="col-md-9"><input asp-for="MinAdvanceBookingHours" class="form-control" /></div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3"><label asp-for="MaxAdvanceBookingDays"></label></div>
                        <div class="col-md-9"><input asp-for="MaxAdvanceBookingDays" class="form-control" /></div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3"><label asp-for="DisplayOrder"></label></div>
                        <div class="col-md-9"><input asp-for="DisplayOrder" class="form-control" /></div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3"><label asp-for="IsActive"></label></div>
                        <div class="col-md-9"><input asp-for="IsActive" /></div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
