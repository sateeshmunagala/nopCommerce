@model BookingAdminModel

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = "Appointment booking details";
    NopHtml.SetActiveMenuItemSystemName(AppointmentBookingDefaults.BookingsAdminMenuSystemName);
}

<div class="content-header clearfix">
    <h1 class="float-left">Appointment booking #@Model.Id</h1>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card card-default">
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9">@Model.Status</dd>
                    <dt class="col-sm-3">Service</dt>
                    <dd class="col-sm-9">@Model.ServiceName</dd>
                    <dt class="col-sm-3">Product</dt>
                    <dd class="col-sm-9">@Model.ProductName</dd>
                    <dt class="col-sm-3">Vendor</dt>
                    <dd class="col-sm-9">@Model.VendorName</dd>
                    <dt class="col-sm-3">Customer</dt>
                    <dd class="col-sm-9">@Model.CustomerDisplayName</dd>
                    <dt class="col-sm-3">Order</dt>
                    <dd class="col-sm-9">@Model.OrderDisplayText</dd>
                    <dt class="col-sm-3">Order item</dt>
                    <dd class="col-sm-9">@Model.OrderItemDisplayText</dd>
                    <dt class="col-sm-3">Start</dt>
                    <dd class="col-sm-9">@Model.StartText</dd>
                    <dt class="col-sm-3">End</dt>
                    <dd class="col-sm-9">@Model.EndText</dd>
                    <dt class="col-sm-3">Attendee</dt>
                    <dd class="col-sm-9">@Model.AttendeeName @Model.AttendeeEmail @Model.AttendeePhone</dd>
                    <dt class="col-sm-3">Notes</dt>
                    <dd class="col-sm-9">@Model.AttendeeNotes</dd>
                    <dt class="col-sm-3">Cancellation</dt>
                    <dd class="col-sm-9">@Model.CancellationReason</dd>
                </dl>
            </div>
        </div>
    </div>
</section>
