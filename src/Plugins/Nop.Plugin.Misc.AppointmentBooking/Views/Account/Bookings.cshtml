@model VendorBookingTabModel

@{
    Layout = "_ColumnsTwo";

    NopHtml.AddTitleParts("Bookings");
    NopHtml.AddTitleParts(T("PageTitle.Account").Text);
    NopHtml.AddCssFileParts(@"~/Plugins/Misc.AppointmentBooking/Content/vendor-services.css", null);
    NopHtml.AddScriptParts(ResourceLocation.Footer, @"~/lib_npm/htmx.org/dist/htmx.min.js");
    NopHtml.AddScriptParts(ResourceLocation.Footer, @"~/Plugins/Misc.AppointmentBooking/Content/vendor-services.js");
    NopHtml.AppendPageCssClassParts("html-account-page");
    NopHtml.AppendPageCssClassParts("html-appointment-bookings-page");

    var upcomingUrl = Url.RouteUrl(AppointmentBookingDefaults.AccountBookingsTabRouteName, new { tab = "upcoming" });
    var completedUrl = Url.RouteUrl(AppointmentBookingDefaults.AccountBookingsTabRouteName, new { tab = "completed" });
}

@section left
{
    @await Component.InvokeAsync(typeof(CustomerNavigationViewComponent), new { selectedTabId = AppointmentBookingDefaults.AccountBookingsTabId })
}

<div class="page account-page appointment-bookings-page">
    <div class="appointment-account-header">
        <div>
            <h1>Bookings</h1>
            <span class="service-chip">1:1 Call</span>
        </div>
        <a class="button-2" href="@Url.RouteUrl(AppointmentBookingDefaults.AccountServicesRouteName)">Services</a>
    </div>

    <div class="page-body">
        <nav class="appointment-booking-tabs" aria-label="Booking sections">
            <button type="button"
                    class="appointment-booking-tab active"
                    data-appointment-booking-tab="upcoming"
                    hx-get="@upcomingUrl"
                    hx-target="#appointment-bookings-panel"
                    hx-swap="innerHTML">
                Upcoming
            </button>
            <button type="button"
                    class="appointment-booking-tab"
                    data-appointment-booking-tab="completed"
                    hx-get="@completedUrl"
                    hx-target="#appointment-bookings-panel"
                    hx-swap="innerHTML">
                Completed
            </button>
        </nav>

        <section id="appointment-bookings-panel"
                 class="appointment-bookings-panel"
                 hx-get="@upcomingUrl"
                 hx-trigger="load"
                 hx-swap="innerHTML"
                 aria-live="polite">
        </section>
    </div>
</div>
