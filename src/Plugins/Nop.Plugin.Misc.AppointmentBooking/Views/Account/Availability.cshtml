@model AvailabilityModel

@{
    Layout = "_ColumnsTwo";

    NopHtml.AddTitleParts("Calendar");
    NopHtml.AddTitleParts(T("PageTitle.Account").Text);
    NopHtml.AddCssFileParts(@"~/Plugins/Misc.AppointmentBooking/Content/vendor-services.css", null);
    NopHtml.AddScriptParts(ResourceLocation.Footer, @"~/Plugins/Misc.AppointmentBooking/Content/vendor-services.js");
    NopHtml.AppendPageCssClassParts("html-account-page");
    NopHtml.AppendPageCssClassParts("html-appointment-availability-page");
}

@section left
{
    @await Component.InvokeAsync(typeof(CustomerNavigationViewComponent), new { selectedTabId = AppointmentBookingDefaults.AccountAvailabilityTabId })
}

<div class="page account-page appointment-availability-page">
    <div class="appointment-account-header">
        <div>
            <h1>Calendar</h1>
            <span class="service-chip">@Model.ActiveServiceCount active service@(Model.ActiveServiceCount == 1 ? "" : "s")</span>
        </div>
        <button type="button" class="button-1 appointment-primary-action" data-appointment-modal-open="unavailable-dates-modal">Add unavailable dates</button>
    </div>

    <div class="appointment-calendar-tabs" aria-label="Calendar sections">
        <a href="#calendar-settings">Settings</a>
        <a href="#calendar-schedule">Schedule</a>
    </div>

    <div class="page-body appointment-calendar-layout">
        <section class="fieldset appointment-calendar-panel" id="calendar-settings">
            <h2 class="title">Settings</h2>
            <p class="appointment-muted">Your schedule applies to all active appointment services.</p>

            <h3 class="appointment-section-title">Unavailable dates</h3>
            @if (!Model.BlockedDates.Any())
            {
                <div class="no-data">No unavailable dates added.</div>
            }
            else
            {
                <div class="appointment-table-wrap">
                    <table class="appointment-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Reason</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.BlockedDates)
                            {
                                <tr>
                                    <td>@item.DateText</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Reason) ? "-" : item.Reason)</td>
                                    <td class="text-right">
                                        <form asp-route="@AppointmentBookingDefaults.AccountAvailabilityDeleteBlockedDateRouteName" method="post">
                                            <input type="hidden" name="blockedDate" value="@item.Date.ToString("yyyy-MM-dd")" />
                                            <button type="submit" class="button-2">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="fieldset appointment-calendar-panel" id="calendar-schedule">
            <form asp-route="@AppointmentBookingDefaults.AccountAvailabilitySaveScheduleRouteName" method="post">
                <input asp-for="VendorId" type="hidden" />
                <div class="appointment-schedule-header">
                    <div>
                        <h2 class="title">Default</h2>
                        <div class="inputs appointment-timezone-input">
                            <label asp-for="TimeZoneId" asp-postfix=":"></label>
                            <select asp-for="TimeZoneId" asp-items="Model.AvailableTimeZones"></select>
                        </div>
                    </div>
                    <button type="submit" class="button-1 appointment-schedule-save">Save</button>
                </div>
                <div asp-validation-summary="ModelOnly" class="message-error appointment-schedule-validation"></div>
                <div class="message-error appointment-schedule-client-validation" data-schedule-client-validation hidden></div>
                <div class="appointment-schedule-list">
                    @for (var i = 0; i < Model.Schedule.Count; i++)
                    {
                        var dayName = Enum.GetName(typeof(DayOfWeek), Model.Schedule[i].DayOfWeek);
                        <div class="appointment-schedule-row @(Model.Schedule[i].Enabled ? "enabled" : "disabled")" data-schedule-day-row data-schedule-day-index="@i">
                            <input asp-for="Schedule[i].DayOfWeek" type="hidden" />
                            <label class="appointment-schedule-day" for="Schedule_@(i)__Enabled">
                                <input asp-for="Schedule[i].Enabled" data-schedule-day-toggle />
                                <span>@Enum.GetName(typeof(DayOfWeek), Model.Schedule[i].DayOfWeek)</span>
                            </label>
                            <span class="appointment-schedule-unavailable">Unavailable</span>
                            <div class="appointment-schedule-intervals" data-schedule-intervals>
                                @for (var j = 0; j < Model.Schedule[i].Intervals.Count; j++)
                                {
                                    <div class="appointment-schedule-interval" data-schedule-interval>
                                        <select asp-for="Schedule[i].Intervals[j].StartTime" asp-items="Model.TimeOptions" data-schedule-start disabled="@(!Model.Schedule[i].Enabled ? "disabled" : null)"></select>
                                        <span class="appointment-schedule-separator">-</span>
                                        <select asp-for="Schedule[i].Intervals[j].EndTime" asp-items="Model.TimeOptions" data-schedule-end disabled="@(!Model.Schedule[i].Enabled ? "disabled" : null)"></select>
                                        <button type="button" class="appointment-schedule-apply" data-schedule-apply-all>Apply To All</button>
                                        <button type="button" class="icon-button appointment-schedule-remove" data-schedule-remove-interval aria-label="Remove @dayName time slot" title="Remove time slot">x</button>
                                    </div>
                                }
                            </div>
                            <button type="button" class="icon-button appointment-schedule-add" data-schedule-add-interval aria-label="Add @dayName time slot" title="Add time slot">+</button>
                        </div>
                    }
                </div>
            </form>
        </section>
    </div>

    <div class="appointment-modal" id="unavailable-dates-modal" aria-hidden="true">
        <div class="appointment-modal__backdrop" data-appointment-modal-close="true"></div>
        <div class="appointment-modal__panel" role="dialog" aria-modal="true" aria-labelledby="unavailable-dates-title">
            <div class="appointment-modal__header">
                <h2 id="unavailable-dates-title">Select date(s) you are unavailable on</h2>
                <button type="button" class="icon-button" data-appointment-modal-close="true" aria-label="Close">x</button>
            </div>
            <form asp-route="@AppointmentBookingDefaults.AccountAvailabilityBlockDatesRouteName" method="post">
                <input asp-for="VendorId" type="hidden" />
                <input asp-for="UnavailableDateValues" type="hidden" data-unavailable-date-values />
                <div class="inputs">
                    <label>Dates</label>
                    <div class="appointment-date-picker" data-unavailable-date-picker>
                        <div class="appointment-calendar-picker" data-unavailable-calendar></div>
                        <div class="appointment-selected-dates" data-unavailable-selected-dates aria-live="polite"></div>
                    </div>
                </div>
                <div class="inputs">
                    <label asp-for="Reason" asp-postfix=":"></label>
                    <input asp-for="Reason" />
                </div>
                <div class="buttons">
                    <button type="submit" class="button-1">Save unavailable dates</button>
                    <button type="button" class="button-2" data-appointment-modal-close="true">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>
