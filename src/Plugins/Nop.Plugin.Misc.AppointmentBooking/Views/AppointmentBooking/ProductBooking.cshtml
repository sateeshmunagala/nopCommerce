@model ProductAppointmentBookingModel

@{
    NopHtml.AddCssFileParts(@"~/Plugins/Misc.AppointmentBooking/Content/appointment-booking.css", null);
    NopHtml.AddScriptParts(ResourceLocation.Footer, @"~/Plugins/Misc.AppointmentBooking/Content/appointment-booking.js");

    var slotGroups = Model.AvailableSlots
        .GroupBy(slot => slot.DateKey)
        .Select(group => new
        {
            DateKey = group.Key,
            DateText = group.First().DateText,
            DayText = group.First().DayText,
            Slots = group.OrderBy(slot => slot.StartUtc).ToList()
        })
        .OrderBy(group => group.Slots.First().StartUtc)
        .ToList();
    var activeDateKey = slotGroups.FirstOrDefault()?.DateKey;
}

<section class="appointment-booking" data-product-id="@Model.Id">
    <div class="appointment-booking__calendar">
        <div class="appointment-booking__header">
            <h2>When should we meet?</h2>
        </div>
        @if (slotGroups.Any())
        {
            <form asp-route="Nop.Plugin.Misc.AppointmentBooking.HoldSlot" asp-route-productId="@Model.Id" method="post" data-appointment-booking-form>
                @Html.AntiForgeryToken()
                <input type="hidden" name="serviceId" value="@Model.ServiceId" />
                <div class="message-error appointment-booking__validation" data-appointment-validation-message tabindex="-1" hidden>Select an appointment time.</div>

                <div class="appointment-booking__selector">
                    <div class="appointment-booking__label">Date</div>
                    <div class="appointment-booking__date-strip" role="tablist" aria-label="Available dates">
                        @foreach (var group in slotGroups)
                        {
                            var isActive = string.Equals(group.DateKey, activeDateKey, StringComparison.Ordinal);
                            <button type="button"
                                    class="appointment-booking__date-card @(isActive ? "active" : null)"
                                    data-appointment-date="@group.DateKey"
                                    role="tab"
                                    aria-selected="@isActive.ToString().ToLowerInvariant()"
                                    aria-controls="appointment-times-@group.DateKey">
                                <span>@group.DayText</span>
                                <strong>@group.DateText</strong>
                            </button>
                        }
                    </div>
                </div>

                <div class="appointment-booking__selector">
                    <div class="appointment-booking__label">Time</div>
                    <div class="appointment-booking__time-groups">
                        @foreach (var group in slotGroups)
                        {
                            var isActive = string.Equals(group.DateKey, activeDateKey, StringComparison.Ordinal);
                            <div class="appointment-booking__time-group @(isActive ? "active" : null)"
                                 id="appointment-times-@group.DateKey"
                                 data-appointment-time-group="@group.DateKey"
                                 role="tabpanel">
                                <div class="appointment-booking__time-strip">
                                    @foreach (var slot in group.Slots)
                                    {
                                        <label class="appointment-booking__time-slot">
                                            <input type="radio" name="startUtc" value="@slot.StartUtc.ToString("O")" required />
                                            <span>@slot.TimeText</span>
                                        </label>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="appointment-booking__timezone">
                    <span>Timezone</span>
                    <strong data-appointment-timezone>Local time</strong>
                </div>

                @if (Model.Questions.Any())
                {
                    <div class="appointment-booking__questions">
                        @foreach (var question in Model.Questions)
                        {
                            <label class="appointment-booking__question">
                                <span>@question.QuestionText</span>
                                <input type="text" name="answers[@question.Id]" @(question.IsRequired ? "required" : "") />
                            </label>
                        }
                    </div>
                }
                <button type="submit" class="button-1 appointment-booking__link">Continue</button>
            </form>
        }
        else
        {
            <p class="appointment-booking__placeholder">
                No appointment slots are available for this service right now.
            </p>
        }
    </div>
</section>
