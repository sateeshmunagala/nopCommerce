@model ProductAppointmentBookingModel

@{
    NopHtml.AddCssFileParts(@"~/Plugins/Misc.AppointmentBooking/Content/appointment-booking.css", null);
    NopHtml.AddScriptParts(ResourceLocation.Footer, @"~/Plugins/Misc.AppointmentBooking/Content/appointment-booking.js");
}

<section class="appointment-booking" data-product-id="@Model.Id">
    <div class="appointment-booking__summary">
        <h2>Book appointment</h2>
        <h3>@(!string.IsNullOrWhiteSpace(Model.ServiceName) ? Model.ServiceName : Model.ProductName)</h3>
        @if (!string.IsNullOrWhiteSpace(Model.ServiceDescription))
        {
            <div class="appointment-booking__description">@Html.Raw(Model.ServiceDescription)</div>
        }
        else if (!string.IsNullOrWhiteSpace(Model.ShortDescription))
        {
            <div class="appointment-booking__description">@Html.Raw(Model.ShortDescription)</div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Price))
        {
            <div class="appointment-booking__price">@Model.Price</div>
        }
    </div>
    <div class="appointment-booking__calendar">
        <div class="appointment-booking__header">
            <span>Choose a time</span>
            @if (Model.DefaultDurationMinutes > 0)
            {
                <small>@Model.DefaultDurationMinutes minutes</small>
            }
        </div>
        @if (Model.AvailableSlots.Any())
        {
            <form asp-controller="AppointmentBooking" asp-action="HoldSlot" asp-route-productId="@Model.Id" method="post">
                <input type="hidden" name="serviceId" value="@Model.ServiceId" />
                <div class="appointment-booking__slots">
                    @foreach (var slot in Model.AvailableSlots)
                    {
                        <label class="appointment-booking__slot" data-date-key="@slot.DateKey">
                            <input type="radio" name="startUtc" value="@slot.StartUtc.ToString("O")" required />
                            <span class="appointment-booking__slot-date">
                                <strong>@slot.DayText</strong>
                                @slot.DateText
                            </span>
                            <span class="appointment-booking__slot-time">@slot.TimeText</span>
                        </label>
                    }
                </div>
                @if (Model.Questions.Any())
                {
                    <div class="appointment-booking__questions">
                        @foreach (var question in Model.Questions)
                        {
                            <label class="appointment-booking__question">
                                <span>@question.QuestionText</span>
                                <input type="text" name="answers[@question.Id]" @(question.IsRequired ? "required" : "") />
                            </label>
                        }
                    </div>
                }
                <button type="submit" class="button-1 appointment-booking__link">Continue to checkout</button>
            </form>
        }
        else
        {
            <p class="appointment-booking__placeholder">
                No appointment slots are available for this service right now.
            </p>
        }
    </div>
</section>
