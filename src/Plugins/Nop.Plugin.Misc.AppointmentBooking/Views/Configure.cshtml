@model ConfigurationModel

@{
    Layout = "_ConfigurePlugin";
}

<form asp-controller="AppointmentBooking" asp-action="Configure" method="post">
    <section class="content">
        <div class="container-fluid">
            <div class="card card-default">
                <div class="card-body">
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="Enabled" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="Enabled" />
                            <span asp-validation-for="Enabled"></span>
                        </div>
                    </div>
                    <nop-nested-setting asp-for="Enabled">
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="DefaultBookingUrl" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="DefaultBookingUrl" />
                                <span asp-validation-for="DefaultBookingUrl"></span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="DefaultDurationMinutes" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="DefaultDurationMinutes" />
                                <span asp-validation-for="DefaultDurationMinutes"></span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="AllowCalendarIframe" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="AllowCalendarIframe" />
                                <span asp-validation-for="AllowCalendarIframe"></span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="CalendarProvider" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="CalendarProvider" />
                                <span asp-validation-for="CalendarProvider"></span>
                            </div>
                        </div>
                    </nop-nested-setting>
                    <div class="form-group row">
                        <div class="col-md-9 offset-md-3">
                            <input type="submit" name="save" class="btn btn-primary" value="@T("Admin.Common.Save")" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
