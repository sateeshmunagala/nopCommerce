@model Nop.Plugin.Misc.AppointmentBooking.Models.AppointmentBookingProductCardModel

@using Nop.Core.Domain.Catalog

@{
    NopHtml.AddCssFileParts(@"~/Plugins/Misc.AppointmentBooking/Content/appointment-booking.css", null);
}

<article class="product-item appointment-product-card" data-productid="@Model.Id">
    <div class="picture">
        <a href="@(await NopUrl.RouteGenericUrlAsync<Product>(new { SeName = Model.SeName }))" title="@Model.Picture?.Title">
            <img alt="@Model.Picture?.AlternateText" src="@Model.Picture?.ImageUrl" title="@Model.Picture?.Title" />
        </a>
    </div>
    <div class="details">
        <h2 class="product-title">
            <a href="@(await NopUrl.RouteGenericUrlAsync<Product>(new { SeName = Model.SeName }))">@Model.ProductName</a>
        </h2>
        @if (!string.IsNullOrWhiteSpace(Model.ShortDescription))
        {
            <div class="description">@Html.Raw(Model.ShortDescription)</div>
        }
        <div class="add-info">
            @if (!string.IsNullOrWhiteSpace(Model.Price))
            {
                <div class="prices">
                    <span class="price actual-price">@Model.Price</span>
                </div>
            }
            <div class="buttons">
                <a class="appointment-product-card__action" href="@(await NopUrl.RouteGenericUrlAsync<Product>(new { SeName = Model.SeName }))">View</a>
            </div>
        </div>
    </div>
</article>
