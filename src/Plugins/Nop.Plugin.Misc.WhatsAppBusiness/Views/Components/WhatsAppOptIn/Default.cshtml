@model SplatDev.Nop.Plugin.Misc.WhatsAppBusiness.Models.OptInModel

<div id="whatsapp-optin" class="whatsapp-optin-widget" style="margin: 24px 0; padding: 20px 24px; background: #f0faf0; border: 1px solid #25D366; border-radius: 8px; font-family: inherit;">
    @if (Model.IsOptedIn)
    {
        <div class="whatsapp-optin-success" style="display: flex; align-items: center; gap: 12px;">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="#25D366" style="flex-shrink: 0;">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                <path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.832-1.438A9.955 9.955 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18a8 8 0 01-4.29-1.24l-.28-.17-3.05.8.82-2.98-.18-.29A8 8 0 1112 20z"/>
            </svg>
            <div>
                <strong style="color: #075E54;">WhatsApp notifications enabled</strong>
                <p style="margin: 4px 0 0; color: #555; font-size: 0.9em;">
                    You will receive order updates for <strong>#@Model.OrderNumber</strong> on your WhatsApp.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="whatsapp-optin-prompt">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="#25D366" style="flex-shrink: 0;">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                    <path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.832-1.438A9.955 9.955 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18a8 8 0 01-4.29-1.24l-.28-.17-3.05.8.82-2.98-.18-.29A8 8 0 1112 20z"/>
                </svg>
                <div>
                    <strong style="color: #075E54;">Receive order updates on WhatsApp</strong>
                    <p style="margin: 4px 0 0; color: #555; font-size: 0.9em;">
                        Get real-time notifications about order <strong>#@Model.OrderNumber</strong> — status changes, shipping, and delivery.
                    </p>
                </div>
            </div>

            <form id="whatsapp-optin-form" style="display: flex; gap: 8px; align-items: flex-end; flex-wrap: wrap;">
                <input type="hidden" name="orderId" value="@Model.OrderId" />
                <div style="flex: 1; min-width: 180px;">
                    <label for="whatsapp-phone" style="font-size: 0.85em; color: #666; display: block; margin-bottom: 4px;">WhatsApp number</label>
                    <input type="tel" id="whatsapp-phone" name="phone" value="@Model.CustomerPhone"
                           placeholder="+55 11 99999-9999"
                           required
                           style="width: 100%; padding: 8px 12px; border: 1px solid #ccc; border-radius: 6px; font-size: 1em;" />
                </div>
                <button type="submit" id="whatsapp-optin-btn"
                        style="padding: 8px 20px; background: #25D366; color: #fff; border: none; border-radius: 6px; font-size: 1em; cursor: pointer; white-space: nowrap; font-weight: 600;">
                    Enable notifications
                </button>
            </form>
            <p style="margin: 8px 0 0; font-size: 0.8em; color: #888;">
                You can opt out at any time from the order details page.
            </p>
        </div>
    }
</div>

@if (!Model.IsOptedIn)
{
    <script asp-location="Footer">
        document.addEventListener('DOMContentLoaded', function () {
            var form = document.getElementById('whatsapp-optin-form');
            if (!form) return;

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                var btn = document.getElementById('whatsapp-optin-btn');
                var phone = document.getElementById('whatsapp-phone').value.trim();
                if (!phone) return;

                btn.disabled = true;
                btn.textContent = 'Enabling...';

                var fd = new FormData();
                fd.append('orderId', '@Model.OrderId');
                fd.append('phone', phone);

                fetch('/WhatsApp/OptIn', { method: 'POST', body: fd })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (data.success) {
                            var widget = document.getElementById('whatsapp-optin');
                            widget.innerHTML =
                                '<div style="display:flex;align-items:center;gap:12px;">' +
                                '<svg width="28" height="28" viewBox="0 0 24 24" fill="#25D366"><circle cx="12" cy="12" r="10" fill="#25D366"/><path d="M9 12l2 2 4-4" stroke="#fff" stroke-width="2" fill="none"/></svg>' +
                                '<div><strong style="color:#075E54;">WhatsApp notifications enabled</strong>' +
                                '<p style="margin:4px 0 0;color:#555;font-size:0.9em;">You will receive updates for order <strong>#@Model.OrderNumber</strong>.</p></div></div>';
                        } else {
                            btn.disabled = false;
                            btn.textContent = 'Enable notifications';
                            alert('Could not enable notifications. Please try again.');
                        }
                    })
                    .catch(function () {
                        btn.disabled = false;
                        btn.textContent = 'Enable notifications';
                    });
            });
        });
    </script>
}
