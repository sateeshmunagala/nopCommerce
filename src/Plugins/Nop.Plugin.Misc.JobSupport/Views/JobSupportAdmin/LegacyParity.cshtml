@model LegacyParityRequestModel
@{
    Layout = "_ConfigurePlugin";
    ViewBag.PageTitle = T("Plugins.Misc.JobSupport.Admin.LegacyParity.Title").Text;
    const string prefix = "Plugins.Misc.JobSupport.Admin.LegacyParity";
}

<style>
    .job-support-admin .js-form-grid { display: grid; grid-template-columns: 1fr; gap: 12px; }
    .job-support-admin .js-result-table { width: 100%; table-layout: fixed; word-break: break-word; }
    .job-support-admin .js-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .job-support-admin .js-warning { word-break: break-word; }
    .job-support-admin .js-submit { min-height: 44px; width: 100%; }
    .job-support-admin .js-badge { display: inline-block; padding: 3px 8px; border-radius: 10px; font-weight: 600; }
    .job-support-admin .js-badge-present { background: #d4edda; color: #155724; }
    .job-support-admin .js-badge-missing { background: #f8d7da; color: #721c24; }
    @@media (min-width: 768px) {
        .job-support-admin .js-form-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .job-support-admin .js-submit { width: auto; }
    }
    @@media (min-width: 1200px) {
        .job-support-admin .js-form-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    }
</style>

<div class="job-support job-support-admin">
    <form asp-controller="JobSupportAdmin" asp-action="LegacyParity" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="cards-group">
            <div class="card card-default">
                <div class="card-header">
                    @T($"{prefix}.Title")
                </div>
                <div class="card-body">
                    <p>@T($"{prefix}.Description")</p>
                    <div class="js-form-grid">
                        <div class="form-group">
                            <nop-label asp-for="QueryType" />
                            <select asp-for="QueryType" class="form-control">
                                <option value="@((int)LegacyParityQueryType.ProfileSearch)">@T($"{prefix}.QueryTypes.ProfileSearch")</option>
                                <option value="@((int)LegacyParityQueryType.Relationship)">@T($"{prefix}.QueryTypes.Relationship")</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <nop-label asp-for="ProductIdentifiers" />
                            <input asp-for="ProductIdentifiers" class="form-control" />
                            <span asp-validation-for="ProductIdentifiers" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <nop-label asp-for="CustomerId" />
                            <input asp-for="CustomerId" class="form-control" />
                        </div>
                        <div class="form-group">
                            <nop-label asp-for="ProfileTypeId" />
                            <input asp-for="ProfileTypeId" class="form-control" />
                        </div>
                        <div class="form-group">
                            <nop-label asp-for="RelationshipType" />
                            <select asp-for="RelationshipType" class="form-control">
                                @foreach (var relationshipType in Enum.GetValues<RelationshipType>())
                                {
                                    <option value="@((int)relationshipType)">@T($"{prefix}.RelationshipTypes.{relationshipType}")</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <nop-label asp-for="PageIndex" />
                            <input asp-for="PageIndex" class="form-control" />
                        </div>
                        <div class="form-group">
                            <nop-label asp-for="PageSize" />
                            <input asp-for="PageSize" class="form-control" />
                        </div>
                        <div class="form-group">
                            <nop-label asp-for="SortOrder" />
                            <input asp-for="SortOrder" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary js-submit">
                        @T($"{prefix}.Run")
                    </button>
                </div>
            </div>

            @if (Model.Result != null)
            {
                var diagnostic = Model.Result.Diagnostic;
                <div class="card card-default">
                    <div class="card-header">@T($"{prefix}.Results")</div>
                    <div class="card-body">
                        <div class="js-scroll">
                            <table class="table table-bordered table-striped js-result-table">
                                <thead>
                                    <tr>
                                        <th>@T($"{prefix}.Result.Metric")</th>
                                        <th>@T($"{prefix}.Result.Value")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr><td>@T($"{prefix}.Result.ProcedureName")</td><td>@diagnostic.ProcedureName</td></tr>
                                    <tr><td>@T($"{prefix}.Result.Success")</td><td>@T($"{prefix}.Status.{(diagnostic.Succeeded ? "Succeeded" : "Failed")}")</td></tr>
                                    <tr><td>@T($"{prefix}.Result.ReturnedRows")</td><td>@diagnostic.ReturnedRowCount</td></tr>
                                    <tr><td>@T($"{prefix}.Result.OutputTotal")</td><td>@(diagnostic.OutputTotalRecords?.ToString() ?? T($"{prefix}.NotAvailable").Text)</td></tr>
                                    <tr><td>@T($"{prefix}.Result.DurationMilliseconds")</td><td>@diagnostic.DurationMilliseconds</td></tr>
                                    <tr><td>@T($"{prefix}.Result.ProfileIds")</td><td>@(diagnostic.ProfileIds.Any() ? string.Join(", ", diagnostic.ProfileIds) : T($"{prefix}.None").Text)</td></tr>
                                    <tr><td>@T($"{prefix}.Result.ErrorCode")</td><td>@T($"{prefix}.ErrorCodes.{diagnostic.ErrorCode}")</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="card card-default">
                    <div class="card-header">@T($"{prefix}.Result.MappingWarnings")</div>
                    <div class="card-body">
                        <div class="js-scroll">
                            <table class="table table-bordered table-striped js-result-table">
                                <thead>
                                    <tr><th>@T($"{prefix}.Result.Warning")</th></tr>
                                </thead>
                                <tbody>
                                    @if (diagnostic.MappingWarnings.Any())
                                    {
                                        foreach (var warning in diagnostic.MappingWarnings)
                                        {
                                            <tr><td class="js-warning">@warning</td></tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr><td>@T($"{prefix}.None")</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="card card-default">
                    <div class="card-header">@T($"{prefix}.Result.ContactPresence")</div>
                    <div class="card-body">
                        <div class="js-scroll">
                            <table class="table table-bordered table-striped js-result-table">
                                <thead>
                                    <tr>
                                        <th>@T($"{prefix}.Result.ProfileId")</th>
                                        <th>@T($"{prefix}.Result.Phone")</th>
                                        <th>@T($"{prefix}.Result.Email")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Result.Profiles.Any())
                                    {
                                        foreach (var profile in Model.Result.Profiles)
                                        {
                                            <tr>
                                                <td>@profile.ProfileId</td>
                                                <td><span class="js-badge @(profile.HasPhone ? "js-badge-present" : "js-badge-missing")">@T($"{prefix}.Presence.{(profile.HasPhone ? "Present" : "Missing")}")</span></td>
                                                <td><span class="js-badge @(profile.HasEmail ? "js-badge-present" : "js-badge-missing")">@T($"{prefix}.Presence.{(profile.HasEmail ? "Present" : "Missing")}")</span></td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr><td colspan="3">@T($"{prefix}.None")</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    </form>
</div>
