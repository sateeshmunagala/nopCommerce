            <div><label asp-for="OneYearSubscriptionProductId">@T($"{prefix}.OneYearSubscriptionProductId")</label><nop-editor asp-for="OneYearSubscriptionProductId" /></div>
            <div><label asp-for="ThreeMonthSubscriptionAllottedCount">@T($"{prefix}.ThreeMonthSubscriptionAllottedCount")</label><nop-editor asp-for="ThreeMonthSubscriptionAllottedCount" /></div>
            <div><label asp-for="SixMonthSubscriptionAllottedCount">@T($"{prefix}.SixMonthSubscriptionAllottedCount")</label><nop-editor asp-for="SixMonthSubscriptionAllottedCount" /></div>
