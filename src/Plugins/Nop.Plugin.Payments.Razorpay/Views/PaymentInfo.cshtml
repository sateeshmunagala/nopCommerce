@model Nop.Plugin.Payments.Razorpay.Models.PaymentInfoModel

<div class="razorpay-payment-info" id="razorpay-payment-info-container">
    <div class="spc-payment-selection" aria-live="polite">
        <span class="spc-payment-selection-label">@T("Plugins.Payments.Razorpay.PaymentInfo.MethodLabel")</span>
        <strong class="spc-payment-selection-name">@T("Plugins.Payments.Razorpay.PaymentInfo.MethodName")</strong>
    </div>
    <p id="razorpay-instruction-message">@T("Plugins.Payments.Razorpay.PaymentInfo.Instructions")</p>
    <button type="button" id="razorpay-pay-button" class="button-1 razorpay-plugin-button spc-razorpay-btn">@T("Plugins.Payments.Razorpay.PaymentInfo.PayButton")</button>

    <input type="hidden" id="RazorpayOrderId" name="RazorpayOrderId" value="" />
    <input type="hidden" id="RazorpayPaymentId" name="RazorpayPaymentId" value="" />
    <input type="hidden" id="RazorpaySignature" name="RazorpaySignature" value="" />

    <div id="razorpay-error-message" class="spc-razorpay-error" style="display: none;"></div>
    <div id="razorpay-success-message" class="spc-razorpay-success" style="display: none;">@T("Plugins.Payments.Razorpay.PaymentInfo.Success")</div>
    <div id="razorpay-pending-message" class="spc-razorpay-pending" style="display: none;">@T("Plugins.Payments.Razorpay.PaymentInfo.PleaseCompletePayment")</div>
</div>

<script>
    (function () {
        var payButton = document.getElementById('razorpay-pay-button');
        var errorContainer = document.getElementById('razorpay-error-message');
        var successContainer = document.getElementById('razorpay-success-message');
        var pendingMessage = document.getElementById('razorpay-pending-message');

        var isPaymentVerified = false;
        var paymentInfoDiagnosticState = window.razorpayPaymentInfoDiagnosticState;
        if (!paymentInfoDiagnosticState) {
            paymentInfoDiagnosticState = {
                paymentInfoSaveRequestPending: false,
                observedPaymentInfoRequests: new WeakSet(),
                observerInstalled: false
            };
            window.razorpayPaymentInfoDiagnosticState = paymentInfoDiagnosticState;
        }

        if (typeof $ === 'undefined') {
            logErrorToDiagnosticEndpoint("JQueryMissing", "jQuery is required for Razorpay checkout binding.");
            return;
        }

        // Hide standard checkout next button initially to enforce Razorpay flow
        $('.payment-info-next-step-button').hide();

        // Re-bind the next button to show warning if payment is not verified
        $(document)
            .off('click.razorpayNext', '.payment-info-next-step-button')
            .on('click.razorpayNext', '.payment-info-next-step-button', function (e) {
                if (!isPaymentVerified) {
                    e.preventDefault();
                    e.stopPropagation();
                    pendingMessage.style.display = 'block';
                    errorContainer.style.display = 'none';
                    return false;
                }
            });

        function isPaymentInfoSaveRequest(url) {
            try {
                var requestPath = new URL(url || '', window.location.origin).pathname.toLowerCase().replace(/\/+$/, '');
                return requestPath.endsWith('/opcsavepaymentinfo');
            } catch (error) {
                return false;
            }
        }

        if (!paymentInfoDiagnosticState.observerInstalled) {
            paymentInfoDiagnosticState.observerInstalled = true;
            $(document)
                .on('ajaxSend.razorpayPaymentInfoDiagnostics', function (event, jqXHR, settings) {
                    if (!paymentInfoDiagnosticState.paymentInfoSaveRequestPending || !jqXHR || !isPaymentInfoSaveRequest(settings && settings.url))
                        return;

                    paymentInfoDiagnosticState.paymentInfoSaveRequestPending = false;
                    paymentInfoDiagnosticState.observedPaymentInfoRequests.add(jqXHR);
                })
                .on('ajaxSuccess.razorpayPaymentInfoDiagnostics', function (event, jqXHR, settings, response) {
                    if (!paymentInfoDiagnosticState.observedPaymentInfoRequests.delete(jqXHR))
                        return;

                    if (!response || typeof response !== 'object' || Array.isArray(response)) {
                        logErrorToDiagnosticEndpoint('RazorpayPaymentInfoAjaxUnexpectedResponse', '');
                        return;
                    }

                    if (response.success === false || response.error || (Array.isArray(response.errors) && response.errors.length > 0)) {
                        logErrorToDiagnosticEndpoint('RazorpayPaymentInfoAjaxJsonError', '');
                        return;
                    }

                    var updateSection = response.update_section;
                    var hasConfirmSection = updateSection &&
                        typeof updateSection === 'object' &&
                        updateSection.name === 'confirm-order' &&
                        response.goto_section === 'confirm_order';

                    logErrorToDiagnosticEndpoint(
                        hasConfirmSection
                            ? 'RazorpayPaymentInfoAjaxConfirmSectionSuccess'
                            : 'RazorpayPaymentInfoAjaxUnexpectedResponse',
                        '');
                })
                .on('ajaxError.razorpayPaymentInfoDiagnostics', function (event, jqXHR) {
                    if (!paymentInfoDiagnosticState.observedPaymentInfoRequests.delete(jqXHR))
                        return;

                    logErrorToDiagnosticEndpoint(
                        jqXHR && jqXHR.status >= 200 && jqXHR.status < 300
                            ? 'RazorpayPaymentInfoAjaxUnexpectedResponse'
                            : 'RazorpayPaymentInfoAjaxTransportFailure',
                        '');
                });
        }

        if (!payButton) {
            logErrorToDiagnosticEndpoint("PayButtonMissing", "razorpay-pay-button element not found on page.");
            return;
        }

        function ensureRazorpaySdkLoaded() {
            if (window.Razorpay) {
                return Promise.resolve();
            }

            if (window.razorpaySdkLoadPromise) {
                return window.razorpaySdkLoadPromise;
            }

            window.razorpaySdkLoadPromise = new Promise(function (resolve, reject) {
                var existingScript = document.querySelector('script[src="https://checkout.razorpay.com/v1/checkout.js"]');

                if (existingScript) {
                    if (window.Razorpay) {
                        resolve();
                        return;
                    }

                    existingScript.addEventListener('load', resolve, { once: true });
                    existingScript.addEventListener('error', function () {
                        reject(new Error('RazorpaySDKLoadFailed'));
                    }, { once: true });
                    return;
                }

                var script = document.createElement('script');
                script.src = 'https://checkout.razorpay.com/v1/checkout.js';
                script.async = true;
                script.onload = resolve;
                script.onerror = function () {
                    reject(new Error('RazorpaySDKLoadFailed'));
                };
                document.head.appendChild(script);
            }).catch(function (error) {
                window.razorpaySdkLoadPromise = null;
                throw error;
            });

            return window.razorpaySdkLoadPromise;
        }

        $(document)
            .off('click.razorpay', '#razorpay-pay-button')
            .on('click.razorpay', '#razorpay-pay-button', function (e) {
                e.preventDefault();

                errorContainer.style.display = 'none';
                pendingMessage.style.display = 'none';

                payButton.disabled = true;
                payButton.textContent = '@T("Plugins.Payments.Razorpay.PaymentInfo.Processing").Text';

                ensureRazorpaySdkLoaded().then(function () {
                    var antiforgeryToken = document.querySelector('input[name="__RequestVerificationToken"]');
                    var formData = new FormData();
                    if (antiforgeryToken) {
                        formData.append('__RequestVerificationToken', antiforgeryToken.value);
                    }

                    return fetch('@Url.Action("CreateOrder", "RazorpayPublic")', {
                        method: 'POST',
                        body: formData
                    });
                })
                .then(function(response) {
                    if (!response.ok) {
                        throw new Error('CreateOrder network response was not ok. Status: ' + response.status);
                    }
                    return response.json();
                })
                .then(function(data) {
                    if (data.error) {
                        throw new Error(data.error);
                    }

                    if (!data.keyId || !data.orderId || !data.amount || !data.currency) {
                        logErrorToDiagnosticEndpoint("CreateOrderMissingData", "Missing required fields in CreateOrder response.");
                        throw new Error('Invalid Razorpay order data received.');
                    }

                    var options = {
                        "key": data.keyId,
                        "amount": data.amount,
                        "currency": data.currency,
                        "name": data.name,
                        "description": data.description,
                        "order_id": data.orderId,
                        "prefill": data.prefill,
                        "handler": function (response) {
                            // Payment successful in popup, now verify server-side
                            logErrorToDiagnosticEndpoint('RazorpayPopupSuccessHandlerEntry', '');
                            verifyPayment(response.razorpay_payment_id, response.razorpay_order_id, response.razorpay_signature);
                        },
                        "modal": {
                            "ondismiss": function() {
                                payButton.disabled = false;
                                payButton.textContent = '@T("Plugins.Payments.Razorpay.PaymentInfo.PayButton").Text';
                                logErrorToDiagnosticEndpoint("ModalDismissed", "User dismissed the Razorpay checkout modal.");
                                pendingMessage.style.display = 'block';
                            }
                        }
                    };

                    try {
                        var rzp = new Razorpay(options);
                        rzp.on('payment.failed', function (response) {
                            var failedDesc = response.error ? response.error.description : 'Payment failed.';
                            showError(failedDesc);
                            logErrorToDiagnosticEndpoint(
                                "PaymentFailed",
                                response && response.error && typeof response.error.description === 'string'
                                    ? response.error.description
                                    : '');
                            pendingMessage.style.display = 'block';
                        });
                        rzp.open();
                    } catch (rzpEx) {
                        showError('Failed to open Razorpay checkout window.');
                        logErrorToDiagnosticEndpoint("RazorpayOpenException", rzpEx.message || 'Unknown exception opening modal.');
                    }
                })
                .catch(function(error) {
                    if (error && error.message === 'RazorpaySDKLoadFailed') {
                        showError('Razorpay checkout could not be loaded. Please try again or check your network connection.');
                        logErrorToDiagnosticEndpoint('RazorpaySDKLoadFailed', 'The external Razorpay script failed to load');
                        return;
                    }

                    showError(error.message);
                    logErrorToDiagnosticEndpoint("CreateOrderException", error.message);
                });
            });

        function verifyPayment(paymentId, orderId, signature) {
            var antiforgeryToken = document.querySelector('input[name="__RequestVerificationToken"]');
            var formData = new FormData();
            if (antiforgeryToken) {
                formData.append('__RequestVerificationToken', antiforgeryToken.value);
            }
            formData.append('razorpay_payment_id', paymentId);
            formData.append('razorpay_order_id', orderId);
            formData.append('razorpay_signature', signature);

            fetch('@Url.Action("VerifyPayment", "RazorpayPublic")', {
                method: 'POST',
                body: formData
            })
            .then(function(response) {
                if (!response.ok) {
                    throw new Error('VerifyPayment network response was not ok. Status: ' + response.status);
                }
                return response.json();
            })
            .then(function(data) {
                if (data.success) {
                    logErrorToDiagnosticEndpoint('RazorpayVerifyPaymentResponseSuccess', '');

                    // Save to hidden fields for form submission
                    document.getElementById('RazorpayOrderId').value = orderId;
                    document.getElementById('RazorpayPaymentId').value = paymentId;
                    document.getElementById('RazorpaySignature').value = signature;

                    isPaymentVerified = true;
                    pendingMessage.style.display = 'none';

                    document.getElementById('razorpay-instruction-message').style.display = 'none';
                    payButton.style.display = 'none';
                    successContainer.style.display = 'block';

                    // Trigger the checkout next button so they can proceed reliably
                    if (typeof PaymentInfo !== 'undefined' && PaymentInfo.save) {
                        var checkoutLoadWaitingState = typeof Checkout === 'undefined' || Checkout === null
                            ? 'unknown'
                            : Checkout.loadWaiting === false ? 'false' : 'active';
                        paymentInfoDiagnosticState.paymentInfoSaveRequestPending = true;
                        logErrorToDiagnosticEndpoint(
                            'RazorpayPaymentInfoSaveInvoked',
                            'CheckoutLoadWaitingState=' + checkoutLoadWaitingState);
                        try {
                            PaymentInfo.save();
                        } finally {
                            paymentInfoDiagnosticState.paymentInfoSaveRequestPending = false;
                        }
                    } else {
                        var nextBtn = document.querySelector('.payment-info-next-step-button');
                        if (nextBtn) {
                            // Unbind our blocking handler then click
                            $(document).off('click.razorpayNext', '.payment-info-next-step-button');
                            paymentInfoDiagnosticState.paymentInfoSaveRequestPending = true;
                            try {
                                nextBtn.click();
                            } finally {
                                paymentInfoDiagnosticState.paymentInfoSaveRequestPending = false;
                            }
                        }
                    }
                } else {
                    var errMsg = data.error || 'Payment verification failed.';
                    showError(errMsg);
                    logErrorToDiagnosticEndpoint("VerifyPaymentFailed", errMsg);
                }
            })
            .catch(function(error) {
                showError('Error verifying payment.');
                logErrorToDiagnosticEndpoint("VerifyPaymentException", error.message);
            });
        }

        function logErrorToDiagnosticEndpoint(errorCode, contextMsg) {
            try {
                var safeContext = '';
                if (errorCode === 'RazorpayPaymentInfoSaveInvoked') {
                    safeContext = contextMsg === 'CheckoutLoadWaitingState=active' || contextMsg === 'CheckoutLoadWaitingState=false'
                        ? contextMsg
                        : 'CheckoutLoadWaitingState=unknown';
                } else if (errorCode === 'PaymentFailed') {
                    safeContext = typeof contextMsg === 'string' ? contextMsg.slice(0, 2000) : '';
                }

                var antiforgeryToken = document.querySelector('input[name="__RequestVerificationToken"]');
                var formData = new FormData();
                if (antiforgeryToken) {
                    formData.append('__RequestVerificationToken', antiforgeryToken.value);
                }
                formData.append('error', errorCode);
                formData.append('context', safeContext);

                fetch('@Url.Action("LogClientError", "RazorpayPublic")', {
                    method: 'POST',
                    body: formData
                }).catch(function() {
                    // Ignore errors posting to diagnostic endpoint
                });
            } catch (error) {
                // Diagnostic failures must not affect checkout.
            }
        }

        function showError(msg) {
            errorContainer.textContent = msg;
            errorContainer.style.display = 'block';
            payButton.disabled = false;
            payButton.textContent = '@T("Plugins.Payments.Razorpay.PaymentInfo.PayButton").Text';
        }
    })();
</script>
