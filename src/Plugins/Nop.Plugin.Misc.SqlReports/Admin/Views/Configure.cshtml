@model ConfigurationModel

@{
    ViewBag.PageTitle = T("Plugins.Misc.SqlReports.Configure").Text;
    NopHtml.SetActiveMenuItemSystemName(SqlReportsDefaults.ConfigureMenuSystemName);
}

<form asp-controller="SqlReportsAdmin" asp-action="Configure" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">@T("Plugins.Misc.SqlReports.Configure")</h1>
        <div class="float-right">
            <button type="submit" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.Save")
            </button>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="form-horizontal">
                <div class="cards-group">
                    <div class="card card-default">
                        <div class="card-body">
                            <div asp-validation-summary="ModelOnly"></div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="MaxRowsPerQuery" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="MaxRowsPerQuery" />
                                    <span asp-validation-for="MaxRowsPerQuery"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="CommandTimeoutSeconds" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="CommandTimeoutSeconds" />
                                    <span asp-validation-for="CommandTimeoutSeconds"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="MaxCellLength" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="MaxCellLength" />
                                    <span asp-validation-for="MaxCellLength"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="EnableInstantQuery" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="EnableInstantQuery" />
                                    <span asp-validation-for="EnableInstantQuery"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="AllowExport" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="AllowExport" />
                                    <span asp-validation-for="AllowExport"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
