@model SqlReportParameterSearchModel

@{
    ViewBag.PageTitle = T("Plugins.Misc.SqlReports.Parameters").Text;
    NopHtml.SetActiveMenuItemSystemName(SqlReportsDefaults.ParametersMenuSystemName);
}

<div class="content-header clearfix">
    <h1 class="float-left">@T("Plugins.Misc.SqlReports.Parameters")</h1>
    <div class="float-right">
        <a asp-action="ParameterCreate" class="btn btn-primary">
            <i class="fas fa-square-plus"></i>
            @T("Admin.Common.AddNew")
        </a>
        <a asp-action="Reports" class="btn btn-default">
            <i class="fas fa-chart-line"></i>
            @T("Plugins.Misc.SqlReports.Reports")
        </a>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                <div class="card card-default card-search">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group row">
                                    <div class="col-md-4">
                                        <nop-label asp-for="SearchName" />
                                    </div>
                                    <div class="col-md-8">
                                        <nop-editor asp-for="SearchName" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-8 offset-md-4">
                                <button type="button" id="search-parameters" class="btn btn-primary btn-search">
                                    <i class="fas fa-magnifying-glass"></i>
                                    @T("Admin.Common.Search")
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card card-default">
                    <div class="card-body">
                        @await Html.PartialAsync("Table", new DataTablesModel
                        {
                            Name = "sqlreportparameters-grid",
                            UrlRead = new DataUrl("ParameterList", "SqlReportsAdmin", null),
                            SearchButtonId = "search-parameters",
                            Length = Model.PageSize,
                            LengthMenu = Model.AvailablePageSizes,
                            Filters = new List<FilterParameter>
                            {
                                new(nameof(Model.SearchName))
                            },
                            ColumnCollection = new List<ColumnProperty>
                            {
                                new(nameof(SqlReportParameterModel.Name))
                                {
                                    Title = T("Plugins.Misc.SqlReports.Parameter.Fields.Name").Text
                                },
                                new(nameof(SqlReportParameterModel.ParameterName))
                                {
                                    Title = T("Plugins.Misc.SqlReports.Parameter.Fields.ParameterName").Text
                                },
                                new(nameof(SqlReportParameterModel.DataType))
                                {
                                    Title = T("Plugins.Misc.SqlReports.Parameter.Fields.DataType").Text,
                                    Width = "120"
                                },
                                new(nameof(SqlReportParameterModel.IsRequired))
                                {
                                    Title = T("Plugins.Misc.SqlReports.Parameter.Fields.IsRequired").Text,
                                    Width = "100",
                                    ClassName = NopColumnClassDefaults.CenterAll,
                                    Render = new RenderBoolean()
                                },
                                new(nameof(SqlReportParameterModel.DisplayOrder))
                                {
                                    Title = T("Plugins.Misc.SqlReports.Parameter.Fields.DisplayOrder").Text,
                                    Width = "120"
                                },
                                new(nameof(SqlReportParameterModel.Id))
                                {
                                    Title = T("Admin.Common.Edit").Text,
                                    Width = "100",
                                    ClassName = NopColumnClassDefaults.Button,
                                    Render = new RenderButtonEdit(new DataUrl("~/Admin/SqlReports/Parameters/Edit/"))
                                }
                            }
                        })
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
