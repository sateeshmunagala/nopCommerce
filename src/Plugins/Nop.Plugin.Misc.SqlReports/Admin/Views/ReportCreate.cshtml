@model SqlReportModel

@{
    ViewBag.PageTitle = T("Plugins.Misc.SqlReports.Report.AddNew").Text;
    NopHtml.SetActiveMenuItemSystemName(SqlReportsDefaults.ReportsMenuSystemName);
}

<form asp-controller="SqlReportsAdmin" asp-action="ReportCreate" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Plugins.Misc.SqlReports.Report.AddNew")
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="Reports">@T("Plugins.Misc.SqlReports.BackToReports")</a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.SaveContinue")
            </button>
        </div>
    </div>
    @await Html.PartialAsync("~/Plugins/Misc.SqlReports/Admin/Views/_ReportCreateOrUpdate.cshtml", Model)
</form>
