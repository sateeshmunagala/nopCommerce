@model InstantQueryModel

@{
    ViewBag.PageTitle = T("Plugins.Misc.SqlReports.InstantQuery").Text;
    NopHtml.SetActiveMenuItemSystemName(SqlReportsDefaults.InstantQueryMenuSystemName);
}

<form asp-controller="SqlReportsAdmin" asp-action="InstantQuery" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Plugins.Misc.SqlReports.InstantQuery")
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="Reports">@T("Plugins.Misc.SqlReports.BackToReports")</a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-play"></i>
                @T("Plugins.Misc.SqlReports.Run")
            </button>
            @if (Model.AllowExport)
            {
                <button type="submit" class="btn btn-success" formaction="@Url.Action("InstantExport")">
                    <i class="far fa-file-excel"></i>
                    @T("Admin.Common.ExportToExcel")
                </button>
            }
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="form-horizontal">
                <div class="cards-group">
                    <div class="card card-default">
                        <div class="card-body">
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="SqlQuery" />
                                </div>
                                <div class="col-md-9">
                                    <textarea asp-for="SqlQuery" class="form-control" rows="14"></textarea>
                                    <span asp-validation-for="SqlQuery"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="ParameterValues" />
                                </div>
                                <div class="col-md-9">
                                    <textarea asp-for="ParameterValues" class="form-control" rows="5"></textarea>
                                    <span asp-validation-for="ParameterValues"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card card-default">
                        <div class="card-body">
                            @await Html.PartialAsync("~/Plugins/Misc.SqlReports/Admin/Views/_Result.cshtml", Model.Result)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
