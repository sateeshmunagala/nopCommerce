@model PublicInfoModel
@{
    Layout = "";
    var resultsId = "skillfinder-inline-results";
    var loadingId = "skillfinder-inline-loading";

    NopHtml.AppendCssFileParts("~/Plugins/Misc.Skillfinder.InlineFilter/Content/css/inline-filter.css");
    NopHtml.AppendCssFileParts("~/Plugins/Misc.AIInterview/Content/css/aiinterview-public.css");
}

<script src="~/lib_npm/htmx.org/dist/htmx.min.js"
        asp-location="Footer"
        onerror="this.onerror=null;this.src='@Url.Content("~/Plugins/Misc.Skillfinder.InlineFilter/Content/js/htmx.min.js")';"></script>
<script src="~/Plugins/Misc.Skillfinder.InlineFilter/Content/js/inline-filter.js" asp-location="Footer"></script>

<section class="sfi-inline-filter" aria-labelledby="skillfinder-inline-filter-title" data-sfi-inline-filter data-sfi-skills-view>
    <header class="sfi-heading">
        <span class="sfi-eyebrow">@T($"{SkillfinderInlineFilterDefaults.LocalizationPrefix}.Eyebrow")</span>
        <h5 id="skillfinder-inline-filter-title">@T($"{SkillfinderInlineFilterDefaults.LocalizationPrefix}.Title")</h5>
    </header>

    @if (Model.Categories.Any())
    {
        <div class="sfi-filter-actions">
            <div class="sfi-skills-filter" data-sfi-skills-filter>
                <div class="sfi-selected-skills" data-sfi-selected-skills aria-live="polite">
                    @foreach (var category in Model.Categories.Where(category => category.IsSelected))
                    {
                        <span class="sfi-skill-badge" data-sfi-skill-badge="@category.SeName">
                            <span>@category.Name</span>
                            <button type="button"
                                    class="sfi-skill-badge-remove"
                                    data-sfi-remove-skill="@category.SeName"
                                    aria-label="Remove @category.Name">&times;</button>
                        </span>
                    }
                </div>

                <label class="sr-only" for="skillfinder-skill-search">Search skills</label>
                <input id="skillfinder-skill-search"
                       class="sfi-skill-search"
                       type="search"
                       placeholder="Search skills"
                       autocomplete="off"
                       data-sfi-skill-search />

                <div class="sfi-skills-container"
                     role="group"
                     aria-label="@T($"{SkillfinderInlineFilterDefaults.LocalizationPrefix}.CategoriesLabel")">
                    @for (var index = 0; index < Model.Categories.Count; index++)
                    {
                        var category = Model.Categories[index];
                        var checkboxId = $"skillfinder-skill-{index}";
                        var categoryViewMoreUrl = Url.RouteUrl("Category", new { SeName = category.SeName });

                        <label class="sfi-skill-option"
                               for="@checkboxId"
                               data-sfi-skill-item
                               data-sfi-skill-name="@category.Name">
                            <input id="@checkboxId"
                                   type="checkbox"
                                   name="categorySeName"
                                   value="@category.SeName"
                                   data-sfi-skill-checkbox
                                   data-sfi-view-more-url="@categoryViewMoreUrl"
                                   hx-get="@Url.RouteUrl(SkillfinderInlineFilterDefaults.RouteName, new { categorySeName = category.SeName })"
                                   hx-trigger="change"
                                   hx-target="#@resultsId"
                                   hx-swap="innerHTML"
                                   hx-indicator="#@loadingId"
                                   @(category.IsSelected ? "checked" : null) />
                            <span data-sfi-skill-label>@category.Name</span>
                        </label>
                    }
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Results.ViewMoreUrl) && !string.IsNullOrWhiteSpace(Model.Results.SelectedCategorySeName))
            {
                <div class="sfi-view-more-wrap">
                    <a class="sfi-view-more" href="@Model.Results.ViewMoreUrl" data-sfi-view-more>
                        @T($"{SkillfinderInlineFilterDefaults.LocalizationPrefix}.ViewMore")
                    </a>
                </div>
            }
        </div>
    }

    <div class="sfi-results-shell">
        <div id="@loadingId" class="sfi-loading htmx-indicator" role="status" aria-live="polite">
            <span class="sfi-loading-text">@T($"{SkillfinderInlineFilterDefaults.LocalizationPrefix}.Loading")</span>
        </div>
        <div id="@resultsId"
             class="sfi-results"
             aria-live="polite"
             aria-busy="false"
             aria-label="@T($"{SkillfinderInlineFilterDefaults.LocalizationPrefix}.ResultsLabel")">
            @await Html.PartialAsync("~/Plugins/Misc.Skillfinder.InlineFilter/Views/_FilteredProductsGrid.cshtml", Model.Results)
        </div>
    </div>
</section>

<script asp-location="Footer">
    (() => {
        const createBadge = (checkbox) => {
            const option = checkbox.closest('[data-sfi-skill-item]');
            const label = option?.querySelector('[data-sfi-skill-label]')?.textContent?.trim() || checkbox.value;
            const badge = document.createElement('span');
            const badgeLabel = document.createElement('span');
            const removeButton = document.createElement('button');

            badge.className = 'sfi-skill-badge';
            badge.dataset.sfiSkillBadge = checkbox.value;
            badgeLabel.textContent = label;
            removeButton.type = 'button';
            removeButton.className = 'sfi-skill-badge-remove';
            removeButton.dataset.sfiRemoveSkill = checkbox.value;
            removeButton.setAttribute('aria-label', `Remove ${label}`);
            removeButton.innerHTML = '&times;';

            badge.append(badgeLabel, removeButton);
            return badge;
        };

        const initializeSkillsFilter = (root) => {
            if (root.dataset.sfiSkillsBound === 'true')
                return;

            root.dataset.sfiSkillsBound = 'true';
            const search = root.querySelector('[data-sfi-skill-search]');
            const selectedSkills = root.querySelector('[data-sfi-selected-skills]');
            const checkboxes = Array.from(root.querySelectorAll('[data-sfi-skill-checkbox]'));

            const renderSelectedSkills = () => {
                selectedSkills.replaceChildren(...checkboxes.filter(checkbox => checkbox.checked).map(createBadge));
            };

            search?.addEventListener('input', () => {
                const query = search.value.trim().toLocaleLowerCase();
                root.querySelectorAll('[data-sfi-skill-item]').forEach(item => {
                    const name = item.dataset.sfiSkillName?.toLocaleLowerCase() || '';
                    item.hidden = query.length > 0 && !name.includes(query);
                });
            });

            root.addEventListener('change', event => {
                const checkbox = event.target.closest?.('[data-sfi-skill-checkbox]');
                if (!checkbox)
                    return;

                renderSelectedSkills();
                const viewMore = root.querySelector('[data-sfi-view-more]');
                const viewMoreUrl = checkbox.dataset.sfiViewMoreUrl;
                if (checkbox.checked && viewMore && viewMoreUrl)
                    viewMore.href = viewMoreUrl;
            });

            root.addEventListener('click', event => {
                const removeButton = event.target.closest?.('[data-sfi-remove-skill]');
                if (!removeButton)
                    return;

                const checkbox = checkboxes.find(item => item.value === removeButton.dataset.sfiRemoveSkill);
                if (!checkbox)
                    return;

                checkbox.checked = false;
                checkbox.dispatchEvent(new Event('change', { bubbles: true }));
            });

            renderSelectedSkills();
        };

        const initialize = () => document.querySelectorAll('[data-sfi-skills-view]').forEach(initializeSkillsFilter);

        if (document.readyState === 'loading')
            document.addEventListener('DOMContentLoaded', initialize, { once: true });
        else
            initialize();
    })();
</script>
