@model SinglePageCheckoutPageModel
@using Nop.Core
@using Nop.Services.Customers
@using Nop.Services.Helpers
@using System.Text.Encodings.Web
@inject IWebHelper webHelper
@inject IWorkContext workContext
@inject ICustomerService customerService
@{
    Layout = "_ColumnsOne";

    var storeLocation = webHelper.GetStoreLocation();

    NopHtml.AddTitleParts(T("PageTitle.Checkout").Text);
    NopHtml.AppendPageCssClassParts("html-checkout-page html-single-page-checkout");

    NopHtml.AddCssFileParts("~/Plugins/Misc.SinglePageCheckout/Content/single-page-checkout.css");
}

<script src="~/js/public.accordion.js" asp-location="Footer"></script>
<script src="~/js/public.onepagecheckout.js" asp-location="Footer"></script>
<script src="~/Plugins/Misc.SinglePageCheckout/Content/single-page-checkout.js" asp-location="Footer"></script>

<div class="page checkout-page spc-page">
    <div class="page-title">
        <h1>@T("Checkout")</h1>
    </div>
    <div class="page-body checkout-data">
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.OpcContentBefore, additionalData = Model.CheckoutModel })

        <div class="spc-layout" id="checkout-steps">
            <div class="spc-column spc-column-primary">
                <div class="spc-checkout-workarea">
                    <div id="opc-billing" class="tab-section allow spc-card spc-card-billing">
                        <div class="step-title spc-card-title">
                            <h2>@T("Checkout.BillingAddress")</h2>
                        </div>
                        <div id="checkout-step-billing" class="step a-item">
                            <form id="co-billing-form" action="" method="post">
                                <div id="checkout-billing-load">
                                    @await Html.PartialAsync("~/Views/Checkout/OpcBillingAddress.cshtml", Model.CheckoutModel.BillingAddress)
                                </div>
                            </form>
                            <script asp-location="Footer">
                                Billing.init('#co-billing-form', '@(storeLocation)checkout/GetAddressById/',
                                    '@(storeLocation)checkout/OpcSaveBilling/',
                                    @(Model.CheckoutModel.DisableBillingAddressCheckoutStep.ToString().ToLowerInvariant()),
                                    @((await customerService.IsGuestAsync(await workContext.GetCurrentCustomerAsync())).ToString().ToLowerInvariant()));
                                if ($("#billing-address-select").length > 0) {
                                    Billing.newAddress($('#billing-address-select').val() === '0');
                                }
                            </script>
                            <div class="buttons spc-buttons" id="billing-buttons-container">
                                <button id="save-billing-address-button" type="button" class="button-1" style="display: none" onclick="Billing.saveEditAddress('@(storeLocation)checkout/SaveEditBillingAddress/'); return false;">@T("Common.Save")</button>
                                <button type="button" name="save" class="button-1 new-address-next-step-button" onclick="Billing.save()">@T("Common.Continue")</button>
                                <span class="please-wait" id="billing-please-wait" style="display: none;">@T("Common.LoadingNextStep")</span>
                            </div>
                        </div>
                    </div>

                    @if (Model.CheckoutModel.ShippingRequired)
                    {
                        <div id="opc-shipping" class="tab-section spc-card spc-card-shipping">
                            <div class="step-title spc-card-title">
                                <h2>@T("Checkout.ShippingAddress")</h2>
                            </div>
                            <div id="checkout-step-shipping" class="step a-item">
                                <form action="" id="co-shipping-form" method="post">
                                    <div id="checkout-shipping-load">
                                        <div class="spc-placeholder">@T("Common.LoadingNextStep")</div>
                                    </div>
                                </form>
                                <script asp-location="Footer">
                                    Shipping.init('#co-shipping-form', '@(storeLocation)checkout/OpcSaveShipping/');
                                </script>
                                <div class="buttons spc-buttons" id="shipping-buttons-container">
                                    @if (!Model.CheckoutModel.DisableBillingAddressCheckoutStep)
                                    {
                                        <p class="back-link">
                                            <a href="#" onclick="Checkout.back(); return false;"><small>&laquo; </small>@T("Common.Back")</a>
                                        </p>
                                    }
                                    <span id="edit-shipping-address-buttons">
                                        <button id="save-shipping-address-button" type="button" class="button-1" style="display: none" onclick="Shipping.saveEditAddress('@(storeLocation)checkout/SaveEditShippingAddress/'); return false;">@T("Common.Save")</button>
                                    </span>
                                    <button type="button" class="button-1 new-address-next-step-button" onclick="Shipping.save()">@T("Common.Continue")</button>
                                    <span id="shipping-please-wait" class="please-wait" style="display: none;">@T("Common.LoadingNextStep")</span>
                                </div>
                            </div>
                        </div>

                        @if (Model.Settings.ShowEstimateShipping)
                        {
                            <div class="spc-card spc-card-estimate">
                                <div class="spc-card-title">
                                    <h2>@T("ShoppingCart.EstimateShipping")</h2>
                                </div>
                                <div class="spc-card-body">
                                    @await Html.PartialAsync("~/Plugins/Misc.SinglePageCheckout/Views/_EstimateShipping.cshtml", Model.EstimateShippingModel)
                                </div>
                            </div>
                        }

                        <div id="opc-shipping_method" class="tab-section spc-card spc-card-shipping-method">
                            <div class="step-title spc-card-title">
                                <h2>@T("Checkout.ShippingMethod")</h2>
                            </div>
                            <div id="checkout-step-shipping-method" class="step a-item">
                                <form id="co-shipping-method-form" action="" method="post">
                                    <div id="checkout-shipping-method-load">
                                        <div class="spc-placeholder">@T("Common.LoadingNextStep")</div>
                                    </div>
                                    <script asp-location="Footer">
                                        var spcShippingLocalizedData = {
                                            NotAvailableMethodsError: "@T("ShippingMethod.NotAvailableMethodsError")",
                                            SpecifyMethodError: "@T("ShippingMethod.SpecifyMethodError")"
                                        };
                                        ShippingMethod.init('#co-shipping-method-form', '@(storeLocation)checkout/OpcSaveShippingMethod/', spcShippingLocalizedData);
                                    </script>
                                    <div class="buttons spc-buttons" id="shipping-method-buttons-container">
                                        <p class="back-link">
                                            <a href="#" onclick="Checkout.back(); return false;"><small>&laquo; </small>@T("Common.Back")</a>
                                        </p>
                                        <button type="button" class="button-1 shipping-method-next-step-button" onclick="ShippingMethod.save()">@T("Common.Continue")</button>
                                        <span id="shipping-method-please-wait" class="please-wait" style="display: none;">@T("Common.LoadingNextStep")</span>
                                    </div>
                                </form>
                            </div>
                        </div>
                    }

                    <div class="spc-payment-cluster spc-card">
                        <div class="step-title spc-card-title">
                            <h2>@T("Checkout.PaymentMethod")</h2>
                        </div>
                        <div id="opc-payment_method" class="tab-section spc-card spc-card-payment-method">
                            <div id="checkout-step-payment-method" class="step a-item">
                                <form action="" id="co-payment-method-form" method="post">
                                    <div id="checkout-payment-method-load">
                                    </div>
                                </form>
                                <script asp-location="Footer">
                                    var spcPaymentLocalizedData = {
                                        NotAvailableMethodsError: "@T("PaymentMethod.NotAvailableMethodsError")",
                                        SpecifyMethodError: "@T("PaymentMethod.SpecifyMethodError")"
                                    };
                                    PaymentMethod.init('#co-payment-method-form', '@(storeLocation)checkout/OpcSavePaymentMethod/', spcPaymentLocalizedData);
                                </script>
                                <div class="buttons spc-buttons" id="payment-method-buttons-container">
                                    <p class="back-link">
                                        <a href="#" onclick="Checkout.back(); return false;"><small>&laquo; </small>@T("Common.Back")</a>
                                    </p>
                                    <button type="button" name="save" class="button-1 payment-method-next-step-button" onclick="PaymentMethod.save()">@T("Common.Continue")</button>
                                    <span class="please-wait" id="payment-method-please-wait" style="display: none;">@T("Common.LoadingNextStep")</span>
                                </div>
                            </div>
                        </div>

                        <div id="opc-payment_info" class="tab-section spc-card spc-card-payment-info">
                            <div id="checkout-step-payment-info" class="step a-item">
                                <form action="" id="co-payment-info-form" method="post">
                                    <div id="checkout-payment-info-load"></div>
                                </form>
                                <script asp-location="Footer">
                                    PaymentInfo.init('#co-payment-info-form', '@(storeLocation)checkout/OpcSavePaymentInfo/');
                                </script>
                                <div class="buttons spc-buttons" id="payment-info-buttons-container">
                                    <button type="button" class="button-1 payment-info-next-step-button" onclick="PaymentInfo.save()">@T("Common.Continue")</button>
                                    <span class="please-wait" id="payment-info-please-wait" style="display: none;">@T("Common.LoadingNextStep")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    @await Html.PartialAsync("~/Plugins/Misc.SinglePageCheckout/Views/_PromoBoxes.cshtml", Model)
                </div>
            </div>

            <div class="spc-column spc-column-secondary">
                <div id="spc-summary-container" class="spc-summary-shell">
                    <div class="spc-summary-progress" aria-hidden="true">
                        <span></span>
                    </div>
                    <div id="spc-summary-content">
                        @await Html.PartialAsync("~/Plugins/Misc.SinglePageCheckout/Views/_Sidebar.cshtml", Model)
                    </div>
                </div>
                <div id="opc-confirm_order" class="tab-section spc-card spc-card-confirm">
                    <div class="step-title spc-card-title">
                        <h2>@T("Checkout.ConfirmOrder")</h2>
                    </div>
                    <div id="checkout-step-confirm-order" class="step a-item">
                        <div id="checkout-confirm-order-load">
                        </div>
                        <script asp-location="Footer">
                            ConfirmOrder.init('@(storeLocation)checkout/OpcConfirmOrder/',
                                '@Url.RouteUrl(NopRouteNames.Standard.CHECKOUT_COMPLETED)',
                                @Model.CheckoutModel.DisplayCaptcha.ToString().ToLowerInvariant(),
                                @Model.CheckoutModel.IsReCaptchaV3.ToString().ToLowerInvariant(),
                                '@Model.CheckoutModel.ReCaptchaPublicKey',
                                '#checkout-step-confirm-order');
                        </script>
                        <div class="buttons spc-buttons" id="confirm-order-buttons-container">
                            <p class="back-link">
                                <a href="#" onclick="Checkout.back(); return false;"><small>&laquo; </small>@T("Common.Back")</a>
                            </p>
                            <button type="button" id="spc-confirm-order-button" class="button-1 confirm-order-next-step-button" onclick="ConfirmOrder.save()" disabled>@T("Checkout.ConfirmButton")</button>
                            <span class="please-wait" id="confirm-order-please-wait" style="display: none;">@T("Checkout.SubmittingOrder")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.OpcContentAfter, additionalData = Model.CheckoutModel })
    </div>
</div>

<script asp-location="Footer">
    $(function () {
        SinglePageCheckout.init({
            summaryUrl: '@Url.RouteUrl(SinglePageCheckoutDefaults.SummaryRouteName)',
            failureUrl: '@(storeLocation)cart/',
            estimateShippingUrl: '@Url.RouteUrl(NopRouteNames.Ajax.ESTIMATE_SHIPPING)',
            noShippingOptionsMessage: '@JavaScriptEncoder.Default.Encode(T("Shipping.EstimateShippingPopUp.NoShippingOptions").Text)'
        });
    });
</script>
