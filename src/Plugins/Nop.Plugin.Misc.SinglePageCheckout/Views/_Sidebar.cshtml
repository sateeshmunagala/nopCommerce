@model SinglePageCheckoutPageModel

@if (Model.ShoppingCartModel != null)
{
    var showDiscountBox = Model.Settings.ShowDiscountBox && Model.ShoppingCartModel.DiscountBox.Display;
    var showGiftCardBox = Model.Settings.ShowGiftCardBox && Model.ShoppingCartModel.GiftCardBox.Display;

    <form asp-route="@NopRouteNames.General.CART" method="post" enctype="multipart/form-data" id="shopping-cart-form" class="spc-summary-form @(Model.CheckoutModel?.ShippingRequired == true ? "" : "spc-no-shipping")">
        @if (Model.ShoppingCartModel.Warnings.Any())
        {
            <div class="message-error">
                <ul>
                    @foreach (var warning in Model.ShoppingCartModel.Warnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            </div>
        }

        @if (Model.Settings.ShowOrderReviewData)
        {
            @await Html.PartialAsync("~/Plugins/Misc.SinglePageCheckout/Views/_OrderReviewData.cshtml", Model.ShoppingCartModel.OrderReviewData)
        }

        @if (Model.Settings.ShowCartOnCheckout)
        {
            <div class="spc-card spc-card-order-summary">
                <div class="spc-card-title">
                    <h2>@T("Checkout.OrderSummary")</h2>
                </div>
                <div class="spc-card-body">
                    @await Html.PartialAsync("~/Plugins/Misc.SinglePageCheckout/Views/_CartSummary.cshtml", Model.ShoppingCartModel)
                </div>
            </div>
        }

        @if (Model.Settings.ShowCheckoutAttributes && Model.ShoppingCartModel.CheckoutAttributes.Any())
        {
            <div class="spc-card spc-card-checkout-attributes">
                <div class="spc-card-title">
                    <h2>@T("Admin.Catalog.Attributes.CheckoutAttributes")</h2>
                </div>
                <div class="spc-card-body">
                    @await Html.PartialAsync("~/Views/Shared/_CheckoutAttributes.cshtml", Model.ShoppingCartModel)
                </div>
            </div>
        }

        <div class="spc-card spc-card-totals">
            <div class="spc-card-title">
                <h2>@T("ShoppingCart.Totals.OrderTotal")</h2>
            </div>
            <div class="spc-card-body">
                @await Component.InvokeAsync(typeof(OrderTotalsViewComponent), new { isEditable = Model.ShoppingCartModel.IsEditable })
                @if (!string.IsNullOrEmpty(Model.ShoppingCartModel.MinOrderSubtotalWarning))
                {
                    <div class="min-amount-warning">
                        @Model.ShoppingCartModel.MinOrderSubtotalWarning
                    </div>
                }
            </div>
        </div>
    </form>
}
