@model ProductOverviewModel

@using Nop.Core.Domain.Catalog
@using Nop.Core.Domain.Orders

@{
    var isRecommended = ViewData["IsRecommended"] as bool? ?? false;
    var shoppingCartTypeId = (int)ShoppingCartType.ShoppingCart;
    const int quantity = 1;
    var addToCartLink = Model.ProductPrice.ForceRedirectionAfterAddingToCart
        ? Url.RouteUrl(NopRouteNames.Ajax.ADD_PRODUCT_TO_CART_CATALOG, new
        {
            productId = Model.Id,
            shoppingCartTypeId,
            quantity,
            forceredirection = Model.ProductPrice.ForceRedirectionAfterAddingToCart
        })
        : Url.RouteUrl(NopRouteNames.Ajax.ADD_PRODUCT_TO_CART_CATALOG, new
        {
            productId = Model.Id,
            shoppingCartTypeId,
            quantity
        });
    var productUrl = await NopUrl.RouteGenericUrlAsync<Product>(new { SeName = Model.SeName });
}

<article class="jb-pricing-card @(isRecommended ? "jb-pricing-card-recommended" : null)" data-productid="@Model.Id">
    @if (isRecommended)
    {
        <div class="jb-pricing-card-badge">Popular</div>
    }

    <div class="jb-pricing-card-body">
        <h2 class="jb-pricing-card-title">
            <a href="@productUrl">@Model.Name</a>
        </h2>

        @if (!string.IsNullOrWhiteSpace(Model.ShortDescription))
        {
            <div class="jb-pricing-card-description">
                @Html.Raw(Model.ShortDescription)
            </div>
        }

        <div class="jb-pricing-card-price-wrap">
            @if (!string.IsNullOrWhiteSpace(Model.ProductPrice.OldPrice))
            {
                <span class="jb-pricing-card-old-price">@Model.ProductPrice.OldPrice</span>
            }
            <span class="jb-pricing-card-price">@Model.ProductPrice.Price</span>
        </div>

        <!-- NEW: Full Description Field -->
        @if (!string.IsNullOrWhiteSpace(Model.FullDescription))
        {
            <div class="jb-pricing-card-full-desc">
                @Html.Raw(Model.FullDescription)
            </div>
        }
    </div>

    @if (!Model.ProductPrice.DisableBuyButton)
    {
        <button type="button"
                class="button-2 jb-pricing-card-cta"
                onclick="AjaxCart.addproducttocart_catalog('@addToCartLink');return false;">
            Buy Now
        </button>
    }
</article>