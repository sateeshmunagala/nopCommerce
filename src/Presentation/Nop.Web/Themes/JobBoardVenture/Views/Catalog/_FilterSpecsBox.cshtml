@model SpecificationFilterModel
@{
    NopHtml.AppendCssFileParts("~/Plugins/Misc.AIInterview/Content/css/aiinterview-public.css");
    var skillsAliases = System.AppDomain.CurrentDomain.GetAssemblies()
        .Select(assembly => assembly.GetType("Nop.Plugin.Misc.AIInterview.Services.AIInterviewJobDisplayService"))
        .Where(type => type != null)
        .Select(type => type.GetField("SkillsAliases")?.GetValue(null) as string[])
        .FirstOrDefault(aliases => aliases != null)
        ?? new[] { "Skills", "Skill Set", "Key Skills", "Required Skills" };
}

<div class="product-filter product-spec-filter product-spec-filter-groups">
    @foreach (var attr in Model.Attributes)
    {
        var isSkillsAttribute = skillsAliases.Any(alias =>
            string.Equals(attr.Name, alias, StringComparison.OrdinalIgnoreCase));
        <details class="group product-spec-group jb-spec-filter-group @(!attr.Values.Any() ? "jb-spec-filter-group-empty" : null) @(attr.Values.Any(x => !string.IsNullOrEmpty(x.ColorSquaresRgb)) ? "product-spec-color" : null) @(isSkillsAttribute ? "jb-skills-filter" : null)" open>
            <summary class="name jb-spec-filter-summary">
                <span class="jb-spec-filter-summary-text">@attr.Name</span>
            </summary>

            @if (isSkillsAttribute)
            {
                <div class="jb-selected-skills" data-jb-selected-skills aria-live="polite">
                    @foreach (var selectedValue in attr.Values.Where(value => value.Selected))
                    {
                        <span class="jb-selected-skill" data-jb-selected-skill="@selectedValue.Id">
                            <span>@selectedValue.Name</span>
                            <button type="button"
                                    class="jb-selected-skill-remove"
                                    data-jb-remove-skill="@selectedValue.Id"
                                    aria-label="Remove @selectedValue.Name">&times;</button>
                        </span>
                    }
                </div>
                <input class="jb-skills-search"
                       type="search"
                       placeholder="Search skills"
                       aria-label="Search @attr.Name"
                       autocomplete="off" />
            }

            <div class="@(isSkillsAttribute ? "jb-skills-scroll-container" : null)">
                <ul class="jb-spec-filter-values">
                    @foreach (var value in attr.Values)
                    {
                        <li class="item @(!string.IsNullOrEmpty(value.ColorSquaresRgb) ? "color-item" : null)" data-jb-skill-item="@(isSkillsAttribute ? "true" : null)">
                            <input id="attribute-option-@value.Id" type="checkbox" data-option-id="@value.Id" checked="@value.Selected" />
                            @if (string.IsNullOrEmpty(value.ColorSquaresRgb))
                            {
                                <label for="attribute-option-@value.Id">
                                    @value.Name
                                </label>
                            }
                            else
                            {
                                <label for="attribute-option-@value.Id" class="attribute-squares color-squares">
                                    <span class="attribute-square" style="background-color: @(value.ColorSquaresRgb);"></span>
                                    @value.Name
                                </label>
                            }
                        </li>
                    }
                </ul>
            </div>
        </details>
    }
</div>

<script asp-location="Footer">
    $(function() {
        var $optionEls = $('[data-option-id]');

        $('.jb-skills-filter').each(function() {
            var $filter = $(this);
            var $search = $filter.find('.jb-skills-search');
            var $items = $filter.find('[data-jb-skill-item="true"]');
            var $checkboxes = $items.find('input[type="checkbox"][data-option-id]');
            var $selectedSkills = $filter.find('[data-jb-selected-skills]');

            function renderSelectedSkills() {
                $selectedSkills.empty();
                $checkboxes.filter(':checked').each(function() {
                    var $checkbox = $(this);
                    var optionId = $checkbox.data('option-id').toString();
                    var optionText = $filter.find('label[for="' + $checkbox.attr('id') + '"]').text().trim();
                    var $badge = $('<span class="jb-selected-skill"></span>').attr('data-jb-selected-skill', optionId);
                    var $remove = $('<button type="button" class="jb-selected-skill-remove">&times;</button>')
                        .attr('data-jb-remove-skill', optionId)
                        .attr('aria-label', 'Remove ' + optionText);

                    $badge.append($('<span></span>').text(optionText), $remove);
                    $selectedSkills.append($badge);
                });
            }

            $search.on('input', function() {
                var query = $(this).val().trim().toLocaleLowerCase();
                $items.each(function() {
                    var $item = $(this);
                    var optionText = $item.find('label').text().trim().toLocaleLowerCase();
                    $item.toggle(!query || optionText.includes(query));
                });
            });

            $checkboxes.on('change', renderSelectedSkills);
            $filter.on('click', '[data-jb-remove-skill]', function() {
                var optionId = $(this).attr('data-jb-remove-skill');
                var $checkbox = $checkboxes.filter(function() {
                    return $(this).data('option-id').toString() === optionId;
                });

                $checkbox.prop('checked', false).trigger('change');
            });

            renderSelectedSkills();
        });

        $optionEls.on('change', function() {
            CatalogProducts.getProducts();
        });

        $(CatalogProducts).on('before', function(e) {
            var selectedOptions = $.map($optionEls, function(el) {
                var $optionEl = $(el);
                if ($optionEl.is(':checked'))
                    return $optionEl.data('option-id');

                return null;
            });

            if (selectedOptions && selectedOptions.length > 0) {
                e.payload.urlBuilder
                    .addParameter('specs', selectedOptions.join(','));
            }
        });
    });
</script>
