@using Nop.Services.Localization
@using Nop.Core
@using System.IO
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Html
@inject ILocalizationService localizationService
@inject IStoreContext storeContext

@{
    static string ToHtmlString(IHtmlContent content)
    {
        if (content == null)
            return string.Empty;

        using var writer = new StringWriter();
        content.WriteTo(writer, HtmlEncoder.Default);
        return writer.ToString();
    }

    Layout = "_ColumnsOne";

    var currentStore = await storeContext.GetCurrentStoreAsync();
    var homepageTitle = await localizationService.GetLocalizedAsync(currentStore, s => s.HomepageTitle);

    if (!string.IsNullOrEmpty(homepageTitle))
    {
        NopHtml.AddTitleParts(homepageTitle);
    }

    var homepageDescription = await localizationService.GetLocalizedAsync(currentStore, s => s.HomepageDescription);

    if (!string.IsNullOrEmpty(homepageDescription))
    {
        NopHtml.AddMetaDescriptionParts(homepageDescription);
    }

    NopHtml.AppendPageCssClassParts("html-home-page");
    const string mockPracticeUrl = "/generic-ai-interview-practice";

    var homepageTopContent = ToHtmlString(await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HomepageTop }));
    var homepageBeforeCategoriesContent = ToHtmlString(await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HomepageBeforeCategories }));
    var filterContent = ToHtmlString(await Component.InvokeAsync(typeof(FilterLevelValueSearchViewComponent)));
    var homepageCategoriesContent = ToHtmlString(await Component.InvokeAsync(typeof(HomepageCategoriesViewComponent)));
    var homepageBeforeProductsContent = ToHtmlString(await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HomepageBeforeProducts }));
    var homepageProductsContent = ToHtmlString(await Component.InvokeAsync(typeof(HomepageProductsViewComponent)));
    var homepageBeforeBestSellersContent = ToHtmlString(await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HomepageBeforeBestSellers }));
    var homepageBestSellersContent = ToHtmlString(await Component.InvokeAsync(typeof(HomepageBestSellersViewComponent)));
    var homepageFaqContent = ToHtmlString(await Component.InvokeAsync(typeof(TopicBlockViewComponent), new { systemName = "HomepageFAQ" }));
    var homepageBottomContent = ToHtmlString(await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HomepageBottom }));
}
<div class="page home-page jb-home-landing">
    <div class="page-body">
        <section class="jb-home-hero" aria-labelledby="jb-home-hero-title">
            <div class="jb-home-hero-shell">
                <div class="jb-home-hero-content">
                    <div class="jb-home-hero-text">
                        <span class="jb-home-badge">AI interview preparation platform</span>
                        <h1 id="jb-home-hero-title">Find jobs faster with AI interviews</h1>
                        <p class="jb-home-hero-copy">Search roles, apply with confidence, and prove your skills through AI-powered interview reports.</p>
                    </div>
                    @* <form class="jb-home-search-form" action="/search" method="get" role="search">
                        <label class="jb-home-search-label" for="jb-home-search-term">Search jobs</label>
                        <div class="jb-home-search-control">
                            <input class="search-box-text" id="jb-home-search-term" name="q" type="search" placeholder="Search jobs, skills, or locations" />
                            <button class="search-box-button" type="submit">Search</button>
                        </div>
                    </form> *@
                    <div class="jb-home-action-row jb-home-hero-actions" aria-label="Primary actions">
                        <a class="button-1 jb-home-button jb-home-button-primary" href="/jobs">Browse jobs</a>
                        <a class="button-2 jb-home-button jb-home-button-secondary" href="@mockPracticeUrl">AI interview</a>
                    </div>
                </div>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(homepageTopContent))
        {
            @Html.Raw(homepageTopContent)
        }

        @* <section class="jb-home-section jb-home-card jb-home-card--accent jb-home-trust-strip" aria-labelledby="jb-home-trust-title">
            <div class="jb-home-section-head">
                <span class="jb-home-eyebrow">Trusted workflow</span>
                <h2 id="jb-home-trust-title">Prepare with clarity before you apply</h2>
                <p>Practice interviews, understand your readiness, and move through applications with more confidence.</p>
            </div>
            <div class="jb-home-trust-pills" aria-label="Platform strengths">
                <span>AI-guided practice</span>
                <span>Role-based preparation</span>
                <span>Interview feedback</span>
                <span>Application progress</span>
            </div>
        </section> *@

        @if (!string.IsNullOrWhiteSpace(homepageBeforeCategoriesContent))
        {
            @Html.Raw(homepageBeforeCategoriesContent)
        }

        @if (!string.IsNullOrWhiteSpace(filterContent))
        {
            <div class="jb-home-filters">
                @Html.Raw(filterContent)
            </div>
        }

        <div class="jb-home-native-components jb-home-dynamic-components">
            @if (!string.IsNullOrWhiteSpace(homepageCategoriesContent))
            {
                <section class="jb-home-section jb-home-card jb-home-card--accent jb-home-categories-section" aria-labelledby="jb-home-categories-title">
                    <div class="jb-home-section-head">
                        <span class="jb-home-eyebrow">Explore roles</span>
                        <h2 id="jb-home-categories-title">Find your fit by skill area</h2>
                        <p>Let our intelligent matching engine connect you with verified roles based on your exact technical expertise.</p>
                    </div>
                    <div class="jb-home-card-content jb-home-category-component">
                        @Html.Raw(homepageCategoriesContent)
                    </div>
                </section>
            }

            @if (!string.IsNullOrWhiteSpace(homepageBeforeProductsContent))
            {
                @Html.Raw(homepageBeforeProductsContent)
            }

            @if (!string.IsNullOrWhiteSpace(homepageProductsContent))
            {
                <section class="jb-home-section jb-home-card jb-home-card--accent jb-home-featured-jobs" aria-labelledby="jb-home-featured-title">
                    <div class="jb-home-section-head">
                        <span class="jb-home-eyebrow">Featured jobs</span>
                        <h2 id="jb-home-featured-title">Fresh roles for your next move</h2>
                        <p>Explore current openings where skill, preparation, and interview readiness matter.</p>
                    </div>
                    <div class="jb-home-card-content jb-home-products-component">
                        @Html.Raw(homepageProductsContent)
                    </div>
                </section>
            }

            @* <section class="jb-home-section jb-home-card jb-home-card--accent jb-home-feature-section" aria-labelledby="jb-home-features-title">
                <div class="jb-home-section-head">
                    <span class="jb-home-eyebrow">Candidate platform</span>
                    <h2 id="jb-home-features-title">Build your career faster</h2>
                    <p>Everything candidates need to discover roles, practice interviews, and track progress in one place.</p>
                </div>
                <div class="jb-home-feature-grid">
                    <article class="jb-home-card jb-home-card--accent jb-home-feature-card">
                        <span class="jb-home-card-accent" aria-hidden="true"></span>
                        <h3>AI job matching</h3>
                        <p>Find roles that align with your skills, interests, and experience.</p>
                    </article>
                    <article class="jb-home-card jb-home-card--accent jb-home-feature-card">
                        <span class="jb-home-card-accent" aria-hidden="true"></span>
                        <h3>AI interview</h3>
                        <p>Practice realistic interviews and understand how you perform before you apply.</p>
                    </article>
                    <article class="jb-home-card jb-home-card--accent jb-home-feature-card">
                        <span class="jb-home-card-accent" aria-hidden="true"></span>
                        <h3>Instant feedback</h3>
                        <p>Review scores, reports, and application progress after every interview.</p>
                    </article>
                </div>
            </section> *@

            <section class="jb-home-section jb-home-card jb-home-card--accent jb-home-steps-section" aria-labelledby="jb-home-steps-title">
                <div class="jb-home-section-head">
                    <span class="jb-home-eyebrow">How it works</span>
                    <h2 id="jb-home-steps-title">Move from search to interview-ready</h2>
                </div>
                <div class="jb-home-steps">
                    <article class="jb-home-card jb-home-card--accent jb-home-step-card">
                        <span>01</span>
                        <h3>Search jobs</h3>
                        <p>Find open roles by title, skill, or category.</p>
                    </article>
                    <article class="jb-home-card jb-home-card--accent jb-home-step-card">
                        <span>02</span>
                        <h3>Apply or practice</h3>
                        <p>Choose a role and begin the application or mock interview flow.</p>
                    </article>
                    <article class="jb-home-card jb-home-card--accent jb-home-step-card">
                        <span>03</span>
                        <h3>Complete AI interview</h3>
                        <p>Answer structured questions in a guided interview experience.</p>
                    </article>
                    <article class="jb-home-card jb-home-card--accent jb-home-step-card">
                        <span>04</span>
                        <h3>Track results</h3>
                        <p>Use reports and application status to plan your next move.</p>
                    </article>
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(homepageBeforeBestSellersContent))
            {
                @Html.Raw(homepageBeforeBestSellersContent)
            }

            @if (!string.IsNullOrWhiteSpace(homepageBestSellersContent))
            {
                <div class="jb-home-card-content jb-home-bestsellers-component">
                    @Html.Raw(homepageBestSellersContent)
                </div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(homepageFaqContent))
        {
            <div class="jb-home-card jb-home-card--accent jb-home-topic-faq">
                @Html.Raw(homepageFaqContent)
            </div>
        }

        <section class="jb-home-section jb-home-card jb-home-card--accent jb-home-final-cta" aria-labelledby="jb-home-final-title">
            <div>
                <span class="jb-home-eyebrow">Get started</span>
                <h2 id="jb-home-final-title">Start your AI-powered job search today</h2>
                <p>Browse open roles or practice with an AI interview before you apply.</p>
            </div>
            <div class="jb-home-action-row jb-home-final-actions">
                <a class="button-1 jb-home-button jb-home-button-primary" href="/jobs">Browse jobs</a>
                <a class="button-2 jb-home-button jb-home-button-secondary" href="@mockPracticeUrl">AI interview</a>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(homepageBottomContent))
        {
            @Html.Raw(homepageBottomContent)
        }
    </div>
</div>
