@model ContactUsModel
@{
    Layout = "_ColumnsOne";

    //title
    NopHtml.AddTitleParts(T("PageTitle.ContactUs").Text);
    //page class
    NopHtml.AppendPageCssClassParts("html-contact-page");
}
<div class="page contact-page">
    <div class="page-body">
        <div class="contact-shell">
            <aside class="contact-info-panel">
                <div class="contact-hero">
                    <div class="contact-hero-intro">
                        <div class="page-title">
                            <h1 id="contact-page-title">@T("PageTitle.ContactUs")</h1>
                        </div>
                    </div>
                    <section class="contact-hero-metadata-cards" aria-label="@T("PageTitle.ContactUs")">
                        <div class="contact-hero-metadata-card">@await Component.InvokeAsync(typeof(TopicBlockViewComponent), new { systemName = "ContactUs" })</div>
                        <div class="contact-hero-metadata-card">@await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ContactUsTop, additionalData = Model })</div>
                        <div class="contact-hero-metadata-card">Email: support@example.com</div>
                        <div class="contact-hero-metadata-card">Phone: +1 000 000 0000</div>
                    </section>
                </div>
            </aside>

            <section class="contact-form-panel" aria-labelledby="contact-page-title">
                @if (Model.SuccessfullySent)
                {
                    <div class="result">
                        @Model.Result
                    </div>
                }
                else
                {
                    <form asp-route="@NopRouteNames.General.CONTACT_US" method="post">
                        <div asp-validation-summary="ModelOnly" class="message-error"></div>
                        <section class="fieldset contact-form-fieldset">
                            <div class="form-fields contact-form-fields">
                                <div class="inputs contact-form-field">
                                    <label asp-for="FullName" asp-postfix=":"></label>
                                    <div class="contact-form-control">
                                        <input asp-for="FullName" placeholder="@T("ContactUs.FullName.Hint")" class="fullname" />
                                        <nop-required />
                                    </div>
                                    <span asp-validation-for="FullName"></span>
                                </div>
                                <div class="inputs contact-form-field">
                                    <label asp-for="Email" asp-postfix=":"></label>
                                    <div class="contact-form-control">
                                        <input asp-for="Email" placeholder="@T("ContactUs.Email.Hint")" class="email" />
                                        <nop-required />
                                    </div>
                                    <span asp-validation-for="Email"></span>
                                </div>
                                @if (Model.SubjectEnabled)
                                {
                                    <div class="inputs contact-form-field contact-form-field-wide">
                                        <label asp-for="Subject" asp-postfix=":"></label>
                                        <div class="contact-form-control">
                                            <input asp-for="Subject" placeholder="@T("ContactUs.Subject.Hint")" class="subject" />
                                            <nop-required />
                                        </div>
                                        <span asp-validation-for="Subject"></span>
                                    </div>
                                }
                                <div class="inputs contact-form-field contact-form-field-wide contact-form-field-enquiry">
                                    <label asp-for="Enquiry" asp-postfix=":"></label>
                                    <div class="contact-form-control">
                                        <textarea asp-for="Enquiry" placeholder="@T("ContactUs.Enquiry.Hint")" class="enquiry"></textarea>
                                        <nop-required />
                                    </div>
                                    <span asp-validation-for="Enquiry"></span>
                                </div>

                                @if (Model.ContactFormAttributes.Count > 0)
                                {
                                    <div class="contact-form-attributes">
                                        @await Html.PartialAsync("_ContactFormAttributes", Model.ContactFormAttributes)
                                    </div>
                                }

                                @if (Model.DisplayCaptcha)
                                {
                                    <div class="contact-form-captcha">
                                        <nop-captcha />
                                    </div>
                                }
                            </div>
                        </section>
                        <section class="buttons contact-form-actions">
                            <button type="submit" name="send-email" class="button-1 contact-us-button">@T("ContactUs.Button")</button>
                        </section>
                    </form>
                }
            </section>
        </div>

        <div class="contact-page-widgets">
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ContactUsBottom, additionalData = Model })
        </div>
    </div>
</div>
