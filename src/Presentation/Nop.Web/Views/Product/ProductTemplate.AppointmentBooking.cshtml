@model ProductDetailsModel
@{
    // Reuse the layout and structure from the Simple product template
    Layout = "~/Views/Shared/_ColumnsTwo.cshtml";
}
@{
    // Reuse the layout and structure from the Simple product template
    Layout = "~/Views/Shared/_ColumnsTwo.cshtml";
}

<div class="product-details-page appointment-booking">
    @* Product details block (reuse from Simple) *@
    @* @await Html.PartialAsync("ProductTemplate.Simple", Model) *@

    @* Google Booking iframe block *@
    @if (!string.IsNullOrEmpty("Test"))
    {
        <section class="booking-section">
            <h3>Book an Appointment</h3>
            <div class="booking-iframe-wrapper">
                    <iframe src="https://calendar.app.google/B2rjmozGomg4ciZx7"
                        width="100%" height="600" frameborder="0" allowfullscreen
                        style="border:0; min-width:300px; max-width:100%;"></iframe>
            </div>
        </section>
    }
</div>

<style>
.appointment-booking .booking-section {  
    margin-top: 2em;  
    padding: 1em;  
    background: #f9f9f9;  
    border-radius: 8px;  
}
.booking-iframe-wrapper {  
    width: 100%;  
    max-width: 800px;  
    margin: 0 auto;  
}
.booking-iframe-wrapper iframe {  
    width: 100%;  
    min-height: 400px;  
    border: none;  
}
</style>


